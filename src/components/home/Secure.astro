---
// "Everything is yours from day one" bento (Figma 858:563, dark 858:975). Not in the M frames; stacks on mobile.
import Icon from '../Icon.astro';
import Dots from './Dots.astro';
const globe = '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>';
const lock = '<rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>';
const tools = [['F', '#1E1E1E', 'Figma', 'Brand and design files'], ['G', '#181717', 'GitHub', 'Code repository'], ['▲', '#000000', 'Vercel', 'Hosting'], ['P', '#0BA4DB', 'Paystack', 'Payments dashboard']];
---
<section class="secure rails">
  <div class="h-wrap">
    <div class="head">
      <p class="h-mono">Secure by setup</p>
      <h2>Everything is yours<br /><span class="dim">from day one.</span></h2>
    </div>
    <div class="bento">
      <div class="r1">
        <div class="cell">
          <div class="ct"><h3>Domain and hosting in your name</h3><p>Registered to your business from day one, with your email on the login. Never ours.</p></div>
          <div class="vig" aria-hidden="true">
            <Dots w={73} h={60} seed={3} style="position:absolute;left:262px;top:8px" />
            <div class="vc domain">
              <div class="ch"><span class="ttl"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={globe} />lumiskincare.com</span><span class="ok">Active</span></div>
              <i class="hr"></i>
              <p class="kv"><span>Registrant</span><b>Lumi Skincare Ltd</b></p>
              <p class="kv"><span>Account login</span><b>Your email</b></p>
              <p class="kv"><span>Hosting</span><b>Your account</b></p>
              <p class="kv"><span>Renews</span><b>12 Oct 2027</b></p>
            </div>
            <i class="fade"></i>
          </div>
        </div>
        <div class="cell">
          <div class="ct"><h3>Nothing goes live without you</h3><p>Every change waits on a preview link until someone on your side says yes.</p></div>
          <div class="vig" aria-hidden="true">
            <div class="steps">
              <div class="step dim2"><span class="sn">03</span><span class="sx"><b>Checks pass</b><span>Links, speed, mobile</span></span><Icon name="check" size={14} class="ck" /></div>
              <div class="step now"><span class="sn">04</span><span class="sx"><b>Needs your approval</b><span>Nothing is live yet</span></span><span class="approve">Approve</span></div>
              <div class="step dim2"><span class="sn">05</span><span class="sx"><b>Live on your site</b><span>After you say yes</span></span><Icon name="check" size={14} class="ck" /></div>
            </div>
            <i class="fade"></i>
          </div>
        </div>
        <div class="cell">
          <div class="ct"><h3>Private until you launch</h3><p>We sign an NDA before you share anything, and ask before your work appears anywhere.</p></div>
          <div class="vig" aria-hidden="true">
            <Dots w={100} h={60} seed={7} style="position:absolute;left:8px;top:160px" />
            <div class="vc nda">
              <div class="ch"><span class="ttl"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={lock} />Mutual NDA</span><span class="ok">Signed</span></div>
              <i class="sk"></i><i class="sk"></i><i class="sk sk2"></i>
              <div class="sigs"><span><b>Ola</b><small>Wintech Studio</small></span><span><b>Ada N.</b><small>You</small></span></div>
              <p class="foot">Signed before you share anything</p>
            </div>
            <i class="fade"></i>
          </div>
        </div>
      </div>
      <div class="r2">
        <div class="cell">
          <div class="vig wide" aria-hidden="true">
            <Dots w={100} h={60} seed={11} style="position:absolute;left:20px;top:30px" />
            <div class="vc access">
              <div class="ah"><b>Project closed · Wintech access</b><span>4 tools</span></div>
              {tools.map((t) => (
                <div class="tool"><span class="logo" style={`background:${t[1]}`}>{t[0]}</span><span class="tn"><span>{t[2]}</span><small>{t[3]}</small></span><span class="rm">Removed</span></div>
              ))}
            </div>
            <i class="fade"></i>
          </div>
          <div class="ct"><h3>Access removed when work ends</h3><p>When the project closes, our access to your tools goes the same day. You get the list.</p></div>
        </div>
        <div class="cell">
          <div class="vig wide" aria-hidden="true">
            <Dots w={95} h={60} seed={5} style="position:absolute;left:440px;top:20px" />
            <div class="handover">
              <div class="vc inv"><b>Final invoice  ·  INV-0311</b><span class="ok">Paid</span></div>
              <div class="swap">
                <div class="file old"><i></i><b>Brand and site files</b><small>Owner: Wintech</small></div>
                <Icon name="arrow-right" size={18} class="arr" />
                <div class="file new"><i></i><b>Brand and site files</b><small>Owner: you</small></div>
              </div>
            </div>
          </div>
          <div class="ct"><h3>Yours on the final payment</h3><p>The contract hands over everything: design files, brand assets, code and documents.</p></div>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .secure{background:var(--h-bg);padding:112px 0}
  .head{display:flex;flex-direction:column;gap:14px}
  h2{font-size:48px;line-height:1.08;letter-spacing:-.96px;font-weight:600;color:var(--h-fg);margin:0}
  .dim{color:#9AA3B2}:root[data-theme="dark"] .dim{color:#5E6678}
  .bento{margin-top:48px;border:1px solid var(--h-rule)}
  .r1,.r2{display:flex}.r1{border-bottom:1px solid var(--h-rule)}
  .cell{flex:1;min-width:0;display:flex;flex-direction:column;overflow:hidden}
  .cell+.cell{border-left:1px solid var(--h-rule)}
  .r1 .cell{padding:32px 32px 0;gap:28px}
  .r2 .cell{padding:0 32px 36px;gap:24px}
  .ct{display:flex;flex-direction:column;gap:8px}
  h3{font-size:20px;font-weight:600;letter-spacing:-.2px;line-height:normal;color:var(--h-fg);margin:0}
  .ct p{font-size:15px;line-height:1.5;color:var(--h-mute);margin:0;max-width:535px}
  .r1 .ct p{max-width:335px}
  .vig{position:relative;width:335px;height:236px;overflow:hidden;flex:none}
  .vig.wide{width:535px;height:244px}
  .fade{position:absolute;left:0;right:0;top:188px;height:48px;background:linear-gradient(180deg,transparent,var(--h-bg))}
  .wide .fade{top:196px}
  .vc{position:absolute;box-sizing:border-box;background:var(--h-card);border:1px solid var(--h-rule);border-radius:12px;box-shadow:var(--h-shadow);color:var(--h-fg)}
  .ch{display:flex;justify-content:space-between;align-items:center}
  .ttl{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:500}
  .ok{background:var(--h-ok-bg);color:var(--h-ok);font-size:11px;font-weight:500;padding:3px 7px;border-radius:5px;line-height:normal}
  .domain{left:18px;top:4px;width:300px;padding:16px;display:flex;flex-direction:column;gap:10px}
  .hr{height:1px;background:var(--h-rule)}
  .kv{display:flex;justify-content:space-between;margin:0;font-size:12px;line-height:normal}
  .kv span{color:var(--h-mute)}.kv b{font-weight:500}
  .steps{position:absolute;left:23px;top:10px;display:flex;flex-direction:column;gap:10px}
  .step{width:290px;box-sizing:border-box;display:flex;align-items:center;gap:12px;padding:11px 12px 11px 14px;background:var(--h-card);border:1px solid var(--h-rule);border-radius:10px}
  .step.dim2{opacity:.5}
  .step.now{border:1.5px solid rgba(10,14,23,.9)}
  :root[data-theme="dark"] .step.now{border-color:rgba(244,246,250,.9)}
  .sn{font:400 11px/normal var(--mono);color:var(--h-mute)}
  .sx{flex:1;display:flex;flex-direction:column;gap:1px;line-height:normal}
  .sx b{font-size:13px;font-weight:500}.sx span{font-size:11px;color:var(--h-mute)}
  .step :global(.ck){color:var(--h-mute)}
  .approve{background:#0A0E17;color:#fff;font-size:12px;font-weight:500;padding:6px 12px;border-radius:6px;line-height:normal}
  :root[data-theme="dark"] .approve{background:#F4F6FA;color:#0A0E17}
  .nda{left:18px;top:4px;width:300px;padding:18px;display:flex;flex-direction:column;gap:12px}
  .sk{height:6px;border-radius:3px;background:var(--h-skel)}.sk.sk2{width:160px}
  .sigs{display:flex;gap:12px}
  .sigs span{flex:1;display:flex;flex-direction:column;gap:4px;padding-top:10px;border-top:1px solid var(--h-rule);line-height:normal}
  .sigs b{font-size:17px;font-weight:500;letter-spacing:-.34px;color:var(--h-accent)}
  .sigs small{font-size:10px;color:var(--h-mute)}
  .foot{margin:0;font-size:11px;color:var(--h-mute);line-height:normal}
  .access{left:78px;top:36px;width:380px;display:flex;flex-direction:column}
  .ah{display:flex;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--h-rule);line-height:normal}
  .ah b{font-size:13px;font-weight:500}.ah span{font-size:12px;color:var(--h-mute)}
  .tool{display:flex;align-items:center;gap:10px;padding:10px 16px;line-height:normal}
  .logo{width:22px;height:22px;border-radius:5.72px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px;font-weight:600;flex:none;box-sizing:border-box}
  :root[data-theme="dark"] .logo{border:1px solid rgba(255,255,255,.14)}
  .tn{flex:1;display:flex;flex-direction:column;gap:1px;font-size:13px}.tn small{font-size:11px;color:var(--h-mute)}
  .rm{background:var(--h-skel);color:var(--h-mute);font-size:11px;font-weight:500;padding:3px 7px;border-radius:5px}
  .handover{position:absolute;left:68px;top:52px;width:400px;display:flex;flex-direction:column;gap:12px;align-items:center}
  .inv{position:relative;width:400px;padding:14px;display:flex;justify-content:space-between;align-items:center}
  .inv b{font-size:13px;font-weight:500;white-space:pre}
  .swap{display:flex;align-items:center;gap:14px}
  .swap :global(.arr){color:var(--h-mute)}
  .file{width:160px;box-sizing:border-box;display:flex;flex-direction:column;gap:8px;padding:12px 14px;background:var(--h-card);border:1px solid var(--h-rule);border-radius:10px;line-height:normal}
  .file i{width:40px;height:6px;border-radius:2px;background:rgba(154,163,178,.5)}
  .file b{font-size:13px;font-weight:500}.file small{font-size:11px;color:var(--h-mute)}
  .file.old{opacity:.55}
  .file.new{border-color:#3B5BFF}.file.new i{background:rgba(59,91,255,.5)}.file.new small{color:#3B5BFF}
  :root[data-theme="dark"] .file.new{border-color:#7C93FF}:root[data-theme="dark"] .file.new i{background:rgba(124,147,255,.5)}:root[data-theme="dark"] .file.new small{color:#7C93FF}
  @media (max-width:1180px){.r1{flex-wrap:wrap}.r1 .cell{flex:1 1 50%}.vig{transform-origin:left top}}
  @media (max-width:1023px){
    .secure{padding:56px 0}
    h2{font-size:34px;line-height:1.06;letter-spacing:-.51px}
    .head{gap:12px}
    .bento{margin-top:20px}
    .r1,.r2{flex-direction:column}
    .cell+.cell{border-left:0;border-top:1px solid var(--h-rule)}
    .r1 .cell,.r2 .cell{padding:24px 16px 0;gap:20px}
    .r2 .cell{flex-direction:column-reverse;justify-content:flex-end;padding-bottom:0}
    .r2 .ct{padding-bottom:0}
    .vig{width:100%;max-width:335px;align-self:center}
    .vig.wide{width:335px;height:200px}.wide .fade{top:152px}
    .access{left:0;width:335px;top:16px}
    .handover{left:-32px;top:30px;transform:scale(.83);transform-origin:center top}
  }
</style>
