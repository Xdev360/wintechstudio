---
// "Meet Wintech". DesignMe team layout: centred head, two slow rows of 142px squares, three stat cards, one button.
// The squares are crops of our own work until team photos exist; the founder photo leads row one once added.
import fs from 'node:fs';
import path from 'node:path';
import { cases } from '../../data/cases';
import services from '../../data/services.json';
const stats: [string, string][] = [['2020', 'The year Wintech started'], [String(cases.length), 'Case studies shipped and on this site'], [String(services.length), 'Services under one project lead']];
const sq = (n: number) => `/images/home/strip/s${n}.webp`;
const founder = fs.existsSync(path.join(process.cwd(), 'public/images/team/oladele.webp')) ? '/images/team/oladele.webp' : null;
const rowA = [...(founder ? [founder] : []), ...[1, 2, 3, 4, 5, 6, 7, 8].map(sq)];
const rowB = [9, 10, 11, 12, 13, 14, 15, 16].map(sq);
---
<section class="team h-sec">
  <div class="h-wrap">
    <div class="h-head">
      <p class="h-eb">One team for design and build</p>
      <h2 class="h-h2">Meet Wintech</h2>
      <p class="h-intro">You don't need to manage five freelancers. You talk to one project lead, and the designers, developers, film crew and AI sit behind them.</p>
    </div>
  </div>
  <div class="rows" aria-hidden="true">
    {[rowA, rowB].map((row, r) => (
      <div class:list={['row', { rev: r === 1 }]}>
        <ul>{[...row, ...row].map((s) => <li><img src={s} alt="" width="142" height="142" loading="lazy" decoding="async" /></li>)}</ul>
      </div>
    ))}
  </div>
  <div class="h-wrap">
    <dl class="stats">{stats.map(([v, l]) => <div><dt>{v}</dt><dd>{l}</dd></div>)}</dl>
    <p class="cta"><a class="h-btn primary" href="/about">Meet the studio</a></p>
  </div>
</section>
<style>
  .team{background:var(--h-bg)}
  .rows{margin:80px auto 0;max-width:1160px;display:flex;flex-direction:column;gap:40px;overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}
  .row ul{list-style:none;margin:0;padding:0;display:flex;gap:6px;width:max-content;animation:roll 60s linear infinite}
  .row.rev ul{animation-direction:reverse;animation-duration:70s}
  .row li{flex:none;width:137px;height:137px;background:var(--h-panel2);overflow:hidden}
  .row img{width:100%;height:100%;object-fit:cover;display:block}
  @keyframes roll{from{transform:translateX(0)}to{transform:translateX(calc(-50% - 3px))}}
  @media (prefers-reduced-motion:reduce){.row ul{animation:none}}
  .stats{margin:80px 0 0;display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  .stats div{border:1px solid var(--h-rule);padding:24px}
  .stats dt{font:600 56px/64.4px var(--font);letter-spacing:-1.12px;color:var(--h-fg)}
  .stats dd{margin:8px 0 0;font:400 14px/21px var(--font);color:var(--h-label)}
  .cta{margin:40px 0 0;text-align:center}
  @media (max-width:767px){
    .rows{margin-top:40px;gap:12px;-webkit-mask-image:none;mask-image:none}
    .row li{width:96px;height:96px}
    .stats{margin-top:40px;grid-template-columns:1fr;gap:16px}
    .stats dt{font-size:44px;line-height:50px;letter-spacing:-.88px}
    .cta .h-btn{width:100%}
  }
</style>
