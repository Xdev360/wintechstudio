---
// Home hero (Figma H1 999:632, H2 801:1527, M 820:3730, M dark 1029:22807)
import Icon from '../Icon.astro';
// "Now playing" reel. Add a video URL to any item (e.g. the Mylo launch film) and it plays in place of the poster.
const reel = [
  { name: 'Mylo', tags: 'Product, brand, app, website', href: '/work/mylo', poster: '/images/cases/film-mylo-800.webp', video: '' },
  { name: 'Virelle Wellness', tags: 'Brand, store, AI assistant', href: '/work/virelle', poster: '/images/cases/film-virelle-800.webp', video: '' },
  { name: "Let's Hang", tags: 'Product, app design', href: '/work/lets-hang', poster: '/images/cases/film-lets-hang-800.webp', video: '' },
];
---
<section class="hero rails">
  <div class="art" aria-hidden="true">
    <img class="l" src="/images/hero/hero-light.svg" alt="" fetchpriority="high" />
    <img class="l soft" src="/images/hero/hero-light.svg" alt="" />
    <img class="d" src="/images/hero/hero-dark.svg" alt="" loading="lazy" />
    <img class="d soft" src="/images/hero/hero-dark.svg" alt="" loading="lazy" />
  </div>
  <div class="fade" aria-hidden="true"></div>
  <div class="h-wrap inner">
    <div class="top">
      <div class="copy">
        <p class="h-mono"><span class="dk">Design and build studio · Lagos, worldwide</span><span class="mb">Design and build studio · Lagos</span></p>
        <h1>Bring the idea.<br />We'll bring <br class="mb" /><span class="gm">the </span><span class="h-grad">team.</span></h1>
        <p class="lede">Brand, websites, stores, AI and automation for businesses <br class="dk" />starting out, adding tech, or refreshing their brand.</p>
        <div class="hctas"><a class="h-btn primary" href="/tools/plan">Plan your project</a><a class="h-btn soft" href="/book">Book a call</a></div>
      </div>
      <aside class="now" id="now-playing" data-reel={JSON.stringify(reel)} aria-label="Now playing" aria-live="polite">
        <a class="media" id="np-media" href={reel[0].href} tabindex="-1">
          <img id="np-poster" src={reel[0].poster} alt="" width="340" height="190" />
          <video id="np-video" muted playsinline loop preload="none" hidden></video>
        </a>
        <p class="np-row"><span class="h-mono">Now playing</span><strong id="np-name">{reel[0].name}</strong></p>
        <p class="np-tags" id="np-tags">{reel[0].tags}</p>
        <div class="np-foot">
          <div class="dashes">{reel.map((r, i) => <button type="button" class={i === 0 ? 'on' : ''} aria-label={`Show ${r.name}`}></button>)}</div>
          <a class="np-link" id="np-link" href={reel[0].href}>View case study <Icon name="arrow-right" size={14} /></a>
        </div>
      </aside>
    </div>
    <ul class="facts">
      <li><strong>1 project lead</strong><span>for every client</span></li>
      <li><strong>Weekly</strong><span>builds you can see</span></li>
      <li><strong>USD or ₦</strong><span>prices on the page</span></li>
    </ul>
  </div>
</section>
<script is:inline>
  (function(){var el=document.getElementById('now-playing');if(!el)return;var reel=JSON.parse(el.dataset.reel),i=0,t,d=el.querySelectorAll('.dashes button');
  function show(n){i=n;var r=reel[n];document.getElementById('np-name').textContent=r.name;document.getElementById('np-tags').textContent=r.tags;document.getElementById('np-link').href=r.href;document.getElementById('np-media').href=r.href;var p=document.getElementById('np-poster'),v=document.getElementById('np-video');p.src=r.poster;if(r.video){v.src=r.video;v.hidden=false;p.hidden=true;v.play().catch(function(){})}else{v.pause();v.hidden=true;p.hidden=false}d.forEach(function(s,k){s.className=k===n?'on':''})}
  var still=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function run(){clearInterval(t);if(!still)t=setInterval(function(){show((i+1)%reel.length)},7000)}
  d.forEach(function(b,k){b.addEventListener('click',function(){show(k);run()})});
  reel.slice(1).forEach(function(r){var im=new Image();im.src=r.poster});run()})();
</script>
<style>
  .hero{position:relative;overflow:hidden;background:var(--h-bg)}
  .art{position:absolute;left:calc(50% - 801px);top:-394px;width:1440px;height:1080px;pointer-events:none}
  .art img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  /* Figma progressive blur: sharp at the top, 8px blur from ~70% to ~82% down the art */
  .art .soft{filter:blur(8px);-webkit-mask-image:linear-gradient(180deg,transparent 70.4%,#000 81.8%);mask-image:linear-gradient(180deg,transparent 70.4%,#000 81.8%)}
  .art .d{display:none}
  :root[data-theme="dark"] .art .d{display:block}:root[data-theme="dark"] .art .l{display:none}
  .fade{position:absolute;inset:0;--c:255,255,255;background:linear-gradient(90deg,rgb(var(--c)) 0,rgb(var(--c)) calc(50% - 720px),rgba(var(--c),.92) calc(50% - 720px + 547px),rgba(var(--c),0) calc(50% - 720px + 893px))}
  :root[data-theme="dark"] .fade{--c:10,14,23}
  .inner{position:relative;z-index:2;padding-top:104px;padding-bottom:72px;display:flex;flex-direction:column;gap:96px}
  .top{display:flex;justify-content:space-between;align-items:flex-start;gap:40px}
  .copy{display:flex;flex-direction:column;gap:28px;align-items:flex-start}
  .mb{display:none}
  h1{font-size:76px;line-height:1;letter-spacing:-1.9px;font-weight:600;color:var(--h-fg);margin:0;white-space:nowrap}
  .lede{font-size:18px;line-height:1.5;color:var(--h-mute);margin:0}
  .hctas{display:flex;gap:10px}
  .now{flex:none;width:374px;display:flex;flex-direction:column;gap:14px;padding:16px;background:#fff;border:1px solid #E3E8ED;
    box-shadow:0 10px 23px rgba(0,0,0,.1),0 41px 41px rgba(0,0,0,.09),0 93px 56px rgba(0,0,0,.05),0 165px 66px rgba(0,0,0,.01)}
  :root[data-theme="dark"] .now{background:#171C2B;border-color:#262E3D}
  .media{display:block;height:190px;overflow:hidden;background:linear-gradient(150.8deg,#E9EDF3 0%,#F7F8FA 71.4%)}
  :root[data-theme="dark"] .media{background:linear-gradient(150.8deg,#1C2432 0%,#0F141E 71.4%)}
  .media img,.media video{width:100%;height:100%;object-fit:cover;display:block}
  .np-row{display:flex;gap:10px;align-items:center;margin:0}
  .np-row strong{font-weight:500;font-size:15px;color:var(--h-fg)}
  .np-tags{font-size:14px;color:var(--h-mute);margin:0;line-height:normal}
  .np-foot{display:flex;justify-content:space-between;align-items:center}
  .dashes{display:flex;gap:6px}
  .dashes button{width:30px;height:2px;padding:0;border:0;background:#E3E7EE;cursor:pointer;position:relative}
  .dashes button::after{content:'';position:absolute;inset:-8px 0}
  .dashes button.on{background:#0A0E17}
  :root[data-theme="dark"] .dashes button{background:rgba(255,255,255,.09)}:root[data-theme="dark"] .dashes button.on{background:#F4F6FA}
  .np-link{display:inline-flex;align-items:center;gap:6px;font:500 14px/normal var(--font);color:var(--h-fg);text-decoration:none}
  .np-link:hover{color:var(--h-accent)}
  .facts{list-style:none;display:flex;gap:24px;padding:0;margin:0;font-size:14px;line-height:normal}
  .facts li{display:flex;gap:6px}.facts strong{font-weight:600;color:var(--h-fg)}.facts span{color:var(--h-mute)}
  @media (max-width:1180px){h1{font-size:52px;letter-spacing:-1.3px}.lede br{display:none}.now{width:320px}.media{height:160px}}
  @media (max-width:1023px){
    .dk{display:none}.mb{display:inline}br.mb{display:block}
    .art{left:-85px;top:391px;width:560px;height:452px}
    .fade{background:linear-gradient(180deg,rgb(var(--c)) 0,rgba(var(--c),.96) 42%,rgba(var(--c),0) 62%)}
    .inner{padding-top:40px;padding-bottom:40px;gap:20px}
    .top{flex-direction:column;align-items:stretch;gap:20px}
    .copy{gap:20px;align-items:stretch}
    h1{font-size:44px;letter-spacing:-.88px}
    .lede{font-size:16px}
    .hctas{flex-direction:column;gap:20px}.hctas .h-btn{padding:14px 20px}
    .now{width:auto}.media{height:184px}
    .facts{display:none}
    .gm{background:linear-gradient(90deg,#254D7F,#3B5BFF);-webkit-background-clip:text;background-clip:text;color:transparent}
    :root[data-theme="dark"] .gm{background-image:linear-gradient(90deg,#8FA3FF,#B9C6FF)}
  }
</style>
