---
// Founder avatar. Drop a square photo at public/images/team/oladele.webp (at least 96x96) and it replaces the initials.
import fs from 'node:fs';
import path from 'node:path';
interface Props { size?: number; class?: string }
const { size = 48, class: cls } = Astro.props;
const has = fs.existsSync(path.join(process.cwd(), 'public/images/team/oladele.webp'));
---
{has
  ? <img class:list={['fav', cls]} src="/images/team/oladele.webp" width={size} height={size} alt="Oladele Ibraheem, founder" loading="lazy" style={`width:${size}px;height:${size}px`} />
  : <span class:list={['fav', 'ini', cls]} aria-hidden="true" style={`width:${size}px;height:${size}px;font-size:${Math.round(size * .3)}px`}>OI</span>}
<style>
  .fav{display:grid;place-items:center;flex:none;object-fit:cover;background:var(--h-panel2,#f3f3f3)}
  .ini{background:#3B5BFF;color:#fff;font-weight:600;letter-spacing:.4px;line-height:1}
</style>
