---
// "Selected work" (Figma 801:1238, dark 801:1799, M 820:3839)
import Icon from '../Icon.astro';
const also = [['Virelle Wellness', '/work/virelle'], ['Manzeelatur Ridho', '/work/manzeelatur-ridho'], ['Tobel Pearls', '/work/tobel-pearls'], ["Let's Hang", '/work/lets-hang'], ['CardioRisk', '/work/cardiorisk']];
---
<section class="work rails">
  <div class="h-wrap">
    <div class="head">
      <p class="h-mono">Selected work</p>
      <h2>Case studies</h2>
    </div>
    <a class="wcard" href="/work/mylo">
      <div class="txt">
        <div class="meta">
          <span class="who"><span class="nm">Mylo</span><span class="chip">Our product</span><span class="chip">Consumer app</span></span>
          <span class="yr">2026</span>
        </div>
        <p class="mmeta">Mylo · Our product</p>
        <h3>The goal app for people who do better together.</h3>
        <p class="desc">Plan the day, tick it off with friends, close it at night and open a chest on Sunday. Designed, branded and built in the studio.</p>
        <span class="read">Read the case study <Icon name="arrow-right" size={14} /></span>
      </div>
      <div class="cover"><img src="/images/home/mylo-cover.webp" alt="Mylo case study cover: the Mylo wordmark above three app screens and the Mylo mascot" width="640" height="440" loading="lazy" /></div>
    </a>
    <p class="also">Also: {also.map((a, i) => <>{i > 0 && ' · '}<a href={a[1]}>{a[0]}</a></>)} <a class="all" href="/work"><Icon name="arrow-right" size={14} /> See all work</a></p>
  </div>
</section>
<style>
  .work{background:var(--h-bg);padding:128px 0}
  .head{display:flex;flex-direction:column;align-items:center;gap:16px;text-align:center}
  h2{font-size:56px;line-height:1.05;letter-spacing:-1.12px;font-weight:600;color:var(--h-fg);margin:0}
  .wcard{display:flex;margin-top:56px;border:1px solid var(--h-rule);text-decoration:none;color:var(--h-fg);background:var(--h-bg)}
  .txt{flex:1;min-width:0;padding:32px;display:flex;flex-direction:column;gap:20px;align-items:flex-start}
  .meta{display:flex;justify-content:space-between;align-items:center;width:100%}
  .who{display:flex;align-items:center;gap:8px}
  .nm{font-size:15px;font-weight:500}
  .chip{background:var(--h-chip);color:var(--h-mute);font-size:12px;padding:3px 7px;line-height:normal}
  :root[data-theme="dark"] .chip{background:#161D2A}
  .yr{font:400 12px/normal var(--mono);color:var(--h-mute)}
  .mmeta{display:none}
  h3{font-size:24px;line-height:1.25;letter-spacing:-.24px;font-weight:600;margin:0;max-width:440px}
  .desc{font-size:16px;line-height:1.5;color:var(--h-mute);margin:0;max-width:440px}
  .read{display:inline-flex;align-items:center;gap:6px;font-size:15px;font-weight:500}
  .wcard:hover .read{color:var(--h-accent)}
  .cover{flex:none;width:640px;height:440px;overflow:hidden;background:linear-gradient(135deg,#1C2432,#0F141E)}
  .cover img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s}
  .wcard:hover .cover img{transform:scale(1.02)}
  .also{text-align:center;margin:56px 0 0;font-size:14px;line-height:normal;color:var(--h-mute)}
  .also a{color:var(--h-mute);text-decoration:none}.also a:hover{color:var(--h-fg)}
  .also .all{display:inline-flex;align-items:center;gap:6px;margin-left:4px}
  @media (max-width:1180px){.cover{width:52%;height:auto;aspect-ratio:640/440}}
  @media (max-width:1023px){
    .work{background:var(--h-alt);padding:56px 0}
    .head{align-items:flex-start;text-align:left;gap:12px}
    h2{font-size:34px;line-height:1.06;letter-spacing:-.51px}
    .wcard{flex-direction:column;margin-top:20px;gap:10px;background:var(--h-card)}
    :root[data-theme="dark"] .wcard{background:#161D2A}
    .cover{order:-1;width:100%;height:220px;aspect-ratio:auto}
    .txt{padding:14px 16px 18px;gap:8px}
    .meta,.desc,.read{display:none}
    .mmeta{display:block;margin:0;font-size:13px;color:var(--h-mute)}
    h3{font-size:19px;letter-spacing:0;max-width:320px}
    .also{display:none}
  }
</style>
