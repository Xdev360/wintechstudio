---
// Home sections below the hero. Desktop order follows Figma H1; mobile order follows the M frame
// (where are you, services, work, templates), with Secure and FAQ kept after them.
import Services from './Services.astro';
import Paths from './Paths.astro';
import Work from './Work.astro';
import Templates from './Templates.astro';
import Secure from './Secure.astro';
import HomeFaq from './HomeFaq.astro';
---
<div class="home-secs">
  <div class="o-svc"><Services /></div>
  <div class="o-paths"><Paths /></div>
  <div class="o-work"><Work /></div>
  <div class="o-tpl"><Templates /></div>
  <div class="o-sec"><Secure /></div>
  <div class="o-faq"><HomeFaq /></div>
</div>
<style>
  .home-secs{display:flex;flex-direction:column}
  @media (max-width:1023px){.o-paths{order:-1}}
</style>
