---
// Two cards under the services accordion. Sizes from docs/DESIGNME-SPEC.md "Cards row under services".
import Ico from './Ico.astro';
const svcIcons = [['palette', 'Brand and packaging'], ['monitor', 'Websites and stores'], ['bot', 'AI assistant'], ['smartphone', 'Apps and MVPs'], ['workflow', 'Automation'], ['clapperboard', 'Motion and film']];
// Simplified single-colour marks for the tools we work in.
const tools: { name: string; svg: string }[] = [
  { name: 'Figma', svg: '<g fill="currentColor"><path d="M8.5 2h3.5v6.6H8.5a3.3 3.3 0 0 1 0-6.6Z"/><path d="M12 2h3.5a3.3 3.3 0 0 1 0 6.6H12Z" opacity=".75"/><path d="M8.5 8.7H12v6.6H8.5a3.3 3.3 0 0 1 0-6.6Z" opacity=".85"/><circle cx="15.5" cy="12" r="3.3" opacity=".6"/><path d="M8.5 15.4H12v3.3a3.3 3.3 0 1 1-3.5-3.3Z" opacity=".7"/></g>' },
  { name: 'Astro', svg: '<g fill="currentColor"><path d="M9.3 3.4c.2-.5.5-.8.9-.8h3.6c.4 0 .7.3.9.8l4.1 12.6c-1.7-.9-3.4-1.4-5.2-1.6L11.8 8.5c0-.2-.3-.2-.4 0l-1.9 5.9c-1.8.2-3.6.7-5.2 1.6Z"/><path d="M8.6 17.3c-.4 1.4.1 3 1.5 3.6.1-.7.6-1.3 1.4-1.3.9 0 1.1.7 1.1 1.5 0 .9.4 1.6 1 2-.1-.7.2-1.3.8-1.7 1.4-1 1.3-2.4 1-3.9-1 .7-2.4 1-3.5 1-1.3 0-2.5-.2-3.3-1.2Z"/></g>' },
  { name: 'Next.js', svg: '<circle cx="12" cy="12" r="9.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M9 16.5v-9l7.4 10.2M15 7.5v5.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>' },
  { name: 'Supabase', svg: '<path fill="currentColor" d="M13.4 21.4c-.5.6-1.5.3-1.5-.5v-6.6H5c-.9 0-1.3-1-.8-1.7l7.3-9.9c.5-.6 1.5-.3 1.5.5v6.6H20c.9 0 1.3 1 .8 1.7Z"/>' },
  { name: 'n8n', svg: '<g fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="4.5" cy="12" r="2.3"/><circle cx="12" cy="12" r="2.3"/><circle cx="19.5" cy="6.5" r="2.3"/><circle cx="19.5" cy="17.5" r="2.3"/><path d="M6.8 12h2.9M14.3 12h1.2c1 0 1.5-.4 1.9-1.2l.4-1.2M15.5 12c1 0 1.5.4 1.9 1.2l.4 1.2"/></g>' },
  { name: 'Claude', svg: '<g stroke="currentColor" stroke-width="2.1" stroke-linecap="round"><path d="M12 3.5v5"/><path d="M12 15.5v5"/><path d="M3.5 12h5"/><path d="M15.5 12h5"/><path d="m6 6 3.5 3.5"/><path d="m14.5 14.5 3.5 3.5"/><path d="m18 6-3.5 3.5"/><path d="M9.5 14.5 6 18"/><path d="m8.2 4.4 1.9 4.4"/><path d="m13.9 15.2 1.9 4.4"/><path d="m19.6 8.2-4.4 1.9"/><path d="m8.8 13.9-4.4 1.9"/></g>' },
];
---
<section class="cards">
  <div class="h-wrap row">
    <article class="card">
      <ul class="icons" aria-label="Our services">{svcIcons.map(([ic, n]) => <li title={n}><Ico name={ic} size={20} /><span class="sr-only">{n}</span></li>)}</ul>
      <h3>Explore every service</h3>
      <p class="tx">Brand, websites, stores, AI, automation, apps and film. Start with one, or have one team run the whole system.</p>
      <a class="h-link" href="/services">See all services <span class="ar">→</span></a>
    </article>
    <article class="card">
      <p class="h-eb">Tools and workflows</p>
      <h3>Built with tools you can keep</h3>
      <p class="tx">Every file and account sits in your name, in the tools the next person can open.</p>
      <div class="mq" aria-label="Tools we use: Figma, Astro, Next.js, Supabase, n8n, Claude">
        <ul class="mt">{[...tools, ...tools, ...tools, ...tools].map((t, i) => <li aria-hidden={i >= tools.length ? 'true' : undefined}><svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" set:html={t.svg} /><span>{t.name}</span></li>)}</ul>
      </div>
    </article>
  </div>
</section>
<style>
  .cards{background:var(--h-bg);padding-bottom:128px}
  .row{display:grid;grid-template-columns:1fr 1fr;gap:20px}
  .card{background:var(--h-panel);padding:80px 20px 40px;display:flex;flex-direction:column;align-items:center;text-align:center;min-width:0;overflow:hidden}
  .icons{list-style:none;margin:0 0 32px;padding:0;display:flex;gap:8px}
  .icons li{width:44px;height:44px;display:grid;place-items:center;border:1px solid var(--h-rule);background:var(--h-bg);color:var(--h-mute)}
  .card .h-eb{margin-bottom:12px}
  h3{font:600 32px/38px var(--font);letter-spacing:-.64px;color:var(--h-fg);margin:0}
  .tx{font:600 18px/27px var(--font);color:var(--h-fg);margin:12px 0 0;max-width:440px}
  .card .h-link{margin-top:24px}
  .mq{margin:32px -20px 0;align-self:stretch;overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)}
  .mt{list-style:none;margin:0;padding:0;display:flex;gap:12px;width:max-content;animation:mq 30s linear infinite}
  .mq:hover .mt{animation-play-state:paused}
  @keyframes mq{to{transform:translateX(calc(-25% - 3px))}}
  .mt li{flex:none;width:86px;height:86px;border-radius:12px;background:var(--h-tint);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:var(--h-fg)}
  .mt span{font:500 11px/1 var(--font);color:var(--h-label)}
  .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  @media (max-width:767px){
    .cards{padding-bottom:64px}
    .row{grid-template-columns:1fr;gap:16px}
    .card{padding:40px 20px}
    .icons{margin-bottom:24px;gap:6px}.icons li{width:40px;height:40px}
    h3{font-size:24px;line-height:30px;letter-spacing:-.48px}
    .tx{font-size:16px;line-height:24px}
    .mq{margin-top:24px}
  }
</style>
