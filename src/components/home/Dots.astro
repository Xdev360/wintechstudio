---
// Decorative dot texture from the "Secure by setup" vignettes: 2px dots on a 10px grid, some missing, varied opacity.
interface Props { w?: number; h?: number; seed?: number; class?: string; style?: string }
const { w = 100, h = 60, seed = 1, class: cls, style } = Astro.props;
let s = seed * 9301 + 49297;
const rnd = () => ((s = (s * 9301 + 49297) % 233280) / 233280);
const dots: [number, number, number][] = [];
for (let x = 1; x < w; x += 10) for (let y = 1; y < h; y += 10) { const r = rnd(); if (r > 0.38) dots.push([x, y, 0.26 + rnd() * 0.48]); }
---
<svg class={cls} style={style} width={w} height={h} viewBox={`0 0 ${w} ${h}`} aria-hidden="true">
  {dots.map(([x, y, o]) => <circle cx={x} cy={y} r="1" fill="var(--h-dot)" fill-opacity={o.toFixed(2)} />)}
</svg>
