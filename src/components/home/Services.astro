---
// "How we help" accordion. Sizes from docs/DESIGNME-SPEC.md "Services accordion".
// Every media slot is its own HTML/CSS animation, scaled from a 584x438 art board.
// Timed steps use data-at (ms from loop start) and optional data-until; the script at the bottom runs them.
import Ico from './Ico.astro';
import services from '../../data/services.json';
import { services as names } from '../../data/site';
const order = ['brand', 'websites', 'ai-assistant', 'apps', 'automation', 'motion'];
const link: Record<string, string> = { 'ai-assistant': 'the AI assistant', websites: 'websites and stores', brand: 'brand and packaging', automation: 'automation', apps: 'apps and MVPs', motion: 'motion and film' };
const items = order.map((slug) => {
  const s = services.find((x) => x.slug === slug)!;
  const name = names.find((n) => n.slug === slug)!.name;
  return { slug, name, link: link[slug], desc: s.intro, bullets: [...s.cells.map((c) => c.title), `Ready in ${s.timeline}`] };
});
const cycle: Record<string, number> = { 'ai-assistant': 9000, websites: 7600, brand: 7600, automation: 7200, apps: 0, motion: 0 };
---
<section class="svc" id="services">
  <div class="h-wrap">
    <div class="h-head">
      <p class="h-eb">How we help</p>
      <h2 class="h-h2">One team for the brand,<br class="dk" /> the build and the AI.</h2>
      <p class="h-intro">Pick one thing or the whole system. Every service is built, handed over, and run if you want us to.</p>
    </div>
    <div class="acc">
      {items.map((s, i) => (
        <details name="home-svc" open={i === 0} data-svc={s.slug}>
          <summary>
            <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="t">{s.name}</span>
            <span class="tg" aria-hidden="true"><i class="h"></i><i class="v"></i></span>
          </summary>
          <div class="body">
            <div class="media" aria-hidden="true">
              <div class={`art a-${s.slug}`} data-cycle={cycle[s.slug]}>
                {s.slug === 'ai-assistant' && (
                  <div class="chat">
                    <div class="ch-head"><span class="av"><Ico name="bot" size={16} /></span><span class="ch-id"><b>Your assistant</b><small><i></i>Online, replies in seconds</small></span></div>
                    <div class="ch-body">
                      <p class="msg me" data-at="300">Hi, do you deliver to Lekki today?</p>
                      <p class="typing" data-at="1000" data-until="2100"><i></i><i></i><i></i></p>
                      <p class="msg bot" data-at="2100">Yes. Orders placed before 3pm arrive today. Shall I place yours?</p>
                      <p class="msg me" data-at="3600">Yes please, same as last time.</p>
                      <p class="typing" data-at="4300" data-until="5400"><i></i><i></i><i></i></p>
                      <p class="msg bot" data-at="5400">Done. Your order is logged and the receipt is on its way.</p>
                      <p class="stamp" data-at="6200"><Ico name="check" size={12} />Replied in 4s · 02:14</p>
                    </div>
                  </div>
                )}
                {s.slug === 'websites' && (
                  <div class="win">
                    <div class="w-bar"><i></i><i></i><i></i><span class="url">yourbrand.com</span></div>
                    <div class="w-page">
                      <div class="w-nav" data-at="200"><b></b><span></span><span></span><span></span><em></em></div>
                      <div class="w-hero">
                        <div class="w-txt">
                          <p class="w-h" data-at="650">Original, sealed and delivered.</p>
                          <i class="w-l" data-at="950"></i><i class="w-l s" data-at="1050"></i>
                          <em class="w-cta" data-at="1350">Shop now</em>
                        </div>
                        <div class="w-pic" data-at="1100"><img src="/images/cases/film-virelle-800.webp" alt="" loading="lazy" width="800" height="550" /></div>
                      </div>
                      <div class="w-cards"><div data-at="1900"><i></i><b></b></div><div data-at="2100"><i></i><b></b></div><div data-at="2300"><i></i><b></b></div></div>
                    </div>
                    <svg class="cursor" data-at="2900" width="18" height="18" viewBox="0 0 24 24"><path d="M4 3l7 18 2.5-7.5L21 11z" fill="#0A0E17" stroke="#fff" stroke-width="1.5" stroke-linejoin="round"/></svg>
                    <span class="tap" data-at="3700"></span>
                    <span class="toast" data-at="4100"><Ico name="check" size={14} />Order received</span>
                  </div>
                )}
                {s.slug === 'brand' && (
                  <div class="kit">
                    <div class="mark">
                      <svg viewBox="0 0 200 200" width="200" height="200">
                        <path class="d1" data-at="200" pathLength="1" d="M100 18c45 0 82 37 82 82s-37 82-82 82-82-37-82-82 37-82 82-82z" />
                        <path class="d2" data-at="700" pathLength="1" d="M58 70l22 64 20-46 20 46 22-64" />
                        <circle class="d3" data-at="1700" cx="100" cy="46" r="7" />
                      </svg>
                      <p class="m-name" data-at="1900">yourbrand</p>
                    </div>
                    <div class="side">
                      <div class="sw">
                        <div data-at="2300" style="--c:#3B5BFF;--t:#fff"><span>#3B5BFF</span></div>
                        <div data-at="2450" style="--c:#0A0E17;--t:#fff"><span>#0A0E17</span></div>
                        <div data-at="2600" style="--c:#F2751F;--t:#fff"><span>#F2751F</span></div>
                        <div data-at="2750" style="--c:#E9EDF3;--t:#0A0E17"><span>#E9EDF3</span></div>
                      </div>
                      <div class="type" data-at="3300"><b>Aa</b><span><strong>Figtree</strong><small>Regular · Medium · Semibold</small></span></div>
                      <div class="label" data-at="3900"><svg viewBox="0 0 200 200" width="22" height="22"><path d="M100 18c45 0 82 37 82 82s-37 82-82 82-82-37-82-82 37-82 82-82z" /><path d="M58 70l22 64 20-46 20 46 22-64" /></svg><span>Label, box and sticker files ready to print</span></div>
                    </div>
                  </div>
                )}
                {s.slug === 'automation' && (
                  <div class="flow">
                    {[
                      ['shopping-bag', 'New order on your store', 'Trigger', 300],
                      ['receipt', 'Receipt sent to the customer', 'WhatsApp and email', 1300],
                      ['package', 'Stock updated', 'Alert when it runs low', 2300],
                      ['bell', 'Follow up booked', 'In 3 days, if no reply', 3300],
                    ].map(([ic, t, d, at], k) => (
                      <>
                        {k > 0 && <span class="wire" data-at={Number(at) - 450}><i></i></span>}
                        <div class="node" data-at={at}><span class="ni"><Ico name={String(ic)} size={16} /></span><span class="nt"><b>{t}</b><small>{d}</small></span><span class="ok"><Ico name="check" size={12} stroke={2} /></span></div>
                      </>
                    ))}
                    <p class="log" data-at="4100">4 steps ran in 2.1s · no one had to touch it</p>
                  </div>
                )}
                {s.slug === 'apps' && (
                  <div class="phones">
                    <div class="ph back l"><img src="/images/cases/tiles/mylo-3-1.webp" alt="" loading="lazy" width="352" height="440" /></div>
                    <div class="ph back r"><img src="/images/cases/tiles/mylo-1-5.webp" alt="" loading="lazy" width="352" height="460" /></div>
                    <div class="ph main">
                      <span class="notch"></span>
                      <div class="screens">
                        <img src="/images/cases/tiles/mylo-1-2.webp" alt="" loading="lazy" width="352" height="560" />
                        <img src="/images/cases/tiles/mylo-3-2.webp" alt="" loading="lazy" width="352" height="470" />
                        <img src="/images/cases/tiles/mylo-1-4.webp" alt="" loading="lazy" width="352" height="400" />
                        <img src="/images/cases/tiles/mylo-1-2.webp" alt="" loading="lazy" width="352" height="560" />
                      </div>
                      <span class="swipe"></span>
                    </div>
                    <div class="dots"><i></i><i></i><i></i></div>
                  </div>
                )}
                {s.slug === 'motion' && (
                  <div class="edit">
                    <div class="view">
                      <img src="/images/cases/film-mylo-800.webp" alt="" loading="lazy" width="800" height="450" />
                      <img src="/images/cases/film-virelle-800.webp" alt="" loading="lazy" width="800" height="550" />
                      <img src="/images/cases/film-lets-hang-800.webp" alt="" loading="lazy" width="800" height="450" />
                      <img src="/images/cases/film-tobel-pearls-800.webp" alt="" loading="lazy" width="800" height="481" />
                      <span class="tc"><Ico name="play" size={9} stroke={0} /><span class="tcw"><span class="tcs">{Array.from({ length: 16 }, (_, k) => <b>0:{String(k).padStart(2, '0')}</b>)}</span></span><em>/ 0:16</em></span>
                    </div>
                    <div class="tl">
                      <div class="ruler">{Array.from({ length: 17 }, (_, k) => <i class={k % 4 === 0 ? 'big' : ''}></i>)}</div>
                      <div class="trk v">
                        <img src="/images/cases/film-mylo-800.webp" alt="" loading="lazy" width="800" height="450" />
                        <img src="/images/cases/film-virelle-800.webp" alt="" loading="lazy" width="800" height="550" />
                        <img src="/images/cases/film-lets-hang-800.webp" alt="" loading="lazy" width="800" height="450" />
                        <img src="/images/cases/film-tobel-pearls-800.webp" alt="" loading="lazy" width="800" height="481" />
                      </div>
                      <div class="trk vo"><span>Voiceover</span></div>
                      <div class="trk au">{Array.from({ length: 56 }, (_, k) => <i style={`--h:${20 + ((k * 37) % 70)}%`}></i>)}</div>
                      <span class="head"></span>
                    </div>
                  </div>
                )}
              </div>
            </div>
            <div class="copy">
              <p class="desc">{s.desc}</p>
              <ul>{s.bullets.map((b) => <li>{b}</li>)}</ul>
              <a class="h-link" href={`/services/${s.slug}`}>Explore {s.link} <span class="ar">→</span></a>
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
<script is:inline>
  (function(){
    var still=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var acc=document.querySelector('.svc .acc');if(!acc)return;
    var arts=acc.querySelectorAll('.art');
    // Fit the 584x438 art board into its media box.
    var ro=new ResizeObserver(function(es){es.forEach(function(e){e.target.style.setProperty('--k',(e.contentRect.width/584).toFixed(4))})});
    acc.querySelectorAll('.media').forEach(function(m){ro.observe(m)});
    var timers=new Map();
    function stop(a){(timers.get(a)||[]).forEach(clearTimeout);timers.set(a,[]);a.classList.remove('run')}
    function play(a){stop(a);a.classList.add('run');var cyc=+a.dataset.cycle;if(!cyc)return;var steps=a.querySelectorAll('[data-at]');a.classList.add('seq');
      if(still){steps.forEach(function(e){if(!e.dataset.until)e.classList.add('in')});return}
      var list=timers.get(a);
      (function tick(){a.classList.remove('out');steps.forEach(function(e){e.classList.remove('in')});
        steps.forEach(function(e){list.push(setTimeout(function(){e.classList.add('in')},+e.dataset.at));if(e.dataset.until)list.push(setTimeout(function(){e.classList.remove('in')},+e.dataset.until))});
        list.push(setTimeout(function(){a.classList.add('out')},cyc-700));list.push(setTimeout(tick,cyc))})()}
    var seen=new WeakMap();
    var io=new IntersectionObserver(function(es){es.forEach(function(e){seen.set(e.target,e.isIntersecting);sync(e.target.closest('details'))})},{threshold:.2});
    function sync(d){var a=d.querySelector('.art');if(d.open&&seen.get(a))play(a);else stop(a)}
    acc.querySelectorAll('details').forEach(function(d){io.observe(d.querySelector('.art'));d.addEventListener('toggle',function(){sync(d)})});
  })();
</script>
<style>
  .svc{padding:108px 0 128px;background:var(--h-bg)}
  .acc{margin-top:80px}
  details{border-top:1px solid var(--h-rule)}
  details:last-child{border-bottom:1px solid var(--h-rule)}
  summary{display:flex;align-items:center;padding:24px 0 0;height:72px;box-sizing:border-box;cursor:pointer;list-style:none;color:var(--h-fg)}
  summary::-webkit-details-marker{display:none}
  details{padding-bottom:24px}
  .n{flex:none;width:112px;font:600 42px/48px var(--font);letter-spacing:-.32px;color:var(--h-label);font-variant-numeric:tabular-nums}
  details[open] .n{color:var(--h-fg)}
  .t{flex:1;min-width:0;font:600 42px/48px var(--font);letter-spacing:-.32px}
  summary:hover .t{color:var(--h-accent-ink)}
  .tg{position:relative;flex:none;width:32px;height:32px;color:var(--h-accent-ink)}
  .tg i{position:absolute;left:50%;top:50%;background:currentColor;border-radius:1px;transition:transform .25s}
  .tg .h{width:22px;height:1.5px;transform:translate(-50%,-50%)}
  .tg .v{width:1.5px;height:22px;transform:translate(-50%,-50%)}
  details[open] .tg .v{transform:translate(-50%,-50%) scaleY(0)}
  .body{display:flex;gap:16px;margin-top:24px;align-items:stretch}
  .media{position:relative;flex:0 1 584px;aspect-ratio:584/438;overflow:hidden;background:var(--h-panel2)}
  .copy{flex:0 1 600px;box-sizing:border-box;padding-right:48px;display:flex;flex-direction:column;gap:24px}
  .desc{font:600 18px/25.2px var(--font);color:var(--h-fg);margin:0}
  .copy ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:4px}
  .copy li{position:relative;padding-left:16px;font:400 16px/24px var(--font);color:var(--h-mute)}
  .copy li::before{content:'';position:absolute;left:2px;top:10px;width:4px;height:4px;border-radius:50%;background:currentColor}
  .copy .h-link{margin-top:auto;align-self:flex-start}

  /* Art board */
  .art{position:absolute;left:50%;top:50%;width:584px;height:438px;transform:translate(-50%,-50%) scale(var(--k,1));transform-origin:center;--card:var(--h-bg);--ln:var(--h-rule);--sk:rgba(var(--h-rgb),.08)}
  .seq [data-at]{opacity:0;transform:translateY(8px);transition:opacity .4s ease,transform .5s cubic-bezier(.2,.7,.2,1)}
  .seq [data-at].in{opacity:1;transform:none}
  .seq.out [data-at]{opacity:0;transition:opacity .5s ease}

  /* AI assistant */
  .chat{position:absolute;left:112px;top:36px;width:360px;height:366px;background:var(--card);border:1px solid var(--ln);display:flex;flex-direction:column;box-shadow:0 12px 32px rgba(0,0,0,.06)}
  .ch-head{display:flex;gap:10px;align-items:center;padding:12px 14px;border-bottom:1px solid var(--ln)}
  .av{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:#3B5BFF;color:#fff}
  .ch-id{display:flex;flex-direction:column}
  .ch-id b{font:600 14px/18px var(--font)}
  .ch-id small{display:flex;align-items:center;gap:6px;font:400 12px/16px var(--font);color:var(--h-label)}
  .ch-id small i{width:6px;height:6px;border-radius:50%;background:#16A34A}
  .ch-body{flex:1;padding:14px;display:flex;flex-direction:column;gap:8px;overflow:hidden}
  .msg{margin:0;max-width:78%;padding:8px 12px;font:400 13px/18px var(--font);border-radius:12px}
  .me{align-self:flex-end;background:rgba(var(--h-rgb),.07);color:var(--h-fg);border-bottom-right-radius:3px}
  .bot{align-self:flex-start;background:#3B5BFF;color:#fff;border-bottom-left-radius:3px}
  .typing{display:none;align-self:flex-start;gap:4px;padding:10px 12px;margin:0;background:rgba(var(--h-rgb),.07);border-radius:12px;border-bottom-left-radius:3px}
  .seq .typing.in{display:flex}
  .typing i{width:5px;height:5px;border-radius:50%;background:var(--h-label);animation:blip 1s infinite}
  .typing i:nth-child(2){animation-delay:.15s}.typing i:nth-child(3){animation-delay:.3s}
  @keyframes blip{0%,60%,100%{opacity:.3;transform:none}30%{opacity:1;transform:translateY(-2px)}}
  .stamp{display:flex;align-items:center;gap:4px;margin:2px 0 0;font:500 11px/14px var(--font);color:var(--h-label)}

  /* Websites */
  .win{position:absolute;left:52px;top:44px;width:480px;height:350px;background:var(--card);border:1px solid var(--ln);box-shadow:0 12px 32px rgba(0,0,0,.06);overflow:hidden}
  .w-bar{height:30px;display:flex;align-items:center;gap:5px;padding:0 10px;border-bottom:1px solid var(--ln);background:rgba(var(--h-rgb),.03)}
  .w-bar i{width:7px;height:7px;border-radius:50%;background:rgba(var(--h-rgb),.18)}
  .url{margin-left:auto;margin-right:auto;transform:translateX(-12px);font:500 10px/16px var(--font);color:var(--h-label);background:var(--card);border:1px solid var(--ln);padding:0 32px;border-radius:2px}
  .w-page{padding:14px 18px;display:flex;flex-direction:column;gap:16px}
  .w-nav{display:flex;align-items:center;gap:12px}
  .w-nav b{width:56px;height:10px;background:var(--h-fg);border-radius:2px;margin-right:auto}
  .w-nav span{width:34px;height:6px;background:var(--sk);border-radius:2px}
  .w-nav em{width:48px;height:18px;background:#3B5BFF;border-radius:2px}
  .w-hero{display:flex;gap:16px;align-items:stretch}
  .w-txt{flex:1;display:flex;flex-direction:column;gap:8px;padding-top:6px}
  .w-h{margin:0 0 4px;font:600 22px/24px var(--font);letter-spacing:-.4px;color:var(--h-fg)}
  .w-l{display:block;height:7px;width:90%;background:var(--sk);border-radius:2px}.w-l.s{width:64%}
  .w-cta{align-self:flex-start;margin-top:8px;font:500 11px/1 var(--font);font-style:normal;color:#fff;background:#0A0E17;padding:8px 12px;border-radius:2px}
  :root[data-theme="dark"] .w-cta{background:#F5F5F5;color:#0A0E17}
  .w-pic{flex:none;width:200px;height:132px;overflow:hidden;background:var(--sk)}
  .w-pic img{width:100%;height:100%;object-fit:cover;transform:scale(2.4);transform-origin:70% 56%}
  .w-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
  .w-cards div{display:flex;flex-direction:column;gap:6px}
  .w-cards i{display:block;height:64px;background:var(--sk)}
  .w-cards b{display:block;height:6px;width:60%;background:var(--sk);border-radius:2px}
  .cursor{position:absolute;left:330px;top:300px}
  .seq .cursor{transition:opacity .3s,transform .9s cubic-bezier(.5,0,.2,1);transform:translate(120px,40px)}
  .seq .cursor.in{transform:translate(-284px,-107px)}
  .tap{position:absolute;left:48px;top:195px;width:28px;height:28px;margin:-14px 0 0 -14px;border-radius:50%;border:2px solid #3B5BFF}
  .tap{opacity:0}.seq .tap.in{animation:tapk .7s ease forwards}
  @keyframes tapk{0%{opacity:1;transform:scale(.3)}100%{opacity:0;transform:scale(1.7)}}
  .toast{position:absolute;right:16px;bottom:16px;display:flex;align-items:center;gap:6px;padding:8px 12px;background:#0A0E17;color:#fff;font:500 12px/16px var(--font);border-radius:2px;box-shadow:0 8px 20px rgba(0,0,0,.18)}
  .toast :global(svg){color:#4ADE80}
  :root[data-theme="dark"] .toast{background:#F5F5F5;color:#0A0E17}:root[data-theme="dark"] .toast :global(svg){color:#16A34A}

  /* Brand */
  .kit{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;gap:40px}
  .mark{display:flex;flex-direction:column;align-items:center;gap:14px;width:220px;height:280px;justify-content:center;background:var(--card);border:1px solid var(--ln)}
  .mark svg{width:140px;height:140px;overflow:visible}
  .mark path{fill:none;stroke:var(--h-fg);stroke-width:9;stroke-linecap:round;stroke-linejoin:round}
  .mark .d1{stroke:#3B5BFF}
  .seq .mark path{transform:none;opacity:1;stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset 1.2s cubic-bezier(.6,0,.3,1)}
  .seq .mark path.in{stroke-dashoffset:0}
  .seq.out .mark path{opacity:0;transition:opacity .5s}
  .d3{fill:#F2751F}
  .seq .d3{transform:scale(0);transform-origin:100px 46px;transform-box:view-box}
  .seq .d3.in{transform:scale(1);transition:transform .45s cubic-bezier(.3,1.6,.5,1),opacity .2s}
  .m-name{margin:0;font:600 20px/24px var(--font);letter-spacing:-.4px;color:var(--h-fg)}
  .side{display:flex;flex-direction:column;gap:12px;width:240px}
  .sw{display:grid;grid-template-columns:repeat(4,1fr);height:118px;border:1px solid var(--ln);overflow:hidden}
  .sw div{background:var(--c);display:flex;align-items:flex-end;padding:6px}
  .sw span{font:500 8.5px/1 var(--font);color:var(--t);writing-mode:vertical-rl;transform:rotate(180deg)}
  .seq .sw div{transform:translateX(30px)}
  .type{display:flex;align-items:center;gap:12px;padding:12px;background:var(--card);border:1px solid var(--ln)}
  .type b{font:600 36px/1 var(--font);letter-spacing:-1px;color:var(--h-fg)}
  .type span{display:flex;flex-direction:column}
  .type strong{font:600 14px/18px var(--font)}.type small{font:400 11px/14px var(--font);color:var(--h-label)}
  .label{display:flex;align-items:center;gap:10px;padding:10px 12px;background:#0A0E17;color:#fff;font:500 11px/14px var(--font)}
  .label path{fill:none;stroke:#fff;stroke-width:14;stroke-linecap:round;stroke-linejoin:round}
  :root[data-theme="dark"] .label{background:#F5F5F5;color:#0A0E17}:root[data-theme="dark"] .label path{stroke:#0A0E17}

  /* Automation */
  .flow{position:absolute;left:142px;top:38px;width:300px;display:flex;flex-direction:column;align-items:center}
  .node{width:100%;display:flex;align-items:center;gap:12px;padding:10px 12px;background:var(--card);border:1px solid var(--ln);box-sizing:border-box;transition:border-color .3s,box-shadow .3s}
