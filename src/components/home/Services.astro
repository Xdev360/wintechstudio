---
// "How we help" accordion (Figma 801:1016, dark 801:1577, M 820:3788)
import Icon from '../Icon.astro';
import services from '../../data/services.json';
import { services as names } from '../../data/site';
const order = ['ai-assistant', 'websites', 'brand', 'automation', 'apps', 'motion'];
const label: Record<string, string> = { 'ai-assistant': 'the AI assistant', websites: 'websites and stores', brand: 'brand and packaging', automation: 'automation', apps: 'apps and MVPs', motion: 'motion and film' };
const items = order.map((slug) => {
  const s = services.find((x) => x.slug === slug)!;
  const name = names.find((n) => n.slug === slug)!.name;
  // The AI assistant copy is taken verbatim from the Figma frame; the rest come from services.json.
  if (slug === 'ai-assistant') return { slug, name, intro: 'An assistant trained on your products, prices and tone. It answers on your website and WhatsApp in seconds, takes orders and bookings, and hands the chat to you when it should.', bullets: ['Trained on your catalogue', 'Website and WhatsApp', 'Orders, bookings, delivery questions', 'Monthly retraining and report'] };
  return { slug, name, intro: s.intro, bullets: s.cells.slice(0, 4).map((c) => c.title) };
});
---
<section class="svc rails" id="services">
  <div class="h-wrap">
    <div class="head">
      <p class="h-mono">How we help</p>
      <h2>One team for the brand,<br />the build and <span class="h-grad">the AI.</span></h2>
      <p class="lede">Pick one thing or the whole system. Every service is built, handed over, and run if you want us to.</p>
    </div>
    <div class="acc">
      {items.map((s, i) => (
        <details name="home-svc" open={i === 0}>
          <summary>
            <span class="t"><span class="n">{String(i + 1).padStart(2, '0')}</span><span>{s.name}</span></span>
            <span class="ic" aria-hidden="true"><Icon name="plus" size={32} stroke={1.5} class="plus" /><i class="bar"></i></span>
          </summary>
          <div class="body">
            <div class={`stage ${s.slug === 'ai-assistant' ? 'chat-stage' : ''}`} aria-hidden="true">
              {s.slug === 'ai-assistant' ? (
                <div class="chat">
                  <p class="me">Hi, is the rosewater mist available?</p>
                  <p class="bot">Yes. ₦25,000, delivery tomorrow in Lagos. Want me to reserve one?</p>
                  <span class="stamp">Replied in 4s · 02:14</span>
                </div>
              ) : (
                <img src={`/images/services/${s.slug}-hero.webp`} alt="" loading="lazy" width="1040" height="760" />
              )}
            </div>
            <div class="txt">
              <p class="intro">{s.intro}</p>
              <ul>{s.bullets.map((b) => <li>{b}</li>)}</ul>
              <a class="h-link" href={`/services/${s.slug}`}>Explore {label[s.slug]} <Icon name="arrow-right" size={14} /></a>
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
<script is:inline>
  // Exclusive accordion fallback for browsers without <details name>
  document.querySelectorAll('.svc details').forEach(function(d,_,all){d.addEventListener('toggle',function(){if(d.open)all.forEach(function(o){if(o!==d)o.open=false})})});
</script>
<style>
  .svc{background:var(--h-bg);padding:128px 0}
  .head{display:flex;flex-direction:column;align-items:center;gap:16px;text-align:center;margin-bottom:72px}
  h2{font-size:56px;line-height:1.05;letter-spacing:-1.12px;font-weight:600;color:var(--h-fg);margin:0;max-width:900px}
  .lede{font-size:18px;line-height:1.5;color:var(--h-mute);margin:0;max-width:620px}
  details{border-bottom:1px solid var(--h-rule);padding:30px 0}
  summary{display:flex;align-items:center;justify-content:space-between;cursor:pointer;list-style:none}
  summary::-webkit-details-marker{display:none}
  .t{display:flex;align-items:center;font-size:44px;font-weight:600;letter-spacing:-.88px;line-height:normal;color:var(--h-fg)}
  .n{width:127px;flex:none}
  summary:hover .t{color:var(--h-accent)}
  .ic{display:flex;align-items:center;justify-content:center;width:32px;height:32px;color:var(--h-accent)}
  .bar{display:none;width:32px;height:2px;background:var(--h-accent)}
  details[open] .bar{display:block}details[open] :global(.plus){display:none}
  .body{display:flex;gap:16px;margin-top:32px}
  .stage{flex:none;width:563px;height:420px;background:var(--h-alt);display:flex;align-items:center;justify-content:center;padding:48px;box-sizing:border-box;overflow:hidden}
  :root[data-theme="dark"] .stage{background:#161D2A}
  .stage img{width:100%;height:100%;object-fit:contain}
  .chat{width:340px;box-sizing:border-box;display:flex;flex-direction:column;gap:10px;align-items:flex-start;padding:16px;background:#fff;border:1px solid #E3E7EE;border-radius:16px;box-shadow:0 20px 40px rgba(0,0,0,.08)}
  .chat p{margin:0;padding:8px 12px;border-radius:12px;font-size:13px;line-height:1.4;width:220px;box-sizing:content-box}
  .me{align-self:flex-end;background:#3B5BFF;color:#fff}
  .bot{background:#F2F4F8;color:#0A0E17}
  .stamp{background:#0A0E17;color:#fff;font:400 11px/normal var(--mono);padding:5px 10px;border-radius:999px}
  :root[data-theme="dark"] .chat{background:#0A0E17;border-color:rgba(255,255,255,.09);box-shadow:0 20px 40px rgba(0,0,0,.35)}
  :root[data-theme="dark"] .bot{background:#1C2432;color:#F4F6FA}
  :root[data-theme="dark"] .stamp{background:#1C2432}
  .txt{flex:1;min-width:0;padding-left:16px;display:flex;flex-direction:column;gap:24px;align-items:flex-start}
  .intro{font-size:19px;font-weight:500;line-height:1.45;color:var(--h-fg);margin:0;max-width:540px}
  ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px}
  li{display:flex;align-items:center;gap:10px;font-size:16px;line-height:normal;color:var(--h-mute)}
  li::before{content:'';width:4px;height:4px;border-radius:50%;background:var(--h-mute);flex:none}
  @media (max-width:1180px){.stage{width:46%}}
  @media (max-width:1023px){
    .svc{padding:56px 0}
    .head{align-items:flex-start;text-align:left;gap:12px;margin-bottom:20px}
    h2{font-size:34px;line-height:1.06;letter-spacing:-.51px}
    .lede{display:none}
    details{padding:18px 0}
    .t{font-size:22px;letter-spacing:0;gap:16px}.n{width:auto}
    .ic{width:20px;height:20px}.ic :global(.plus){width:20px;height:20px}.bar{width:14px;height:1.5px}
    .body{flex-direction:column;margin-top:16px}
    .stage{display:none}
    .txt{padding-left:0;gap:16px}
    .intro{font-size:16px}
    li{font-size:15px}
  }
</style>
