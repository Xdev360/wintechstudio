---
// Work card, DesignMe /projects pattern: hairline card, padding 8, media panel on top (motion loop or
// cover image, see CardMedia), meta row (client 16/600 + tag chip + year 13px muted) with a hairline
// under it, then title 20/600 + 32x32 hairline arrow button. Hover: media zooms, arrow nudges.
import type { Case } from '../../data/cases';
import Icon from '../Icon.astro';
import CardMedia from './CardMedia.astro';
interface Props { c: Case; eager?: boolean; ratio?: string; filters?: boolean }
const { c, eager = false, ratio = '4 / 3', filters = false } = Astro.props;
const tagCls = c.tag === 'Our product' ? 'own' : c.tag === 'Concept' ? 'concept' : 'client';
---
<a class="wk" href={`/work/${c.slug}`} data-cats={filters ? c.filters.join(',') : undefined} aria-label={`${c.name} case study: ${c.cardLine}`}>
  <span class="cv" style={`aspect-ratio:${ratio}`}><CardMedia c={c} eager={eager} class="fillm" /></span>
  <span class="mt">
    <span class="cl">{c.name}</span>
    <span class:list={['tg', tagCls]}>{c.tag}</span>
    <span class="yr">{c.year}</span>
  </span>
  <span class="ft">
    <span class="tt">{c.cardLine}</span>
    <span class="ar" aria-hidden="true"><Icon name="arrow-right" size={14} /></span>
  </span>
</a>
<style>
  .wk{display:flex;flex-direction:column;padding:8px;border:1px solid var(--wk-line,rgba(10,14,23,.10));background:var(--wk-bg,#fff);color:inherit;text-decoration:none;transition:border-color .25s}
  .wk[hidden]{display:none}
  .wk:hover,.wk:focus-visible{border-color:var(--wk-line2,rgba(10,14,23,.2))}
  .cv{position:relative;display:block}
  .cv > :global(.fillm){position:absolute;inset:0}
  .mt{display:flex;align-items:center;gap:8px;padding:20px 12px 16px;border-bottom:1px solid var(--wk-line,rgba(10,14,23,.10))}
  .cl{font-size:16px;line-height:24px;font-weight:600}
  .tg{font-size:13px;line-height:19.5px;font-weight:400;padding:2px 8px;border-radius:2px;background:var(--wk-tint,rgba(10,14,23,.06))}
  .tg.own{background:rgba(59,91,255,.10);color:#2F4BE6}
  .tg.concept{background:rgba(242,117,31,.16);color:#A14A12}
  .yr{margin-left:auto;font-size:13px;line-height:19.5px;font-weight:400;opacity:.62;font-variant-numeric:tabular-nums}
  .ft{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;padding:16px 12px 12px;flex:1}
  .tt{font-size:20px;line-height:26px;font-weight:600;letter-spacing:-.2px;max-width:420px}
  .ar{flex:none;width:32px;height:32px;display:grid;place-items:center;border:1px solid var(--wk-line,rgba(10,14,23,.10));background:var(--wk-bg,#fff);transition:background .25s,color .25s,border-color .25s}
  .ar :global(svg){transition:transform .35s cubic-bezier(.2,.7,.2,1)}
  .wk:hover .ar,.wk:focus-visible .ar{background:var(--wk-fg,#0A0E17);border-color:var(--wk-fg,#0A0E17);color:var(--wk-bg,#fff)}
  .wk:hover .ar :global(svg),.wk:focus-visible .ar :global(svg){transform:translateX(3px)}
  :global(:root[data-theme="dark"]) .tg.own,:global(.is-dark) .tg.own{background:rgba(59,91,255,.22);color:#9DB0FF}
  :global(:root[data-theme="dark"]) .tg.concept,:global(.is-dark) .tg.concept{background:rgba(242,117,31,.2);color:#F6A46B}
  @media (prefers-reduced-motion:reduce){.ar :global(svg){transition:none}.wk:hover .ar :global(svg){transform:none}}
  @media (max-width:1023px){
    .cl{font-size:15px;line-height:22.5px}
    .tt{font-size:18px;line-height:23.4px;letter-spacing:-.18px}
  }
</style>
