---
// One chapter visual. 'todo' = raster panel exported from Figma to public/images/cases/ch/<figma id, : as ->.webp.
// It renders only when the file exists, at its real pixel size or smaller (width/height from the file, max-width capped).
// 'swatches' = colour row rebuilt in HTML.
import fs from 'node:fs';
import sharp from 'sharp';
import type { Visual } from '../../data/cases';
interface Props { v: Visual }
const { v } = Astro.props;
const file = v.kind === 'todo' ? `/images/cases/ch/${v.id.replace(':', '-')}.webp` : '';
const has = !!file && fs.existsSync(`public${file}`);
let w = v.kind === 'todo' ? v.w : 0, h = v.kind === 'todo' ? v.h : 0;
if (has) { try { const m = await sharp(`public${file}`).metadata(); w = m.width ?? w; h = m.height ?? h; } catch {} }
---
{v.kind === 'todo' ? (has ? (
  <figure class="img" data-figma={v.id}><span class="fr" data-inframe style={`max-width:min(100%,${w}px)`}><img src={file} alt={v.label} width={w} height={h} loading="lazy" decoding="async" /></span></figure>
) : null) : (
  <figure class="sw" data-figma={v.id} style={v.bg ? `--sw-bg:${v.bg}` : ''} aria-label="Colour palette">
    {v.items.map(i => <div class="chip" style={`background:${i.hex};color:${i.ink}`}><strong>{i.name}</strong><span>{i.hex}</span></div>)}
  </figure>
)}
<style>
  figure{margin:0}
  .img{display:flex;justify-content:center}
  .fr{display:block;width:100%;overflow:hidden}
  .img img{display:block;width:100%;height:auto}
  .fr:global(.fx) img{transform:scale(1.06);will-change:transform;backface-visibility:hidden}
  .sw{background:var(--sw-bg,var(--c-panel));padding:64px 56px;display:grid;grid-template-columns:repeat(5,1fr);gap:16px}
  :root[data-theme="dark"] .sw{background:var(--c-panel)}
  .chip{aspect-ratio:208/129;border-radius:12px;padding:0 14px 14px;display:flex;flex-direction:column;justify-content:flex-end;gap:2px}
  .chip strong{font-size:14px;line-height:21px;font-weight:500}.chip span{font-size:11px;line-height:14.3px;font-family:var(--mono)}
  @media (max-width:1023px){
    .sw{padding:16px;display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:8px;scrollbar-width:none}
    .chip{flex:0 0 160px;scroll-snap-align:start}
  }
</style>
