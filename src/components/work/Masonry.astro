---
// PXDX gallery (pxdx.pl/works/*): three columns of separate images, side columns 352 and middle 544
// (ratio kept, fluid up to 1360 wide with a 20px gap), nearly full bleed.
// Scroll motion as on PXDX: the side columns travel with the page while the middle column moves on its
// own track, so the middle wall slides past the sides as you scroll and every column ends on the same
// bottom line when the section leaves. Done in a clipped window: each column sits T px above the window
// and shifts by s*T (s in -1..1), so no column ever shows a gap. Middle runs s: +1 -> -1, sides -0.25 -> +0.25.
// Reduced motion: static. Mobile (<1024): one swipe track with a progress line.
import type { Tile } from '../../data/cases';
interface Props { slug: string; name: string; cols: Tile[][] }
const { slug, name, cols } = Astro.props;
const src = (f: string) => `/images/cases/tiles/${f}`;
const GAP = 20;
const widths = [352, 544, 352];
// Column heights at the design width (1248 + 2 gaps). The window is the shortest column minus 2*T.
const heights = cols.map((c, i) => c.reduce((s, t) => s + t[2] * (widths[i] / t[1]), 0) + GAP * Math.max(0, c.length - 1));
const designW = widths.reduce((a, b) => a + b, 0) + GAP * 2;
const T = 240; // travel at the design width, scaled with the gallery width in CSS
const minH = Math.min(...heights);
const winH = Math.round(minH - 2 * T);
const flat: Tile[] = [];
const max = Math.max(...cols.map(c => c.length));
for (let i = 0; i < max; i++) for (const c of [cols[1], cols[0], cols[2]]) if (c && c[i]) flat.push(c[i]);
const fit = ([, w, h]: Tile) => { const s = Math.min(330 / w, 440 / h); return [Math.round(w * s), Math.round(h * s)]; };
---
<section class="pxdx" aria-label={`${name}: selected screens and brand work`} data-slug={slug}
  style={`--win:${winH / designW};--t:${T / designW}`}>
  <div class="win" data-gal>
    <div class="cols">
      {cols.map((col, ci) => (
        <div class="col" data-mid={ci === 1 ? '' : undefined}>
          {col.map(([f, w, h]) => (
            <figure class="tl" style={`aspect-ratio:${w} / ${h}`}>
              <img src={src(f)} width={w} height={h} alt="" loading="eager" decoding="async" />
            </figure>
          ))}
        </div>
      ))}
    </div>
  </div>
  <div class="mslider" data-slider>
    <div class="track" data-track>
      {flat.map(t => { const [w, h] = fit(t); return <img src={src(t[0])} width={w} height={h} style={`width:${w}px;height:${h}px`} alt="" loading="lazy" decoding="async" />; })}
    </div>
    <div class="prog" aria-hidden="true"><i data-bar></i></div>
  </div>
</section>
<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-gal]').forEach(win => {
    const cols = [...win.querySelectorAll<HTMLElement>('.col')];
    let on = false, raf = 0, cur = -2, target = 0;
    const desk = () => innerWidth >= 1024;
    function measure() {
      const r = win.getBoundingClientRect(), vh = innerHeight;
      // 0 when the window's top meets the viewport bottom, 1 when its bottom meets the viewport top
      target = Math.min(1, Math.max(0, (vh - r.top) / (vh + r.height)));
    }
    function paint() {
      raf = 0;
      if (!desk() || still) { cols.forEach(c => (c.style.transform = '')); return; }
      cur = cur < -1 ? target : cur + (target - cur) * 0.14; // light easing, like PXDX's smooth scroll
      const T = win.clientWidth * (parseFloat(getComputedStyle(win).getPropertyValue('--t')) || 0);
      cols.forEach(c => {
        const s = c.hasAttribute('data-mid') ? 1 - 2 * cur : -0.25 + 0.5 * cur;
        c.style.transform = `translate3d(0,${(-T + s * T).toFixed(1)}px,0)`;
      });
      if (on && Math.abs(target - cur) > 0.0005) raf = requestAnimationFrame(paint);
    }
    const kick = () => { measure(); if (!raf) raf = requestAnimationFrame(paint); };
    new IntersectionObserver(([e]) => { on = e.isIntersecting; if (on) kick(); }, { rootMargin: '200px 0px' }).observe(win);
    addEventListener('scroll', () => { if (on) kick(); }, { passive: true });
    addEventListener('resize', kick);
    kick();
  });
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach(s => {
    const t = s.querySelector<HTMLElement>('[data-track]'); const b = s.querySelector<HTMLElement>('[data-bar]');
    if (!t || !b) return;
    const upd = () => { const max = t.scrollWidth - t.clientWidth; const vis = t.clientWidth / t.scrollWidth; b.style.width = `${Math.max(8, vis * 100)}%`; b.style.left = `${max > 0 ? (t.scrollLeft / max) * (100 - vis * 100) : 0}%`; };
    t.addEventListener('scroll', upd, { passive: true }); addEventListener('resize', upd); upd();
  });
</script>
<style>
  .pxdx{width:100%;max-width:1360px;margin:0 auto}
  /* window height and travel scale with the gallery width */
  .win{--w:min(1360px,calc(100vw - 80px));--tpx:calc(var(--w) * var(--t));position:relative;height:calc(var(--w) * var(--win));overflow:hidden}
  .cols{display:grid;grid-template-columns:352fr 544fr 352fr;gap:20px;align-items:start}
  .col{display:flex;flex-direction:column;gap:20px;will-change:transform;transform:translate3d(0,calc(var(--tpx) * -1),0)}
  .tl{margin:0;overflow:hidden;background:var(--c-panel,#f2f2f2)}
  .tl img{display:block;width:100%;height:100%;object-fit:cover}
  @media (prefers-reduced-motion:reduce){.win{height:auto}.col{transform:none!important}}
  .mslider{display:none}
  @media (max-width:1023px){
    .pxdx{padding:0;box-sizing:border-box}
    .win{display:none}
    .mslider{display:block}
    .track{display:flex;align-items:center;gap:8px;overflow-x:auto;scroll-snap-type:x mandatory;padding:0 16px;height:440px;scrollbar-width:none;overscroll-behavior-x:contain}
    .track::-webkit-scrollbar{display:none}
    .track img{flex:none;scroll-snap-align:center;object-fit:cover;background:var(--c-panel,#f2f2f2)}
    .prog{margin:14px 16px 0;height:2px;background:var(--c-line,rgba(0,0,0,.1));position:relative}
    .prog i{position:absolute;left:0;top:0;height:2px;width:12%;background:var(--c-fg,#111)}
  }
</style>
