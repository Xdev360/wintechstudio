---
// Black Friday process illustrations: one detailed looping motion per step, drawn in CSS so it
// follows the light and dark tokens. Scenes are 388 x 460 (the desktop frame) and scale down on phones.
// A scene only animates while its root has .play, so the page restarts it when the step becomes active.
import Lc from '../ui/Lc.astro';
interface Props { k: number; play?: boolean }
const { k, play = false } = Astro.props;
const burst = Array.from({ length: 28 }, (_, i) => {
  const a = (i / 28) * Math.PI * 2 + (i % 2) * 0.11;
  const d = 110 + ((i * 37) % 70);
  return { x: Math.round(Math.cos(a) * d), y: Math.round(Math.sin(a) * d * 0.85), r: (i * 67) % 360, c: ['#3B5BFF', '#8B9CFF', 'var(--fg)', '#3B5BFF'][i % 4], s: i % 3 };
});
---
<div class={`sv s${k}${play ? ' play' : ''}`} aria-hidden="true">
  {k === 0 && (
    <>
      <div class="ph">
        <div class="pr"><i class="av"></i><span class="nums"><span><b>142</b>posts</span><span><b>3.2k</b>followers</span><span><b>210</b>following</span></span></div>
        <p class="hn">yourbrand</p>
        <i class="ln w1"></i><i class="ln w2"></i>
        <div class="acts"><span>Follow</span><span>Message</span></div>
        <div class="hl">{['New', 'Shop', 'Info', 'Faq'].map(l => <span><i></i>{l}</span>)}</div>
        <div class="gd">{Array.from({ length: 9 }, (_, i) => <i class={`t t${i}`}></i>)}</div>
      </div>
      <div class="lens"><i></i></div>
      <div class="rep">
        <p class="cap">Audit report</p>
        {['No prices on the page', 'Link in bio goes nowhere', 'Site is slow on a phone'].map((t, i) => (
          <div class="fd" style={`--d:${1 + i * 0.5}s`}><span class="n">{i + 1}</span><span>{t}</span></div>
        ))}
      </div>
      <div class="fn">
        <p class="cap">Where customers drop off</p>
        {[['Found you', 100], ['Messaged', 42], ['Paid', 9]].map(([l, v], i) => (
          <div class="fr"><span>{l}<em>{v}%</em></span><i style={`--w:${v}%;--d:${0.4 + i * 0.35}s`}></i></div>
        ))}
      </div>
      <p class="chip c0"><Lc name="search" size={13} stroke={2.4} />Weak point: no prices on the page</p>
    </>
  )}
  {k === 1 && (
    <>
      <div class="sheet back"></div>
      <div class="sheet">
        <div class="shd"><p class="cap">Brand guideline</p><span class="pg">01</span></div>
        <div class="lgx">
          <i class="gl gv1"></i><i class="gl gv2"></i><i class="gl gh1"></i><i class="gl gh2"></i>
          <svg class="mk" viewBox="0 0 64 44" width="96" height="66"><path d="M4 6 L18 38 L32 14 L46 38 L60 6" /></svg>
        </div>
        <div class="ty">
          <p class="aa">Aa</p>
          <div class="tsx"><b>Heading</b><span>Body text</span><em>Figtree</em></div>
        </div>
        <i class="ln w1"></i><i class="ln w3"></i>
      </div>
      <div class="sw">
        {[['#3B5BFF', 'Signal', '#3B5BFF'], ['#0A0E17', 'Ink', '#0A0E17'], ['#8B9CFF', 'Sky', '#8B9CFF'], ['var(--tint)', 'Mist', '#E9EDF5']].map(([c, n, h], i) => (
          <div class="s" style={`--c:${c};--d:${0.7 + i * 0.25}s`}><i></i><span><b>{n}</b>{h}</span></div>
        ))}
      </div>
      <div class="dk"><svg viewBox="0 0 64 44" width="40" height="28"><path d="M4 6 L18 38 L32 14 L46 38 L60 6" /></svg><span>On dark</span></div>
      <p class="stamp"><Lc name="check" size={14} stroke={2.8} />Approved by you</p>
    </>
  )}
  {k === 2 && (
    <>
      <div class="ph">
        <div class="pr"><i class="av b"><svg viewBox="0 0 64 44" width="22" height="16"><path d="M4 6 L18 38 L32 14 L46 38 L60 6" /></svg></i><span class="nums"><span><b>142</b>posts</span><span><b>3.4k</b>followers</span><span><b>210</b>following</span></span></div>
        <p class="hn">yourbrand</p>
        <i class="ln w1"></i>
        <div class="acts"><span class="pri">Book now</span><span>Message</span></div>
        <div class="hl lab">{['Prices', 'Book', 'Reviews', 'Shop'].map((l, i) => <span style={`--d:${0.3 + i * 0.3}s`}><i></i>{l}</span>)}</div>
        <div class="gd">{Array.from({ length: 9 }, (_, i) => <i class={`f f${[0, 1, 2, 1, 0, 1, 2, 1, 0][i]}`} style={`--d:${1.6 + i * 0.1}s`}>{i % 4 === 0 && <span>Aa</span>}</i>)}</div>
      </div>
      <div class="story"><div class="sbar"><i></i><i></i><i></i></div><p class="sh">This week only</p><i class="sl a"></i><i class="sl b"></i><span>Book now</span></div>
      <div class="vis"><Lc name="trend" size={14} stroke={2.4} /><span><b>+128</b>profile visits</span></div>
      <p class="chip c2"><Lc name="flag" size={13} stroke={2.4} />Highlights point to prices</p>
    </>
  )}
  {k === 3 && (
    <>
      <div class="bw">
        <div class="bb"><i></i><i></i><i></i><span><Lc name="lock" size={9} stroke={2.4} />yourbrand.com</span></div>
        <div class="bc">
          <div class="nv"><i class="lg"></i><span>Shop</span><span>Prices</span><span>About</span><em>Book</em></div>
          <div class="hro"><p>Look good.<br />Book in a minute.</p><span class="btn">Book a call</span></div>
          <div class="prc">{[['Basic', '₦25k'], ['Full', '₦60k'], ['Premium', '₦95k']].map(([n, v], i) => <div style={`--d:${0.9 + i * 0.15}s`}><span>{n}</span><b>{v}</b></div>)}</div>
        </div>
        <svg class="cur" viewBox="0 0 24 24" width="22" height="22"><path d="M4 2 L4 19 L9 14 L12.5 21 L15.5 19.5 L12 13 L19 13 Z" /></svg>
      </div>
      <div class="sp">
        <svg viewBox="0 0 64 64" width="58" height="58"><circle cx="32" cy="32" r="26" class="trk" /><circle cx="32" cy="32" r="26" class="arc" /></svg>
        <span><b>98</b>Speed on a phone</span>
      </div>
      <div class="gs">
        <p class="gu">yourbrand.com</p>
        <p class="gt">Your Brand · Prices and booking</p>
        <i class="g2"></i><i class="g3"></i>
      </div>
      <p class="chip c3"><Lc name="tag" size={13} stroke={2.4} />Prices now on the home page</p>
    </>
  )}
  {k === 4 && (
    <>
      <div class="bst">{burst.map(p => <i class={`p p${p.s}`} style={`--x:${p.x}px;--y:${p.y}px;--r:${p.r}deg;--c:${p.c}`}></i>)}</div>
      <div class="lc">
        <span class="lic"><Lc name="rocket" size={22} stroke={2} /></span>
        <p class="lu">yourbrand.com</p>
        <p class="lt">You're live.</p>
        <span class="live">Live</span>
      </div>
      <div class="ho">
        {[['file', 'Guideline'], ['layers', 'Logo files'], ['lock', 'Logins']].map(([ic, t], i) => (
          <span style={`--d:${0.5 + i * 0.15}s`}><Lc name={ic} size={13} stroke={2.2} />{t}</span>
        ))}
      </div>
    </>
  )}
</div>
<style>
  .sv{position:relative;width:388px;height:460px;--ink:var(--fg);--card:var(--bg);--soft2:var(--tint);font-family:inherit;color:var(--fg)}
  .sv *{box-sizing:border-box}
  .sv p{margin:0}
  .cap{font:500 10px/1 var(--font-mono,monospace);letter-spacing:1px;text-transform:uppercase;color:var(--lab)}
  .ln{display:block;height:6px;background:var(--soft2);margin-top:6px}
  .w1{width:78%}.w2{width:52%}.w3{width:64%}
  .chip{position:absolute;display:inline-flex;align-items:center;gap:8px;background:var(--ink);color:var(--card);font-size:12px;font-weight:500;line-height:16px;padding:9px 12px;white-space:nowrap;opacity:0;transform:translateY(8px) scale(.96);z-index:5}
  .chip :global(svg){color:#8B9CFF}

  /* phone (audit + social) */
  .ph{position:absolute;left:22px;top:22px;width:196px;height:416px;background:var(--card);padding:16px 14px;box-shadow:0 18px 40px rgba(10,14,23,.10)}
  .pr{display:flex;align-items:center;gap:10px}
  .av{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:var(--soft2);flex:none}
  .av.b{background:#3B5BFF}.av svg path{fill:none;stroke:#fff;stroke-width:7;stroke-linecap:square}
  .nums{display:flex;gap:8px;flex:1;justify-content:space-between}
  .nums span{display:flex;flex-direction:column;align-items:center;font-size:7.5px;color:var(--mute)}
  .nums b{font-size:11px;font-weight:600;color:var(--fg)}
  .hn{margin-top:10px!important;font-size:11px;font-weight:600}
  .acts{display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-top:10px}
  .acts span{font-size:9px;font-weight:600;text-align:center;padding:6px 0;background:var(--soft2)}
  .acts .pri{background:#3B5BFF;color:#fff}
  .hl{display:flex;justify-content:space-between;margin-top:12px}
  .hl span{display:flex;flex-direction:column;align-items:center;gap:4px;font-size:8px;font-weight:500;color:var(--mute)}
  .hl i{display:block;width:32px;height:32px;border-radius:50%;background:var(--soft2)}
  .gd{display:grid;grid-template-columns:repeat(3,1fr);gap:3px;margin-top:12px}
  .gd i{display:grid;place-items:center;aspect-ratio:1;background:var(--soft2);font-style:normal}

  /* 0 · audit */
  .s0 .t1,.s0 .t5,.s0 .t6{opacity:.6}
  .s0 .lens{position:absolute;left:40px;top:250px;width:78px;height:78px;z-index:4}
  .s0 .lens::before{content:"";position:absolute;inset:0 16px 16px 0;border-radius:50%;border:5px solid #3B5BFF;background:color-mix(in srgb,var(--card) 30%,transparent)}
  .s0 .lens i{position:absolute;right:4px;bottom:0;width:9px;height:28px;background:#3B5BFF;transform:rotate(-45deg)}
  .rep{position:absolute;right:20px;top:26px;width:156px;background:var(--card);padding:14px;box-shadow:0 18px 40px rgba(10,14,23,.10)}
  .fd{display:flex;gap:8px;align-items:flex-start;margin-top:10px;font-size:10.5px;line-height:14px;font-weight:500;opacity:0;transform:translateX(8px)}
  .fd .n{display:grid;place-items:center;width:16px;height:16px;flex:none;background:#3B5BFF;color:#fff;font-size:9px;font-weight:600}
  .fn{position:absolute;right:20px;top:198px;width:156px;background:var(--card);padding:14px;box-shadow:0 18px 40px rgba(10,14,23,.10)}
  .fr{margin-top:10px}
  .fr span{display:flex;justify-content:space-between;font-size:10.5px;font-weight:500;margin-bottom:5px}
  .fr em{font-style:normal;color:var(--mute)}
  .fr i{display:block;height:7px;width:0;background:#3B5BFF}
  .fr:nth-child(3) i{opacity:.65}.fr:nth-child(4) i{opacity:.35}
  .c0{right:20px;bottom:22px;width:156px;white-space:normal;align-items:flex-start}
  .s0.play .lens{animation:scan 7s cubic-bezier(.45,0,.2,1) infinite}
  .s0.play .t7{animation:hot 7s ease infinite}
  .s0.play .fr i{animation:grow 7s cubic-bezier(.2,.8,.2,1) infinite;animation-delay:var(--d)}
  .s0.play .fd{animation:slin 7s cubic-bezier(.2,.8,.2,1) infinite;animation-delay:var(--d)}
  .s0.play .c0{animation:pop 7s cubic-bezier(.2,.8,.2,1) infinite}
  @keyframes scan{0%,6%{transform:translate(0,0)}20%,26%{transform:translate(70px,-150px)}40%,46%{transform:translate(10px,-40px)}60%,92%{transform:translate(64px,8px)}100%{transform:translate(0,0)}}
  @keyframes hot{0%,58%{background:var(--soft2)}64%,92%{background:#3B5BFF;opacity:.55}100%{background:var(--soft2)}}
  @keyframes grow{0%{width:0}14%,88%{width:var(--w)}100%{width:0}}
  @keyframes slin{0%{opacity:0;transform:translateX(8px)}8%,88%{opacity:1;transform:none}98%,100%{opacity:0}}
  @keyframes pop{0%,58%{opacity:0;transform:translateY(8px) scale(.96)}64%,92%{opacity:1;transform:none}100%{opacity:0;transform:translateY(8px) scale(.96)}}

  /* 1 · brand */
  .sheet{position:absolute;left:22px;top:26px;width:196px;height:330px;background:var(--card);padding:16px;box-shadow:0 18px 40px rgba(10,14,23,.10)}
  .sheet.back{left:36px;top:40px;background:var(--soft2);box-shadow:none}
  .shd{display:flex;justify-content:space-between;align-items:center}
  .shd .pg{font-size:10px;color:var(--mute)}
  .lgx{position:relative;height:118px;margin-top:12px;background:color-mix(in srgb,#3B5BFF 7%,var(--card));display:grid;place-items:center}
  .gl{position:absolute;background:#3B5BFF;opacity:.18}
  .gv1,.gv2{top:0;bottom:0;width:1px}.gv1{left:30%}.gv2{left:70%}
  .gh1,.gh2{left:0;right:0;height:1px}.gh1{top:28%}.gh2{top:72%}
  .mk path,.dk path{fill:none;stroke-linecap:square;stroke-linejoin:miter}
  .mk path{stroke:#3B5BFF;stroke-width:6;stroke-dasharray:150;stroke-dashoffset:150}
  .ty{display:flex;align-items:flex-end;gap:12px;margin-top:14px;opacity:0}
  .aa{font-size:46px;line-height:48px;font-weight:600;letter-spacing:-1.4px}
  .tsx{display:flex;flex-direction:column;gap:2px;padding-bottom:4px}
  .tsx b{font-size:13px;font-weight:600}.tsx span{font-size:10px;color:var(--mute)}.tsx em{font-style:normal;font-size:9px;color:var(--lab);font-family:var(--font-mono,monospace)}
  .sw{position:absolute;right:20px;top:26px;display:grid;grid-template-columns:repeat(2,68px);gap:10px 8px}
  .s{display:flex;flex-direction:column;gap:6px;opacity:0;transform:scale(.6);background:var(--card);padding:6px;box-shadow:0 10px 24px rgba(10,14,23,.08)}
  .s i{display:block;width:56px;height:48px;background:var(--c)}
  .s span{display:flex;flex-direction:column;font-size:8.5px;color:var(--mute);font-family:var(--font-mono,monospace)}
  .s b{font-family:var(--font,inherit);font-size:10px;font-weight:600;color:var(--fg)}
  .dk{position:absolute;right:20px;top:258px;width:144px;height:72px;background:#0A0E17;display:flex;align-items:center;justify-content:center;gap:10px;opacity:0}
  .dk path{stroke:#fff;stroke-width:7}.dk span{font-size:10px;color:rgba(255,255,255,.6)}
  .stamp{position:absolute;left:22px;bottom:30px;display:inline-flex;align-items:center;gap:8px;background:#3B5BFF;color:#fff;font-size:12px;font-weight:600;padding:9px 12px;opacity:0;transform:scale(1.3) rotate(-4deg);z-index:5}
  .s1.play .mk path{animation:draw 7s cubic-bezier(.6,0,.2,1) infinite}
  .s1.play .ty{animation:fadeup 7s ease infinite;animation-delay:.3s}
  .s1.play .s{animation:swatch 7s cubic-bezier(.2,.9,.3,1.3) infinite;animation-delay:var(--d)}
  .s1.play .dk{animation:fadeup 7s ease infinite;animation-delay:1.1s}
  .s1.play .sheet.back{animation:stack 7s ease infinite}
  .s1.play .stamp{animation:stamp 7s cubic-bezier(.2,.9,.3,1.2) infinite}
  @keyframes draw{0%{stroke-dashoffset:150}22%,90%{stroke-dashoffset:0}100%{stroke-dashoffset:150}}
  @keyframes fadeup{0%,18%{opacity:0;transform:translateY(8px)}30%,90%{opacity:1;transform:none}100%{opacity:0}}
  @keyframes swatch{0%,20%{opacity:0;transform:scale(.6)}30%,90%{opacity:1;transform:none}100%{opacity:0;transform:scale(.6)}}
  @keyframes stack{0%,40%{transform:translate(0,0)}55%,90%{transform:translate(12px,10px)}100%{transform:translate(0,0)}}
  @keyframes stamp{0%,60%{opacity:0;transform:scale(1.3) rotate(-4deg)}66%,92%{opacity:1;transform:rotate(-4deg)}100%{opacity:0}}

  /* 2 · social */
  .hl.lab i{transform:scale(.75)}
  .f{opacity:0;transform:perspective(200px) rotateY(80deg)}
  .f span{font-size:13px;font-weight:600;color:#fff}
  .f0{background:#3B5BFF!important}.f1{background:var(--soft2)}.f2{background:#8B9CFF!important}
  .story{position:absolute;right:20px;top:26px;width:132px;height:236px;background:#3B5BFF;padding:12px;display:flex;flex-direction:column;gap:7px;box-shadow:0 18px 40px rgba(59,91,255,.25);opacity:0;transform:translateY(20px)}
  .sbar{display:grid;grid-template-columns:repeat(3,1fr);gap:3px}.sbar i{height:2px;background:rgba(255,255,255,.45)}.sbar i:first-child{background:#fff}
  .story .sh{margin-top:14px!important;font-size:15px;line-height:18px;font-weight:600;color:#fff}
  .story .sl{display:block;height:6px;background:rgba(255,255,255,.45)}.story .a{width:86%}.story .b{width:60%}
  .story span{margin-top:auto;background:#fff;color:#3B5BFF;font-size:11px;font-weight:600;text-align:center;padding:8px 0}
  .vis{position:absolute;right:20px;top:278px;width:132px;display:flex;gap:10px;align-items:center;background:var(--card);padding:12px;box-shadow:0 14px 30px rgba(10,14,23,.10);color:#3B5BFF;opacity:0}
  .vis span{display:flex;flex-direction:column;font-size:9.5px;color:var(--mute)}.vis b{font-size:16px;font-weight:600;color:var(--fg)}
  .c2{right:20px;bottom:22px;width:132px;white-space:normal;align-items:flex-start}
  .s2.play .hl.lab i{animation:ring 7s cubic-bezier(.2,.9,.3,1.3) infinite;animation-delay:var(--d)}
  .s2.play .f{animation:flip 7s cubic-bezier(.2,.8,.2,1) infinite;animation-delay:var(--d)}
  .s2.play .story{animation:storyin 7s cubic-bezier(.2,.8,.2,1) infinite}
  .s2.play .sbar i:nth-child(2){animation:sbar 7s linear infinite}
  .s2.play .vis{animation:fadeup 7s ease infinite;animation-delay:2.2s}
  .s2.play .c2{animation:pop 7s cubic-bezier(.2,.8,.2,1) infinite}
  @keyframes ring{0%{transform:scale(.75);background:var(--soft2)}10%,90%{transform:none;background:#3B5BFF;box-shadow:0 0 0 2px var(--card),0 0 0 4px #3B5BFF}100%{transform:scale(.75);background:var(--soft2)}}
  @keyframes flip{0%{opacity:0;transform:perspective(200px) rotateY(80deg)}8%,90%{opacity:1;transform:none}100%{opacity:0}}
  @keyframes storyin{0%,26%{opacity:0;transform:translateY(20px)}36%,90%{opacity:1;transform:none}100%{opacity:0;transform:translateY(20px)}}
  @keyframes sbar{0%,40%{background:rgba(255,255,255,.45)}70%,100%{background:#fff}}

  /* 3 · website */
  .bw{position:absolute;left:20px;top:60px;width:348px;height:236px;background:var(--card);box-shadow:0 18px 40px rgba(10,14,23,.10);overflow:hidden}
  .bb{display:flex;align-items:center;gap:5px;height:26px;padding:0 10px;background:var(--soft2)}
  .bb>i{width:7px;height:7px;border-radius:50%;background:var(--card)}
  .bb span{display:inline-flex;align-items:center;gap:4px;margin-left:10px;font-size:9.5px;color:var(--mute)}
  .bc{padding:10px 12px}
  .nv{display:flex;gap:12px;align-items:center;font-size:8.5px;color:var(--mute)}
  .nv .lg{width:16px;height:16px;background:#3B5BFF;margin-right:auto}
  .nv em{font-style:normal;font-weight:600;color:var(--card);background:var(--fg);padding:4px 7px}
  .hro{margin-top:10px;background:color-mix(in srgb,#3B5BFF 10%,var(--card));padding:14px;display:flex;align-items:flex-end;justify-content:space-between;gap:10px;opacity:0;transform:translateY(12px)}
  .hro p{font-size:17px;line-height:20px;font-weight:600;letter-spacing:-.3px}
  .btn{flex:none;background:#3B5BFF;color:#fff;font-size:9.5px;font-weight:600;padding:7px 10px}
  .prc{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:8px}
  .prc div{background:var(--soft2);padding:8px;display:flex;flex-direction:column;gap:2px;opacity:0;transform:translateY(10px)}
  .prc span{font-size:8.5px;color:var(--mute)}.prc b{font-size:13px;font-weight:600}
  .cur{position:absolute;left:280px;top:190px;z-index:3}
  .cur path{fill:var(--fg);stroke:var(--card);stroke-width:1.5}
  .sp{position:absolute;left:20px;bottom:26px;width:168px;display:flex;gap:10px;align-items:center;background:var(--card);padding:12px;box-shadow:0 18px 40px rgba(10,14,23,.10);opacity:0}
  .sp circle{fill:none;stroke-width:6}.sp .trk{stroke:var(--soft2)}.sp .arc{stroke:#3B5BFF;stroke-dasharray:163;stroke-dashoffset:163;transform:rotate(-90deg);transform-origin:50% 50%}
  .sp span{display:flex;flex-direction:column;font-size:9.5px;color:var(--mute)}.sp b{font-size:22px;line-height:24px;font-weight:600;color:var(--fg)}
  .gs{position:absolute;right:20px;bottom:26px;width:168px;background:var(--card);padding:12px;box-shadow:0 18px 40px rgba(10,14,23,.10);opacity:0}
  .gu{font-size:9px;color:var(--mute)}.gt{margin-top:3px!important;font-size:11px;font-weight:600;color:#3B5BFF}
  .gs i{display:block;height:5px;margin-top:6px;background:var(--soft2)}.gs .g2{width:90%}.gs .g3{width:62%}
  .c3{left:20px;top:18px}
  .s3.play .hro{animation:build 7s cubic-bezier(.2,.8,.2,1) infinite;animation-delay:.3s}
  .s3.play .prc div{animation:build 7s cubic-bezier(.2,.8,.2,1) infinite;animation-delay:var(--d)}
