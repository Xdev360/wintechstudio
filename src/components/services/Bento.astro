---
// "What you get": sticky head on the left (dm-stick), hairline grid on the right: three square cells, then two full-width cells.
// The art moves a few percent inside each frame on scroll (data-pfx, public/scroll-fx.js).
// The vignette art is cropped out of the exported card images (public/images/services/<slug>-<n>.webp, 2x) by its Figma rect.
interface Props { slug: string; cells: [string, string][]; lines: string[] }
const { slug, cells, lines } = Astro.props;
const textTop = slug === 'brand'; // brand: text above the art in every cell; others: wide cells put art on top
const cw = [400, 400, 399, 600, 599];
const rect = (i: number) => i < 3
  ? { x: 32, y: textTop ? 134 : 138, w: 335, h: 236 }
  : { x: 32, y: textTop ? 134 : 0, w: 535, h: 244 };
---
<section class="dm dm-sec line wyg">
  <div class="wrap dm-stick bs">
    <div class="dm-head">
      <p class="dm-eb">What you get</p>
      <h2 class="dm-h2s">{lines[0]} <span>{lines[1]}</span></h2>
      <a class="dm-link" href="#brief">Build your brief</a>
    </div>
    <div class="grid">
      {cells.map(([t, d], i) => {
        const r = rect(i);
        const imgStyle = `width:${(cw[i] / r.w) * 100}%;left:${(-r.x / r.w) * 100}%;top:${(-r.y / r.h) * 100}%`;
        return (
          <div class:list={['cell', i > 2 ? 'wide' : 'top']}>
            <div class="txt"><h3 class="dm-h3">{t}</h3><p class="dm-body">{d}</p></div>
            <div class="vig" style={`aspect-ratio:${r.w}/${r.h}`} data-pfx="0.04"><img src={`/images/services/${slug}-${i + 1}.webp`} alt="" style={imgStyle} loading="lazy" decoding="async" /></div>
          </div>
        );
      })}
    </div>
  </div>
</section>
<style>
  h2 span{color:var(--lab)}
  .bs{grid-template-columns:minmax(0,360px) minmax(0,1fr)}
  .bs .dm-head{gap:16px}
  .bs .dm-link{margin-top:8px}
  .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--hl);border:1px solid var(--hl)}
  .cell{display:flex;flex-direction:column;gap:24px;padding:32px;min-width:0;background:var(--bg)}
  .top{grid-column:span 1}
  .top:nth-child(3){grid-column:span 2;flex-direction:row;align-items:center}
  .top:nth-child(3) .txt{flex:1}
  .top:nth-child(3) .vig{flex:0 0 52%;margin-top:0}
  .wide{grid-column:span 2}
  .txt{display:flex;flex-direction:column;gap:8px}
  .vig{position:relative;overflow:hidden;width:100%;margin-top:auto}
  .vig img{will-change:transform}
  .vig img{position:absolute;max-width:none;height:auto;display:block;object-fit:fill}
  @media (max-width:1023px){
    .bs{grid-template-columns:minmax(0,1fr)}
    h2 span{color:inherit}
    .grid{display:flex;flex-direction:column}
    .top:nth-child(3){flex-direction:column;align-items:stretch}
    .top:nth-child(3) .vig{flex:none;margin-top:auto}
    .cell{padding:20px;gap:16px}
  }
</style>
