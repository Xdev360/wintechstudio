---
// Brief builder, compact DesignMe form. Picks are saved in localStorage "wt-brief-<slug>", sent to /book?service=<slug> or WhatsApp.
import Lc from '../ui/Lc.astro';
import { contact } from '../../data/site';
interface Q { q: string; multi: boolean; options: string[] }
interface Props { slug: string; name: string; label: string; starting: string; questions: Q[] }
const { slug, name, label, starting, questions } = Astro.props;
const pad = (i: number) => String(i + 1).padStart(2, '0');
---
<section class="dm dm-sec alt bb" id="brief">
  <div class="wrap">
    <div class="dm-head c">
      <p class="dm-eb">Before the call</p>
      <h2 class="dm-h2">Tick what fits. We read it before we talk.</h2>
      <p class="dm-intro">No forms to fill. Tap what applies, and your picks are compiled into a brief that goes with your booking.</p>
    </div>
    <div class="bb-grid" data-brief data-slug={slug} data-service={name}>
      <div class="bb-form">
        <div class="bb-top"><h3>Build your brief</h3><span class="dm-eb">Saved as you tick</span></div>
        {questions.map((q, i) => (
          <fieldset class="bq" data-q={q.q} data-multi={q.multi ? '1' : '0'}>
            <legend><span class="dm-num">{pad(i)}</span><span class="qt">{q.q}</span>{q.multi && <span class="any">Pick any</span>}</legend>
            <div class="chips">{q.options.map(o => (
              <button type="button" class="chip" aria-pressed="false" data-v={o}><Lc name="check" size={14} stroke={2} class="ck" /><span>{o}</span></button>
            ))}</div>
          </fieldset>
        ))}
        <label class="bq note"><span class="qt">Anything else? (optional)</span><textarea data-note rows="3" placeholder="A link to your Instagram, a brand you like, or one line about the business"></textarea></label>
      </div>
      <aside class="bb-sum" aria-label="Your brief">
        <div class="sum-top"><span class="dm-eb">Your brief · {label}</span><span class="cnt"><span data-count>0</span> picks</span></div>
        <ul class="sum-list" data-list><li class="empty">Tap options to build your brief.</li></ul>
        <div class="start"><span class="dm-eb">Likely starting point</span><strong>{starting}</strong></div>
        <div class="acts">
          <a class="dm-btn p w" data-book href={`/book?service=${slug}`}>Book a call with this brief</a>
          <a class="dm-btn o w" data-wa href={contact.whatsappLink} target="_blank" rel="noopener">Send it on WhatsApp</a>
        </div>
        <p class="fine">Your picks are attached to the booking, so the call starts where the brief ends.</p>
      </aside>
    </div>
  </div>
</section>

<div class="dm mbar" data-mbar hidden>
  <div><span class="dm-eb"><span data-count>0</span> picks · {label}</span><strong>{starting}</strong></div>
  <button type="button" class="dm-btn p sm" data-open>Review <Lc name="arrow-right" /></button>
</div>
<div class="dm msheet" data-sheet hidden>
  <div class="scrim" data-close></div>
  <div class="sheet" role="dialog" aria-modal="true" aria-label={`Your brief · ${label}`}>
    <div class="sh-top"><h3>Your brief · {label}</h3><button type="button" class="x dm-ib" data-close aria-label="Close"><Lc name="x" /></button></div>
    <ul class="sh-list" data-slist></ul>
    <div class="sh-foot">
      <div class="start"><span class="dm-eb">Likely starting point</span><strong>{starting}</strong></div>
      <a class="dm-btn p w" data-book href={`/book?service=${slug}`}>Book a call with this brief</a>
      <a class="dm-btn o w" data-wa href={contact.whatsappLink} target="_blank" rel="noopener">Send it on WhatsApp</a>
    </div>
  </div>
</div>

<script is:inline define:vars={{ slug, wa: contact.whatsappLink }}>
(function(){
  var root=document.querySelector('[data-brief]');if(!root)return;
  var KEY='wt-brief-'+slug,state={};
  try{state=JSON.parse(localStorage.getItem(KEY)||'{}')||{}}catch(e){}
  var note=root.querySelector('[data-note]');if(state._note)note.value=state._note;
  var fs=[].slice.call(root.querySelectorAll('fieldset.bq'));
  fs.forEach(function(f){var q=f.dataset.q,multi=f.dataset.multi==='1';
    f.querySelectorAll('.chip').forEach(function(b){
      if((state[q]||[]).indexOf(b.dataset.v)>-1)b.setAttribute('aria-pressed','true');
      b.addEventListener('click',function(){var on=b.getAttribute('aria-pressed')==='true';if(!multi)f.querySelectorAll('.chip').forEach(function(x){x.setAttribute('aria-pressed','false')});b.setAttribute('aria-pressed',String(!on));save()});
    })});
  note.addEventListener('input',save);
  function save(){var s={};fs.forEach(function(f){var v=[].slice.call(f.querySelectorAll('.chip[aria-pressed="true"]')).map(function(b){return b.dataset.v});if(v.length)s[f.dataset.q]=v});if(note.value)s._note=note.value;state=s;try{localStorage.setItem(KEY,JSON.stringify(s))}catch(e){}render()}
  function text(){var l=['Brief: '+root.dataset.service];fs.forEach(function(f){var k=f.dataset.q;if(state[k])l.push(k+': '+state[k].join(', '))});if(state._note)l.push('Note: '+state._note);return l.join('\n')}
  var keep=/^(WhatsApp|Instagram|Google|Email|AI|Lagos|Nigeria|Web|Mobile)/;
  function joinv(v){return v.map(function(x,i){return i&&!keep.test(x)&&/^[A-Z][a-z]/.test(x)?x.charAt(0).toLowerCase()+x.slice(1):x}).join(', ')}
  function li(q,v){var e=document.createElement('li');var a=document.createElement('span');a.textContent=q;var b=document.createElement('b');b.textContent=v;e.appendChild(a);e.appendChild(b);return e}
  function render(){
    var list=root.querySelector('[data-list]'),sl=document.querySelector('[data-slist]'),n=0;list.innerHTML='';sl.innerHTML='';
    fs.forEach(function(f){var k=f.dataset.q,v=state[k];if(!v)return;n+=v.length;list.appendChild(li(k,joinv(v)));sl.appendChild(li(k,joinv(v)))});
    if(!n){list.innerHTML='<li class="empty">Tap options to build your brief.</li>';sl.innerHTML='<li class="empty">Nothing ticked yet. Tap the options that fit.</li>'}
    document.querySelectorAll('[data-count]').forEach(function(c){c.textContent=n});
    var href=wa+'?text='+encodeURIComponent('Hello Wintech, here is my brief.\n\n'+text());
    document.querySelectorAll('[data-wa]').forEach(function(a){a.href=href});
    document.querySelectorAll('[data-book]').forEach(function(a){a.href='/book?service='+slug});
  }
  render();
  // Mobile: sticky bar while the brief is on screen, sheet on Review.
  var bar=document.querySelector('[data-mbar]'),sheet=document.querySelector('[data-sheet]'),sec=document.getElementById('brief');
  if('IntersectionObserver' in window){new IntersectionObserver(function(es){es.forEach(function(e){var on=e.isIntersecting;bar.hidden=!on;document.documentElement.classList.toggle('brief-bar-on',on)})},{rootMargin:'0px 0px -30% 0px'}).observe(sec)}
  function open(){sheet.hidden=false;document.documentElement.style.overflow='hidden';var x=sheet.querySelector('.x');x&&x.focus()}
  function close(){sheet.hidden=true;document.documentElement.style.overflow=''}
  bar.querySelector('[data-open]').addEventListener('click',open);
  sheet.querySelectorAll('[data-close]').forEach(function(b){b.addEventListener('click',close)});
  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&!sheet.hidden)close()});
  window.addEventListener('resize',function(){if(window.innerWidth>1023&&!sheet.hidden)close()});
})();
</script>

<style>
  .bb-grid{display:grid;grid-template-columns:minmax(0,1fr) 352px;gap:20px;align-items:start;margin-top:80px}
  .bb-form{border:1px solid var(--hl);background:var(--bg)}
  .bb-top{display:flex;justify-content:space-between;align-items:center;height:56px;padding:0 24px;border-bottom:1px solid var(--hl)}
  .bb-top h3{font-size:16px;line-height:24px}
  .bq{border:0;margin:0;padding:20px 24px;display:flex;flex-direction:column;gap:12px;min-width:0}
  .bq+.bq{border-top:1px solid var(--hl)}
  .bq legend{float:left;width:100%;padding:0;display:flex;align-items:baseline;gap:10px}
  .bq legend+*{clear:both}
  .qt{font-size:14px;line-height:21px;font-weight:600;color:var(--fg)}
  .any{font-size:13px;line-height:18px;color:var(--lab)}
  .chips{display:flex;flex-wrap:wrap;gap:8px}
  .chip{display:inline-flex;align-items:center;gap:6px;height:32px;padding:0 12px;background:var(--bg);border:1px solid var(--hl);border-radius:2px;font:400 14px/1 var(--font);color:var(--fg);cursor:pointer;transition:border-color .15s,background .15s,color .15s}
  .chip:hover{border-color:var(--hl2)}
  .chip :global(.ck){display:none;margin-left:-2px}
  .chip[aria-pressed="true"]{background:var(--fg);border-color:var(--fg);color:var(--bg)}
  .chip[aria-pressed="true"] :global(.ck){display:block}
  .note{gap:8px}
  textarea{width:100%;min-height:88px;padding:10px 12px;border:1px solid var(--hl);border-radius:2px;background:var(--bg);color:var(--fg);font:400 15px/22px var(--font);resize:vertical}
  textarea::placeholder{color:var(--lab);opacity:.8}
  textarea:focus{outline:none;border-color:var(--sig)}

  .bb-sum{position:sticky;top:96px;border:1px solid var(--hl);background:var(--bg);padding:24px;display:flex;flex-direction:column;gap:16px}
  .sum-top{display:flex;justify-content:space-between;gap:12px}
  .cnt{font-size:13px;line-height:14.3px;color:var(--lab)}
  .sum-list,.sh-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column}
  .sum-list :global(li),.sh-list :global(li){border-top:1px solid var(--hl);padding:10px 0;display:flex;flex-direction:column;gap:2px}
  .sum-list :global(span),.sh-list :global(span){font-size:13px;line-height:18px;color:var(--lab)}
  .sum-list :global(b),.sh-list :global(b){font-size:14px;line-height:21px;font-weight:500;color:var(--fg)}
  .sum-list :global(.empty),.sh-list :global(.empty){font-size:14px;line-height:21px;color:var(--mute)}
  .start{background:var(--panel);padding:12px 16px;display:flex;flex-direction:column;gap:4px}
  .start strong{font-size:16px;line-height:24px;font-weight:600}
  .acts{display:flex;flex-direction:column;gap:8px}
  .fine{font-size:13px;line-height:18px;color:var(--lab)}
  .mbar,.msheet{display:none}
  @media (max-width:1023px){
    .bb-grid{display:block;margin-top:32px}
    .bb-top{display:none}
    .bq{padding:16px}
    .bb-sum{display:none}
    .mbar:not([hidden]){display:flex;position:fixed;left:0;right:0;bottom:0;z-index:55;background:var(--bg);border-top:1px solid var(--hl);padding:12px 16px;justify-content:space-between;align-items:center;gap:12px;padding-bottom:max(12px,env(safe-area-inset-bottom))}
    .mbar>div{display:flex;flex-direction:column;gap:2px}
    .mbar strong{font-size:14px;line-height:21px;font-weight:600}
    .msheet:not([hidden]){display:block;position:fixed;inset:0;z-index:70}
    .scrim{position:absolute;inset:0;background:rgba(10,14,23,.4)}
    .sheet{position:absolute;left:0;right:0;bottom:0;max-height:88vh;overflow:auto;background:var(--bg);border-top:1px solid var(--hl);animation:up .25s ease-out}
    .sh-top{display:flex;justify-content:space-between;align-items:center;padding:16px}
    .sh-top h3{font-size:18px;line-height:24px}
    .x{cursor:pointer;color:var(--fg)}
    .sh-list{padding:0 16px}
    .sh-foot{padding:16px 16px 24px;display:flex;flex-direction:column;gap:8px}
    :global(html.brief-bar-on #ask-open){display:none}
  }
  @keyframes up{from{transform:translateY(40px);opacity:.6}}
</style>
