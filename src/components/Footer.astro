---
import { services, contact } from '../data/site';
const q = encodeURIComponent('What does Wintech Studio (wintechstudio.com) do, and who is it for?');
const ais = [
  ['ChatGPT', `https://chatgpt.com/?q=${q}`],
  ['Claude', `https://claude.ai/new?q=${q}`],
  ['Perplexity', `https://www.perplexity.ai/search?q=${q}`],
  ['Gemini', 'https://gemini.google.com/app'],
  ['Grok', `https://grok.com/?q=${q}`],
];
const cols = [
  { h: 'Services', links: [['/services#starting', 'Starting something'], ['/services#adding-tech', 'Adding tech to my business'], ['/services#refresh', 'Refreshing my brand'], ...services.map(s => [`/services/${s.slug}`, s.short])] },
  { h: 'Studio', links: [['/work', 'Work'], ['/how-we-work', 'How we work'], ['/about', 'About'], ['/faq', 'FAQ'], ['/join-the-bench', 'Join the bench']] },
  { h: 'Free tools', links: [['/tools/plan', 'Plan your project'], ['/tools/cost-calculator', 'Cost calculator'], ['/tools/inbox-check', 'Inbox check'], [contact.templates, 'Templates · live']] },
  { h: 'More', links: [['/pricing', 'Pricing'], ['/contact', 'Contact'], ['/privacy', 'Privacy'], ['/terms', 'Terms'], ['/llms.txt', 'llms.txt']] },
];
---
<footer class="site-footer">
  <div class="wrap top">
    <div class="intro">
      <p class="mono clock" id="clock">Lagos · London</p>
      <h2>Built for momentum.</h2>
      <p class="sub">Design, build and run with one project lead.</p>
      <div class="contacts">
        <div><p class="mono">Let's talk</p><a href="/book">Book a strategy call</a></div>
        <div><p class="mono">Send email</p><a href={`mailto:${contact.email}`}>{contact.email}</a></div>
      </div>
    </div>
    <nav class="cols" aria-label="Footer">
      {cols.map(c => (<div><p class="mono">{c.h}</p>{c.links.map(([h, l]) => <a href={h}>{l}</a>)}</div>))}
    </nav>
  </div>
  <div class="wrap bottom">
    <div>
      <p class="ask">Ask AI about Wintech</p>
      <div class="chips">{ais.map(([n, h]) => <a href={h} target="_blank" rel="noopener">{n}</a>)}</div>
    </div>
    <p class="mono legal">© Wintech Studio 2026 · <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> · <a href={contact.whatsappLink}>WhatsApp {contact.whatsapp}</a></p>
  </div>
</footer>
<script is:inline>
  (function(){var el=document.getElementById('clock');if(!el)return;function f(tz){return new Intl.DateTimeFormat('en-GB',{hour:'2-digit',minute:'2-digit',timeZone:tz}).format(new Date())}function t(){el.textContent='LAGOS '+f('Africa/Lagos')+'  ·  LONDON '+f('Europe/London')}t();setInterval(t,30000)})();
</script>
<style>
  .site-footer{background:#0A0E17;color:#F4F4F5;padding:80px 0 36px}
  .site-footer .mono{color:#9AA3B2;letter-spacing:.66px}
  .top{display:flex;justify-content:space-between;gap:48px;flex-wrap:wrap}
  .intro h2{font-size:40px;letter-spacing:-.6px;margin-top:18px;color:#F4F6FA}
  .sub{color:#9AA3B2;font-size:16px;margin:18px 0 18px}
  .contacts{display:flex;gap:40px}.contacts a{color:#F4F6FA;font-size:16px;text-decoration:none;font-weight:500}.contacts .mono{margin:0 0 4px}
  .cols{display:flex;gap:48px;flex-wrap:wrap}
  .cols div{display:flex;flex-direction:column;gap:11px}.cols .mono{margin:0 0 4px}
  .cols a{color:#F4F6FA;text-decoration:none;font-size:14px}.cols a:hover{color:#fff}
  .bottom{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-top:56px}
  .ask{font-weight:600;font-size:18px;margin:0 0 12px}
  .chips{display:flex;gap:8px;flex-wrap:wrap}.chips a{color:#B9C1CF;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);padding:8px 12px;font-size:13px;text-decoration:none}.chips a:hover{background:rgba(255,255,255,.1);color:#fff}
  .legal a{color:inherit;text-decoration:none}
  @media (max-width:767px){.site-footer{padding:48px 0 32px}.intro h2{font-size:30px}.cols{gap:28px}.contacts{flex-direction:column;gap:16px}}
</style>
