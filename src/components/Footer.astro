---
// Footer per docs/DESIGNME-SPEC.md: clock row, brand row, main (heading + contact + Ask AI | link grid), legal row.
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { services, contact } from '../data/site';
import { aiMarks } from '../data/ai-marks';
const q = encodeURIComponent('What does Wintech Studio (wintechstudio.com) do, and who is it for?');
const ais: [string, string, string][] = [
  ['ChatGPT', 'GPT', `https://chatgpt.com/?q=${q}`],
  ['Claude', 'CL', `https://claude.ai/new?q=${q}`],
  ['Perplexity', 'PX', `https://www.perplexity.ai/search?q=${q}`],
  ['Gemini', 'GE', 'https://gemini.google.com/app'],
  ['Grok', 'GK', `https://grok.com/?q=${q}`],
];
const cols: { h: string; links: [string, string, boolean?][] }[] = [
  { h: 'Services', links: [['/services#starting', 'Starting something'], ['/services#adding-tech', 'Adding tech to my business'], ['/services#refresh', 'Refreshing my brand'], ...services.map(s => [`/services/${s.slug}`, s.name] as [string, string]), ['/services', 'All services']] },
  { h: 'Work', links: [['/work', 'Case studies'], ['/work/mylo', 'Mylo'], ['/work/virelle', 'Virelle Wellness'], ['/work/tobel-pearls', 'Tobel Pearls'], ['/work/manzeelatur-ridho', 'Manzeelatur Ridho'], ['/work/lets-hang', "Let's Hang"]] },
  { h: 'Studio', links: [['/about', 'About'], ['/how-we-work', 'How we work'], ['/faq', 'FAQ'], ['/join-the-bench', 'Join the bench'], ['/pricing', 'Pricing'], ['/contact', 'Contact'], [contact.templates, 'Templates', true]] },
];
const clocks: [string, string][] = [['Lagos', 'Africa/Lagos'], ['London', 'Europe/London']];
---
<footer class="site-footer">
  <div class="clocks-row">
    <div class="wrap clocks" aria-label="Local times">
      {clocks.map(([c, tz]) => <p class="ck"><span>{c}</span><i aria-hidden="true"></i><time data-tz={tz}>--:--</time></p>)}
    </div>
  </div>
  <div class="wrap">
    <div class="brand">
      <Logo />
      <p class="tagline">Brand, websites, AI and automation, from one studio in Lagos.</p>
    </div>
  </div>
  <div class="wrap main">
    <div class="left">
      <h2>Design, build and run it, with one project lead.</h2>
      <div class="contact">
        <div><p class="fh">Let's talk</p><a href="/book">Book a call</a></div>
        <div><p class="fh">Send email</p><a href={`mailto:${contact.email}`}>{contact.email}</a></div>
        <div><p class="fh">WhatsApp</p><a href={contact.whatsappLink} target="_blank" rel="noopener">{contact.whatsapp}</a></div>
      </div>
      <div class="ask">
        <p>Ask AI about Wintech</p>
        <div class="ais">{ais.map(([n, , h]) => <a href={h} target="_blank" rel="noopener" aria-label={`Ask ${n} about Wintech Studio`} title={`Ask ${n}`}><svg viewBox={aiMarks[n].vb} width="18" height="18" fill="currentColor" fill-rule="evenodd" aria-hidden="true" set:html={aiMarks[n].svg} /></a>)}</div>
      </div>
    </div>
    <div class="right">
      <nav class="grid3" aria-label="Footer">
        {cols.map(c => (
          <div class="fc"><p class="fh">{c.h}</p>{c.links.map(([h, l, ext]) => <a href={h} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>{l}{ext && <Icon name="arrow-up-right" size={12} />}</a>)}</div>
        ))}
      </nav>
      <div class="addr">
        <p class="fh">Address</p>
        <p>Lagos, Nigeria</p>
        <p><a href={`mailto:${contact.email}`}>{contact.email}</a></p>
      </div>
    </div>
  </div>
  <div class="bottom">
    <div class="legal">
      <div class="ll"><span>© 2026 Wintech Studio. All rights reserved.</span><a href="/privacy">Privacy policy</a><a href="/terms">Terms of service</a><a href="/llms.txt">llms.txt</a></div>
      <div class="ll"><a href="https://www.instagram.com/wintechstudio" target="_blank" rel="noopener">Instagram</a><a href="https://x.com/wintechstudio_" target="_blank" rel="noopener">X</a><a href={contact.whatsappLink} target="_blank" rel="noopener">WhatsApp</a><a href="/book">Book a call</a></div>
    </div>
  </div>
</footer>
<script is:inline>
  (function(){var els=document.querySelectorAll('[data-tz]');function f(tz){return new Intl.DateTimeFormat('en-GB',{hour:'2-digit',minute:'2-digit',timeZone:tz}).format(new Date())}function t(){els.forEach(function(e){e.textContent=f(e.dataset.tz)})}t();setInterval(t,30000);
})();
</script>
<style>
  /* DesignMe footer: always dark, hairlines at 12% white */
  .site-footer{--fg:#F5F5F5;--fg-2:rgba(245,245,245,.75);--fg-3:rgba(245,245,245,.62);--rule:rgba(245,245,245,.12);--rule-2:rgba(245,245,245,.24);--hover:rgba(245,245,245,.06);background:#0F0F0F;color:var(--fg);border-top:1px solid rgba(255,255,255,.06)}
  /* clock row: hairline runs edge to edge */
  .clocks-row{border-bottom:1px solid var(--rule)}
  .clocks{display:flex;justify-content:space-between;padding-top:16px;padding-bottom:16px}
  .ck{display:flex;align-items:center;gap:8px;margin:0;font:500 11px/14.3px var(--font);letter-spacing:.66px;text-transform:uppercase;color:var(--fg-3)}
  .ck i{width:1px;height:11px;background:var(--rule-2)}
  .ck time{color:var(--fg-2);font-variant-numeric:tabular-nums}
  /* brand row: centred, hairline at container width */
  .brand{display:flex;flex-direction:column;align-items:center;text-align:center;gap:12px;padding:40px 0;border-bottom:1px solid var(--rule)}
  .brand :global(.logo){height:22px;font-size:22px}.brand :global(.logo-m){width:30px;height:22px}
  .tagline{margin:0;font-size:18px;line-height:27px;font-weight:500;color:var(--fg-2)}
  /* main */
  .main{display:grid;grid-template-columns:minmax(0,506fr) minmax(0,598fr);gap:96px;padding-top:48px;padding-bottom:80px}
  .left h2{font-size:32px;line-height:36.8px;letter-spacing:-.64px;font-weight:600;margin:0;max-width:420px}
  .contact{display:flex;flex-wrap:wrap;gap:24px 56px;margin-top:40px;padding-bottom:32px;border-bottom:1px solid var(--rule)}
  .contact .fh{margin-bottom:12px}
  .contact a{font-size:16px;line-height:24px;font-weight:500;color:var(--fg);text-decoration:underline;text-decoration-color:var(--rule-2);text-underline-offset:3px}
  .contact a:hover{text-decoration-color:currentColor}
  .ask{margin-top:48px}
  .ask p{font-size:24px;line-height:31.2px;letter-spacing:-.24px;font-weight:600;margin:0 0 16px}
  .ais{display:flex;flex-wrap:wrap;gap:12px}
  .ais a{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;background:rgba(245,245,245,.06);border-radius:2px;color:var(--fg);text-decoration:none;transition:background .15s,transform .15s}
  .ais a:hover{transform:translateY(-1px)}
  .ais a:hover{background:rgba(245,245,245,.12);color:var(--fg)}
  .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;padding-bottom:40px;border-bottom:1px solid var(--rule)}
  .fc{display:flex;flex-direction:column;align-items:flex-start;gap:10px}
  .fh{margin:0 0 6px;font:500 11px/14.3px var(--font);letter-spacing:.66px;text-transform:uppercase;color:var(--fg-3)}
  .fc a{display:inline-flex;align-items:center;gap:4px;font-size:14px;line-height:21px;font-weight:500;color:var(--fg);text-decoration:none}
  .fc a :global(svg){color:var(--fg-3)}
  .fc a:hover{text-decoration:underline;text-underline-offset:3px}
  .addr{margin-top:40px}
  .addr p:not(.fh){margin:0;font-size:14px;line-height:21px;font-weight:500;color:var(--fg-2)}
  .addr a{color:inherit;text-decoration:none}.addr a:hover{color:var(--fg)}
  /* bottom row: hairline at 1280 */
  .bottom{max-width:1280px;margin:0 auto;border-top:1px solid var(--rule)}
  .legal{max-width:1200px;margin:0 auto;box-sizing:border-box;display:flex;justify-content:space-between;align-items:center;gap:16px 32px;flex-wrap:wrap;padding:32px 0}
  .ll{display:flex;gap:32px;flex-wrap:wrap;font:500 12px/18px var(--font);letter-spacing:.48px;text-transform:uppercase;color:var(--fg-2)}
  .ll a{color:inherit;text-decoration:none}.ll a:hover{color:var(--fg)}
  :global(body:has(#ask)) .legal{padding-bottom:88px}
  @media (max-width:1279px){.bottom{margin:0 40px}.legal{margin:0}}
  @media (max-width:1023px){.main{grid-template-columns:1fr;gap:48px}}
  @media (max-width:767px){
    .brand{padding:32px 0}
    .tagline{font-size:16px;line-height:24px}
    .main{padding-top:40px;padding-bottom:56px}
    .left h2{font-size:24px;line-height:28.8px;letter-spacing:-.48px}
    .contact{flex-direction:column;gap:20px}
    .grid3{grid-template-columns:1fr 1fr;gap:32px 16px}
    .bottom{margin:0 16px}
    .ll{gap:16px 24px}
  }
</style>
