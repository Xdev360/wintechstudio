---
// Ask Wintech AI: pill fixed bottom centre (Kit 799:592 sleep / 799:604 awake) and the chat sheet (822:4702).
import AiFace from './AiFace.astro';
import Bi from './Bi.astro';
const chips = ['Monthly plans', 'How fast can you start?', 'Do I need a store?', 'Can I pay in naira?'];
---
<div id="ask" data-state="sleep">
  <button class="pill" id="ask-open" type="button" aria-expanded="false" aria-controls="ask-panel">
    <span class="face"><AiFace size={26} /><span class="z" aria-hidden="true"><i>z</i><i>z</i><i>Z</i></span></span>
    <span>Ask Wintech AI</span>
  </button>
  <div class="scrim" id="ask-scrim" hidden></div>
  <section class="sheet" id="ask-panel" role="dialog" aria-label="Wintech AI" hidden>
    <header>
      <div class="who"><AiFace size={32} /><div><strong>Wintech AI</strong><span>Answers from this site · the team can also help</span></div></div>
      <div class="hact"><button type="button" id="ask-clear">Clear</button><button type="button" id="ask-close" aria-label="Close"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button></div>
    </header>
    <div class="log" id="ask-log" aria-live="polite">
      <div class="row bot"><AiFace size={24} /><p>Hi. Ask me about prices, timelines, or what we would fix first in your business.</p></div>
      <div class="links"><a href="/pricing"><Bi name="receipt" size={32} />See pricing</a><a href="/tools/plan"><Bi name="rocket" size={32} />Plan your project</a></div>
    </div>
    <div class="chips" id="ask-chips">{chips.map(c => <button type="button">{c}</button>)}<a href="/book">Book a call</a></div>
    <form id="ask-form">
      <div class="field"><input id="ask-in" autocomplete="off" placeholder="Your question" aria-label="Your question" maxlength="600" /><button type="submit" aria-label="Send"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></button></div>
      <p class="foot">Wintech AI answers from wintechstudio.com. <a href="/privacy">Privacy policy</a></p>
    </form>
  </section>
</div>
<script is:inline>
(function(){var root=document.getElementById('ask'),panel=document.getElementById('ask-panel'),scrim=document.getElementById('ask-scrim'),btn=document.getElementById('ask-open'),log=document.getElementById('ask-log'),form=document.getElementById('ask-form'),inp=document.getElementById('ask-in'),hist=[],busy=false,first=log.innerHTML;
  var faceTpl=log.querySelector('.ai-face').outerHTML;
  btn.addEventListener('mouseenter',function(){root.dataset.state='awake'});btn.addEventListener('mouseleave',function(){if(panel.hidden)root.dataset.state='sleep'});
  function set(o){panel.hidden=!o;scrim.hidden=!o;root.classList.toggle('open',o);btn.setAttribute('aria-expanded',o);root.dataset.state=o?'awake':'sleep';if(o)setTimeout(function(){inp.focus()},50)}
  btn.onclick=function(){set(panel.hidden)};document.getElementById('ask-close').onclick=function(){set(false);btn.focus()};scrim.onclick=function(){set(false)};
  document.getElementById('ask-clear').onclick=function(){log.innerHTML=first;hist=[];document.getElementById('ask-chips').hidden=false};
  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&!panel.hidden)set(false)});
  function add(t,who){var d=document.createElement('div');d.className='row '+who;if(who==='bot')d.innerHTML=faceTpl;var p=document.createElement('p');p.textContent=t;d.appendChild(p);log.appendChild(d);log.scrollTop=log.scrollHeight;return p}
  async function ask(q){if(busy||!q.trim())return;busy=true;add(q,'me');hist.push({role:'user',content:q});var p=add('Typing','bot');p.classList.add('typing');
    try{var r=await fetch('/api/ai',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({messages:hist})});if(!r.ok||!r.body)throw 0;var rd=r.body.getReader(),dec=new TextDecoder(),t='';
      while(true){var x=await rd.read();if(x.done)break;t+=dec.decode(x.value,{stream:true});p.classList.remove('typing');p.textContent=t;log.scrollTop=log.scrollHeight}hist.push({role:'assistant',content:t})}
    catch(e){p.classList.remove('typing');p.textContent='The assistant is resting right now. ';var a=document.createElement('a');a.href='https://wa.me/2349134071813?text='+encodeURIComponent(q);a.target='_blank';a.rel='noopener';a.textContent='Ask us on WhatsApp';p.append(a);hist.pop()}
    busy=false}
  form.onsubmit=function(e){e.preventDefault();var q=inp.value;inp.value='';ask(q)};
  document.querySelectorAll('#ask-chips button').forEach(function(b){b.onclick=function(){ask(b.textContent)}});
  document.addEventListener('click',function(e){var a=e.target.closest('[data-ask]');if(a){e.preventDefault();set(true)}});
})();
</script>
<style>
  .pill{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);z-index:60;display:inline-flex;align-items:center;gap:10px;padding:10px 20px 10px 12px;border-radius:999px;background:rgba(255,255,255,.92);border:1px solid #E3E7EE;box-shadow:0 8px 28px rgba(0,0,0,.1);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);font:500 15px var(--font);color:#0A0E17;cursor:pointer}
  .face{position:relative;display:inline-flex}
  .z{position:absolute;left:24px;top:-6px;display:flex;gap:1px;font:500 8px var(--font);color:#5E6678}
  .z i{font-style:normal;animation:zz 2.7s ease-in-out infinite}.z i:nth-child(2){font-size:9px;animation-delay:.3s}.z i:nth-child(3){font-size:11px;animation-delay:.6s}
  @keyframes zz{0%,100%{opacity:.2;transform:translateY(2px)}50%{opacity:1;transform:translateY(-2px)}}
  #ask[data-state="awake"] .z{display:none}
  :root[data-theme="dark"] .pill{background:rgba(10,14,23,.92);border-color:rgba(255,255,255,.12);color:#F4F6FA;box-shadow:0 8px 28px rgba(0,0,0,.1),0 0 28px rgba(59,91,255,.32)}
  #ask.open .pill,:global(html.menu-open) .pill{display:none}
  .scrim{position:fixed;inset:0;z-index:58;background:rgba(10,14,23,.24)}.scrim[hidden]{display:none}
  .sheet{position:fixed;left:50%;bottom:83px;transform:translateX(-50%);z-index:61;width:min(672px,calc(100vw - 32px));max-height:calc(100dvh - 120px);display:flex;flex-direction:column;background:rgba(255,255,255,.97);backdrop-filter:blur(12px);border:1px solid #E3E7EE;box-shadow:0 28px 70px rgba(0,0,0,.14);color:#0A0E17}
  .sheet[hidden]{display:none}
  :root[data-theme="dark"] .sheet{background:rgba(19,26,38,.97);border-color:rgba(255,255,255,.1);color:#F4F6FA}
  header{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;border-bottom:1px solid var(--rule)}
  .who{display:flex;gap:10px;align-items:center}.who div{display:flex;flex-direction:column;gap:1px}.who strong{font-weight:600;font-size:15px}.who span{font-size:12px;color:var(--fg-2)}
  .hact{display:flex;gap:14px;align-items:center}.hact button{background:none;border:0;color:var(--fg-2);font:13px var(--font);cursor:pointer;padding:0;display:inline-flex}.hact button:last-child{color:var(--fg)}
  .log{flex:1;overflow:auto;padding:16px;display:flex;flex-direction:column;gap:12px;min-height:160px}
  .row{display:flex;gap:8px;align-items:flex-end}.row p{margin:0;padding:10px 14px;font-size:14px;line-height:1.5;background:var(--surface);max-width:532px;white-space:pre-wrap}
  .row.me{justify-content:flex-end}.row.me p{background:#3B5BFF;color:#fff;line-height:normal}
  .row p.typing{background:none;padding:0 0 4px;font-size:12px;color:var(--fg-2)}
  .links{display:flex;gap:8px;padding-left:32px;flex-wrap:wrap}.links a{display:flex;align-items:center;gap:8px;padding:9px 12px;border:1px solid var(--rule);font:500 13px var(--font);color:inherit;text-decoration:none}.links a:hover{background:var(--surface)}
  .chips{display:flex;flex-wrap:wrap;gap:6px;padding:0 16px 12px}.chips[hidden]{display:none}
  .chips button,.chips a{font:13px var(--font);padding:7px 11px;border:1px solid var(--rule);background:transparent;color:inherit;cursor:pointer;text-decoration:none}.chips button:hover,.chips a:hover{background:var(--surface)}
  form{padding:0 16px 14px;display:flex;flex-direction:column;gap:8px}
  .field{display:flex;align-items:center;justify-content:space-between;border:1px solid var(--rule);padding:6px 6px 6px 14px}
  .field input{flex:1;border:0;background:transparent;font:14px var(--font);color:inherit;outline:none;box-shadow:none!important;min-width:0}.field:focus-within{border-color:var(--sig)}.field input::placeholder{color:rgba(94,102,120,.7)}
  .field button{background:#0A0E17;color:#fff;border:0;padding:9px;display:inline-flex;cursor:pointer}:root[data-theme="dark"] .field button{background:#F4F6FA;color:#0A0E17}
  .foot{margin:0;font-size:11px;color:var(--fg-2)}.foot a{color:inherit}
  @media (max-width:767px){.pill{bottom:16px}.sheet{bottom:0;width:100%;max-height:88dvh}.links{padding-left:0}}
</style>
