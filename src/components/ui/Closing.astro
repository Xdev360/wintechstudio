---
// Closing band "light wave drifts" (Figma 807:2509): dark band, three blurred glows drifting at the bottom.
---
<section class="closing">
  <span class="glow g1" aria-hidden="true"></span><span class="glow g2" aria-hidden="true"></span><span class="glow g3" aria-hidden="true"></span>
  <div class="inner">
    <p class="eyebrow">YOU'VE REACHED THE END, SO NOW…</p>
    <h2>Tell us what<br />you're building.</h2>
    <p class="sub">We map the right scope, team, timeline and next step.</p>
    <div class="ctas"><a class="b primary" href="/book">Book a call</a><a class="b ghost" href="/tools/plan">Plan your project</a></div>
  </div>
</section>
<style>
  .closing{position:relative;overflow:hidden;background:#0A0E17;min-height:480px;display:flex;justify-content:center;padding:96px 16px 120px}
  .glow{position:absolute;border-radius:50%;filter:blur(140px);pointer-events:none}
  .g1{width:900px;height:320px;left:calc(50% - 660px);top:320px;background:rgba(59,91,255,.7);animation:d1 14s ease-in-out infinite alternate}
  .g2{width:760px;height:280px;left:calc(50% - 100px);top:350px;background:rgba(37,77,127,.9);animation:d2 17s ease-in-out infinite alternate}
  .g3{width:600px;height:200px;left:calc(50% - 420px);top:400px;background:rgba(124,147,255,.35);animation:d1 12s ease-in-out infinite alternate-reverse}
  @keyframes d1{to{transform:translateX(80px)}}@keyframes d2{to{transform:translateX(-90px)}}
  @media (prefers-reduced-motion:reduce){.glow{animation:none}}
  .inner{position:relative;display:flex;flex-direction:column;align-items:center;gap:24px;text-align:center}
  .eyebrow{font:400 11px var(--mono);letter-spacing:.66px;color:#9AA3B2;margin:0}
  h2{font-size:76px;line-height:1;letter-spacing:-1.9px;font-weight:600;color:#F4F6FA;margin:0}
  .sub{font-size:18px;color:#9AA3B2;margin:0}
  .ctas{display:flex;gap:10px}
  .b{font:500 16px var(--font);padding:13px 20px;text-decoration:none;border:1px solid transparent}
  .primary{background:#3B5BFF;color:#fff}.primary:hover{background:var(--sig-hover)}
  .ghost{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.15);color:#F4F6FA}.ghost:hover{background:rgba(255,255,255,.14)}
  @media (max-width:767px){.closing{min-height:0;padding:72px 16px 96px}h2{font-size:44px;letter-spacing:-1px}.sub{font-size:16px}.ctas{flex-direction:column;width:100%;max-width:320px}.b{text-align:center}}
</style>
