---
// Closing band per docs/DESIGNME-SPEC.md: black, 252 padding, centred eyebrow + 72px H2 + sub + one button,
// animated glow along the bottom (335 tall). Mobile: padding 196, H2 42, button 286 wide.
---
<section class="closing">
  <div class="glow" aria-hidden="true">
    <span class="g g1"></span><span class="g g2"></span><span class="g g3"></span><span class="hz"></span>
  </div>
  <div class="inner">
    <p class="eb">You've reached the end, so now</p>
    <h2>Tell us what you're building.</h2>
    <p class="sub">We map the right scope, team, timeline and next step.</p>
    <a class="btn btn-primary cta" href="/book">Book a call</a>
  </div>
</section>
<style>
  .closing{position:relative;overflow:hidden;background:#000;color:#F5F5F5;padding:252px 16px;display:flex;justify-content:center;isolation:isolate}
  .inner{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;text-align:center;max-width:640px}
  .eb{font:500 11px/14.3px var(--font);letter-spacing:.66px;text-transform:uppercase;color:rgba(245,245,245,.62);margin:0 0 24px}
  h2{max-width:560px;font-size:72px;line-height:79.2px;letter-spacing:-1.44px;font-weight:600;color:#F5F5F5;margin:0}
  .sub{font-size:18px;line-height:27px;font-weight:600;color:rgba(245,245,245,.75);margin:24px 0 40px}
  .cta{min-width:140px}

  /* glow: soft light drifting along the bottom edge */
  .glow{position:absolute;left:0;right:0;bottom:0;height:335px;overflow:hidden;pointer-events:none;-webkit-mask-image:linear-gradient(180deg,transparent,#000 45%);mask-image:linear-gradient(180deg,transparent,#000 45%)}
  .g{position:absolute;bottom:-60%;width:70%;height:120%;border-radius:50%;will-change:transform}
  .g1{left:-10%;background:radial-gradient(closest-side,rgba(59,91,255,.75),rgba(59,91,255,0));animation:d1 14s ease-in-out infinite alternate}
  .g2{left:35%;background:radial-gradient(closest-side,rgba(37,77,127,.9),rgba(37,77,127,0));animation:d2 17s ease-in-out infinite alternate}
  .g3{left:15%;width:60%;bottom:-75%;background:radial-gradient(closest-side,rgba(160,178,255,.45),rgba(160,178,255,0));animation:d3 11s ease-in-out infinite alternate}
  .hz{position:absolute;left:0;right:0;bottom:0;height:1px;background:linear-gradient(90deg,transparent,rgba(160,178,255,.6) 30%,rgba(255,255,255,.8) 50%,rgba(160,178,255,.6) 70%,transparent);background-size:200% 100%;animation:hz 8s linear infinite}
  @keyframes d1{to{transform:translateX(18%) scale(1.08)}}
  @keyframes d2{to{transform:translateX(-22%) scale(.94)}}
  @keyframes d3{0%{transform:translateX(-10%);opacity:.7}100%{transform:translateX(30%);opacity:1}}
  @keyframes hz{to{background-position:-200% 0}}
  @media (prefers-reduced-motion:reduce){.g,.hz{animation:none}}

  @media (max-width:767px){
    .closing{padding:196px 16px}
    h2{font-size:42px;line-height:46.2px;letter-spacing:-.84px;max-width:340px}
    .sub{font-size:16px;line-height:24px}
    .cta{width:286px;max-width:100%}
  }
</style>
