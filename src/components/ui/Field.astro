---
interface Props { label: string; name: string; type?: string; placeholder?: string; required?: boolean; options?: string[]; rows?: number }
const { label, name, type = 'text', placeholder, required, options, rows } = Astro.props;
const id = 'f-' + name.toLowerCase().replace(/\W+/g, '-');
---
<div class="field">
  {options ? (<fieldset><legend>{label}</legend><div class="chips">{options.map(o => <label class="chip"><input type="radio" name={name} value={o} data-label={label} /><span>{o}</span></label>)}</div></fieldset>)
  : (<><label for={id}>{label}</label>{rows ? <textarea id={id} name={name} rows={rows} placeholder={placeholder} required={required} data-label={label}></textarea> : <input id={id} name={name} type={type} placeholder={placeholder} required={required} data-label={label} />}</>)}
</div>
<style>
  .field{display:grid;gap:8px}.field label,.field legend{font-size:14px;font-weight:500}
  fieldset{border:0;padding:0;margin:0}legend{margin-bottom:10px}
  input:not([type=radio]),textarea{font:15px var(--font);padding:13px 14px;border:1px solid var(--rule);background:var(--card);color:var(--fg);width:100%;box-sizing:border-box}
  input:focus,textarea:focus{outline:2px solid var(--sig);outline-offset:-1px}
  .chips{display:flex;flex-wrap:wrap;gap:8px}.chip input{position:absolute;opacity:0;pointer-events:none}
  .chip span{display:inline-block;font-size:14px;padding:9px 14px;border:1px solid var(--rule);background:var(--card);cursor:pointer}
  .chip input:checked+span{background:var(--fg);color:var(--bg);border-color:var(--fg)}.chip input:focus-visible+span{outline:2px solid var(--sig)}
</style>
