---
// Form field, DesignMe sizes: 14/500 label, 40px input, 2px radius, hairline border. `options` renders single-pick chips; `suggest` adds a datalist.
interface Props { label: string; name: string; type?: string; placeholder?: string; required?: boolean; options?: string[]; rows?: number; suggest?: string[]; value?: string; class?: string; autocomplete?: string }
const { label, name, type = 'text', placeholder, required, options, rows, suggest, value, class: cls, autocomplete } = Astro.props;
const id = 'f-' + name.toLowerCase().replace(/\W+/g, '-');
---
<div class:list={['field', cls]}>
  {options ? (<fieldset><legend>{label}</legend><div class="chips">{options.map(o => <label class="chip"><input type="radio" name={name} value={o} data-label={label} checked={o === value} /><span>{o}</span></label>)}</div></fieldset>)
  : (<><label for={id}>{label}</label>{rows ? <textarea id={id} name={name} rows={rows} placeholder={placeholder} required={required} data-label={label}></textarea> : <input id={id} name={name} type={type} placeholder={placeholder} required={required} data-label={label} list={suggest ? id + '-l' : undefined} value={value} autocomplete={autocomplete} />}{suggest && <datalist id={id + '-l'}>{suggest.map(s => <option value={s} />)}</datalist>}</>)}
</div>
<style>
  .field{display:flex;flex-direction:column;gap:8px;min-width:0}
  .field label,.field legend{font-size:14px;line-height:21px;font-weight:500;color:var(--fg);padding:0}
  fieldset{border:0;padding:0;margin:0;min-width:0}legend{margin-bottom:8px}
  input:not([type=radio]),textarea{font:400 15px/22px var(--font);height:40px;padding:8px 12px;border:1px solid var(--hl,var(--rule));border-radius:2px;background:var(--bg);color:var(--fg);width:100%;box-sizing:border-box;-webkit-appearance:none;appearance:none;transition:border-color .15s}
  textarea{height:112px;resize:vertical;display:block}
  input::placeholder,textarea::placeholder{color:var(--lab,var(--fg-2));opacity:.7}
  input:hover,textarea:hover{border-color:var(--hl2,var(--ash))}
  input:focus,textarea:focus{outline:none;border-color:var(--sig);box-shadow:0 0 0 3px rgba(59,91,255,.16)}
  .chips{display:flex;flex-wrap:wrap;gap:8px}
  .chip{position:relative}
  .chip input{position:absolute;opacity:0;pointer-events:none}
  .chip span{display:inline-flex;align-items:center;height:32px;padding:0 12px;font-size:14px;line-height:1;border:1px solid var(--hl,var(--rule));border-radius:2px;background:var(--bg);color:var(--fg);cursor:pointer;transition:background .15s,border-color .15s}
  .chip span:hover{border-color:var(--hl2,var(--ash))}
  .chip input:checked+span{background:var(--fg);border-color:var(--fg);color:var(--bg)}
  .chip input:focus-visible+span{box-shadow:var(--ring)}
</style>
