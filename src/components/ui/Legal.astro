---
// Legal page: heading, sticky "On this page" list on the left, clauses on the right.
import Page from '../../layouts/Page.astro';
import '../../styles/studio.css';
interface Props { title: string; path: string; description: string; clauses: [string, string][]; updated?: string }
const { title, path, description, clauses, updated = '25 October 2026' } = Astro.props;
const id = (s: string) => s.toLowerCase().replace(/\W+/g, '-');
const linkify = (s: string) => s.replace(/hello@wintechstudio\.com/g, '<a href="mailto:hello@wintechstudio.com">hello@wintechstudio.com</a>');
---
<Page title={`${title} · Wintech Studio`} description={description} crumbs={[[title, path]]} closing={false}>
  <div class="dm lg">
    <section class="dm-top">
      <div class="wrap"><div class="dm-head"><p class="dm-eb">Legal</p><h1 class="dm-h1">{title}</h1><p class="dm-intro">Last updated {updated}. Draft for legal review.</p></div></div>
    </section>
    <section class="dm-sec">
      <div class="wrap lgg">
        <nav class="dm-toc dm-sticky" aria-label="On this page">{clauses.map(([h], i) => <a href={`#${id(h)}`} class:list={{ on: i === 0 }}>{h}</a>)}</nav>
        <div class="cl">{clauses.map(([h, b]) => <section id={id(h)}><h2 class="dm-h3">{h}</h2><p set:html={linkify(b)} /></section>)}</div>
      </div>
    </section>
  </div>
</Page>
<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.lg nav a')];
  const mark = (h: string) => links.forEach(a => a.classList.toggle('on', a.getAttribute('href') === h));
  let hold = 0;
  links.forEach(a => a.addEventListener('click', () => { hold = Date.now() + 1000; mark(a.getAttribute('href')!); }));
  const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting && Date.now() > hold) mark('#' + e.target.id); }), { rootMargin: '-25% 0px -65% 0px' });
  document.querySelectorAll('.lg .cl section').forEach(s => io.observe(s));
</script>
<style>
  .lgg{display:grid;grid-template-columns:240px minmax(0,672px);justify-content:space-between;gap:64px;align-items:start}
  .cl{display:flex;flex-direction:column}
  .cl section{display:flex;flex-direction:column;gap:8px;padding:24px 0;border-top:1px solid var(--hl);scroll-margin-top:96px}
  .cl section:first-child{border-top:0;padding-top:0}
  .cl p{font-size:16px;line-height:24px;color:var(--mute)}
  .cl p :global(a){color:var(--fg);text-underline-offset:3px}
  .cl p :global(a:hover){color:var(--sig)}
  @media (max-width:1023px){
    .lgg{grid-template-columns:1fr;gap:0}
    nav{display:none}
    .cl section{padding:20px 0}
    .cl p{font-size:15px;line-height:22px}
  }
</style>
