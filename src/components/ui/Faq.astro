---
// FAQ band from Figma S7/S9 "faq": heading and a "Still deciding?" card on the left, an accordion on the right.
// Props kept compatible: items, title, ld (FAQPage JSON-LD), plain (drop the "Still deciding?" card).
import Icon from '../Icon.astro';
interface Props { items: [string, string][]; title?: string; ld?: boolean; plain?: boolean }
const { items, title = 'Short answers', ld = true, plain = false } = Astro.props;
---
<section class="fq">
  <div class="wrap fq-g">
    <div class="fq-l">
      <div class="fq-h"><p class="fq-eb">FAQ</p><h2>{title}</h2></div>
      {!plain && <div class="fq-c"><h3>Still deciding?</h3><p>Ask Wintech AI now, or the<br />project lead on a call.</p><a class="btn btn-primary" href="/book">Book a call</a></div>}
    </div>
    <div class="fq-list">{items.map(([q, a], i) => <details open={i === 0}><summary><span>{q}</span><Icon name="plus" size={20} class="pl" /><Icon name="minus" size={20} class="mi" /></summary><p>{a}</p></details>)}</div>
  </div>
</section>
{ld && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: items.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) })} />}
<style>
  .fq{padding:112px 0;background:var(--bg)}
  .fq-g{display:grid;grid-template-columns:380px 1fr;gap:80px;align-items:start}
  .fq-l{display:flex;flex-direction:column;gap:24px}
  .fq-h{display:flex;flex-direction:column;gap:16px}
  .fq-eb{font-family:var(--mono);font-size:11px;line-height:14px;letter-spacing:.06em;text-transform:uppercase;color:var(--fg-2);margin:0}
  h2{font-size:44px;line-height:1.05;letter-spacing:-.02em;font-weight:600;margin:0}
  .fq-c{background:var(--surface);padding:24px;display:flex;flex-direction:column;gap:12px;align-items:flex-start}
  .fq-c h3{font-size:20px;line-height:24px;font-weight:600;letter-spacing:0;margin:0}
  .fq-c p{font-size:15px;line-height:1.5;color:var(--fg-2);margin:0}
  .fq-c .btn{font-size:16px;line-height:19px;padding:13px 20px}
  details{border-bottom:1px solid var(--rule);padding:22px 0}
  summary{display:flex;justify-content:space-between;align-items:center;gap:16px;cursor:pointer;list-style:none;font-size:19px;line-height:23px;font-weight:500;color:var(--fg)}
  summary::-webkit-details-marker{display:none}
  summary :global(svg){flex:none;color:var(--fg)}
  summary :global(.mi),details[open] summary :global(.pl){display:none}
  details[open] summary :global(.mi){display:block}
  details p{font-size:16px;line-height:1.55;color:var(--fg-2);margin:12px 0 0;max-width:620px}
  summary:hover span{color:var(--sig)}
  @media (max-width:1023px){
    .fq{padding:56px 0}
    .fq-g{grid-template-columns:1fr;gap:24px}
    h2{font-size:30px;letter-spacing:-.015em}
    .fq-c{display:none}
    details{padding:16px 0}
    summary{font-size:16px;line-height:19px}
    summary :global(svg){width:18px;height:18px}
    details p{font-size:14px;line-height:1.5;margin-top:10px}
  }
</style>
