---
// FAQ band, DesignMe spec: side column (eyebrow, 42px H2, ask card) and 672px of 68px panel rows with a 28px +/- tile.
// Props: items, title, ld (FAQPage JSON-LD), plain (no ask card), eyebrow, service (pre-fills /book).
import Lc from './Lc.astro';
import AiFace from '../AiFace.astro';
import { contact } from '../../data/site';
interface Props { items: [string, string][]; title?: string; ld?: boolean; plain?: boolean; eyebrow?: string; service?: string; id?: string }
const { items, title = 'Short answers', ld = true, plain = false, eyebrow = 'FAQ', service, id = 'questions' } = Astro.props;
---
<section class="dm fq" id={id}>
  <div class="wrap dm-side">
    <div class="fq-side">
      <div class="dm-head"><p class="dm-eb">{eyebrow}</p><h2 class="dm-h2s">{title}</h2></div>
      {!plain && (
        <div class="ask">
          <AiFace size={48} />
          <h3>Still deciding?</h3>
          <p>Ask Wintech AI now, or the project lead on a 25 minute call.</p>
          <a class="dm-btn p mw" href={service ? `/book?service=${service}` : '/book'}>Book a call</a>
          <p class="mail">Or email us <a href={`mailto:${contact.email}`}>{contact.email}</a></p>
        </div>
      )}
    </div>
    <div class="qs">{items.map(([q, a], i) => (
      <details open={i === 0}>
        <summary><span class="pm" aria-hidden="true"><Lc name="plus" class="p" /><Lc name="minus" class="m" /></span><span class="q">{q}</span></summary>
        <p>{a}</p>
      </details>
    ))}</div>
  </div>
</section>
{ld && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: items.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) })} />}
<style>
  .fq{padding:var(--sec) 0;background:var(--bg)}
  .fq-side{display:flex;flex-direction:column;gap:40px}
  .ask{background:var(--panel);padding:24px;display:flex;flex-direction:column;align-items:flex-start;gap:12px}
  .ask h3{font-size:24px;line-height:31.2px;letter-spacing:-.24px;margin-top:4px}
  .ask>p{font-size:16px;line-height:24px;color:var(--mute)}
  .ask .dm-btn{margin-top:8px}
  .ask .mail{font-size:14px;line-height:21px}
  .ask .mail a{color:var(--fg);font-weight:500;text-underline-offset:3px}
  .ask .mail a:hover{color:var(--sig)}
  .qs{display:flex;flex-direction:column;gap:12px}
  details{background:var(--panel)}
  summary{display:flex;align-items:center;gap:20px;min-height:68px;padding:20px;cursor:pointer;list-style:none;font-size:16px;font-weight:500;line-height:24px;color:var(--fg)}
  summary::-webkit-details-marker{display:none}
  .pm{flex:none;width:28px;height:28px;display:grid;place-items:center;border:1px solid var(--hl);background:var(--bg);color:var(--fg)}
  .pm :global(.m),details[open] .pm :global(.p){display:none}
  details[open] .pm :global(.m){display:block}
  summary:hover .q{color:var(--sig)}
  details p{padding:0 20px 24px 68px;margin-top:-8px;font-size:16px;line-height:24px;color:var(--mute)}
  @media (max-width:1023px){
    .wrap{display:flex;flex-direction:column}
    .fq-side{display:contents}
    .dm-head{order:1}
    .qs{order:2;margin-top:24px}
    .ask{order:3;margin-top:24px}
    summary{gap:16px;padding:16px;min-height:60px;font-size:15px;line-height:22px;align-items:flex-start}
    details p{padding:0 16px 20px 60px;font-size:15px;line-height:22px}
  }
</style>
