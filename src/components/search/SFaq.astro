---
// Search-page FAQ: the shared FAQ band (spec pattern) without the side ask card.
import Faq from '../ui/Faq.astro';
interface Props { items: [string, string][]; title?: string; id?: string }
const { items, title = 'Short answers', id = 'questions' } = Astro.props;
---
<Faq items={items} title={title} id={id} eyebrow="Questions" />
