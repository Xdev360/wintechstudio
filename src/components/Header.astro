---
// Site header: announcement strip, 75px bar, mega menus and the mobile sheet. Sizes from docs/DESIGNME-SPEC.md.
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { contact } from '../data/site';

type Item = { href: string; label: string; icon: string; ask?: boolean };
type Col = { h: string; items: Item[] };
type Feat = { href: string; img: string; img2x?: string; alt: string; label: string; icon: string };
type Menu = { label: string; cols: Col[]; feat?: Feat };

const menus: Menu[] = [
  { label: 'Services', cols: [
    { h: 'Start, run or revamp', items: [
      { href: '/services#starting', label: 'Starting something', icon: 'rocket' },
      { href: '/services#adding-tech', label: 'Adding tech to my business', icon: 'store' },
      { href: '/services#refresh', label: 'Refreshing my brand', icon: 'refresh' } ] },
    { h: 'What we build', items: [
      { href: '/services/brand', label: 'Brand and packaging', icon: 'palette' },
      { href: '/services/websites', label: 'Websites and stores', icon: 'monitor' },
      { href: '/services/ai-assistant', label: 'AI assistant', icon: 'message' },
      { href: '/services/automation', label: 'Automation', icon: 'zap' },
      { href: '/services/apps', label: 'Apps and MVPs', icon: 'code' },
      { href: '/services/motion', label: 'Motion and film', icon: 'film' } ] },
  ], feat: { href: '/work/mylo', img: '/images/cases/film-mylo-800.webp', img2x: '/images/cases/film-mylo.webp', alt: 'Mylo launch film poster', label: 'Mylo, our own product', icon: 'play' } },
  { label: 'Work', cols: [
    { h: 'Our work', items: [
      { href: '/work', label: 'Case studies', icon: 'grid' },
      { href: '/how-we-work', label: 'How we work', icon: 'route' },
      { href: '/about', label: 'About', icon: 'users' } ] },
    { h: 'Recent projects', items: [
      { href: '/work/mylo', label: 'Mylo', icon: 'smartphone' },
      { href: '/work/virelle', label: 'Virelle Wellness', icon: 'leaf' },
      { href: '/work/tobel-pearls', label: 'Tobel Pearls', icon: 'truck' },
      { href: '/work/manzeelatur-ridho', label: 'Manzeelatur Ridho', icon: 'briefcase' },
      { href: '/work/lets-hang', label: "Let's Hang", icon: 'map-pin' } ] },
  ], feat: { href: '/work/virelle', img: '/images/cases/film-virelle-800.webp', img2x: '/images/cases/film-virelle.webp', alt: 'Virelle Wellness case study', label: 'Virelle Wellness case study', icon: 'leaf' } },
  { label: 'Studio', cols: [
    { h: 'Studio', items: [
      { href: '/about', label: 'About', icon: 'info' },
      { href: '/how-we-work', label: 'How we work', icon: 'route' },
      { href: '/faq', label: 'FAQ', icon: 'help' },
      { href: '/join-the-bench', label: 'Join the bench', icon: 'user-plus' } ] },
    { h: 'Talk to us', items: [
      { href: '/book', label: 'Book a call', icon: 'calendar' },
      { href: '/contact', label: 'Contact', icon: 'mail' },
      { href: '#ask', label: 'Ask Wintech AI', icon: 'sparkles', ask: true } ] },
  ], feat: { href: '/work/tobel-pearls', img: '/images/cases/film-tobel-pearls-800.webp', img2x: '/images/cases/film-tobel-pearls.webp', alt: 'Tobel Pearls case study', label: 'Tobel Pearls case study', icon: 'truck' } },
];
const foot: [string, string, string][] = [['/services', 'All services', 'layers'], ['/pricing', 'Pricing', 'receipt'], ['/book', 'Book a call', 'calendar'], ['/work', 'Case studies', 'grid'], ['/contact', 'Contact', 'mail']];
const path = Astro.url.pathname;
const cur = (h: string) => (h !== '/' && path.startsWith(h) ? 'page' : undefined);
---
<header class="site-header" id="site-header">
  <a class="announce" href={contact.templates} target="_blank" rel="noopener">
    <span class="new">NEW</span>
    <span class="at"><span class="at-l">Need a website today? </span>Start free with Wintech Templates</span>
    <svg class="aa" width="16" height="10" viewBox="0 0 16 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 5h14M11 1l4 4-4 4"/></svg>
  </a>
  <div class="bar">
    <div class="row">
      <Logo class="hl" />
      <nav class="nav" aria-label="Main">
        {menus.map((m, i) => (
          <div class="dd" data-dd>
            <button class="ni" type="button" aria-expanded="false" aria-controls={`mm-${i}`}>{m.label}<Icon name="plus" size={14} class="pl" /></button>
            <div class="mega" id={`mm-${i}`}>
              <div class="mtop">
                {m.cols.map(c => (
                  <div class="col">
                    <p class="mh">{c.h}</p>
                    <div class="ml">
                      {c.items.map(it => (
                        <a class="mi" href={it.href} data-ask={it.ask ? '' : undefined} aria-current={cur(it.href)}>
                          <span class="ib"><Icon name={it.icon} size={16} /></span>
                          <span class="mt">{it.label}</span>
                          <Icon name="arrow-right" size={12} class="ma" />
                        </a>
                      ))}
                    </div>
                  </div>
                ))}
                {m.feat && (
                  <div class="col feat">
                    <p class="mh">Featured</p>
                    <a class="fm" href={m.feat.href} tabindex="-1" aria-hidden="true">
                      <img src={m.feat.img} srcset={m.feat.img2x ? `${m.feat.img} 1292w, ${m.feat.img2x} 2720w` : undefined} sizes="398px" width="398" height="224" alt="" loading="lazy" decoding="async" />
                    </a>
                    <div class="ml"><a class="mi" href={m.feat.href}><span class="ib"><Icon name={m.feat.icon} size={16} /></span><span class="mt">{m.feat.label}</span><Icon name="arrow-right" size={12} class="ma" /></a></div>
                  </div>
                )}
              </div>
              <div class="mfoot">{foot.map(([h, l, ic]) => <a href={h}><Icon name={ic} size={16} />{l}</a>)}</div>
            </div>
          </div>
        ))}
        <a class="ni" href="/pricing" aria-current={cur('/pricing')}>Pricing</a>
        <a class="ni" href={contact.templates} target="_blank" rel="noopener">Templates<Icon name="arrow-up-right" size={12} /></a>
        <a class="ni" href="/contact" aria-current={cur('/contact')}>Contact</a>
      </nav>
      <div class="actions">
        <button class="ib-btn sound" id="sound-toggle" type="button" aria-label="Sound effects" aria-pressed="false" title="Sound effects"><Icon name="volume-x" size={18} class="off" /><Icon name="volume-2" size={18} class="onn" /></button>
        <button class="ib-btn" id="theme-toggle" type="button" aria-label="Switch light and dark" title="Light or dark"><Icon name="moon" size={18} class="moon" /><Icon name="sun" size={18} class="sun" /></button>
        <a class="book" href="/book">Book a call</a>
        <button class="burger" id="menu-open" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
          <span class="dots" aria-hidden="true">{Array.from({ length: 9 }).map(() => <i />)}</span>
          <Icon name="x" size={20} class="bx" />
        </button>
      </div>
    </div>
  </div>
  <div class="msheet" id="mobile-menu" hidden>
    <nav class="mbody" aria-label="Mobile">
      {menus.map(m => (
        <details class="mg">
          <summary>{m.label}<Icon name="chevron-down" size={20} class="chev" /></summary>
          <div class="msub">
            {m.cols.map(c => (<><p class="msh">{c.h}</p>{c.items.map(it => <a href={it.href} data-ask={it.ask ? '' : undefined}>{it.label}</a>)}</>))}
            {m.label === 'Services' && <a href="/services">All services</a>}
          </div>
        </details>
      ))}
      <a class="mrow" href="/pricing">Pricing<Icon name="arrow-right" size={18} /></a>
      <a class="mrow" href={contact.templates} target="_blank" rel="noopener">Templates<Icon name="arrow-up-right" size={18} /></a>
      <a class="mrow" href="/contact">Contact<Icon name="arrow-right" size={18} /></a>
    </nav>
    <div class="mfoot2"><a class="btn btn-primary" href="/book">Book a call</a></div>
  </div>
</header>
<script is:inline>
  (function(){
    var root=document.documentElement,hdr=document.getElementById('site-header');
    try{var t=localStorage.getItem('theme');if(t&&!root.dataset.force)root.dataset.theme=t}catch(e){}
    document.getElementById('theme-toggle')?.addEventListener('click',function(){var d=root.dataset.theme==='dark'?'light':'dark';root.dataset.theme=d;try{localStorage.setItem('theme',d)}catch(e){}});
    // mobile sheet: sits under the bar, fills the rest of the screen
    var b=document.getElementById('menu-open'),s=document.getElementById('mobile-menu');
    function place(){s.style.top=Math.max(0,hdr.getBoundingClientRect().bottom)+'px'}
    function ms(o){if(o)place();s.hidden=!o;root.classList.toggle('menu-open',o);b.setAttribute('aria-expanded',String(o));b.setAttribute('aria-label',o?'Close menu':'Open menu');document.body.style.overflow=o?'hidden':''}
    b?.addEventListener('click',function(){ms(s.hidden)});
    s?.addEventListener('click',function(e){if(e.target.closest('a'))ms(false)});
    window.addEventListener('resize',function(){if(!s.hidden){if(innerWidth>1099)ms(false);else place()}});
    // desktop mega menus
    var dds=[].slice.call(document.querySelectorAll('[data-dd]')),timer;
    function shut(d){d.classList.remove('open');d.querySelector('button').setAttribute('aria-expanded','false')}
    function close(except){dds.forEach(function(d){if(d!==except)shut(d)})}
    function open(d){close(d);d.classList.add('open');d.querySelector('button').setAttribute('aria-expanded','true')}
    dds.forEach(function(d){
      d.addEventListener('mouseenter',function(){clearTimeout(timer);open(d)});
      d.addEventListener('mouseleave',function(){timer=setTimeout(function(){shut(d)},140)});
      d.querySelector('button').addEventListener('click',function(){d.classList.contains('open')?close():open(d)});
      d.addEventListener('focusout',function(e){if(!d.contains(e.relatedTarget))shut(d)});
    });
    document.addEventListener('keydown',function(e){if(e.key==='Escape'){close();if(!s.hidden)ms(false)}});
    document.addEventListener('click',function(e){if(!e.target.closest('[data-dd]'))close()});
  })();
</script>
<style>
  /* the strip scrolls away, the bar sticks */
  .site-header{position:sticky;top:-32px;z-index:50}

  /* Announcement: 32 tall, near-black in both themes, slow soft sheen, hairline under */
  .announce{position:relative;overflow:hidden;display:flex;justify-content:center;align-items:center;gap:12px;height:32px;padding:4px 40px;background:#111111;border-bottom:1px solid rgba(245,245,245,.12);color:rgba(255,255,255,.75);font:400 14px/21px var(--font);text-decoration:none;white-space:nowrap}
  .announce::before{content:"";position:absolute;inset:0 auto 0 0;width:45%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.07) 45%,rgba(160,178,255,.08) 55%,transparent);transform:translateX(-110%);animation:sheen 9s ease-in-out infinite;pointer-events:none}
  @keyframes sheen{0%{transform:translateX(-110%)}60%,100%{transform:translateX(330%)}}
  .announce>*{position:relative}
  .announce:hover{color:#fff}.announce:hover .aa{transform:translateX(2px)}
  .aa{flex:none;transition:transform .15s}
  .new{background:#fff;color:#0A0E17;font:400 11px/16px var(--font);letter-spacing:.44px;padding:1px 8px;border-radius:2px}
  :global(:root[data-theme="dark"]) .announce{background:#1A1A1A}

  /* Bar: 74 + 1px hairline, 1280 container with 40 side padding */
  .bar{background:var(--bg);border-bottom:1px solid var(--rule)}
  .row{position:relative;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:24px;max-width:1280px;height:74px;margin:0 auto;padding:0 40px}
  .nav{display:flex;align-items:center;gap:4px}
  .row :global(.hl){justify-self:start}
  .ni{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 12px;border:0;border-radius:2px;background:none;color:var(--fg);font:500 14px/21px var(--font);text-decoration:none;cursor:pointer;white-space:nowrap;transition:background .15s}
  .ni:hover,.dd.open>.ni{background:var(--hover)}
  .ni[aria-current]{background:var(--hover)}
  .ni :global(svg){flex:none;color:var(--fg-2)}
  .ni :global(.pl){transition:transform .2s}.dd.open>.ni :global(.pl){transform:rotate(45deg)}
  .actions{display:flex;align-items:center;justify-content:flex-end;gap:8px}
  .ib-btn{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;border:0;padding:0;background:none;color:var(--fg-2);cursor:pointer;transition:background .15s,color .15s}
  .ib-btn:hover{background:var(--hover);color:var(--fg)}
  .book{display:inline-flex;align-items:center;justify-content:center;height:36px;padding:0 16px;margin-left:4px;background:var(--sig);color:#fff;font:500 14px/21px var(--font);border-radius:2px;text-decoration:none;white-space:nowrap}.book:hover{background:var(--sig-hover)}
  .sound :global(.onn){display:none}:global(:root[data-sound="on"]) .sound :global(.onn){display:block}:global(:root[data-sound="on"]) .sound :global(.off){display:none}
  #theme-toggle :global(.sun){display:none}:global(:root[data-theme="dark"]) #theme-toggle :global(.sun){display:block}:global(:root[data-theme="dark"]) #theme-toggle :global(.moon){display:none}
  .burger{display:none;position:relative;align-items:center;justify-content:center;width:40px;height:40px;border:0;padding:0;border-radius:2px;background:none;color:var(--fg);cursor:pointer}
  .burger:hover{background:var(--hover)}
  .dots{display:grid;grid-template-columns:repeat(3,3px);gap:3px}
  .dots i{width:3px;height:3px;border-radius:50%;background:currentColor}
  .burger :global(.bx){display:none}
  .burger[aria-expanded="true"] .dots{display:none}.burger[aria-expanded="true"] :global(.bx){display:block}

  /* Mega menu: 1200 panel under the bar, page colour, hairline border, equal columns */
  .mega{position:absolute;top:100%;left:40px;right:40px;background:var(--bg);border:1px solid var(--rule);box-shadow:0 12px 24px -16px rgba(0,0,0,.12);opacity:0;visibility:hidden;transform:translateY(-4px);transition:opacity .14s,transform .14s,visibility 0s .14s}
  .dd.open .mega{opacity:1;visibility:visible;transform:none;transition:opacity .14s,transform .14s}
  .mtop{display:grid;grid-auto-flow:column;grid-auto-columns:1fr}
  .col{display:flex;flex-direction:column;min-width:0;border-left:1px solid var(--rule)}
  .col:first-child{border-left:0}
  .mh{display:flex;align-items:center;height:42px;padding:12px 16px;margin:0;border-bottom:1px solid var(--rule);font:400 11px/14px var(--font);letter-spacing:.44px;text-transform:uppercase;color:var(--fg-3)}
  .ml{display:flex;flex-direction:column;padding:4px 0}
  .mi{display:flex;align-items:center;gap:12px;height:44px;padding:8px 16px;color:var(--fg);text-decoration:none;font:500 16px/24px var(--font);transition:background .12s}
  .mi:hover,.mi:focus-visible{background:var(--hover)}
  .mi[aria-current] .mt{text-decoration:underline;text-underline-offset:3px;text-decoration-color:var(--rule-2)}
  .ib{flex:none;display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border:1px solid var(--rule);background:var(--bg);color:var(--fg-3)}
  .mt{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .mi :global(.ma){flex:none;color:var(--fg-2);opacity:0;transform:translateX(-3px);transition:opacity .12s,transform .12s}
  .mi:hover :global(.ma),.mi:focus-visible :global(.ma){opacity:1;transform:none}
  .feat .fm{display:block;height:224px;overflow:hidden;background:var(--surface)}
  .feat .ml{padding:0 0 4px}
  .feat .fm img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .4s}
  .feat:hover .fm img{transform:scale(1.02)}
  .mfoot{display:flex;padding:4px 0;border-top:1px solid var(--rule)}
  .mfoot a{flex:1;display:flex;align-items:center;justify-content:center;gap:8px;height:38px;padding:0 16px;color:var(--fg);font:500 14px/21px var(--font);text-decoration:none;transition:background .12s}
  .mfoot a :global(svg){color:var(--fg-3)}
  .mfoot a:hover{background:var(--hover)}

  /* Mobile sheet: under the bar, simple groups, Book a call pinned */
  .msheet{position:fixed;left:0;right:0;bottom:0;top:99px;z-index:49;display:flex;flex-direction:column;background:var(--bg)}
  .msheet[hidden]{display:none}
  .mbody{flex:1;overflow:auto;padding:8px 16px 16px;-webkit-overflow-scrolling:touch}
  .mg{border-bottom:1px solid var(--rule)}
  .mg summary,.mrow{display:flex;justify-content:space-between;align-items:center;height:56px;color:var(--fg);font:500 20px/28px var(--font);letter-spacing:-.2px;text-decoration:none;list-style:none;cursor:pointer}
  .mg summary::-webkit-details-marker{display:none}
  .mg summary :global(.chev),.mrow :global(svg){color:var(--fg-3);transition:transform .2s}
  .mg[open] summary :global(.chev){transform:rotate(180deg)}
  .mrow{border-bottom:1px solid var(--rule)}
  .msub{display:flex;flex-direction:column;padding:0 0 12px}
  .msh{margin:16px 0 4px;font:500 11px/14.3px var(--font);letter-spacing:.66px;text-transform:uppercase;color:var(--fg-3)}
  .msh:first-child{margin-top:0}
  .msub a{display:flex;align-items:center;height:40px;color:var(--fg-2);font:400 16px/24px var(--font);text-decoration:none}
  .msub a:hover{color:var(--fg)}
  .mfoot2{padding:12px 16px calc(16px + env(safe-area-inset-bottom));border-top:1px solid var(--rule);background:var(--bg)}
  .mfoot2 .btn{width:100%}

  @media (max-width:1279px){.row{grid-template-columns:auto 1fr auto}.ni{padding:0 10px}.nav{gap:0}}
  @media (max-width:1099px){
    .nav,.book{display:none}
    .burger{display:inline-flex}
    .row{grid-template-columns:auto 1fr;height:66px;padding:0 16px}
    .actions{gap:4px}
    .row :global(.hl .logo-t){display:none}
    .row :global(.hl){height:auto}.row :global(.hl .logo-m){width:28px;height:20px}
  }
  @media (max-width:767px){
    .announce{padding:4px 16px;gap:8px;font-size:13px}
    .at-l{display:none}
  }
  @media (prefers-reduced-motion:reduce){.announce::before{animation:none;display:none}}
</style>
