---
// Figma "tool hero (light streak drifts)": dark band with two blurred light streaks.
interface Props { label: string; title: string; text: string; class?: string }
const { label, title, text, class: cls = '' } = Astro.props;
---
<section class:list={['th', cls]}>
  <span class="s1" aria-hidden="true"></span><span class="s2" aria-hidden="true"></span>
  <div class="in">
    <p class="lb">{label}</p>
    <h1 set:html={title} />
    <p class="tx">{text}</p>
  </div>
</section>
<style>
  .th{position:relative;overflow:hidden;background:#05070C;padding:64px 16px 120px;text-align:center;isolation:isolate}
  .s1,.s2{position:absolute;border-radius:50%;filter:blur(120px);z-index:-1;pointer-events:none}
  .s1{left:calc(50% - 956px);top:180px;width:1900px;height:260px;background:rgba(59,91,255,.55);animation:drift 18s ease-in-out infinite alternate}
  .s2{left:calc(50% - 541px);top:250px;width:1400px;height:200px;background:rgba(37,77,127,.8);animation:drift 24s ease-in-out infinite alternate-reverse}
  @keyframes drift{from{transform:translateX(-40px)}to{transform:translateX(40px)}}
  @media (prefers-reduced-motion:reduce){.s1,.s2{animation:none}}
  .in{max-width:680px;margin:0 auto;display:grid;gap:18px;justify-items:center}
  .lb{margin:0;font:400 11px/14px var(--mono);letter-spacing:.06em;text-transform:uppercase;color:#9AA3B2}
  h1{margin:0;font-size:56px;line-height:1.05;letter-spacing:-.02em;font-weight:600;color:#F4F6FA}
  .tx{margin:0;font-size:17px;line-height:1.5;color:#B9C1CF}
  @media (max-width:1023px){
    .th{padding:35px 16px 66px}.in{gap:18px}
    .s1{top:150px}.s2{top:200px}
    h1{font-size:30px;line-height:1.06;letter-spacing:-.015em}h1 :global(br){display:block}
    .tx{font-size:15px}
  }
</style>
