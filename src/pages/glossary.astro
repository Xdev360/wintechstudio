---
import Page from '../layouts/Page.astro';
import SRelated from '../components/search/SRelated.astro';
import '../components/search/search.css';
const terms: [string, string][] = [['AEO', 'Answer engine optimisation. Writing and structuring pages so AI tools like ChatGPT can find and quote them.'], ['Brand guideline', 'A file that shows how to use your logo, colours, fonts and tone, so everyone uses them the same way.'], ['CMS', 'A content management system. The place you edit words, photos and prices without touching code.'], ['Domain', 'Your address on the internet, like wintechstudio.com. You rent it yearly and it should be in your name.'], ['Hosting', 'The computer that serves your site to visitors. Fast hosting means pages open quickly on mobile data.'], ['Landing page', 'A single page built for one goal, like signing up or booking a call.'], ['MVP', 'Minimum viable product. The smallest version of an app that real people can use and pay for.'], ['Payment gateway', 'The service that takes card, bank transfer and USSD payments on your site and sends the money to your bank. Paystack and Flutterwave are the common ones in Nigeria.'], ['SEO', 'Search engine optimisation. Making pages that Google understands and shows for the right searches.'], ['USSD checkout', 'Paying by dialling a short code on any phone, no internet or card needed.'], ['WhatsApp Business API', 'The official way to connect WhatsApp to software, so an assistant can reply and take orders for you.']];
const id = (s: string) => s.toLowerCase().replace(/\W+/g, '-');
const letters = [...new Set(terms.map(t => t[0][0]))];
const ld = { '@context': 'https://schema.org', '@type': 'DefinedTermSet', name: 'Wintech Studio glossary', hasDefinedTerm: terms.map(([n, d]) => ({ '@type': 'DefinedTerm', name: n, description: d, url: `https://www.wintechstudio.com/glossary#${id(n)}` })) };
---
<Page title="Website and AI glossary in plain English · Wintech Studio" description="Plain-English definitions of website and AI words: AEO, CMS, domain, hosting, MVP, payment gateway, SEO, USSD checkout and more." crumbs={[['Glossary', '/glossary']]} jsonld={[ld]} closing={false}>
  <div class="dm">
  <section class="dm-top gl">
    <div class="wrap">
      <div class="dm-head"><p class="dm-eb">Glossary</p><h1 class="dm-h1">Website and AI words, in plain English</h1></div>
      <nav class="az" aria-label="Jump to letter">{letters.map((l, i) => <a href={`#${id(terms.find(t => t[0][0] === l)![0])}`} class:list={{ on: i === 0 }} data-l={l}>{l}</a>)}</nav>
      <dl>{terms.map(([n, d]) => <div id={id(n)} data-l={n[0]}><dt>{n}</dt><dd>{d}</dd></div>)}</dl>
    </div>
  </section>
  </div>
  <SRelated items={[['Guide · Payments', 'How to take Paystack payments on your website in Nigeria', '/guides/paystack-payments-on-your-website'], ['Compare', 'Custom website or Wintech Templates', '/compare/custom-website-vs-wintech-templates'], ['Industry', 'Websites and AI for salons in Lagos', '/industries/salons']]} />
</Page>
<script is:inline>
(function(){var as=document.querySelectorAll('.az a');as.forEach(function(a){a.addEventListener('click',function(){as.forEach(function(x){x.classList.toggle('on',x===a)})})});
  if(!('IntersectionObserver'in window))return;var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){var l=e.target.dataset.l;as.forEach(function(x){x.classList.toggle('on',x.dataset.l===l)})}})},{rootMargin:'-35% 0px -60% 0px'});
  document.querySelectorAll('dl > div').forEach(function(d){io.observe(d)})})();
</script>
<style>
  .gl{padding-bottom:128px}
  .az{display:flex;flex-wrap:wrap;gap:6px;margin:40px 0}
  .az a{display:grid;place-items:center;min-width:32px;height:32px;padding:0 10px;border:1px solid var(--hl);border-radius:2px;color:var(--fg);font-size:14px;font-weight:500;text-decoration:none}
  .az a:hover{border-color:var(--hl2)}
  .az a.on{background:var(--fg);border-color:var(--fg);color:var(--bg)}
  dl{margin:0}
  dl>div{display:grid;grid-template-columns:280px minmax(0,672px);gap:48px;padding:20px 0;border-top:1px solid var(--hl);scroll-margin-top:110px}
  dt{font-size:20px;font-weight:600;line-height:26px;letter-spacing:-.2px}
  dd{margin:0;font-size:16px;line-height:24px;color:var(--mute)}
  @media (max-width:1023px){
    .gl{padding-bottom:64px}
    .az{margin:24px 0}
    dl>div{grid-template-columns:1fr;gap:4px;padding:16px 0}
    dt{font-size:17px;line-height:24px}dd{font-size:15px;line-height:22px}
  }
</style>
