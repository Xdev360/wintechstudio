---
import Page from '../layouts/Page.astro';
import Faq from '../components/ui/Faq.astro';
import Icon from '../components/Icon.astro';
import services from '../data/services.json';
import '../styles/studio.css';

const aiNgnMo = services.find(s => s.slug === 'ai-assistant')!.priceNgn.split(' + ')[1].replace('/mo', '');
const cards = [
  { name: 'AI care plan', price: '$60', ngn: aiNgnMo, per: '/mo', desc: 'For every AI assistant we build.', items: ['Retraining when products change', 'Monthly report: chats, orders, questions', 'Fixes within one working day', 'Hosting and model costs included'] },
  { name: 'Growth and content', price: '$600', per: '/mo', desc: '3 month minimum. Posts, films and campaigns.', items: ['12 posts and 2 short films a month', 'Captions and posting calendar', 'Monthly results call', 'Ads support, budget separate'], dark: true },
  { name: 'Run it for you', price: 'Custom', per: '', desc: 'For owners who want the whole system handled.', items: ['Store, AI, automation and content', 'One project lead, weekly check in', 'Priority on new features', 'Quoted after the diagnostic'] },
];
const faqs: [string, string][] = [
  ['Can I pause?', 'Yes, one month at a time. The AI care plan keeps running while content pauses.'],
  ['Do I need a build first?', 'For the AI care plan, yes: it looks after an AI assistant we built. For the other plans, tell us what you run on a call and we will say what you need first.'],
  ['Who owns the content?', 'You do. Accounts stay in your name, and the posts, films and files we make for you are yours once paid.'],
];
const ld = { '@context': 'https://schema.org', '@type': 'OfferCatalog', name: 'Wintech Studio monthly plans', itemListElement: cards.filter(c => c.price !== 'Custom').map(c => ({ '@type': 'Offer', name: c.name, price: c.price.replace('$', ''), priceCurrency: 'USD', description: c.desc })) };
---
<Page title="Monthly plans · Wintech Studio" description="AI care plan $60 a month, growth and content $600 a month, or have the whole system run for you. Pause for a month when it is quiet, cancel with 30 days notice." crumbs={[['Pricing', '/pricing'], ['Monthly plans', '/monthly-plans']]} jsonld={[ld]}>
  <div class="sp mp">
    <section class="hero">
      <div class="wrap">
        <div class="hd c">
          <p class="eb">Monthly plans</p>
          <h1 class="t1">We keep it running<br /><span class="gt">after launch.</span></h1>
          <p class="ld">A system needs care. Pick a plan, pause for a month when it is quiet, cancel with 30 days notice.</p>
        </div>
      </div>
    </section>
    <section class="plans-s">
      <div class="wrap plans">{cards.map(c => (
        <div class:list={['plan', { ink: c.dark }]}>
          <p class="pl-eb">{c.name}</p>
          <p class="pl-p"><span>{c.price}</span>{c.per && <small>{c.per}</small>}</p>
          <p class="pl-d">{c.desc}</p>
          <ul class="ticks">{c.items.map(t => <li><Icon name="check" size={16} stroke={1.75} />{t}</li>)}</ul>
          <a class:list={['btn', c.dark ? 'btn-primary' : 'btn-dark']} href="/book">Book a call</a>
        </div>
      ))}</div>
    </section>
    <Faq items={faqs} title="Plan questions" />
  </div>
</Page>
<style>
  .hero{padding-bottom:56px}
  .plans-s{padding:24px 0 112px}
  .plans{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;align-items:start}
  .plan{background:var(--surface);padding:32px;display:flex;flex-direction:column;gap:18px}
  .pl-eb{font-family:var(--mono);font-size:11px;line-height:14px;letter-spacing:.06em;text-transform:uppercase;color:var(--sig);margin:0}
  .pl-p{display:flex;align-items:baseline;gap:4px;margin:0;font-size:48px;line-height:58px;font-weight:600;letter-spacing:-.02em;color:var(--fg)}
  .pl-p small{font-size:17px;line-height:20px;font-weight:400;letter-spacing:0;color:var(--fg-2)}
  .pl-d{font-size:15px;line-height:1.5;color:var(--fg-2);margin:0;max-width:300px}
  .plan .btn{width:100%}
  .plan.ink{background:var(--inkc)}
  .plan.ink .pl-eb{color:var(--inkc-eb)}
  .plan.ink .pl-p{color:#fff}.plan.ink .pl-p small,.plan.ink .pl-d{color:var(--inkc-2)}
  .plan.ink .ticks li{color:#fff}.plan.ink .ticks :global(svg){color:var(--inkc-eb)}
  :root[data-theme="dark"] .plan:not(.ink){background:var(--card);border:1px solid var(--rule)}
  :root[data-theme="dark"] .plan.ink{border:1px solid #2A3550}
  @media (max-width:1023px){
    .hero{padding-bottom:0}
    .plans-s{padding:28px 0 56px}
    .plans{grid-template-columns:1fr}
    .plan{padding:24px}
    .pl-p{font-size:40px;line-height:48px}
  }
</style>
