---
import Page from '../layouts/Page.astro';
import Faq from '../components/ui/Faq.astro';
import Lc from '../components/ui/Lc.astro';
import services from '../data/services.json';
import '../styles/studio.css';

const aiNgnMo = services.find(s => s.slug === 'ai-assistant')!.priceNgn.split(' + ')[1].replace('/mo', '');
const cards = [
  { name: 'AI care plan', price: '$60', ngn: aiNgnMo, per: '/mo', desc: 'For every AI assistant we build.', items: ['Retraining when products change', 'Monthly report: chats, orders, questions', 'Fixes within one working day', 'Hosting and model costs included'] },
  { name: 'Growth and content', price: '$600', per: '/mo', desc: '3 month minimum. Posts, films and campaigns.', items: ['12 posts and 2 short films a month', 'Captions and posting calendar', 'Monthly results call', 'Ads support, budget separate'], dark: true },
  { name: 'Run it for you', price: 'Custom', per: '', desc: 'For owners who want the whole system handled.', items: ['Store, AI, automation and content', 'One project lead, weekly check in', 'Priority on new features', 'Quoted after the diagnostic'] },
];
const faqs: [string, string][] = [
  ['Can I pause?', 'Yes, one month at a time. The AI care plan keeps running while content pauses.'],
  ['Do I need a build first?', 'For the AI care plan, yes: it looks after an AI assistant we built. For the other plans, tell us what you run on a call and we will say what you need first.'],
  ['Who owns the content?', 'You do. Accounts stay in your name, and the posts, films and files we make for you are yours once paid.'],
];
const ld = { '@context': 'https://schema.org', '@type': 'OfferCatalog', name: 'Wintech Studio monthly plans', itemListElement: cards.filter(c => c.price !== 'Custom').map(c => ({ '@type': 'Offer', name: c.name, price: c.price.replace('$', ''), priceCurrency: 'USD', description: c.desc })) };
---
<Page title="Monthly plans · Wintech Studio" description="AI care plan $60 a month, growth and content $600 a month, or have the whole system run for you. Pause for a month when it is quiet, cancel with 30 days notice." crumbs={[['Pricing', '/pricing'], ['Monthly plans', '/monthly-plans']]} jsonld={[ld]}>
  <div class="dm mp">
    <section class="dm-top">
      <div class="wrap">
        <div class="dm-head c">
          <p class="dm-eb">Monthly plans</p>
          <h1 class="dm-h1">We keep it running after launch.</h1>
          <p class="dm-intro">A system needs care. Pick a plan, pause for a month when it is quiet, cancel with 30 days notice.</p>
        </div>
      </div>
    </section>
    <section class="dm-sec flush">
      <div class="wrap dm-grid g3 plans">{cards.map(c => (
        <div class:list={['dm-card', 'plan', { hi: c.dark }]}>
          <div class="pl-top"><p class="dm-eb">{c.name}</p>{c.dark && <span class="dm-tag b">Most picked</span>}</div>
          <p class="pl-p"><span>{c.price}</span>{c.per && <small>{c.per}</small>}</p>
          <p class="dm-body">{c.desc}</p>
          <ul class="dm-ticks">{c.items.map(t => <li><Lc name="check" />{t}</li>)}</ul>
          <a class:list={['dm-btn', 'w', c.dark ? 'p' : 's']} href="/book">Book a call</a>
        </div>
      ))}</div>
    </section>
  </div>
  <Faq items={faqs} title="Plan questions" />
</Page>
<style>
  .plans{align-items:stretch}
  .plan{padding:32px;gap:16px}
  .plan.hi{border-color:var(--fg)}
  .pl-top{display:flex;justify-content:space-between;align-items:center;min-height:29px}
  .pl-p{display:flex;align-items:baseline;gap:4px;font-size:56px;line-height:64.4px;font-weight:600;letter-spacing:-1.12px}
  .pl-p small{font-size:16px;line-height:24px;font-weight:400;letter-spacing:0;color:var(--mute)}
  .plan .dm-ticks{margin-bottom:8px}
  .plan .dm-btn{margin-top:auto}
  @media (max-width:1023px){
    .plan{padding:20px}
    .pl-p{font-size:36px;line-height:41.4px;letter-spacing:-.72px}
  }
</style>
