---
import Page from '../../layouts/Page.astro';
import Lc from '../../components/ui/Lc.astro';
import '../../components/search/search.css';
// Layout from Figma I1 (Insights). Only pages that exist are listed.
const posts = [
  { href: '/guides/paystack-payments-on-your-website', cat: 'Payments', min: '6 min read', t: 'How to take Paystack payments on your website in Nigeria', d: 'Open an account, verify the business, add checkout and test before you go live. Card, bank transfer and USSD.' },
  { href: '/compare/custom-website-vs-wintech-templates', cat: 'Compare', min: '4 min', t: 'Custom website or Wintech Templates: which one fits?' },
  { href: '/industries/salons', cat: 'Industries', min: '4 min', t: 'Websites and AI for salons in Lagos' },
  { href: '/glossary', cat: 'Glossary', min: '3 min', t: 'Website and AI words, in plain English' },
];
const icons: Record<string, string> = { Payments: 'banknote', Compare: 'layout', Industries: 'scissors', Glossary: 'book' };
const cats = ['All', ...new Set(posts.map(p => p.cat))];
const [lead, ...rest] = posts;
---
<Page title="Guides · Plain answers for owners and founders · Wintech Studio" description="Plain-English guides for business owners in Nigeria: taking payments, choosing a website, AI for your industry and the words you will hear." crumbs={[['Guides', '/guides']]}>
  <div class="dm">
  <section class="dm-top">
    <div class="wrap">
      <div class="dm-head c">
        <p class="dm-eb">Guides</p>
        <h1 class="dm-h1">Plain answers for owners and founders.</h1>
        <p class="dm-intro">What to set up, what to pick and what the words mean. Written by the studio.</p>
      </div>
      <div class="dm-chips fchips" role="group" aria-label="Filter guides">{cats.map((c, i) => <button type="button" class="dm-chip" data-c={c} aria-pressed={i === 0 ? 'true' : 'false'}>{c}</button>)}</div>
    </div>
  </section>
  <section class="dm-sec flush">
    <div class="wrap">
      <a class="feat post" href={lead.href} data-c={lead.cat}>
        <div class="dm-media cover big" data-todo-image="823:6026" aria-hidden="true"><span class="dm-ib s36"><Lc name={icons[lead.cat]} size={18} /></span></div>
        <div class="ft"><div class="meta"><span class="dm-tag">{lead.cat}</span><span class="mn">{lead.min}</span></div><h2 class="dm-h2s">{lead.t}</h2><p class="dm-body">{lead.d}</p><span class="dm-link">Read the guide</span></div>
      </a>
      <div class="dm-grid g3 pg">{rest.map(p => (
        <a class="post card" href={p.href} data-c={p.cat}>
          <div class="dm-media cover" data-todo-image="823:6040" aria-hidden="true"><span class="dm-ib s36"><Lc name={icons[p.cat]} size={18} /></span></div>
          <div class="meta"><span class="dm-tag">{p.cat}</span><span class="mn">{p.min}</span></div>
          <div class="tt"><h3 class="dm-h3">{p.t}</h3><span class="dm-arrow"><Lc name="arrow-up-right" /></span></div>
        </a>
      ))}</div>
    </div>
  </section>
  </div>
</Page>
<script is:inline>
(function(){var bs=document.querySelectorAll('.fchips button');bs.forEach(function(b){b.onclick=function(){bs.forEach(function(x){x.setAttribute('aria-pressed',x===b)});var c=b.dataset.c;document.querySelectorAll('.post').forEach(function(p){p.hidden=c!=='All'&&p.dataset.c!==c})}})})();
</script>
<style>
  .fchips{justify-content:center}
  .post{text-decoration:none;color:var(--fg)}.post[hidden]{display:none}
  .cover{display:grid;place-items:center;aspect-ratio:4/3}
  .feat{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px;align-items:center;border:1px solid var(--hl);padding:8px;margin-bottom:20px;transition:border-color .15s}
  .feat .cover{aspect-ratio:16/10}
  .ft{display:flex;flex-direction:column;gap:16px;padding:24px 32px 24px 0}
  .meta{display:flex;align-items:center;gap:12px}
  .mn{font-size:13px;line-height:18px;color:var(--lab)}
  .card{display:flex;flex-direction:column;border:1px solid var(--hl);padding:8px;transition:border-color .15s}
  .card .meta{padding:12px 8px;border-bottom:1px solid var(--hl)}
  .tt{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;padding:12px 8px 8px}
  .feat:hover,.card:hover{border-color:var(--hl2)}
  .post:hover h2,.post:hover h3{color:var(--sig)}
  @media (max-width:1023px){
    .fchips{justify-content:flex-start}
    .feat{grid-template-columns:1fr;gap:0}
    .ft{padding:16px 8px 8px;gap:12px}
    .feat .cover{aspect-ratio:4/3}
  }
</style>
