---
import Page from '../../layouts/Page.astro';
import SFaq from '../../components/search/SFaq.astro';
import SRelated from '../../components/search/SRelated.astro';
import '../../components/search/search.css';
const title = "How to choose a web designer in Lagos";
const steps: [string, string][] = [["Look at live sites, not screenshots", "Ask for links to sites that are live today. Open them on your phone, on data, not Wi-Fi."], ["Check they show up on Google", "Search the business name of their clients. A good site appears, with the right title and description."], ["Ask who owns what", "The domain, hosting and logins should be in your name, not the designer's."], ["Get the price in writing", "A clear quote lists pages, features, timeline, payments and what happens after launch."], ["Ask about after launch", "Who fixes bugs, how fast, and what updates cost. Free fixes for a period is a good sign."], ["Meet the person doing the work", "On a call you learn more in 20 minutes than from any portfolio."]];
const toc = [["short", "Short answer"], ["steps", "The checklist"], ["flags", "Red flags to walk away from"], ["wintech", "How we work at Wintech Studio"], ["questions", "Questions"]];
const faqs: [string, string][] = [["Should I hire a freelancer or an agency?", "A freelancer can be great for a small site. A studio is better when you need brand, website and integrations to work together, with someone accountable after launch."], ["How much should I pay?", "It depends on pages, selling online and your brand. Our guide on website costs in Nigeria breaks it down."], ["Can a designer guarantee I rank first on Google?", "No. A good designer builds the site so Google can read it. Ranking also depends on content, reviews and links over time."]];
const ld = [{"@context": "https://schema.org", "@type": "Article", "headline": "How to choose a web designer in Lagos", "description": "A checklist for picking a web designer or agency in Lagos: live work, speed on a phone, Google, ownership of your site, and the red flags to walk away from.", "datePublished": "2026-11-17", "dateModified": "2026-11-17", "author": {"@type": "Person", "name": "Oladele Ibraheem"}, "publisher": {"@type": "Organization", "name": "Wintech Studio", "logo": {"@type": "ImageObject", "url": "https://www.wintechstudio.com/icon-512.png"}}, "mainEntityOfPage": "https://www.wintechstudio.com/guides/choose-a-web-designer-in-lagos"}, {"@context": "https://schema.org", "@type": "HowTo", "name": "How to choose a web designer in Lagos", "step": [{"@type": "HowToStep", "position": 1, "name": "Look at live sites, not screenshots", "text": "Ask for links to sites that are live today. Open them on your phone, on data, not Wi-Fi."}, {"@type": "HowToStep", "position": 2, "name": "Check they show up on Google", "text": "Search the business name of their clients. A good site appears, with the right title and description."}, {"@type": "HowToStep", "position": 3, "name": "Ask who owns what", "text": "The domain, hosting and logins should be in your name, not the designer's."}, {"@type": "HowToStep", "position": 4, "name": "Get the price in writing", "text": "A clear quote lists pages, features, timeline, payments and what happens after launch."}, {"@type": "HowToStep", "position": 5, "name": "Ask about after launch", "text": "Who fixes bugs, how fast, and what updates cost. Free fixes for a period is a good sign."}, {"@type": "HowToStep", "position": 6, "name": "Meet the person doing the work", "text": "On a call you learn more in 20 minutes than from any portfolio."}]}];
---
<Page title={`${title} · Wintech Studio`} description="A checklist for picking a web designer or agency in Lagos: live work, speed on a phone, Google, ownership of your site, and the red flags to walk away from." crumbs={[['Guides', '/guides'], ["Hiring", '/guides/choose-a-web-designer-in-lagos']]} jsonld={ld} closing={false}>
  <div class="dm">
  <section class="dm-top art">
    <div class="wrap ag">
      <article>
        <div class="dm-head"><p class="dm-eb">Guide · Hiring</p><h1 class="dm-h1 sm">{title}</h1>
        <p class="meta"><span>Updated 17 Nov 2026</span><i>·</i><span>6 min read</span><i>·</i><b>By Oladele Ibraheem</b></p></div>
        <div class="dm-short" id="short"><p class="dm-eb">Short answer</p><p>Pick the designer whose live sites load fast on a phone, show up on Google and still work months after launch. Make sure the domain and logins are in your name, the price is written down with what it includes, and you know who fixes things after launch.</p></div>
        <h2 id="steps">The checklist</h2>
        <ol class="steps">{steps.map(([n, t], i) => <li><span class="num">{i + 1}</span><div><h3>{n}</h3><p>{t}</p></div></li>)}</ol>
        <h2 id="flags">Red flags to walk away from</h2>
        <Fragment set:html={`<ul><li>No live links, only images.</li><li>The domain will be registered in the designer's name.</li><li>The full payment is due before any design is shown.</li><li>No mention of speed, Google or how you will edit the site.</li><li>Promises like "number one on Google in a week". Nobody can promise that.</li></ul>`} />
        <h2 id="wintech">How we work at Wintech Studio</h2>
        <Fragment set:html={`<p>We start by studying how your customers find you and where they drop off, then design and build around that. You pay in parts tied to milestones, you own everything, and every site is built to be fast on Nigerian mobile data. You can see live work on our <a href="/work">work page</a>.</p>`} />
      </article>
      <aside class="dm-sticky">
        <nav class="dm-toc toc" aria-label="On this page"><p class="dm-eb">On this page</p>{toc.map(([h, t]) => <a href={`#${h}`} data-to={h}>{t}</a>)}</nav>
        <div class="cta"><h3>Want to see if we fit?</h3><p>Book a 25 minute call with the project lead. Bring your questions from this list.</p><a class="dm-btn p mw" href="/book">Book a call</a></div>
      </aside>
    </div>
  </section>
  </div>
  <SFaq items={faqs} />
  <SRelated items={[["Pricing", "How much does a website cost in Nigeria?", "/guides/website-cost-nigeria"], ["Guide", "Do I need a website if I sell on Instagram?", "/guides/website-or-instagram"], ["Work", "See live sites we built", "/work"]]} />
</Page>
<script is:inline>
(function(){var links=document.querySelectorAll('.toc a');if(!('IntersectionObserver'in window))return;var on=function(id){links.forEach(function(a){a.classList.toggle('on',a.dataset.to===id)})};
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting)on(e.target.id)})},{rootMargin:'-30% 0px -60% 0px'});
  links.forEach(function(a){var t=document.getElementById(a.dataset.to);if(t)io.observe(t)});on('short')})();
</script>
<style>
  .art{padding-bottom:128px}
  .ag{display:grid;grid-template-columns:minmax(0,720px) 320px;justify-content:space-between;gap:64px;align-items:start}
  article{display:flex;flex-direction:column}
  .meta{display:flex;flex-wrap:wrap;gap:8px;font-size:14px;line-height:21px;color:var(--mute)}
  .meta i{font-style:normal;color:var(--lab)}.meta b{font-weight:500;color:var(--fg)}
  .dm-short{margin-top:40px}
  .dm-short,h2{scroll-margin-top:110px}
  h2{margin:48px 0 12px;font-size:24px;line-height:31.2px;letter-spacing:-.24px}
  article>p{font-size:16px;line-height:26px;color:var(--mute)}
  .steps{list-style:none;margin:0;padding:0;border-top:1px solid var(--hl)}
  .steps li{display:flex;gap:16px;padding:16px 0;border-bottom:1px solid var(--hl)}
  .num{flex:none;width:28px;height:28px;display:grid;place-items:center;border:1px solid var(--hl);font-size:13px;font-weight:600}
  .steps h3{font-size:16px;line-height:24px;font-weight:600;margin-top:2px}
  .steps p{font-size:16px;line-height:24px;color:var(--mute)}
  aside{display:flex;flex-direction:column;gap:32px;padding-top:8px}
  .toc{gap:0}.toc .dm-eb{padding:0 0 8px 16px}
  .cta{display:flex;flex-direction:column;align-items:flex-start;gap:12px;padding:24px;background:var(--panel)}
  .cta h3{font-size:20px;line-height:26px;letter-spacing:-.2px}
  .cta p{font-size:14px;line-height:21px;color:var(--mute)}
  @media (max-width:1023px){
    .art{padding-bottom:64px}
    .ag{grid-template-columns:1fr;gap:32px}
    .dm-short{margin-top:24px}
    h2{margin:32px 0 8px;font-size:20px;line-height:26px}
    article>p{font-size:15px;line-height:24px}
    .steps p{font-size:15px;line-height:22px}
    .toc{display:none}
    .cta{padding:20px 16px}
  }
</style>
<style>
  article :global(p){font-size:16px;line-height:26px;color:var(--mute);margin:0 0 14px}
  article :global(p b),article :global(li b){color:var(--fg);font-weight:600}
  article :global(ul){margin:0 0 14px;padding-left:20px;display:flex;flex-direction:column;gap:8px}
  article :global(li){font-size:16px;line-height:26px;color:var(--mute)}
  article :global(a){color:var(--sig)}
</style>
