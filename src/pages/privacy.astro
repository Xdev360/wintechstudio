---
import Legal from '../components/ui/Legal.astro';
---
<Legal title="Privacy policy" path="/privacy" description="What Wintech Studio collects, how we use it and how to ask for a copy, a correction or deletion." clauses={[
  ['What we collect', 'Your name, email or WhatsApp, business details, the picks you tick in a brief, and anything you send through the contact form, booking page or Wintech AI. Analytics only if you allow cookies.'],
  ['Briefs and picks', 'Your picks are saved in your browser as you tick. They reach us only when you send the brief or book a call. Forms on this site open WhatsApp or your email app with your message ready; nothing is sent until you press send.'],
  ['How we use it', 'To reply, prepare for your call, send a proposal and run the work you hire us for. We do not sell your data.'],
  ['Wintech AI', 'The assistant answers from this website. Conversations may be stored to improve answers. Do not share payment details in chat.'],
  ['Your rights', 'Ask for a copy, a correction or deletion at hello@wintechstudio.com.'],
]} />
