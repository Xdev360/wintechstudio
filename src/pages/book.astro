---
import Page from '../layouts/Page.astro';
import Lc from '../components/ui/Lc.astro';
import '../styles/studio.css';
import { services } from '../data/site';
const names = Object.fromEntries([...services.map(s => [s.slug, s.name]), ['plan', 'Project plan'], ['diagnostic', 'Paid diagnostic ($200)']]);
const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
const times = ['10:00', '11:30', '13:00', '15:00', '16:30'];
const expect = [['clock', '25 minutes', 'We read your brief before the call.'], ['user', 'With the project lead', 'The person who would run your project.'], ['check', 'One next step', 'The diagnostic, a proposal or a quick job.']];
---
<Page title="Book a call · Wintech Studio" description="Pick a time for a 25 minute call with the Wintech project lead. Your brief comes with you, so the call goes on your business, not on questions." crumbs={[['Book a call', '/book']]} closing={false}>
  <div class="dm">
  <section class="dm-top bk">
    <div class="wrap">
      <div class="dm-head">
        <p class="dm-eb">Book a 25 minute call</p>
        <h1 class="dm-h1">Pick a time. Your brief comes with you.</h1>
        <p class="dm-intro">The project lead reads your picks before the call, so the 25 minutes go on your business, not on questions.</p>
      </div>
      <form class="grid" id="bk" data-send="Call request from wintechstudio.com">
        <div class="cal">
          <div class="mg">
            <div class="mh"><h2 id="mlabel">-</h2><button type="button" class="nav dm-ib" id="prev" aria-label="Previous month"><Lc name="chevron-left" /></button><button type="button" class="nav dm-ib" id="next" aria-label="Next month"><Lc name="chevron-right" /></button></div>
            <div class="wd">{days.map(d => <span>{d}</span>)}</div>
            <div class="days" id="days" role="grid" aria-label="Pick a day"></div>
            <p class="tz"><Lc name="globe" />Africa/Lagos (WAT)</p>
          </div>
          <div class="strip" id="strip" aria-label="Pick a day"></div>
          <div class="times">
            <p class="dl" id="dlabel">Pick a day</p>
            <div class="tl" id="times">{times.map(t => <button type="button" data-t={t} aria-pressed="false" disabled>{t}</button>)}</div>
          </div>
        </div>
        <div class="brief">
          <div class="bh"><span class="bt"><span class="dm-ib s28"><Lc name="file" /></span><span id="btitle">Your brief</span></span><span class="dm-tag att" id="att" hidden>Attached</span></div>
          <div id="rows"></div>
          <div class="pick" id="pick" hidden>
            <p class="pl">What is it about?</p>
            <div class="chips">{[...services.map(s => s.name), 'Not sure yet'].map(n => <label><input type="radio" name="Service" value={n} data-label="Service" /><span>{n}</span></label>)}</div>
            <p class="nob">No brief attached. <a href="/services">Build one on a service page</a> first, it takes three minutes, or just send your details.</p>
          </div>
          <div class="links" id="links" hidden><a id="edit" href="/services">Edit picks</a><a href="/services">Add another service</a></div>
          <div class="fields">
            <label class="f"><span>Your name</span><input name="Name" data-label="Name" required placeholder="Ada Okafor" autocomplete="name" /></label>
            <label class="f"><span>Email or WhatsApp</span><input name="Contact" data-label="Contact" required placeholder="ada@business.com" autocomplete="email" /></label>
            <input type="hidden" name="Call" data-label="Call" id="callf" />
            <input type="hidden" name="Brief ID" data-label="Brief ID" id="idf" />
            <input type="hidden" name="Brief for" data-label="Brief for" id="svcf" />
            <button class="dm-btn p w" type="submit" value="whatsapp" id="confirm">Send request</button>
            <button class="em" type="submit" value="email">Or send it by email</button>
          </div>
        </div>
      </form>
    </div>
  </section>
  <section class="dm-sec alt">
    <div class="wrap">
      <div class="dm-head c"><p class="dm-eb">What to expect</p><h2 class="dm-h2">25 minutes, one next step</h2></div>
      <div class="dm-cells c3 eg">{expect.map(([i, t, d]) => <div><span class="dm-ib"><Lc name={i} /></span><h3 class="dm-h3">{t}</h3><p class="dm-body">{d}</p></div>)}</div>
    </div>
  </section>
  </div>
</Page>
<script is:inline define:vars={{ names, times }}>
(function(){
  var $=function(s){return document.getElementById(s)};
  var slug=new URLSearchParams(location.search).get('service')||'',brief=null;
  try{brief=JSON.parse(localStorage.getItem('wt-brief-'+slug)||'null')}catch(e){}
  var LBL={'What do you have now?':'What you have now','What do you need?':'What you need','How should it feel?':'How it should feel','Who buys from you?':'Who buys','When do you need it?':'When','_note':'Note','Need':'What you need'};
  var rows=$('rows'),svcName=names[slug]||'';
  function row(k,v,cls){var d=document.createElement('div');d.className='br'+(cls?' '+cls:'');d.innerHTML='<span></span><b></b>';d.firstChild.textContent=k;d.lastChild.textContent=v;rows.appendChild(d)}
  if(brief&&Object.keys(brief).length){
    $('att').hidden=false;$('links').hidden=false;$('edit').href=slug==='plan'?'/services':'/services/'+slug+'#brief';
    row('Service',svcName||slug,'keep');
    Object.keys(brief).forEach(function(k){var v=brief[k];v=Array.isArray(v)?v.join(', '):v;if(!v||v==='-')return;var l=LBL[k]||k.replace(/\?$/,'');row(l,v,/need|budget|estimate/i.test(l)?'keep':'')});
    $('svcf').value=svcName;
  }else{
    $('btitle').textContent='Your details';
    var match=false;if(svcName)document.querySelectorAll('input[name="Service"]').forEach(function(i){if(i.value===svcName){i.checked=true;match=true}});
    if(svcName&&!match){row('Service',svcName,'keep');$('svcf').value=svcName}else $('pick').hidden=false;
  }
  // calendar: weekdays from tomorrow, six weeks ahead, times in WAT
  var now=new Date(),start=new Date(now.getFullYear(),now.getMonth(),now.getDate()+1),end=new Date(start.getTime()+42*864e5);
  var view=new Date(start.getFullYear(),start.getMonth(),1),sel=null,time=null;
  var M=['January','February','March','April','May','June','July','August','September','October','November','December'],D=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  var ok=function(d){var w=d.getDay();return d>=start&&d<=end&&w!==0&&w!==6};
  var fmt=function(d){return D[d.getDay()]+' '+d.getDate()+' '+M[d.getMonth()].slice(0,3)};
  function first(){var d=new Date(start);while(!ok(d))d.setDate(d.getDate()+1);return d}
  sel=first();
  function cal(){
    $('mlabel').textContent=M[view.getMonth()]+' '+view.getFullYear();
    var g=$('days');g.innerHTML='';var off=(view.getDay()+6)%7,n=new Date(view.getFullYear(),view.getMonth()+1,0).getDate();
    for(var i=0;i<off;i++)g.appendChild(document.createElement('span'));
    for(var d=1;d<=n;d++){var dt=new Date(view.getFullYear(),view.getMonth(),d),b=document.createElement('button');b.type='button';b.textContent=d;
      if(ok(dt)){b.className='av';b.onclick=(function(x){return function(){sel=x;time=null;upd()}})(dt);if(sel&&+sel===+dt)b.setAttribute('aria-pressed','true')}else b.disabled=true;g.appendChild(b)}
    $('prev').disabled=view<=new Date(start.getFullYear(),start.getMonth(),1);$('next').disabled=new Date(view.getFullYear(),view.getMonth()+1,1)>end;
    var s=$('strip');s.innerHTML='';var x=new Date(start),c=0;while(c<5&&x<=end){if(ok(x)){var bb=document.createElement('button');bb.type='button';bb.innerHTML='<small></small><b></b>';bb.firstChild.textContent=D[x.getDay()].toUpperCase();bb.lastChild.textContent=x.getDate();if(sel&&+sel===+x)bb.setAttribute('aria-pressed','true');bb.onclick=(function(y){return function(){sel=y;time=null;view=new Date(y.getFullYear(),y.getMonth(),1);upd()}})(new Date(x));s.appendChild(bb);c++}x.setDate(x.getDate()+1)}
  }
  function upd(){cal();$('dlabel').textContent=sel?fmt(sel):'Pick a day';
    document.querySelectorAll('#times button').forEach(function(b){b.disabled=!sel;b.setAttribute('aria-pressed',b.dataset.t===time)});
    var when=sel&&time?fmt(sel)+', '+time:'';$('callf').value=when?when+' WAT':'';$('confirm').textContent=when?'Confirm '+when:'Send request';}
  document.querySelectorAll('#times button').forEach(function(b){b.onclick=function(){time=b.dataset.t;upd()}});
  $('prev').onclick=function(){view=new Date(view.getFullYear(),view.getMonth()-1,1);cal()};
  $('next').onclick=function(){view=new Date(view.getFullYear(),view.getMonth()+1,1);cal()};
  upd();
  var id='WT-'+String(now.getFullYear()).slice(2)+String(now.getMonth()+1).padStart(2,'0')+'-'+String(Math.floor(Math.random()*900)+100);$('idf').value=id;
  // after form-send.js opens WhatsApp or email, show the B2 confirmation
  $('bk').addEventListener('submit',function(e){if(!this.checkValidity())return;var svc=$('svcf').value||((document.querySelector('input[name="Service"]:checked')||{}).value)||'';
    try{sessionStorage.setItem('wt-sent',JSON.stringify({id:id,service:svc,slug:slug,when:$('callf').value,iso:sel&&time?sel.toISOString().slice(0,10)+'T'+time:''}))}catch(_){}
    var via=(e.submitter&&e.submitter.value)||'whatsapp';setTimeout(function(){location.href='/brief-sent'},via==='email'?900:400)});
})();
</script>
<style>
  .bk{padding-bottom:128px}
  .grid{display:grid;grid-template-columns:minmax(0,1fr) 352px;gap:20px;margin-top:40px;align-items:start}
  .cal{display:flex;gap:24px;padding:24px;border:1px solid var(--hl)}
  .mg{flex:1;display:grid;gap:12px;align-content:start}
  .mh{display:flex;align-items:center;gap:8px}
  .mh h2{flex:1;font-size:16px;line-height:24px}
  .nav{cursor:pointer;color:var(--fg)}.nav:disabled{opacity:.3;cursor:default}
  .wd,.days{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}
  .wd span{text-align:center;font-size:11px;font-weight:500;line-height:14.3px;letter-spacing:.66px;text-transform:uppercase;color:var(--lab)}
  .days :global(button){height:40px;background:none;border:0;border-radius:2px;color:var(--lab);opacity:.5;font:400 14px/1 var(--font)}
  .days :global(button.av){opacity:1;background:var(--tint);color:var(--fg);font-weight:500;cursor:pointer}
  .days :global(button.av:hover){background:color-mix(in srgb,var(--fg) 12%,transparent)}
  .days :global(button[aria-pressed="true"]){background:var(--sig)!important;color:#fff}
  .tz{display:flex;align-items:center;gap:8px;font-size:13px;line-height:18px;color:var(--lab);margin-top:4px}
  .strip{display:none}
  .times{width:176px;display:grid;gap:12px;align-content:start}
  .dl{font-size:16px;font-weight:600;line-height:24px;height:32px;display:flex;align-items:center}
  .tl{display:grid;gap:8px}
  .tl button{height:40px;background:var(--bg);border:1px solid var(--hl);border-radius:2px;color:var(--fg);font:500 14px/1 var(--font);cursor:pointer}
  .tl button:hover:not(:disabled){border-color:var(--hl2)}.tl button:disabled{opacity:.4;cursor:default}
  .tl button[aria-pressed="true"]{background:var(--fg);border-color:var(--fg);color:var(--bg)}
  .brief{background:var(--panel)}
  .bh{display:flex;justify-content:space-between;align-items:center;padding:16px 20px}
  .bt{display:flex;align-items:center;gap:10px;font-size:16px;font-weight:600;line-height:24px}
  .att{background:color-mix(in srgb,var(--ok) 14%,transparent);color:var(--ok)}
  #rows :global(.br){display:grid;gap:2px;padding:10px 20px;border-top:1px solid var(--hl)}
  #rows :global(.br span){font-size:13px;line-height:18px;color:var(--lab)}
  #rows :global(.br b){font-weight:500;font-size:14px;line-height:21px}
  .links{display:flex;gap:16px;padding:12px 20px;border-top:1px solid var(--hl)}
  .links a{font-size:14px;font-weight:600;line-height:21px;color:var(--fg);text-underline-offset:3px}
  .pick{padding:16px 20px;border-top:1px solid var(--hl);display:grid;gap:12px}
  .pick[hidden],.links[hidden],.att[hidden]{display:none}
  .pl{font-size:14px;font-weight:500;line-height:21px}
  .chips{display:flex;flex-wrap:wrap;gap:8px}.chips label{position:relative}.chips input{position:absolute;opacity:0;pointer-events:none}
  .chips span{display:inline-flex;align-items:center;height:32px;padding:0 12px;font-size:14px;border:1px solid var(--hl);border-radius:2px;background:var(--bg);cursor:pointer}
  .chips input:checked+span{background:var(--fg);border-color:var(--fg);color:var(--bg)}.chips input:focus-visible+span{box-shadow:var(--ring)}
  .nob{font-size:13px;line-height:18px;color:var(--mute)}.nob a{color:var(--fg)}
  .fields{display:grid;gap:12px;padding:16px 20px 20px;border-top:1px solid var(--hl)}
  .f{display:grid;gap:6px}.f span{font-size:14px;font-weight:500;line-height:21px}
  .f input{height:40px;padding:8px 12px;background:var(--bg);border:1px solid var(--hl);border-radius:2px;color:var(--fg);font:400 15px var(--font)}
  .f input::placeholder{color:var(--lab);opacity:.7}.f input:focus{outline:none;border-color:var(--sig)}
  .em{background:none;border:0;color:var(--mute);font:400 14px var(--font);cursor:pointer;padding:0;text-decoration:underline;text-underline-offset:3px}.em:hover{color:var(--fg)}
  .eg{margin-top:80px}
  @media (max-width:1023px){
    .bk{padding-bottom:64px}
    .grid{grid-template-columns:1fr;gap:16px;margin-top:24px}
    .cal{flex-direction:column;gap:16px;padding:0;border:0}
    .mg{display:none}
    .strip{display:flex;gap:8px}
    .strip :global(button){flex:1;display:grid;gap:2px;justify-items:center;padding:8px 0;background:var(--bg);border:1px solid var(--hl);border-radius:2px;color:var(--fg);cursor:pointer}
    .strip :global(small){font-size:11px;font-weight:500;letter-spacing:.66px;color:var(--lab)}.strip :global(b){font-size:16px;font-weight:600;line-height:24px}
    .strip :global(button[aria-pressed="true"]){background:var(--sig);border-color:var(--sig);color:#fff}.strip :global(button[aria-pressed="true"] small){color:#fff}
    .times{width:auto}.dl{display:none}
    .tl{display:flex;flex-wrap:wrap;gap:8px}.tl button{padding:0 16px}
    .brief{margin:0 -16px}
    .bh{padding:16px}
    #rows :global(.br){padding:10px 16px}#rows :global(.br:not(.keep)){display:none}
    .links{display:none !important}
    .pick,.fields{padding:16px}
    .eg{margin-top:40px}
  }
</style>
