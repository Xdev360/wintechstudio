---
// Services index on the DesignMe spec: page head, three "where are you" cards, the service list, quick jobs.
import Page from '../../layouts/Page.astro';
import Lc from '../../components/ui/Lc.astro';
import services from '../../data/services.json';
import { services as names, contact } from '../../data/site';
import '../../styles/studio.css';
const icons: Record<string, string> = { brand: 'palette', websites: 'monitor', 'ai-assistant': 'bot', automation: 'zap', apps: 'code', motion: 'film' };
const doors = [
  { id: 'starting', icon: 'rocket', t: 'Starting something', d: 'An idea or a waitlist. You need a brand, a page to test demand and a first version.', tags: [['Brand', 'brand'], ['Landing page', 'websites'], ['MVP', 'apps']] },
  { id: 'adding-tech', icon: 'bag', t: 'Adding tech to my business', d: 'It already sells. You want a store, replies at any hour and less work on your phone.', tags: [['Store', 'websites'], ['AI assistant', 'ai-assistant'], ['Automation', 'automation']], badge: 'Most of our clients' },
  { id: 'refresh', icon: 'refresh', t: 'Refreshing my brand', d: 'It works but looks cheaper than it is. You want it sharper and more premium.', tags: [['Rebrand', 'brand'], ['New website', 'websites'], ['Packaging', 'brand']] },
];
const words = [['WEBSITE', 'Sites and stores'], ['BRAND', 'Logo, identity, packaging'], ['MOTION', 'Films and explainers']];
---
<Page title="Services · Wintech Studio" description="Brand, websites and stores, AI assistants, automation, apps and motion, from one team in Lagos." crumbs={[['Services', '/services']]}>
  <div class="dm sx">
    <section class="dm-top">
      <div class="wrap">
        <div class="dm-head c">
          <p class="dm-eb">Services</p>
          <h1 class="dm-h1">Pick one thing, or the whole system.</h1>
          <p class="dm-intro">Every service has a page where you tick what you need and send us a brief. No call needed to get started.</p>
        </div>
      </div>
    </section>

    <section class="dm-sec flush" aria-label="Where are you?">
      <div class="wrap dm-grid g3">
        {doors.map(o => (
          <div class="dm-card door" id={o.id}>
            <div class="dtop"><span class="dm-ib"><Lc name={o.icon} /></span>{o.badge && <span class="dm-tag b">{o.badge}</span>}</div>
            <h2 class="dm-h3">{o.t}</h2>
            <p class="dm-body">{o.d}</p>
            <p class="tags">{o.tags.map(([l, h]) => <a href={`/services/${h}`}>{l}</a>)}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="dm-sec line">
      <div class="wrap dm-stick">
        <div class="dm-head"><p class="dm-eb">All services</p><h2 class="dm-h2s">Six services, one team.</h2><p class="dm-intro">Starting prices and typical timelines. Your proposal fixes the real price before any work starts.</p></div>
        <ul class="dm-rows list">
          {services.map((s, i) => (
            <li>
              <a class="row" href={`/services/${s.slug}`}>
                <span class="dm-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="dm-ib s36"><Lc name={icons[s.slug]} size={18} /></span>
                <span class="tx"><strong>{names.find(n => n.slug === s.slug)!.name}</strong><span>{s.intro}</span><em class="mp">{s.price} · {s.timeline}</em></span>
                <span class="pr"><b>{s.price}</b><span>{s.timeline}</span></span>
                <span class="dm-arrow"><Lc name="arrow-right" /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="dm-sec alt">
      <div class="wrap dm-split">
        <div class="dm-head">
          <p class="dm-eb">Quick jobs</p>
          <h2 class="dm-h2">Just need one thing? Send one word.</h2>
          <p class="dm-intro">Message WEBSITE, BRAND or MOTION on Instagram or WhatsApp. We reply within the hour with three examples, the starting price and three questions.</p>
        </div>
        <ul class="dm-rows words">
          {words.map(([w, l]) => <li><a href={`${contact.whatsappLink}?text=${encodeURIComponent(w)}`} target="_blank" rel="noopener"><span class="dm-ib"><Lc name="message" /></span><b>{w}</b><span>{l}</span><Lc name="arrow-up-right" class="go" /></a></li>)}
        </ul>
      </div>
    </section>
  </div>
</Page>
<style>
  .door{scroll-margin-top:120px}
  .dtop{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
  .tags{display:flex;flex-wrap:wrap;gap:4px 16px;margin-top:auto;padding-top:8px}
  .tags a{font-size:14px;font-weight:600;line-height:21px;color:var(--fg);text-underline-offset:3px}
  .tags a:hover{color:var(--sig)}

  .row{display:flex;align-items:center;gap:20px;padding:24px 0;text-decoration:none;color:var(--fg)}
  .row .dm-num{width:24px}
  .list{border-top:1px solid var(--hl)}
  .tx{flex:1;display:flex;flex-direction:column;gap:2px;min-width:0}
  .tx strong{font-size:20px;line-height:26px;font-weight:600;letter-spacing:-.2px}
  .tx span{font-size:16px;line-height:24px;color:var(--mute);max-width:560px}
  .row:hover strong{color:var(--sig)}
  .mp{display:none;font-style:normal;font-size:13px;line-height:18px;color:var(--lab);margin-top:2px}
  .pr{display:flex;flex-direction:column;gap:2px;width:150px;flex:none}
  .pr b{font-size:14px;line-height:21px;font-weight:600}
  .pr span{font-size:13px;line-height:18px;color:var(--lab)}

  .words{align-self:center}
  .words a{display:flex;align-items:center;gap:12px;padding:16px 0;text-decoration:none;color:var(--fg)}
  .words b{font-size:16px;line-height:24px;font-weight:600;color:var(--sig);width:96px}
  :global(:root[data-theme="dark"]) .words b{color:#8FA3FF}
  .words span:not(.dm-ib){flex:1;font-size:16px;line-height:24px;color:var(--mute)}
  .words :global(.go){color:var(--lab);transition:transform .2s}
  .words a:hover :global(.go){transform:translate(2px,-2px);color:var(--fg)}
  @media (max-width:1023px){
    .row{gap:12px;padding:16px 0;align-items:flex-start}
    .row .dm-num,.row .dm-arrow{display:none}
    .tx strong{font-size:17px;line-height:24px}
    .tx span{font-size:14px;line-height:21px}
    .pr{display:none}
    .mp{display:block}
    .words b{width:80px}
  }
</style>
