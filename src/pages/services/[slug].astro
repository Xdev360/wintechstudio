---
// Service page on the DesignMe spec. Per-service content comes from services.json and bento.ts.
import Page from '../../layouts/Page.astro';
import Faq from '../../components/ui/Faq.astro';
import Lc from '../../components/ui/Lc.astro';
import Bento from '../../components/services/Bento.astro';
import BriefBuilder from '../../components/services/BriefBuilder.astro';
import services from '../../data/services.json';
import { bento } from '../../data/bento';
import { services as names } from '../../data/site';
import '../../styles/studio.css';
export function getStaticPaths() { return services.map(s => ({ params: { slug: s.slug } })); }
const s = services.find(x => x.slug === Astro.params.slug)! as (typeof services)[number] & { built?: { title: string; items: { slug: string; name: string; line: string; img: string }[] } };
const meta = names.find(n => n.slug === s.slug)!;
const name = meta.name;
// heroTitle marks gradient words with *...* and line breaks with \n; this layout shows it as plain text.
const heroText = s.heroTitle.replace(/\*/g, '').replace(/\n/g, ' ');
const ngn = s.priceNgn.replace(/^or /, '');
const steps = [['Brief', 'Your picks, read before the call.'], ['Call', '25 minutes with the project lead.'], ['Proposal', 'Fixed scope, price and date.'], ['Build weekly', 'Something to see every Friday.']];
const faqs: [string, string][] = [
  [`How much does ${name.toLowerCase()} cost?`, `${s.price.replace(/^from/, 'From')}${s.priceNgn ? ` (${s.priceNgn})` : ''}. Your proposal fixes the real price before any work starts.`],
  ['How do payments work?', '50% to start, 40% at design approval and 10% at handover. Monthly plans are billed monthly.'],
  ['Who owns the work?', 'You do. Accounts are in your name from day one, and every file, asset and line of code is yours on the final payment.'],
];
const svcLd = { '@context': 'https://schema.org', '@type': 'Service', name, serviceType: name, provider: { '@type': 'Organization', name: 'Wintech Studio', url: 'https://www.wintechstudio.com' }, areaServed: ['Nigeria', 'Worldwide'], description: s.intro };
---
<Page title={`${name} · Wintech Studio`} description={s.intro} crumbs={[['Services', '/services'], [name, `/services/${s.slug}`]]} jsonld={[svcLd]}>
  <div class="dm svc">
    <section class="dm-top hero">
      <div class="wrap hg">
        <div class="dm-head">
          <p class="dm-eb">Services · {meta.short}</p>
          <h1 class="dm-h1">{heroText}</h1>
          <p class="sub">{s.intro}</p>
          <div class="dm-ctas"><a class="dm-btn p" href="#brief">Build your brief</a><a class="dm-btn s" href={`/book?service=${s.slug}`}>Book a call</a></div>
          <dl class="dm-facts">
            <div><dt>{s.price}</dt><dd>{ngn}</dd></div>
            <div><dt>{s.timeline}</dt><dd>typical timeline</dd></div>
          </dl>
        </div>
        <div class="dm-media stage"><img src={`/images/services/${s.slug}-hero.webp`} alt={`${name}: example work`} width="1040" height="760" fetchpriority="high" /></div>
      </div>
    </section>

    <Bento slug={s.slug} cells={bento[s.slug]} lines={s.whatLines} />

    {s.built && (
      <section class="dm-sec line built">
        <div class="wrap">
          <div class="dm-head c"><p class="dm-eb">Brands we built</p><h2 class="dm-h2">{s.built.title}</h2></div>
          <div class="dm-grid g4">
            {s.built.items.map(c => (
              <a class="case" href={`/work/${c.slug}`}>
                <span class="dm-media ci"><img src={c.img} alt="" loading="lazy" decoding="async" width="576" height="480" /></span>
                <span class="cm"><strong>{c.name}</strong></span>
                <span class="ct"><span>{c.line}</span><span class="dm-arrow"><Lc name="arrow-up-right" /></span></span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <BriefBuilder slug={s.slug} name={name} label={s.briefLabel} starting={s.starting} questions={s.brief} />

    <section class="dm-sec line">
      <div class="wrap">
        <div class="dm-head c"><p class="dm-eb">How it runs</p><h2 class="dm-h2">Four steps, one project lead.</h2></div>
        <ol class="dm-cells c4 steps">{steps.map(([t, d], i) => <li><span class="dm-num">{String(i + 1).padStart(2, '0')}</span><h3 class="dm-h3">{t}</h3><p class="dm-body">{d}</p></li>)}</ol>
      </div>
    </section>
  </div>
  <Faq items={faqs} plain title={`${meta.short} questions`} />
</Page>
<style>
  .hg{display:grid;grid-template-columns:minmax(0,1fr) 520px;gap:64px;align-items:center}
  .sub{font-size:18px;line-height:27px;color:var(--mute);max-width:560px}
  .hero .dm-ctas{margin-top:8px}
  .hero .dm-facts{margin-top:8px}
  .stage{width:520px;aspect-ratio:520/380}
  .stage img{animation:rise .8s cubic-bezier(.2,.7,.2,1) .1s both}
  @keyframes rise{from{opacity:0;transform:translateY(14px)}}
  @media (prefers-reduced-motion:reduce){.stage img{animation:none}}

  .case{display:flex;flex-direction:column;border:1px solid var(--hl);padding:8px;text-decoration:none;color:var(--fg);transition:border-color .15s}
  .case:hover{border-color:var(--hl2)}
  .ci{display:block;aspect-ratio:4/3}
  .ci img{object-position:30% 50%;transition:transform .4s}
  .case:hover .ci img{transform:scale(1.03)}
  .cm{padding:12px 8px;border-bottom:1px solid var(--hl)}
  .cm strong{font-size:16px;line-height:24px;font-weight:600}
  .ct{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 8px 4px}
  .ct>span:first-child{font-size:14px;line-height:21px;color:var(--mute)}

  .steps{list-style:none;margin-top:80px;padding:0}
  @media (max-width:1023px){
    .hg{grid-template-columns:1fr;gap:32px}
    .sub{font-size:16px;line-height:24px}
    .stage{width:100%}
    .built .dm-grid{grid-template-columns:1fr 1fr;gap:12px}
    .case{padding:6px}
    .cm{padding:10px 4px}
    .ct{padding:10px 4px 2px}
    .ct .dm-arrow{display:none}
    .ct>span:first-child{font-size:13px;line-height:18px}
    .steps{margin-top:40px}
  }
</style>
