---
// Service page template, Figma S1-S6 (807:2173, 807:2594, 807:3008, 807:3398, 807:3802, 807:4209), dark ref 823:5523,
// mobile M · Service · * (1014:22465 etc.). Per-service differences come from services.json and bento.ts.
import Page from '../../layouts/Page.astro';
import Faq from '../../components/ui/Faq.astro';
import Icon from '../../components/Icon.astro';
import Bento from '../../components/services/Bento.astro';
import BriefBuilder from '../../components/services/BriefBuilder.astro';
import services from '../../data/services.json';
import { bento } from '../../data/bento';
import { services as names } from '../../data/site';
export function getStaticPaths() { return services.map(s => ({ params: { slug: s.slug } })); }
const s = services.find(x => x.slug === Astro.params.slug)! as (typeof services)[number] & { built?: { title: string; items: { slug: string; name: string; line: string; img: string }[] } };
const meta = names.find(n => n.slug === s.slug)!;
const name = meta.name;
// "*text*" in heroTitle marks the gradient words; "\n" marks the desktop line breaks.
const heroHtml = s.heroTitle.split('\n').map(l => l.replace(/\*([^*]+)\*/g, '<span class="grad">$1</span>')).join('<br class="dbr" /> ');
const ngn = s.priceNgn.replace(/^or /, '');
const steps = [['Brief', 'Your picks, read before the call.'], ['Call', '25 minutes with the project lead.'], ['Proposal', 'Fixed scope, price and date.'], ['Build weekly', 'Something to see every Friday.']];
const faqs: [string, string][] = [
  [`How much does ${name.toLowerCase()} cost?`, `${s.price.replace(/^from/, 'From')}${s.priceNgn ? ` (${s.priceNgn})` : ''}. Your proposal fixes the real price before any work starts.`],
  ['How do payments work?', '50% to start, 40% at design approval and 10% at handover. Monthly plans are billed monthly.'],
  ['Who owns the work?', 'You do. Accounts are in your name from day one, and every file, asset and line of code is yours on the final payment.'],
];
const svcLd = { '@context': 'https://schema.org', '@type': 'Service', name, serviceType: name, provider: { '@type': 'Organization', name: 'Wintech Studio', url: 'https://www.wintechstudio.com' }, areaServed: ['Nigeria', 'Worldwide'], description: s.intro };
---
<Page title={`${name} · Wintech Studio`} description={s.intro} crumbs={[['Services', '/services'], [name, `/services/${s.slug}`]]} jsonld={[svcLd]}>
  <div class="svc">
    <section class="hero">
      <div class="wrap hg">
        <div class="hl">
          <p class="eb"><span class="dk">Services · {name}</span><span class="mb">Services · {meta.short}</span></p>
          <h1 set:html={heroHtml} />
          <p class="intro">{s.intro}</p>
          <div class="ctas"><a class="btn btn-primary" href="#brief">Build your brief</a><a class="btn btn-soft" href="/book">Book a call</a></div>
          <dl class="meta">
            <div><dt>{s.price}</dt><dd>{ngn}</dd></div>
            <div><dt>{s.timeline}</dt><dd><span class="dk">typical timeline</span><span class="mb">timeline</span></dd></div>
          </dl>
        </div>
        <div class="stage"><img src={`/images/services/${s.slug}-hero.webp`} alt={`${name}: example work`} width="520" height="380" fetchpriority="high" /></div>
      </div>
    </section>

    <Bento slug={s.slug} cells={bento[s.slug]} lines={s.whatLines} />

    {s.built && (
      <section class="built">
        <div class="wrap">
          <p class="eb">Brands we built</p>
          <h2>{s.built.title}</h2>
          <div class="cases">
            {s.built.items.map(c => (
              <a class="case" href={`/work/${c.slug}`}>
                <span class="ci"><img src={c.img} alt="" loading="lazy" decoding="async" width="288" height="240" /></span>
                <span class="ct"><strong>{c.name}</strong><span>{c.line}</span><span class="lk">See the case <Icon name="arrow-up-right" size={14} /></span></span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <BriefBuilder slug={s.slug} name={name} label={s.briefLabel} starting={s.starting} questions={s.brief} />

    <section class="runs">
      <div class="wrap">
        <div class="rh"><p class="eb">How it runs</p><h2>Four steps, one project lead.</h2></div>
        <ol class="steps">{steps.map(([t, d], i) => <li><span class="n">{String(i + 1).padStart(2, '0')}</span><span class="st"><strong>{t}</strong><span>{d}</span></span></li>)}</ol>
      </div>
    </section>
  </div>
  <Faq items={faqs} plain />
</Page>
<style>
  .svc{position:relative}
  .svc::before,.svc::after{content:'';position:absolute;top:0;bottom:0;width:1px;background:var(--rule);z-index:1;pointer-events:none}
  .svc::before{left:calc(50% - 640px)}.svc::after{left:calc(50% + 639px)}
  .eb{font-family:var(--mono);font-size:11px;line-height:14px;letter-spacing:.06em;text-transform:uppercase;color:var(--fg-2);margin:0}
  .mb{display:none}
  :global(.grad){background:linear-gradient(90deg,#254D7F,#3B5BFF);-webkit-background-clip:text;background-clip:text;color:transparent}
  :global(:root[data-theme="dark"]) :global(.grad){background-image:linear-gradient(90deg,#8FA3FF,#C9D1F5)}

  .hero{padding:48px 0 96px}
  .hg{display:grid;grid-template-columns:minmax(0,611px) 520px;justify-content:space-between;align-items:center;gap:40px}
  .hl{display:flex;flex-direction:column;gap:26px;align-items:flex-start}
  h1{font-size:64px;line-height:1.02;letter-spacing:-.025em;font-weight:600;margin:0}
  .intro{font-size:18px;line-height:1.55;color:var(--fg-2);max-width:520px;margin:0}
  .ctas{display:flex;gap:10px}
  .ctas .btn{font-size:16px;line-height:19px;padding:13px 20px}
  .meta{display:flex;gap:20px;margin:0}
  .meta div{display:flex;flex-direction:column;gap:2px}
  .meta dt{font-size:15px;line-height:18px;font-weight:600}
  .meta dd{margin:0;font-size:13px;line-height:16px;color:var(--fg-2)}
  .stage{width:520px;aspect-ratio:520/380;background:#F2F4F8;overflow:hidden}
  .stage img{display:block;width:100%;height:100%;object-fit:cover;animation:rise .8s cubic-bezier(.2,.7,.2,1) .1s both}
  @keyframes rise{from{opacity:0;transform:translateY(18px) scale(.985)}}
  @media (prefers-reduced-motion:reduce){.stage img{animation:none}}

  .built{padding:96px 0}
  .built h2{font-size:40px;line-height:48px;letter-spacing:-.025em;font-weight:600;margin:12px 0 28px}
  .cases{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
  .case{display:flex;flex-direction:column;border:1px solid var(--rule);background:var(--card);text-decoration:none;color:var(--fg);transition:border-color .15s}
  .case:hover{border-color:var(--ash)}
  .ci{display:block;aspect-ratio:288/240;overflow:hidden;background:var(--surface)}
  .ci img{display:block;width:100%;height:100%;object-fit:cover;object-position:30% 50%;transition:transform .4s}
  .case:hover .ci img{transform:scale(1.03)}
  .ct{display:flex;flex-direction:column;padding:20px;gap:6px}
  .ct strong{font-size:18px;line-height:22px;font-weight:600}
  .ct>span{font-size:14px;line-height:17px;color:var(--fg-2)}
  .ct .lk{display:inline-flex;align-items:center;gap:6px;color:var(--sig);font-weight:500;margin-top:11px}
  .case:hover .lk{text-decoration:underline;text-underline-offset:3px}

  .runs{padding:96px 0;background:var(--surface)}
  .rh{display:flex;flex-direction:column;gap:16px;margin-bottom:48px}
  .rh h2{font-size:40px;line-height:1.05;letter-spacing:-.02em;font-weight:600;margin:0}
  .steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
  .steps li{background:var(--card);border:1px solid var(--rule);padding:24px;display:flex;flex-direction:column;gap:10px}
  :global(:root[data-theme="dark"]) .steps li{background:var(--bg)}
  .n{font-family:var(--mono);font-size:12px;line-height:16px;color:var(--sig)}
  :global(:root[data-theme="dark"]) .n{color:#7C93FF}
  .st{display:flex;flex-direction:column;gap:10px}
  .st strong{font-size:20px;line-height:24px;font-weight:600}
  .st span{font-size:14px;line-height:17px;color:var(--fg-2)}

  @media (max-width:1279px){.svc::before,.svc::after{display:none}}
  @media (max-width:1023px){
    .wrap{padding-left:16px;padding-right:16px}
    .dk{display:none}.mb{display:inline}
    .eb{font-size:10px;line-height:13px}
    .hero{padding:24px 0 56px}
    .hg{grid-template-columns:1fr;gap:20px}
    .hl{gap:12px;display:grid;grid-template-columns:1fr}
    h1{font-size:36px;line-height:1.06;letter-spacing:-.015em;margin-top:0}
    h1 :global(.grad){background:none;color:inherit}
    h1 :global(.dbr){display:none}
    .intro{font-size:15px;line-height:1.5}
    .meta{order:4;gap:24px;margin-top:8px}
    .meta dd{font-size:12px;line-height:14px}
    .ctas{order:5;margin-top:8px}
    .ctas .btn-soft{display:none}
    .ctas .btn-primary{width:100%;padding:14px 20px}
    .stage{width:100%;aspect-ratio:358/262}
    .built{display:none}
    .runs{padding:56px 0}
    .rh{gap:12px;margin-bottom:24px}
    .rh h2{font-size:28px;line-height:34px;letter-spacing:-.018em}
    .steps{grid-template-columns:1fr;gap:0}
    .steps li{flex-direction:row;gap:16px;padding:18px 0;background:none!important;border:0;border-top:1px solid var(--rule)}
    .st{gap:4px}
    .st strong{font-size:18px;line-height:22px}
  }
</style>
