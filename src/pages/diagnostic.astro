---
import Page from '../layouts/Page.astro';
import Lc from '../components/ui/Lc.astro';
import Faq from '../components/ui/Faq.astro';
import '../styles/studio.css';
const price = { usd: '$200', ngn: '₦150,000' };
const ticks = ['5 working days', 'Written plan with priorities', 'A priced proposal for the build', 'Credited in full if you continue'];
const look = [['trend', 'How do customers find you?', 'Instagram, referrals, walk ins, search. Which ones pay.'], ['banknote', 'How does money move?', 'From the first message to delivery, and where it leaks.'], ['users', 'Why do competitors win?', 'Price, packaging, reply speed, proof.'], ['flag', 'What do we fix first?', 'The order of work, the price and the date.']];
const days = [['Kickoff', 'We get access, your numbers and 30 minutes with you.'], ['Customers', 'We message you like a customer and map every step.'], ['Competitors', 'Three competitors, side by side.'], ['The plan', 'Fixes in order, with what each one costs.'], ['Readout', '30 minutes on a call. The report is yours.']];
const faqs: [string, string][] = [
  ['Is the fee really credited?', `Yes. If you go ahead within 30 days, the full ${price.usd} comes off the build.`],
  ['What do you need from me?', 'Access to the places customers reach you (Instagram, WhatsApp Business, your site if you have one), a rough idea of monthly sales, and 30 minutes on day one.'],
  ['Is this where partner builds are offered?', 'Yes. A partner build is offered by invitation after the diagnostic, only when the numbers work for both of us.'],
];
const ld = [{ '@context': 'https://schema.org', '@type': 'Service', name: 'Paid diagnostic', provider: { '@type': 'Organization', name: 'Wintech Studio' }, description: 'Five working days studying how customers find you, how money moves and why competitors win, ending in a written plan and a priced proposal.', offers: { '@type': 'Offer', price: '200', priceCurrency: 'USD' } }, { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }];
---
<Page title="Paid diagnostic · Before we build, we study · Wintech Studio" description="Five working days for $200: how customers find you, how money moves and why competitors win. A written plan you can use even if you never hire us, credited in full if you continue." crumbs={[['Pricing', '/pricing'], ['Paid diagnostic', '/diagnostic']]} jsonld={ld}>
  <div class="dm dg">
    <section class="dm-top">
      <div class="wrap hg">
        <div class="dm-head">
          <p class="dm-eb">The paid diagnostic</p>
          <h1 class="dm-h1">Before we build, we study.</h1>
          <p class="dm-intro">Five working days. We study how customers find you, how money moves, and why competitors win. You get a written plan you can use even if you never hire us.</p>
        </div>
        <div class="dm-card pc">
          <p class="dm-eb">The diagnostic</p>
          <p class="pr"><span class="u">{price.usd}</span><span class="n">{price.ngn}</span></p>
          <ul class="dm-ticks">{ticks.map(t => <li><Lc name="check" />{t}</li>)}</ul>
          <a class="dm-btn p w" href="/book?service=diagnostic">Start the diagnostic</a>
        </div>
      </div>
    </section>
    <section class="dm-sec alt">
      <div class="wrap dm-stick">
        <div class="dm-head"><p class="dm-eb">What we look at</p><h2 class="dm-h2s">Four questions, answered in writing.</h2></div>
        <div class="dm-cells c2 lg">{look.map(([i, t, d]) => <div><span class="dm-ib"><Lc name={i} /></span><h3 class="dm-h3">{t}</h3><p class="dm-body">{d}</p></div>)}</div>
      </div>
    </section>
    <section class="dm-sec">
      <div class="wrap dm-stick">
        <div class="dm-head"><p class="dm-eb">Five days</p><h2 class="dm-h2s">What happens each day</h2><a class="dm-link" href="/book?service=diagnostic">Start the diagnostic</a></div>
        <ol class="dm-rows dl">{days.map(([t, d], i) => <li><span class="dm-eb">Day {i + 1}</span><b>{t}</b><span class="dd">{d}</span></li>)}</ol>
      </div>
    </section>
  </div>
  <Faq items={faqs} title="Diagnostic questions" ld={false} service="diagnostic" />
</Page>
<style>
  .hg{display:grid;grid-template-columns:minmax(0,1fr) 400px;gap:64px;align-items:center}
  .pc{padding:32px;gap:16px}
  .pr{display:flex;align-items:baseline;gap:10px}
  .pr .u{font-size:56px;line-height:64.4px;font-weight:600;letter-spacing:-1.12px}
  .pr .n{font-size:16px;line-height:24px;color:var(--mute)}
  .pc .dm-ticks{margin-bottom:8px}
  .dl li{display:grid;grid-template-columns:80px 200px 1fr;gap:32px;align-items:center;padding:20px 0}
  .dl b{font-size:20px;line-height:26px;font-weight:600;letter-spacing:-.2px}
  .dd{font-size:16px;line-height:24px;color:var(--mute)}
  @media (max-width:1023px){
    .hg{grid-template-columns:1fr;gap:32px}
    .pc{padding:20px}
    .pr .u{font-size:36px;line-height:41.4px;letter-spacing:-.72px}
    .dl li{grid-template-columns:1fr;gap:4px;padding:16px 0}
    .dl b{font-size:17px;line-height:24px}
    .dd{font-size:15px;line-height:22px}
  }
</style>
