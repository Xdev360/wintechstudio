---
import Page from '../layouts/Page.astro';
import Field from '../components/ui/Field.astro';
import Lc from '../components/ui/Lc.astro';
import { contact } from '../data/site';
import '../styles/studio.css';
const ld = { '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Contact Wintech Studio' };
const ways = [
  ['mail', 'Email', contact.email, `mailto:${contact.email}`],
  ['message', 'WhatsApp', `${contact.whatsapp} · send WEBSITE, BRAND or MOTION`, contact.whatsappLink],
  ['calendar', 'Prefer to talk?', 'Book a 25 minute call', '/book'],
  ['eye', 'Want to see the work first?', 'Seven case studies', '/work'],
];
---
<Page title="Contact · Wintech Studio" description="Tell us what you run and what is not working. We reply within one working day. Email hello@wintechstudio.com or WhatsApp +234 913 407 1813." crumbs={[['Contact', '/contact']]} jsonld={[ld]} closing={false}>
  <div class="dm ct">
    <section class="dm-top cs">
      <div class="wrap dm-split cg">
        <div class="cl">
          <div class="dm-head">
            <p class="dm-eb">Contact</p>
            <h1 class="dm-h1">Send us the details.</h1>
            <p class="dm-intro">Tell us what you run and what is not working. We reply within one working day.</p>
          </div>
          <ul class="dm-rows ways">{ways.map(([ic, t, d, h]) => (
            <li><a href={h} target={h.startsWith('http') ? '_blank' : undefined} rel={h.startsWith('http') ? 'noopener' : undefined}>
              <span class="dm-ib"><Lc name={ic} /></span>
              <span class="wt"><strong>{t}</strong><small>{d}</small></span>
              <Lc name="arrow-up-right" class="go" />
            </a></li>
          ))}</ul>
        </div>
        <form class="dm-form form" data-send="New enquiry from wintechstudio.com">
          <div class="two">
            <Field label="Your name" name="Name" placeholder="Ada Okafor" required autocomplete="name" />
            <Field label="Email or WhatsApp" name="Contact" placeholder="ada@business.com" required />
          </div>
          <Field label="Business and a link" name="Business" placeholder="Instagram, website or both" />
          <Field label="Where are you?" name="Stage" options={['Starting something', 'Adding tech to my business', 'Refreshing my brand']} />
          <Field label="Budget" name="Budget" options={['Under $1,000', '$1,000 to $3,000', '$3,000+', 'Not sure']} />
          <Field label="What is not working right now?" name="Problem" rows={4} placeholder="Orders come in on WhatsApp and we miss some at night" />
          <div class="dm-send">
            <button class="dm-btn p" type="submit" value="whatsapp">Send details</button>
            <p>Opens WhatsApp. <button class="dm-plain" type="submit" value="email">Send by email instead</button></p>
          </div>
          <p class="dm-sent sent" hidden>Your message is ready in WhatsApp or your email app. Press send there and we reply within one working day.</p>
        </form>
      </div>
    </section>
  </div>
</Page>
<style>
  .cs{padding-bottom:128px}
  .cl{display:flex;flex-direction:column;gap:40px}
  .ways a{display:flex;align-items:center;gap:12px;padding:16px 0;text-decoration:none;color:var(--fg)}
  .wt{flex:1;display:flex;flex-direction:column}
  .wt strong{font-size:14px;line-height:21px;font-weight:600}
  .wt small{font-size:14px;line-height:21px;color:var(--mute)}
  .ways :global(.go){color:var(--lab);transition:transform .2s}
  .ways a:hover :global(.go){color:var(--fg);transform:translate(2px,-2px)}
  .ways a:hover strong{color:var(--sig)}
  .form{background:var(--panel);padding:32px}
  @media (max-width:1023px){
    .cs{padding-bottom:64px}
    .cl{gap:24px}
    .form{padding:20px 16px;margin:0 -16px}
  }
</style>
