---
import Page from '../../layouts/Page.astro';
import Lc from '../../components/ui/Lc.astro';
import '../../components/search/search.css';
// Figma X1. Only salons has its own page so far; the other cards point at the service that fits them best.
const cards = [
  ['bag', 'Fashion and beauty', 'Lookbooks, sizes, DMs that turn into orders.', 'Store · AI replies · Packaging', '/industries/salons'],
  ['utensils', 'Food and drinks', 'Menus, delivery areas, catering enquiries.', 'Menu site · Orders · Film', '/services/websites'],
  ['heart', 'Wellness', 'Trust, expiry dates, product questions.', 'Store · AI assistant · Brand', '/work/virelle'],
  ['wrench', 'Engineering and services', 'Proof of past work and fast quotes.', 'Website · Case pages · Quote form', '/services/websites'],
  ['home', 'Real estate', 'Listings, viewings and follow ups.', 'Listings site · Booking · Automation', '/services/automation'],
  ['rocket', 'Startups', 'Demand first, then the product.', 'Landing page · Brand · MVP', '/services/apps'],
];
---
<Page title="Industries · Built for how your business sells · Wintech Studio" description="Websites, AI assistants and brands tuned to fashion and beauty, food, wellness, engineering, real estate and startups in Nigeria." crumbs={[['Industries', '/industries']]}>
  <div class="dm">
  <section class="dm-top">
    <div class="wrap">
      <div class="dm-head c">
        <p class="dm-eb">Industries</p>
        <h1 class="dm-h1">Built for how your business actually sells.</h1>
        <p class="dm-intro">The same team, tuned to the questions your customers ask.</p>
      </div>
    </div>
  </section>
  <section class="dm-sec flush">
    <div class="wrap dm-grid g3">{cards.map(([i, t, d, tags, h]) => <a class="dm-card" href={h}><span class="ti"><span class="dm-ib"><Lc name={i} /></span><span class="dm-arrow"><Lc name="arrow-up-right" /></span></span><h2 class="dm-h3">{t}</h2><p class="dm-body">{d}</p><span class="tg">{tags}</span></a>)}</div>
  </section>
  </div>
</Page>
<style>
  .dm-card{min-height:240px}
  .ti{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
  .tg{margin-top:auto;padding-top:8px;font-size:13px;line-height:18px;color:var(--lab)}
  a:hover h2{color:var(--sig)}
  @media (max-width:1023px){.dm-card{min-height:0}}
</style>
