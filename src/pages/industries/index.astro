---
import Page from '../../layouts/Page.astro';
import Icon from '../../components/Icon.astro';
import Bi from '../../components/tools/Bi.astro';
import '../../components/search/search.css';
// Figma X1. Only salons has its own page so far; the other cards point at the service that fits them best.
const cards = [
  ['bag', 'Fashion and beauty', 'Lookbooks, sizes, DMs that turn into orders.', 'Store · AI replies · Packaging', '/industries/salons'],
  ['gift', 'Food and drinks', 'Menus, delivery areas, catering enquiries.', 'Menu site · Orders · Film', '/services/websites'],
  ['heart', 'Wellness', 'Trust, expiry dates, product questions.', 'Store · AI assistant · Brand', '/work/virelle'],
  ['shield', 'Engineering and services', 'Proof of past work and fast quotes.', 'Website · Case pages · Quote form', '/services/websites'],
  ['home', 'Real estate', 'Listings, viewings and follow ups.', 'Listings site · Booking · Automation', '/services/automation'],
  ['rocket', 'Startups', 'Demand first, then the product.', 'Landing page · Brand · MVP', '/services/apps'],
];
---
<Page title="Industries · Built for how your business sells · Wintech Studio" description="Websites, AI assistants and brands tuned to fashion and beauty, food, wellness, engineering, real estate and startups in Nigeria." crumbs={[['Industries', '/industries']]}>
  <section class="s-sec xh">
    <div class="wrap">
      <p class="s-k mute">Industries</p>
      <h1>Built for how your<br />business actually sells.</h1>
      <p class="ld">The same team, tuned to the questions your customers ask.</p>
    </div>
  </section>
  <section class="s-sec xg">
    <div class="wrap g">{cards.map(([i, t, d, tags, h]) => <a href={h}><span class="ti"><Bi name={i} size={56} /><Icon name="arrow-up-right" size={18} /></span><h2>{t}</h2><p>{d}</p><span class="tg">{tags}</span></a>)}</div>
  </section>
</Page>
<style>
  .xh{padding:56px 0 56px}
  h1{margin:16px 0;max-width:900px;font-size:68px;line-height:1.05;letter-spacing:-.02em;font-weight:600}
  .ld{margin:0;max-width:640px;font-size:18px;line-height:1.5;color:var(--fg-2)}
  .xg{padding:24px 0 112px}
  .g{display:grid;grid-template-columns:repeat(3,1fr);gap:48px 16px}
  a{display:flex;flex-direction:column;gap:12px;padding:28px;background:var(--surface);text-decoration:none;color:var(--fg);transition:background .2s}
  a:hover{background:var(--rule)}
  .ti{display:flex;justify-content:space-between;align-items:center;height:56px}
  .ti :global(svg:last-child){transition:transform .2s}a:hover .ti :global(svg:last-child){transform:translate(2px,-2px)}
  h2{margin:0;font-size:22px;font-weight:600;line-height:26px;letter-spacing:0}
  p{margin:0;max-width:320px;font-size:15px;line-height:1.5;color:var(--fg-2)}
  .tg{font:400 12px/16px var(--mono);color:var(--sig)}
  @media (max-width:1023px){
    .xh{padding:30px 0 24px}
    h1{font-size:34px;line-height:1.06;letter-spacing:-.015em}
    .ld{font-size:15px}
    .xg{padding:8px 0 56px}
    .g{grid-template-columns:1fr;gap:16px}
    a{padding:20px}
  }
</style>
