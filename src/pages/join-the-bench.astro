---
import Page from '../layouts/Page.astro';
import Field from '../components/ui/Field.astro';
const roles = [['Brand designer', 'Remote · per project', 'Identity, packaging, guidelines'], ['Product designer', 'Remote · per project', 'Flows, UI and design systems'], ['Frontend developer', 'Remote · per project', 'Astro, Next.js, Tailwind'], ['Full stack developer', 'Remote · per project', 'Supabase, APIs, payments'], ['Motion designer', 'Remote · per project', 'Explainers and launch films'], ['AI and automation engineer', 'Remote · per project', 'Assistants, n8n, WhatsApp'], ['Film and photo crew', 'Lagos · per shoot', 'Product and studio shoots']];
const how = [['A clear brief', 'Scope, references, deadline and the rate, before you start.'], ['One project lead', 'No client chasing. Questions go to one person.'], ['Reviewed work', 'Feedback in one thread, twice a week.'], ['Paid on delivery', 'Within 5 working days of approval.']];
---
<Page title="Join the bench · Wintech Studio" description="Designers, developers, film crews and AI engineers who want steady, well briefed projects. Wintech runs the client; you run the craft." crumbs={[['Join the bench', '/join-the-bench']]} closing={false}>
  <section class="sec">
    <div class="wrap">
      <p class="mono">Join the bench</p>
      <h1 class="h1">Do your best work.<br />We bring the clients.</h1>
      <p class="lede">Designers, developers, film crews and AI engineers who want steady, well briefed projects. Wintech runs the client; you run the craft.</p>
      <div class="grid g3 roles">{roles.map(([r, w, d]) => <div class="card"><h3>{r}</h3><p class="mono">{w}</p><p>{d}</p></div>)}</div>
    </div>
  </section>
  <section class="sec alt"><div class="wrap"><p class="mono">How it works</p><h2 class="h2">Briefed, reviewed, paid on time.</h2><ol class="grid g4 how">{how.map(([t, d], i) => <li class="card"><p class="mono">{String(i + 1).padStart(2, '0')}</p><h3>{t}</h3><p>{d}</p></li>)}</ol></div></section>
  <section class="sec" id="apply">
    <div class="wrap grid2">
      <div><p class="mono">Apply</p><h2 class="h2">Show us three things you are proud of.</h2><p class="lede">We review every application and reply when a project fits your craft.</p></div>
      <form class="card form" data-send="Bench application from wintechstudio.com">
        <Field label="Name" name="Name" placeholder="Your name" required />
        <Field label="Role" name="Role" options={roles.map(r => r[0])} />
        <Field label="Portfolio link" name="Portfolio" placeholder="Behance, Dribbble, GitHub or a site" required />
        <Field label="Rate" name="Rate" placeholder="Per project or per day, in USD or naira" />
        <div class="send"><button class="btn btn-primary" type="submit" value="whatsapp">Send on WhatsApp</button><button class="btn btn-outline" type="submit" value="email">Send by email</button></div>
        <p class="sent" hidden>Your application is ready. Press send in WhatsApp or your email app.</p>
      </form>
    </div>
  </section>
</Page>
<style>
  .roles{margin-top:40px}.roles h3{font-size:18px;margin:0 0 4px}.how{list-style:none;padding:0;margin-top:40px}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start}.form{display:grid;gap:22px;padding:32px}.send{display:flex;gap:10px;flex-wrap:wrap}.sent{color:#1A7F4B;font-size:14px;margin:0}
  @media (max-width:1023px){.grid2{grid-template-columns:1fr;gap:32px}}
</style>
