---
import Page from '../layouts/Page.astro';
import Field from '../components/ui/Field.astro';
import Lc from '../components/ui/Lc.astro';
import '../styles/studio.css';
const roles = [['palette', 'Brand designer', 'Remote · per project', 'Identity, packaging, guidelines'], ['pen', 'Product designer', 'Remote · per project', 'Flows, UI and design systems'], ['code', 'Frontend developer', 'Remote · per project', 'Astro, Next.js, Tailwind'], ['database', 'Full stack developer', 'Remote · per project', 'Supabase, APIs, payments'], ['film', 'Motion designer', 'Remote · per project', 'Explainers and launch films'], ['bot', 'AI and automation engineer', 'Remote · per project', 'Assistants, n8n, WhatsApp'], ['camera', 'Film and photo crew', 'Lagos · per shoot', 'Product and studio shoots']];
const how = [['A clear brief', 'Scope, references, deadline and the rate, before you start.'], ['One project lead', 'No client chasing. Questions go to one person.'], ['Reviewed work', 'Feedback in one thread, twice a week.'], ['Paid on delivery', 'Within 5 working days of approval.']];
---
<Page title="Join the bench · Wintech Studio" description="Designers, developers, film crews and AI engineers who want steady, well briefed projects. Wintech runs the client; you run the craft." crumbs={[['Join the bench', '/join-the-bench']]} closing={false}>
  <div class="dm jb">
    <section class="dm-top">
      <div class="wrap">
        <div class="dm-head c">
          <p class="dm-eb">Join the bench</p>
          <h1 class="dm-h1">Do your best work. We bring the clients.</h1>
          <p class="dm-intro">Designers, developers, film crews and AI engineers who want steady, well briefed projects. Wintech runs the client; you run the craft.</p>
          <div class="dm-ctas cc"><a class="dm-btn p" href="#apply">Apply</a></div>
        </div>
      </div>
    </section>

    <section class="dm-sec line">
      <div class="wrap">
        <div class="dm-head c"><p class="dm-eb">Open roles</p><h2 class="dm-h2">Who we work with</h2></div>
        <ul class="dm-rows rl">{roles.map(([ic, r, w, d]) => (
          <li><a href="#apply" data-role={r}>
            <span class="dm-ib s36"><Lc name={ic} size={18} /></span>
            <span class="rt"><strong>{r}</strong><small>{d}</small></span>
            <span class="wd">{w}</span>
            <span class="dm-arrow"><Lc name="arrow-right" /></span>
          </a></li>
        ))}</ul>
      </div>
    </section>

    <section class="dm-sec alt">
      <div class="wrap">
        <div class="dm-head c"><p class="dm-eb">How it works</p><h2 class="dm-h2">Briefed, reviewed, paid on time.</h2></div>
        <ol class="dm-cells c4 hg">{how.map(([t, d], i) => <li><span class="dm-num">{String(i + 1).padStart(2, '0')}</span><h3 class="dm-h3">{t}</h3><p class="dm-body">{d}</p></li>)}</ol>
      </div>
    </section>

    <section class="dm-sec" id="apply">
      <div class="wrap dm-split">
        <div class="dm-head"><p class="dm-eb">Apply</p><h2 class="dm-h2s">Show us three things you are proud of.</h2><p class="dm-intro">A portfolio link is enough. We reply when a project fits your craft.</p></div>
        <form class="dm-form form" data-send="Bench application from wintechstudio.com">
          <Field label="Name" name="Name" placeholder="Your name" required autocomplete="name" />
          <Field label="Role" name="Role" placeholder="Brand designer" suggest={roles.map(r => r[1])} required />
          <Field label="Portfolio link" name="Portfolio" placeholder="Behance, Dribbble, GitHub or a site" required />
          <Field label="Rate" name="Rate" placeholder="Per project or per day, in USD or naira" />
          <div class="dm-send">
            <button class="dm-btn p" type="submit" value="whatsapp">Send application</button>
            <p>Opens WhatsApp. <button class="dm-plain" type="submit" value="email">Send by email instead</button></p>
          </div>
          <p class="dm-sent sent" hidden>Your application is ready. Press send in WhatsApp or your email app.</p>
        </form>
      </div>
    </section>
  </div>
</Page>
<script>
  // Picking a role pre-fills the application form.
  document.querySelectorAll<HTMLAnchorElement>('.jb [data-role]').forEach(a => a.addEventListener('click', () => {
    const f = document.getElementById('f-role') as HTMLInputElement | null;
    if (f) { f.value = a.dataset.role || ''; setTimeout(() => document.getElementById('f-name')?.focus({ preventScroll: true }), 400); }
  }));
</script>
<style>
  .cc{justify-content:center;margin-top:8px}
  .rl{margin-top:80px}
  .rl a{display:flex;align-items:center;gap:16px;padding:20px 0;text-decoration:none;color:var(--fg)}
  .rt{flex:1;display:flex;flex-direction:column;min-width:0}
  .rt strong{font-size:20px;line-height:26px;font-weight:600;letter-spacing:-.2px}
  .rt small{font-size:14px;line-height:21px;color:var(--mute)}
  .rl a:hover strong{color:var(--sig)}
  .wd{font-size:14px;line-height:21px;color:var(--lab);white-space:nowrap}
  .hg{list-style:none;padding:0;margin-top:80px}
  .form{background:var(--panel);padding:32px}
  @media (max-width:1023px){
    .cc{margin-top:16px}
    .rl,.hg{margin-top:40px}
    .rl a{gap:12px;padding:16px 0;align-items:flex-start}
    .rl .dm-arrow{display:none}
    .rt strong{font-size:17px;line-height:24px}
    .wd{display:none}
    .form{padding:20px 16px;margin:0 -16px}
  }
</style>
