---
import Page from '../layouts/Page.astro';
import services from '../data/services.json';
import { services as names } from '../data/site';
import '../styles/studio.css';
// "Likely starting point" comes straight from services.json.
const start = Object.fromEntries(services.map(s => [s.slug, `${s.price.replace(/^from /, '').replace(/ \+ .*/, '')} · ${s.timeline}`]));
const byName = Object.fromEntries(names.map(n => [n.name, n.slug]));
---
<Page title="Brief sent · Wintech Studio" description="Your brief is on its way to the Wintech project lead, who replies within one working day." closing={false}>
  <div class="dm">
    <section class="dm-sec sent">
      <div class="wrap in">
        <svg class="face" width="116" height="106" viewBox="0 0 116 106" fill="none" aria-hidden="true"><path d="M28.8 7.2h57.6a24 24 0 0 1 24 24V60a24 24 0 0 1-24 24H36L20.16 94.56a1.08 1.08 0 0 1-2.64-1.44V82.08A24 24 0 0 1 4.8 60V31.2a24 24 0 0 1 24-24Z" fill="url(#fa)"/><path d="M28.8 7.2h57.6a24 24 0 0 1 24 24V60a24 24 0 0 1-24 24H36L20.16 94.56a1.08 1.08 0 0 1-2.64-1.44V82.08A24 24 0 0 1 4.8 60V31.2a24 24 0 0 1 24-24Z" fill="url(#fb)"/><path d="M33.6 42c2.88-7.2 11.52-7.2 14.4 0m19.2 0c2.88-7.2 11.52-7.2 14.4 0" stroke="#F4F6FA" stroke-width="5.76" stroke-linecap="round"/><path d="m48 57.6 9.6 8.16 9.6-8.16" stroke="#F4F6FA" stroke-width="5.04" stroke-linecap="round" stroke-linejoin="round"/><defs><linearGradient id="fa" x1="4.8" y1="7.2" x2="90.9" y2="111" gradientUnits="userSpaceOnUse"><stop stop-color="#1E2A44"/><stop offset="1" stop-color="#0A0E17"/></linearGradient><linearGradient id="fb" x1="4.8" y1="7.2" x2="4.8" y2="94.9" gradientUnits="userSpaceOnUse"><stop stop-color="#fff" stop-opacity=".18"/><stop offset=".5" stop-color="#fff" stop-opacity="0"/></linearGradient></defs></svg>
        <div class="dm-head c">
          <p class="dm-eb">Brief sent</p>
          <h1 class="dm-h1">Got it. We read it before we talk.</h1>
          <p class="dm-intro">Your message opened in WhatsApp or your email app; once you press send it reaches us. The project lead replies within one working day with a time, or a question if something is unclear.</p>
        </div>
        <div class="card" id="card">
          <div class="r"><span>Brief ID</span><b id="bid">-</b></div>
          <div class="r" id="r-svc"><span>Service</span><b id="bsvc">-</b></div>
          <div class="r" id="r-call"><span>Call</span><b id="bcall">-</b></div>
          <div class="r" id="r-start"><span>Likely starting point</span><b id="bstart">-</b></div>
        </div>
        <div class="dm-ctas cc"><a class="dm-btn p" id="ics" href="#" download="wintech-call.ics">Add it to my calendar</a><a class="dm-btn s" href="/work">See our work</a></div>
      </div>
    </section>
  </div>
</Page>
<script is:inline define:vars={{ start, byName }}>
(function(){
  var s=null;try{s=JSON.parse(sessionStorage.getItem('wt-sent')||'null')}catch(e){}
  var $=function(i){return document.getElementById(i)};
  if(!s){$('card').hidden=true;$('ics').hidden=true;return}
  $('bid').textContent=s.id;
  var slug=s.slug&&start[s.slug]?s.slug:byName[s.service];
  if(s.service)$('bsvc').textContent=s.service;else $('r-svc').hidden=true;
  if(s.when)$('bcall').textContent=s.when;else{$('bcall').textContent='The project lead proposes a time'}
  if(slug)$('bstart').textContent=start[slug];else $('r-start').hidden=true;
  if(!s.iso){$('ics').hidden=true;return}
  // the call time is in WAT (UTC+1)
  var d=new Date(s.iso+':00+01:00'),e=new Date(d.getTime()+25*6e4),z=function(x){return x.toISOString().replace(/[-:]/g,'').replace(/\.\d+/,'')};
  var ics=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//Wintech Studio//Booking//EN','BEGIN:VEVENT','UID:'+s.id+'@wintechstudio.com','DTSTAMP:'+z(new Date()),'DTSTART:'+z(d),'DTEND:'+z(e),'SUMMARY:Call with Wintech Studio','DESCRIPTION:25 minute call with the project lead. Brief '+s.id+'. Time to be confirmed by Wintech.','END:VEVENT','END:VCALENDAR'].join('\r\n');
  $('ics').href=URL.createObjectURL(new Blob([ics],{type:'text/calendar'}));
})();
</script>
<style>
  .in{display:flex;flex-direction:column;align-items:center;gap:32px}
  .face{width:72px;height:66px}
  .card{width:560px;max-width:100%;border:1px solid var(--hl)}
  .r{display:flex;justify-content:space-between;gap:16px;padding:12px 20px;font-size:14px;line-height:21px}
  .r+.r{border-top:1px solid var(--hl)}
  .r span{color:var(--lab)}.r b{font-weight:500;text-align:right}
  .card[hidden],.r[hidden],#ics[hidden]{display:none}
  .cc{justify-content:center}
  @media (max-width:1023px){
    .in{align-items:flex-start;gap:24px}
    .face{width:56px;height:52px}
    .r{padding:12px 16px}
  }
</style>
