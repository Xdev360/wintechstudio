---
import Page from '../layouts/Page.astro';
import Lc from '../components/ui/Lc.astro';
import '../styles/studio.css';
// [name, short (mobile), detail, the AI drafts, we decide, when]
const steps = [
  ['Brief', 'Your ticks, read before we talk.', 'Your ticks from the service page, read before we talk.', 'Compiles your picks and links into one page.', 'Decide if we are a fit, honestly.', 'Day 1'],
  ['Study', 'Business model, money flows, competitors.', 'Business model, money flows, competitors.', 'Drafts the competitor scan.', 'Decide what matters first.', 'Week 1'],
  ['Proposal', 'Scope, price, dates, signed first.', 'Scope, price and dates, signed before work.', 'Formats the proposal.', 'Set the scope and the order.', 'Week 1'],
  ['Build weekly', 'Something new every Friday.', 'Something new every Friday.', 'Drafts variations, code and checks.', 'Choose, refine, approve.', 'Weeks 2 to 6'],
  ['Polish and ship', 'The last 10% that feels expensive.', 'The last 10% that makes it feel expensive.', 'Runs checks on every page.', 'Final QA and your sign off.', 'Launch'],
  ['Run it', 'Docs, training, care plan.', 'Docs, training, and a care plan if you want.', 'Answers customers, runs automations.', 'Retrain, report, improve.', 'After'],
];
const team = [['palette', 'Brand'], ['pen', 'Design'], ['code', 'Development'], ['film', 'Film'], ['bot', 'AI and automation']];
const ld = { '@context': 'https://schema.org', '@type': 'HowTo', name: 'How Wintech Studio runs a project', step: steps.map(([n, , d], i) => ({ '@type': 'HowToStep', position: i + 1, name: n, text: d })) };
---
<Page title="How we work · Wintech Studio" description="You talk to one project lead. Behind them sit designers, developers, a film crew and the AI. Six steps from brief to a system you can run." crumbs={[['How we work', '/how-we-work']]} jsonld={[ld]}>
  <div class="dm hw">
    <section class="dm-top">
      <div class="wrap">
        <div class="dm-head c">
          <p class="dm-eb">How we work</p>
          <h1 class="dm-h1">AI does the legwork. People make the calls.</h1>
          <p class="dm-intro">You talk to one project lead. Behind them sit designers, developers, a film crew and the AI. Nothing ships until you say yes.</p>
        </div>
      </div>
    </section>

    <section class="dm-sec alt">
      <div class="wrap">
        <div class="dm-head c"><p class="dm-eb">The model</p><h2 class="dm-h2">Who talks to whom</h2></div>
        <div class="dg">
          <div class="dm-card nd"><span class="dm-ib s36"><Lc name="user" size={18} /></span><h3 class="dm-h3">You</h3><p class="dm-small">Two check ins a week, one thread.</p></div>
          <div class="ln"><span class="dm-eb">One thread</span><i></i></div>
          <div class="dm-card nd lead"><span class="dm-ib s36"><Lc name="sparkles" size={18} /></span><h3 class="dm-h3">Project lead</h3><p class="dm-small">Plans, briefs, reviews every piece.</p></div>
          <div class="ln"><span class="dm-eb">Briefs and reviews</span><i></i></div>
          <ul class="tm">{team.map(([ic, t]) => <li><span class="dm-ib s28"><Lc name={ic} /></span><span>{t}</span></li>)}</ul>
        </div>
      </div>
    </section>

    <section class="dm-sec">
      <div class="wrap dm-stick">
        <div class="dm-head"><p class="dm-eb">Six steps</p><h2 class="dm-h2s">From brief to a system you can run.</h2><p class="dm-intro">Something new every Friday. Nothing ships until you say yes.</p><a class="dm-link" href="/book">Book a call</a></div>
        <ol class="dm-rows st">{steps.map(([n, , d, ai, we, when], i) => (
          <li>
            <div class="st-n"><span class="dm-num">{String(i + 1).padStart(2, '0')}</span><span class="dm-eb">{when}</span></div>
            <div class="st-t"><h3 class="dm-h3">{n}</h3><p class="dm-body">{d}</p></div>
            <div class="st-b"><p class="dm-eb">The AI drafts</p><p>{ai}</p></div>
            <div class="st-b we"><p class="dm-eb">We decide</p><p>{we}</p></div>
          </li>
        ))}</ol>
      </div>
    </section>
  </div>
</Page>
<style>
  .dg{display:grid;grid-template-columns:1fr 140px 1fr 140px 1fr;align-items:center}
  .nd{align-items:flex-start}
  .lead{border-color:var(--fg)}
  .ln{display:flex;flex-direction:column;align-items:center;gap:8px;padding:0 12px}
  .ln span{white-space:nowrap}
  .ln i{display:block;width:100%;height:1px;background:var(--sig)}
  .tm{list-style:none;padding:4px 0;margin:0;border:1px solid var(--hl);background:var(--bg)}
  .tm li{display:flex;align-items:center;gap:12px;height:44px;padding:8px 16px;font-size:16px;font-weight:500;line-height:24px}
  .st li{display:grid;grid-template-columns:96px minmax(0,1fr) minmax(0,1fr);gap:16px 20px;align-items:start;padding:32px 0}
  .st-t{grid-column:2 / 4}
  .st-n{grid-row:span 2}
  .st-n{display:flex;flex-direction:column;gap:6px}
  .st-n .dm-num{font-size:20px;line-height:26px;font-weight:600;color:var(--fg)}
  .st-t{display:flex;flex-direction:column;gap:6px}
  .st-b{padding:16px;display:flex;flex-direction:column;gap:6px;background:var(--panel)}
  .st-b.we{background:color-mix(in srgb,var(--sig) 7%,var(--bg))}
  .st-b p:last-child{font-size:14px;line-height:21px}
  @media (max-width:1023px){
    .dg{grid-template-columns:1fr;gap:0}
    .ln{flex-direction:row;justify-content:flex-start;gap:12px;padding:12px 0 12px 16px}
    .ln i{width:1px;height:24px;order:-1}
    .st li{grid-template-columns:1fr;gap:12px;padding:20px 0}
    .st-t{grid-column:auto}.st-n{grid-row:auto}
    .st-n{flex-direction:row;align-items:baseline;gap:12px}
  }
</style>
