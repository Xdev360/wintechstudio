---
import Page from '../layouts/Page.astro';
import Lc from '../components/ui/Lc.astro';
import '../styles/studio.css';
import fs from 'node:fs';
import path from 'node:path';
// Founder portrait: drop public/images/team/oladele-portrait.webp (4:5, at least 800x1000) or the square oladele.webp.
const pf = ['oladele-portrait.webp', 'oladele.webp'].find(f => fs.existsSync(path.join(process.cwd(), 'public/images/team', f)));
const portrait = pf ? `/images/team/${pf}` : null;
const linkedin = 'https://www.linkedin.com/in/ibraheem-oladele-302254333';
const ld = { '@context': 'https://schema.org', '@type': 'AboutPage', name: 'About Wintech Studio', mainEntity: { '@type': 'Person', name: 'Oladele Ibraheem', jobTitle: 'Founder and project lead', sameAs: ['https://www.linkedin.com/in/ibraheem-oladele-302254333'], worksFor: { '@type': 'Organization', name: 'Wintech Studio' } } };
const facts = [['Lagos', 'working worldwide'], ['2020', 'when Wintech started'], ['1', 'project lead per client'], ['A few', 'projects at a time']];
const films = [['mylo', 'Mylo', 'Our own product'], ['virelle', 'Virelle Wellness', 'Brand, store, packaging'], ['tobel-pearls', 'Tobel Pearls', 'Brand identity']];
const bench = [['palette', 'Brand designers'], ['pen', 'Product designers'], ['code', 'Developers'], ['camera', 'Film and photo'], ['bot', 'AI engineers']];
---
<Page title="About · Wintech Studio" description="A Lagos design and build studio. We make the brand, the website or store, the AI and the automation a business runs on." crumbs={[['About', '/about']]} jsonld={[ld]}>
  <div class="dm ab">
    <section class="dm-top">
      <div class="wrap">
        <div class="dm-head c">
          <p class="dm-eb">About Wintech</p>
          <h1 class="dm-h1">The team founders never had.</h1>
          <p class="dm-intro">A Lagos design and build studio. We make the brand, the website or store, the AI and the automation a business runs on.</p>
        </div>
        <dl class="dm-grid g4 facts">{facts.map(([a, b]) => <div class="dm-stat"><dt><b>{a}</b></dt><dd><span>{b}</span></dd></div>)}</dl>
        <div class="dm-grid g3 films">{films.map(([s, n, t]) => (
          <a class="film" href={`/work/${s}`}>
            <span class="dm-media fmv" data-pfx="0.06"><img src={`/images/cases/film-${s}-800.webp`} alt={`${n} case study`} width="1292" height="727" loading="lazy" decoding="async" /></span>
            <span class="fc"><strong>{n}</strong><span>{t}</span></span>
          </a>
        ))}</div>
      </div>
    </section>

    <section class="dm-sec alt">
      <div class="wrap dm-stick note-g">
        <div class="dm-head fhead">
          <p class="dm-eb">A note from the founder</p><h2 class="dm-h2s">Built to be the team I never had.</h2>
          <figure class="fcard">
            {portrait ? <img src={portrait} alt="Oladele Ibraheem, founder of Wintech Studio" width="800" height="1000" loading="lazy" decoding="async" /> : <span class="fph" aria-hidden="true">OI</span>}
            <figcaption><strong>Oladele Ibraheem</strong><span>Founder and project lead, Lagos</span><a href={linkedin} target="_blank" rel="noopener">LinkedIn</a></figcaption>
          </figure>
        </div>
        <article class="note">
          <p>Good ideas don't die because they were bad. They die because one person is doing six jobs, or managing five freelancers who never talk to each other.</p>
          <p>So you talk to one project lead. Behind that person sit the designers, developers, film crew and the AI. One plan, one price, something new every week.</p>
          <p>I started Wintech in 2020 and I still lead every project myself. When you work with us, the person you meet on the first call is the person accountable for the result.</p>
          <p>We take a few projects at a time and say no when we are not the right fit.</p>
          <svg class="sig" width="160" height="52" viewBox="0 0 160 52" fill="none" aria-hidden="true"><path pathLength="1" d="M6 36.0006C16 18.0006 32 10.0006 36 22.0006C40 34.0006 22 44.0006 18 34.0006C14 24.0006 40 10.0006 48 14.0006C56 18.0006 42 40.0006 52 36.0006C62 32.0006 66 8.00064 72 12.0006C78 16.0006 64 34.0006 74 32.0006C84 30.0006 86 16.0006 92 18.0006C98 20.0006 88 30.0006 98 28.0006C106 26.0006 112 18.0006 120 18.0006C128 18.0006 124 28.0006 134 26.0006" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <p class="by">Oladele Ibraheem · Founder and project lead</p>
        </article>
      </div>
    </section>

    <section class="dm-sec">
      <div class="wrap dm-stick">
        <div class="dm-head"><p class="dm-eb">Who we build for</p><h2 class="dm-h2s">Good fits, and poor ones.</h2></div>
        <div class="dm-grid fg">
          <div class="dm-card"><p class="dm-eb">We build for</p><ul class="dm-ticks">{['Owners whose product already sells', 'Businesses running before tech was part of it', 'Founders with proof of demand or money in hand', 'People who will keep running it after launch'].map(t => <li><Lc name="check" class="ok" />{t}</li>)}</ul></div>
          <div class="dm-card"><p class="dm-eb">We are a poor fit if</p><ul class="dm-ticks">{['You want the cheapest quote in town', 'You need it yesterday with no plan', 'You want us to run the business for you', 'You cannot spare two hours a week'].map(t => <li><Lc name="x" class="no" />{t}</li>)}</ul></div>
        </div>
      </div>
    </section>

    <section class="dm-sec line">
      <div class="wrap dm-stick">
        <div class="dm-head"><p class="dm-eb">The bench</p><h2 class="dm-h2s">Specialists behind the curtain.</h2><p class="dm-intro">Wintech keeps the relationship, the strategy and the standard. Named partners produce under our brief and our review.</p><div class="bc"><a class="dm-btn s mw" href="/join-the-bench">Join the bench</a></div></div>
        <ul class="dm-rows bl">{bench.map(([ic, t]) => <li><span class="dm-ib s36"><Lc name={ic} size={18} /></span><span>{t}</span></li>)}</ul>
      </div>
    </section>
  </div>
</Page>
<script>
  const sig = document.querySelector('.ab .sig');
  if (sig) new IntersectionObserver((es, o) => es.forEach(e => { if (e.isIntersecting) { sig.classList.add('in'); o.disconnect(); } }), { threshold: .6 }).observe(sig);
</script>
<style>
  .facts{margin:64px 0 0}
  .facts dd{margin:0}
  .films{margin-top:20px}
  .film{display:flex;flex-direction:column;border:1px solid var(--hl);padding:8px;text-decoration:none;color:var(--fg);transition:border-color .15s}
  .film:hover{border-color:var(--hl2)}
  .fmv{display:block;aspect-ratio:16/10}
  .fmv img{will-change:transform}
  .fc{display:flex;justify-content:space-between;gap:12px;padding:12px 8px 4px;font-size:14px;line-height:21px}
  .fc strong{font-weight:600}.fc span{color:var(--mute)}
  .film:hover strong{color:var(--sig)}
  .note{max-width:640px;display:flex;flex-direction:column;gap:16px}
  .note>p:not(.dm-eb):not(.by){font-size:18px;line-height:27px;color:var(--mute)}
  .sig{color:var(--fg);display:block;margin-top:8px}
  .sig path{stroke-dasharray:1;stroke-dashoffset:1;animation:draw 1.2s ease-out .2s forwards;animation-play-state:paused}
  .sig.in path{animation-play-state:running}
  @keyframes draw{to{stroke-dashoffset:0}}
  @media (prefers-reduced-motion:reduce){.sig path{animation:none;stroke-dashoffset:0}}
  .by{font-size:14px;line-height:21px;color:var(--lab)}
  .fcard{margin:16px 0 0;width:100%;max-width:300px;border:1px solid var(--hl);background:var(--bg);padding:8px}
  .fcard img,.fph{display:block;width:100%;aspect-ratio:4/5;object-fit:cover;background:var(--panel)}
  .fph{display:grid;place-items:center;background:#3B5BFF;color:#fff;font:600 48px/1 var(--font);letter-spacing:1px}
  .fcard figcaption{display:flex;flex-direction:column;gap:2px;padding:12px 8px 4px;font-size:14px;line-height:21px}
  .fcard strong{font-weight:600}.fcard figcaption span{color:var(--mute)}
  .fcard a{margin-top:6px;color:var(--fg);font-weight:500;text-decoration:underline;text-underline-offset:3px}.fcard a:hover{color:var(--sig)}
  .fg .dm-card{padding:32px;gap:16px}
  .fg :global(.ok){color:var(--ok)}
  .fg :global(.no){color:var(--err)}
  .bl li{display:flex;align-items:center;gap:16px;padding:24px 0;font-size:20px;font-weight:600;line-height:26px;letter-spacing:-.2px}
  .bc{margin-top:8px}
  @media (max-width:1023px){
    .facts{margin-top:32px;grid-template-columns:1fr 1fr!important;gap:12px}
    .facts .dm-stat{padding:16px}
    .films{margin-top:12px;gap:12px}
    .note>p:not(.dm-eb):not(.by){font-size:16px;line-height:24px}
    .fcard{max-width:220px}
    .fg .dm-card{padding:20px}
    .bl li{padding:14px 0;font-size:17px;line-height:24px}
    .bc{margin-top:8px}
  }
</style>
