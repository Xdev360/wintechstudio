---
// Partners (Nov 2026): the yearly website partnership and company operating system.
// Design: Figma kQl8LQLi5xdRVVyXF3R4NZ, page "Website · v5", frame "S19 · Partnerships · light" (1445:23089).
// No price is shown: the fee is quoted after a call (never invent prices).
import Page from '../layouts/Page.astro';
const who: [string, string, string][] = [
  ['rocket', 'Startups', 'You have a product and a launch date. We keep the site, the waitlist and the admin moving while you build the company.'],
  ['layers', 'Agencies', 'You sell the brand and the strategy. We build and run the sites behind it for your clients, under your name if you want.'],
  ['store', 'Businesses', 'Shops, clinics, schools and service firms in any country. Your site takes orders and bookings, and your team works from one place.'],
];
const parts: { n: string; t: string; d: string; items: string[]; dark?: boolean }[] = [
  { n: '01', t: 'Website care', d: 'We keep it fresh and fast. You never log in to fix anything.', items: ['New pages, products and posts', 'Copy, images and price changes', 'Speed, uptime and security watch', 'Hosting, domain and backups', 'A monthly change report'] },
  { n: '02', t: 'Wired for sales', d: 'Every visit has a next step, and every lead lands somewhere.', items: ['Forms, booking and WhatsApp', 'Payments and checkout', 'Email and follow ups', 'The Ask AI assistant', 'Analytics you can read'] },
  { n: '03', t: 'Your company OS', d: 'The tools your team works in, built for how you run.', items: ['Admin panel for orders and content', 'Client or student portal', 'Staff tasks and approvals', 'Dashboards for the numbers', 'Automations that join it up'], dark: true },
];
// Operating system diagram: node positions as % of the diagram box, core in the middle.
const nodes: [string, number, number, string][] = [
  ['Website', 15, 17, 'globe'], ['Admin', 50, 10, 'layout'], ['Client portal', 85, 17, 'users'],
  ['Payments', 11, 55, 'card'], ['WhatsApp and email', 89, 55, 'message'],
  ['Staff tasks', 25, 88, 'check'], ['AI assistant', 50, 92, 'sparkles'], ['Dashboards', 75, 88, 'chart'],
];
const year: [string, string, string][] = [
  ['Month 1', 'Diagnose and wire', 'We audit the site and the tools, fix what is broken, and connect forms, payments and messages.'],
  ['Months 2 and 3', 'Build the system', 'The admin, the portal and the automations your team needs, designed with you and shipped in weekly builds.'],
  ['Every month', 'Updates and a report', 'New pages and content, speed and security checks, and one short report on what changed and what it did.'],
  ['Every quarter', 'Review the roadmap', 'We look at the numbers together and agree what to build next. New ideas go into the plan, not a new quote.'],
];
const proof: [string, string, string, string, string][] = [
  ['virelle', 'Virelle Wellness', 'Store, admin and AI assistant', 'Orders, stock and delivery in one admin, with an AI that answers customers day and night.', '/images/cases/cover-virelle.webp'],
  ['manzeelatur-ridho', 'Manzeelatur Ridho', 'App, parent space and ustadh panel', 'Children learn, parents pay and track, and the ustadh runs classes from one panel.', '/images/cases/cover-manzeelatur-ridho.webp'],
  ['mylo', 'Mylo', 'App, desktop app and admin', 'Rooms, rewards and releases run from one admin panel, without touching code.', '/images/cases/cover-mylo.webp'],
];
const faq: [string, string][] = [
  ['Do we own the website and the system?', 'Yes. Every account, domain and file sits in your name. If you leave, everything stays with you.'],
  ['Can you take over a site someone else built?', 'Yes. We start with an audit, fix what is broken, then move it into the plan.'],
  ['What if we need something new mid year?', 'It goes on the roadmap and into a monthly build. No surprise invoices.'],
  ['Can agencies sell this under their own name?', 'Yes. We work behind your brand and report to you, not your client.'],
  ['Where are your partners based?', 'Anywhere. We work from Lagos with clients across Nigeria, the UK, the US and beyond, on calls, WhatsApp and one shared thread.'],
];
const flow = ['New order on the site', 'WhatsApp to the customer', 'Task for the packer', 'Shows on your dashboard'];
const ld = { '@context': 'https://schema.org', '@type': 'Service', name: 'Wintech Partner: yearly website partnership', provider: { '@type': 'Organization', name: 'Wintech Studio' }, areaServed: 'Worldwide', description: 'A yearly partnership: website care, wiring the site to sales, and a company operating system with admin, portal, dashboards and automations.' };
const ic: Record<string, string> = {
  globe: '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
  layout: '<rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/>',
  users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  card: '<rect width="20" height="14" x="2" y="5" rx="2"/><path d="M2 10h20"/>',
  message: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>',
  check: '<path d="M21.801 10A10 10 0 1 1 17 3.335"/><path d="m9 11 3 3L22 4"/>',
  sparkles: '<path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/>',
  chart: '<path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>',
  rocket: '<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>',
  layers: '<path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>',
  store: '<path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"/><path d="M2 7h20"/>',
  tick: '<path d="M20 6 9 17l-5-5"/>',
};
const svg = (n: string, s = 20) => `<svg xmlns="http://www.w3.org/2000/svg" width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ic[n]}</svg>`;
---
<Page title="Partners · Wintech Studio" description="A yearly website partnership for startups, agencies and businesses worldwide. We keep your website fresh, wire it to sales and build your company's operating system: admin, portal and automations." crumbs={[['Partners', '/partners']]} jsonld={[ld]}>
  <div class="pt">
    <!-- Hero -->
    <section class="hero">
      <div class="wrap hc">
        <p class="chip rv"><i></i>Wintech Partner · yearly</p>
        <h1 class="rv d1"><span>We run your website.</span><span>You run the company.</span></h1>
        <p class="intro rv d2">A yearly partnership for startups, agencies and businesses anywhere in the world. We keep your website fresh, wire it to sales, and build the operating system behind it: the admin, the portal and the automations. You do not need to touch a thing.</p>
        <div class="ctas rv d3"><a class="btn p" href="/book?service=partner">Book a partner call</a><a class="btn s" href="#included">See what's included</a></div>
      </div>
      <div class="wrap">
        <div class="bento">
          <figure class="tile web rv d2">
            <span class="live"><i></i>virellewellnesshub.com · live</span><span class="lab">Website</span>
            <div class="scr"><img src="/images/partners/site-virelle.webp" width="1440" height="1000" alt="The Virelle Wellness Hub store we designed and built" fetchpriority="high" /></div>
          </figure>
          <figure class="tile adm rv d3">
            <span class="lab">Admin</span>
            <div class="scr"><img src="/images/partners/admin.webp" width="1440" height="900" alt="An admin overview with requests, payouts and today's tasks (sample figures)" loading="lazy" /></div>
          </figure>
          <figure class="tile por rv d4">
            <span class="lab">Portal</span>
            <div class="scr"><img src="/images/partners/portal-virelle.webp" width="390" height="900" alt="A customer tracking an order in the Virelle portal" loading="lazy" /></div>
          </figure>
          <figure class="tile aut rv d5" aria-label="An automation: a new order sends a WhatsApp, makes a task and shows on the dashboard">
            <span class="lab">Automations</span>
            <ol class="flow">{flow.map((f, i) => <li style={`--i:${i}`}><i></i>{f}</li>)}</ol>
          </figure>
        </div>
      </div>
    </section>

    <!-- Who -->
    <section class="sec">
      <div class="wrap">
        <div class="head c rv"><p class="eb">Who we partner with</p><h2>Built for teams that would rather not run their own tech.</h2></div>
        <div class="who">{who.map(([i, t, d], k) => <div class="card rv" style={`--d:${k * 90}ms`}><span class="ib" set:html={svg(i, 22)} /><h3>{t}</h3><p>{d}</p></div>)}</div>
      </div>
    </section>

    <!-- Included -->
    <section class="sec mist" id="included">
      <div class="wrap">
        <div class="head rv"><p class="eb">What's in the partnership</p><h2>Three parts, one yearly plan.</h2><p class="lead">One team looks after all of it, and you get one report a month that says what changed.</p></div>
        <div class="parts">{parts.map((p, k) => (
          <div class:list={['part rv', { dark: p.dark }]} style={`--d:${k * 110}ms`}>
            <p class="pn">{p.n}</p><h3>{p.t}</h3><p class="pd">{p.d}</p>
            <ul>{p.items.map(it => <li><span class="ck" set:html={svg('tick', 12)} />{it}</li>)}</ul>
          </div>))}
        </div>
      </div>
    </section>

    <!-- OS diagram -->
    <section class="sec">
      <div class="wrap">
        <div class="head c rv"><p class="eb">The operating system</p><h2>Every part talks to every other part.</h2><p class="lead">An order on the site shows in the admin. The customer gets a message, the team gets a task, and you see it on one dashboard. Nothing is copied by hand.</p></div>
        <div class="os" id="os">
          <div class="grid" aria-hidden="true">{Array.from({ length: 18 }).map(() => <i />)}</div>
          <svg class="wires" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {nodes.map(([, x, y], k) => <><path class="w" d={`M50 50 L${x} ${y}`} style={`--k:${k}`} /><path class="pulse" pathLength="100" d={`M50 50 L${x} ${y}`} style={`--k:${k}`} /></>)}
          </svg>
          <div class="core"><strong>Your company OS</strong><span>Built and run by Wintech</span></div>
          {nodes.map(([n, x, y, i], k) => <div class="node" style={`left:${x}%;top:${y}%;--k:${k}`}><span set:html={svg(i, 15)} />{n}</div>)}
        </div>
      </div>
    </section>

    <!-- Year -->
    <section class="sec mist">
      <div class="wrap">
        <div class="head rv"><p class="eb">How a year runs</p><h2>A plan on day one and a report every month.</h2></div>
        <ol class="year" id="year">{year.map(([k, t, d], i) => (
          <li class="step rv" style={`--d:${i * 120}ms`}>
            <span class="bars" aria-hidden="true">{[0, 1, 2, 3].map(j => <b class={j <= i ? 'on' : ''} style={`--j:${j}`} />)}</span>
            <p class="sk">{k}</p><h3>{t}</h3><p>{d}</p>
          </li>))}
        </ol>
      </div>
    </section>

    <!-- Proof -->
    <section class="sec">
      <div class="wrap">
        <div class="head rv"><p class="eb">Proof</p><h2>Systems we have already built.</h2><p class="lead">Each of these is more than a website. Real projects from our case studies.</p></div>
        <div class="proof">{proof.map(([slug, n, w, d, img], k) => (
          <a class="pc rv" href={`/work/${slug}`} style={`--d:${k * 110}ms`}>
            <span class="pim"><img src={img} alt="" width="738" height="540" loading="lazy" /></span>
            <span class="pb"><span class="pk">{n}</span><span class="pw">{w}</span><span class="pdd">{d}</span><span class="pl">Read the case study <span aria-hidden="true">→</span></span></span>
          </a>))}
        </div>
      </div>
    </section>

    <!-- Price and questions -->
    <section class="sec mist">
      <div class="wrap pq">
        <div class="price rv">
          <p class="eb">The price</p>
          <h2>One yearly fee. Quoted after one call.</h2>
          <p>The fee depends on the size of your site and the system you need. We look at both on a short call, then send a written plan with a fixed yearly price.</p>
          <a class="btn p" href="/book?service=partner">Book a partner call</a>
        </div>
        <div class="faq rv">
          <p class="eb">Questions</p>
          {faq.map(([q, a], i) => <details open={i === 0}><summary>{q}<span class="pm" aria-hidden="true"></span></summary><p>{a}</p></details>)}
        </div>
      </div>
    </section>
  </div>
</Page>
<script>
  // Reveal on scroll, plus the diagram and year bars start when they come into view.
  const els = [...document.querySelectorAll<HTMLElement>('.pt .rv, .pt .os, .pt .year')];
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
    els.forEach((el) => io.observe(el));
  } else els.forEach((el) => el.classList.add('in'));
</script>
<style>
  .pt{--r:2px;--ink2:#0A0E17;background:var(--bg);color:var(--fg)}
  .wrap{max-width:1200px;margin:0 auto;padding:0 var(--gutter)}
  .eb{font:500 12px/16px var(--mono);letter-spacing:.8px;text-transform:uppercase;color:var(--fg-3);margin:0}
  h1,h2,h3{margin:0;font-weight:500}
  .btn{display:inline-flex;align-items:center;justify-content:center;height:44px;padding:0 20px;border-radius:2px;font:500 16px/1 var(--font);text-decoration:none;transition:transform .2s,background .2s,box-shadow .2s}
  .btn.p{background:var(--sig);color:#fff}
  .btn.p:hover{background:var(--sig-hover);transform:translateY(-1px)}
  .btn.s{background:var(--mist);color:var(--fg)}
  .btn.s:hover{background:var(--hover)}

  /* reveal */
  .rv{opacity:0;transform:translateY(28px);transition:opacity .8s cubic-bezier(.2,.7,.2,1),transform 1s cubic-bezier(.2,.7,.2,1);transition-delay:var(--d,0ms)}
  .rv.in{opacity:1;transform:none}
  .d1{--d:80ms}.d2{--d:160ms}.d3{--d:240ms}.d4{--d:320ms}.d5{--d:400ms}

  /* hero */
  .hero{padding:72px 0 112px}
  .hc{display:flex;flex-direction:column;align-items:center;text-align:center;gap:24px}
  .chip{display:inline-flex;align-items:center;gap:8px;padding:8px 14px;border-radius:2px;background:var(--mist);font:500 12px/16px var(--mono);letter-spacing:.8px;text-transform:uppercase;color:var(--fg-2)}
  .chip i{width:8px;height:8px;border-radius:50%;background:var(--sig);box-shadow:0 0 0 0 rgba(59,91,255,.5);animation:ping 2.4s infinite}
  @keyframes ping{0%{box-shadow:0 0 0 0 rgba(59,91,255,.45)}80%,100%{box-shadow:0 0 0 10px rgba(59,91,255,0)}}
  h1{display:flex;flex-direction:column;font-size:64px;line-height:70px;letter-spacing:-1.3px;max-width:900px}
  h1 span:last-child{color:color-mix(in srgb,var(--fg) 45%,transparent)}
  .intro{max-width:720px;margin:0;font:400 19px/29px var(--font);color:var(--fg-2)}
  .ctas{display:flex;gap:12px;flex-wrap:wrap;justify-content:center}
  .bento{margin-top:64px;display:grid;grid-template-columns:700fr 226fr 226fr;grid-template-rows:268px 268px;gap:24px}
  .tile{position:relative;margin:0;border-radius:var(--r);background:var(--mist);border:1px solid var(--rule);overflow:hidden}
  .lab{position:absolute;top:28px;right:32px;font:500 13px/16px var(--mono);letter-spacing:.8px;text-transform:uppercase;color:var(--fg-3);z-index:2}
  .web{grid-row:1/3}
  .web .live{position:absolute;left:32px;top:22px;z-index:2;display:inline-flex;align-items:center;gap:8px;height:32px;padding:0 14px;border-radius:2px;background:var(--bg);box-shadow:0 2px 10px rgba(0,0,0,.06);font:500 13px/1 var(--font)}
  .live i{width:7px;height:7px;border-radius:50%;background:#22A06B;box-shadow:0 0 0 3px rgba(34,160,107,.18)}
  .web .scr{position:absolute;left:40px;right:40px;top:76px;bottom:0;border-radius:2px 0 0;overflow:hidden;box-shadow:0 18px 50px rgba(10,14,23,.12)}
  .web .scr img{width:100%;height:auto;display:block;animation:pan 16s ease-in-out infinite alternate}
  @keyframes pan{0%,12%{transform:translateY(0)}88%,100%{transform:translateY(calc(-100% + 484px))}}
  .adm{grid-column:2/4}
  .adm .lab{left:32px;right:auto}
  .adm .scr{position:absolute;left:32px;right:0;top:64px;bottom:0;border-radius:2px 0 0 0;overflow:hidden;box-shadow:0 16px 40px rgba(10,14,23,.1)}
  .adm .scr img{width:150%;max-width:none;height:auto;display:block;transform-origin:0 0;transition:transform 6s ease}
  .adm:hover .scr img{transform:translate(-18%,-8%)}
  .por .lab{left:28px;right:auto}
  .por .scr{position:absolute;left:28px;right:28px;top:58px;bottom:0;border-radius:2px 0 0;overflow:hidden;box-shadow:0 16px 40px rgba(10,14,23,.12)}
  .por .scr img{width:100%;height:auto;display:block}
  .aut{background:var(--ink2);color:#fff}
  .aut .lab{left:24px;right:auto;color:#B9C1CF}
  .flow{list-style:none;margin:0;padding:64px 20px 0;display:flex;flex-direction:column;gap:10px}
  .flow li{display:inline-flex;align-items:center;gap:8px;align-self:flex-start;padding:8px 12px;border-radius:2px;background:#1A2030;font:500 13px/16px var(--font);white-space:nowrap;animation:step 6s infinite;animation-delay:calc(var(--i) * 1.2s)}
  .flow li i{width:6px;height:6px;border-radius:50%;background:#22A06B}
  @keyframes step{0%,100%{background:#1A2030;transform:none}8%,22%{background:var(--sig);transform:translateX(4px)}30%{background:#1A2030;transform:none}}

  /* sections */
  .sec{padding:120px 0}
  .sec.mist{background:var(--mist)}
  :root[data-theme="dark"] .sec.mist{background:#141414}
  .head{display:flex;flex-direction:column;gap:16px;max-width:620px}
  .head.c{align-items:center;text-align:center;max-width:820px;margin:0 auto}
  .head h2{font-size:48px;line-height:54px;letter-spacing:-.8px}
  .lead{margin:0;font:400 18px/28px var(--font);color:var(--fg-2);max-width:680px}
  .who,.parts,.proof{margin-top:56px;display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .card{padding:32px;border-radius:var(--r);background:var(--bg);border:1px solid var(--rule);display:flex;flex-direction:column;gap:14px}
  .ib{width:40px;height:40px;border-radius:2px;background:var(--mist);display:grid;place-items:center;color:var(--sig)}
  .card h3{font-size:24px;line-height:30px}
  .card p{margin:0;font:400 16px/25px var(--font);color:var(--fg-2)}
  .part{padding:32px;border-radius:var(--r);background:var(--bg);border:1px solid var(--rule);display:flex;flex-direction:column;gap:14px}
  .part.dark{background:var(--ink2);color:#fff}
  .pn{margin:0;font:500 13px/16px var(--mono);color:var(--sig)}
  .part.dark .pn{color:#B9C1CF}
  .part h3{font-size:28px;line-height:34px}
  .pd{margin:0;font:400 16px/25px var(--font);color:var(--fg-2);padding-bottom:16px;border-bottom:1px solid var(--rule)}
  .part.dark .pd{color:#B9C1CF;border-color:#2A3142}
  .part ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px}
  .part li{display:flex;align-items:center;gap:10px;font:400 16px/22px var(--font)}
  .ck{flex:none;width:18px;height:18px;border-radius:50%;display:grid;place-items:center;background:#E6EBFF;color:var(--sig)}
  .part.dark .ck{background:var(--sig);color:#fff}

  /* OS diagram */
  .os{position:relative;margin:64px auto 0;height:520px}
  .grid{position:absolute;inset:0;display:grid;grid-template-columns:repeat(6,1fr);grid-template-rows:repeat(3,1fr);gap:20px}
  .grid i{border-radius:2px;background:color-mix(in srgb,var(--mist) 70%,var(--bg))}
  .wires{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
  .w{fill:none;stroke:var(--ash);stroke-width:1.5;stroke-dasharray:4 6;vector-effect:non-scaling-stroke;opacity:0;transition:opacity .6s;transition-delay:calc(var(--k) * 80ms + 300ms)}
  .pulse{fill:none;stroke:var(--sig);stroke-width:2.5;stroke-linecap:round;vector-effect:non-scaling-stroke;stroke-dasharray:6 200;stroke-dashoffset:6;opacity:0}
  .os.in .w{opacity:1}
  .os.in .pulse{opacity:1;animation:flow 3.2s cubic-bezier(.5,0,.5,1) infinite;animation-delay:calc(var(--k) * .4s + 1s)}
  @keyframes flow{from{stroke-dashoffset:6}to{stroke-dashoffset:-120}}
  .core{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%) scale(.8);opacity:0;z-index:2;display:flex;flex-direction:column;align-items:center;gap:6px;padding:24px 32px;border-radius:2px;background:var(--ink2);color:#fff;box-shadow:0 16px 48px rgba(59,91,255,.25);transition:transform .8s cubic-bezier(.2,1.4,.3,1),opacity .5s}
  .core strong{font:500 22px/26px var(--font)}.core span{font:400 13px/16px var(--font);color:#B9C1CF}
  .core::after{content:'';position:absolute;inset:-10px;border-radius:2px;border:1px solid rgba(59,91,255,.4);animation:halo 3s ease-out infinite}
  @keyframes halo{0%{opacity:.8;transform:scale(.96)}100%{opacity:0;transform:scale(1.18)}}
