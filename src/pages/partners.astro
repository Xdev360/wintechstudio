---
// Partners (Nov 2026): the yearly website partnership and company operating system.
// Built on the site's shared layout (studio.css: dm-top, dm-sec, dm-stick, dm-rows, dm-cells, dm-card) so it reads
// like How we work, Pricing and the service pages: square corners, hairlines, sticky left headings.
// No price: the yearly fee is quoted after a call (never invent prices).
import Page from '../layouts/Page.astro';
import Lc from '../components/ui/Lc.astro';
import '../styles/studio.css';
const who: [string, string, string][] = [
  ['rocket', 'Startups', 'You have a product and a launch date. We keep the site, the waitlist and the admin moving while you build the company.'],
  ['layers', 'Agencies', 'You sell the brand and the strategy. We build and run the sites behind it for your clients, under your name if you want.'],
  ['store', 'Businesses', 'Shops, clinics, schools and service firms in any country. Your site takes orders and bookings, and your team works from one place.'],
];
const parts: [string, string, string, string[]][] = [
  ['01', 'Website care', 'We keep it fresh and fast. You never log in to fix anything.', ['New pages, products and posts', 'Copy, image and price changes', 'Speed, uptime and security watch', 'Hosting, domain and backups']],
  ['02', 'Wired for sales', 'Every visit has a next step, and every lead lands somewhere.', ['Forms, booking and WhatsApp', 'Payments and checkout', 'Email follow ups', 'The Ask AI assistant and analytics']],
  ['03', 'Your company OS', 'The tools your team works in, built for how you run.', ['Admin for orders and content', 'Client or student portal', 'Staff tasks and approvals', 'Dashboards and automations']],
];
const os: [string, string, string][] = [
  ['globe', 'Website', 'Takes the order or the booking.'],
  ['layout-dashboard', 'Admin', 'Your team sees it, edits it, ships it.'],
  ['users', 'Portal', 'The customer tracks it themselves.'],
  ['message-circle', 'WhatsApp and email', 'Updates go out on their own.'],
  ['check-circle', 'Staff tasks', 'The right person gets the job.'],
  ['bar-chart', 'Dashboard', 'You see the numbers in one place.'],
];
const year: [string, string, string][] = [
  ['Month 1', 'Diagnose and wire', 'We audit the site and the tools, fix what is broken, and connect forms, payments and messages.'],
  ['Months 2 and 3', 'Build the system', 'The admin, the portal and the automations your team needs, designed with you and shipped in weekly builds.'],
  ['Every month', 'Updates and a report', 'New pages and content, speed and security checks, and one short report on what changed.'],
  ['Every quarter', 'Review the roadmap', 'We look at the numbers together and agree what to build next. New ideas go into the plan, not a new quote.'],
];
const proof: [string, string, string, string][] = [
  ['virelle', 'Virelle Wellness', 'Store, admin and AI assistant', 'Orders, stock and delivery in one admin, with an AI that answers customers day and night.'],
  ['manzeelatur-ridho', 'Manzeelatur Ridho', 'App, parent space and ustadh panel', 'Children learn, parents pay and track, and the ustadh runs classes from one panel.'],
  ['mylo', 'Mylo', 'App, desktop app and admin', 'Rooms, rewards and releases run from one admin panel, without touching code.'],
];
const faq: [string, string][] = [
  ['Do we own the website and the system?', 'Yes. Every account, domain and file sits in your name. If you leave, everything stays with you.'],
  ['Can you take over a site someone else built?', 'Yes. We start with an audit, fix what is broken, then move it into the plan.'],
  ['What if we need something new mid year?', 'It goes on the roadmap and into a monthly build. No surprise invoices.'],
  ['Can agencies sell this under their own name?', 'Yes. We work behind your brand and report to you, not your client.'],
  ['Where are your partners based?', 'Anywhere. We work from Lagos with clients across Nigeria, the UK, the US and beyond.'],
];
const ld = { '@context': 'https://schema.org', '@type': 'Service', name: 'Wintech Partner: yearly website partnership', provider: { '@type': 'Organization', name: 'Wintech Studio' }, areaServed: 'Worldwide', description: 'A yearly partnership: website care, wiring the site to sales, and a company operating system with admin, portal, dashboards and automations.' };
---
<Page title="Partners · Wintech Studio" description="A yearly website partnership for startups, agencies and businesses worldwide. We keep your website fresh, wire it to sales and build your company's operating system." crumbs={[['Partners', '/partners']]} jsonld={[ld]}>
  <div class="dm pt">
    <section class="dm-top">
      <div class="wrap">
        <div class="dm-head c">
          <p class="dm-eb">Wintech Partner · yearly</p>
          <h1 class="dm-h1">We run your website. You run the company.</h1>
          <p class="dm-intro">A yearly partnership for startups, agencies and businesses anywhere in the world. We keep your site fresh, wire it to sales, and build the operating system behind it. You do not need to touch a thing.</p>
          <div class="dm-ctas"><a class="dm-btn p" href="/book?service=partner">Book a partner call</a><a class="dm-btn o" href="#included">See what's included</a></div>
        </div>
        <div class="shots" data-rv>
          <figure class="sh web"><figcaption><span class="dm-eb">Website</span><span class="live"><i></i>virellewellnesshub.com</span></figcaption><div class="scr"><img src="/images/partners/site-virelle.webp" width="1440" height="1000" alt="The Virelle Wellness Hub store we designed and built" fetchpriority="high" /></div></figure>
          <figure class="sh adm"><figcaption><span class="dm-eb">Admin</span><span class="dm-eb mute">Sample figures</span></figcaption><div class="scr"><img src="/images/partners/admin.webp" width="1440" height="900" alt="An admin overview with requests, payouts and today's tasks" loading="lazy" /></div></figure>
          <figure class="sh por"><figcaption><span class="dm-eb">Portal</span></figcaption><div class="scr"><img src="/images/partners/portal-virelle.webp" width="390" height="900" alt="A customer tracking an order in the Virelle portal" loading="lazy" /></div></figure>
        </div>
      </div>
    </section>

    <section class="dm-sec alt">
      <div class="wrap dm-stick">
        <div class="dm-head"><p class="dm-eb">Who we partner with</p><h2 class="dm-h2s">For teams that would rather not run their own tech.</h2></div>
        <ul class="dm-rows wh">{who.map(([ic, t, d]) => <li data-rv><span class="dm-ib s36"><Lc name={ic} size={18} /></span><div><h3 class="dm-h3">{t}</h3><p class="dm-body">{d}</p></div></li>)}</ul>
      </div>
    </section>

    <section class="dm-sec" id="included">
      <div class="wrap">
        <div class="dm-head c"><p class="dm-eb">What's in the partnership</p><h2 class="dm-h2">Three parts, one yearly plan.</h2><p class="dm-intro">One team looks after all of it, and you get one report a month that says what changed.</p></div>
        <div class="dm-cells c3 pr">{parts.map(([n, t, d, items]) => (
          <div class="pc" data-rv>
            <span class="dm-num">{n}</span>
            <h3 class="dm-h3">{t}</h3>
            <p class="dm-small">{d}</p>
            <ul>{items.map(it => <li><Lc name="check" size={14} />{it}</li>)}</ul>
          </div>))}
        </div>
      </div>
    </section>

    <section class="dm-sec alt">
      <div class="wrap dm-stick">
        <div class="dm-head"><p class="dm-eb">The operating system</p><h2 class="dm-h2s">Every part talks to every other part.</h2><p class="dm-intro">One order moves through the whole company on its own. Nothing is copied by hand.</p></div>
        <ol class="flow" id="flow">{os.map(([ic, t, d], i) => (
          <li style={`--i:${i}`}><span class="fn dm-num">{String(i + 1).padStart(2, '0')}</span><span class="dm-ib s28"><Lc name={ic} /></span><div><h3 class="dm-h3">{t}</h3><p class="dm-small">{d}</p></div></li>
        ))}</ol>
      </div>
    </section>

    <section class="dm-sec">
      <div class="wrap dm-stick">
        <div class="dm-head"><p class="dm-eb">How a year runs</p><h2 class="dm-h2s">A plan on day one and a report every month.</h2><a class="dm-link" href="/how-we-work">How we work</a></div>
        <ol class="dm-rows yr">{year.map(([k, t, d]) => <li data-rv><span class="dm-eb">{k}</span><div><h3 class="dm-h3">{t}</h3><p class="dm-body">{d}</p></div></li>)}</ol>
      </div>
    </section>

    <section class="dm-sec alt">
      <div class="wrap">
        <div class="dm-head c"><p class="dm-eb">Proof</p><h2 class="dm-h2">Systems we have already built.</h2></div>
        <div class="dm-cells c3 pf">{proof.map(([slug, n, w, d]) => (
          <a class="pfc" href={`/work/${slug}`} data-rv>
            <span class="pim"><img src={`/images/cases/cover-${slug}.webp`} alt="" width="738" height="540" loading="lazy" /></span>
            <span class="pb"><span class="dm-eb">{n}</span><span class="dm-h3">{w}</span><span class="dm-small">{d}</span><span class="dm-link">Read the case study</span></span>
          </a>))}
        </div>
      </div>
    </section>

    <section class="dm-sec">
      <div class="wrap dm-stick">
        <div class="dm-head"><p class="dm-eb">The price</p><h2 class="dm-h2s">One yearly fee, quoted after one call.</h2><p class="dm-intro">The fee depends on the size of your site and the system you need. We look at both on a short call, then send a written plan with a fixed yearly price.</p><div class="dm-ctas"><a class="dm-btn p" href="/book?service=partner">Book a partner call</a></div></div>
        <div class="fq">{faq.map(([q, a], i) => <details open={i === 0}><summary class="dm-h3">{q}<Lc name="plus" size={16} /></summary><p class="dm-body">{a}</p></details>)}</div>
      </div>
    </section>
  </div>
</Page>
<script>
  const els = [...document.querySelectorAll<HTMLElement>('.pt [data-rv], .pt .flow')];
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.15 });
    els.forEach((el) => io.observe(el));
  } else els.forEach((el) => el.classList.add('in'));
  const fl = document.getElementById('flow');
  const setH = () => fl && fl.style.setProperty('--h', fl.offsetHeight + 'px');
  setH(); addEventListener('resize', setH);
</script>
<style>
  [data-rv]{opacity:0;transform:translateY(20px);transition:opacity .7s cubic-bezier(.2,.7,.2,1),transform .8s cubic-bezier(.2,.7,.2,1)}
  [data-rv].in{opacity:1;transform:none}
  /* hero screens: three real screens in hairline frames */
  .shots{display:grid;grid-template-columns:2.2fr 1.4fr .8fr;gap:16px;margin-top:56px;align-items:end}
  .sh{margin:0;border:1px solid var(--hl);background:var(--panel);display:flex;flex-direction:column}
  .sh figcaption{display:flex;align-items:center;justify-content:space-between;gap:8px;height:40px;padding:0 14px;border-bottom:1px solid var(--hl);background:var(--bg)}
  .mute{color:var(--lab)}
  .live{display:inline-flex;align-items:center;gap:6px;font:500 12px/1 var(--font)}
  .live i{width:6px;height:6px;border-radius:50%;background:#22A06B}
  .scr{position:relative;overflow:hidden}
  .web .scr{height:440px}.web img{width:100%;height:auto;display:block;animation:pan 18s ease-in-out infinite alternate}
  @keyframes pan{0%,10%{transform:translateY(0)}90%,100%{transform:translateY(calc(-100% + 440px))}}
  .adm .scr{height:330px}.adm img{width:160%;max-width:none;height:auto;display:block}
  .por .scr{height:380px}.por img{width:100%;height:auto;display:block}
  /* who */
  .wh li{display:grid;grid-template-columns:36px 1fr;gap:20px;align-items:start;padding:28px 0}
  .wh .dm-h3{margin:0 0 6px}
  /* parts */
  .pc{display:flex;flex-direction:column;gap:10px;padding:32px}
  .pc .dm-num{color:var(--sig)}
  .pc ul{list-style:none;margin:12px 0 0;padding:16px 0 0;border-top:1px solid var(--hl);display:flex;flex-direction:column;gap:10px}
  .pc li{display:flex;align-items:center;gap:10px;font-size:15px;line-height:22px}
  .pc li :global(svg){color:var(--sig);flex:none}
  /* OS flow: a vertical wire with a pulse that runs down through each step */
  .flow{position:relative;list-style:none;margin:0;padding:0;border:1px solid var(--hl);background:var(--bg)}
  .flow::before{content:'';position:absolute;left:83px;top:0;bottom:0;width:1px;background:var(--hl)}
  .flow::after{content:'';position:absolute;left:82px;top:0;width:3px;height:56px;background:var(--sig);opacity:0}
  .flow.in::after{opacity:1;animation:run 4.8s cubic-bezier(.5,0,.5,1) infinite}
  @keyframes run{from{transform:translateY(0)}to{transform:translateY(calc(var(--h,480px) - 56px))}}
  .flow li{position:relative;display:grid;grid-template-columns:40px 28px 1fr;gap:16px;align-items:center;padding:20px 24px;border-top:1px solid var(--hl);opacity:.35;transition:opacity .4s}
  .flow li:first-child{border-top:0}
  .flow.in li{animation:lit 4.8s infinite;animation-delay:calc(var(--i) * .8s)}
  @keyframes lit{0%,100%{opacity:.45}6%,22%{opacity:1}30%{opacity:.45}}
  .flow .dm-ib{position:relative;z-index:1;background:var(--bg)}
  .flow .dm-h3{margin:0 0 2px}
  /* year */
  .yr li{display:grid;grid-template-columns:140px 1fr;gap:20px;padding:28px 0}
  .yr .dm-eb{color:var(--sig);padding-top:4px}
  .yr .dm-h3{margin:0 0 6px}
  /* proof */
  .pfc{display:flex;flex-direction:column;color:var(--fg);text-decoration:none}
  .pim{display:block;aspect-ratio:4/3;overflow:hidden;border-bottom:1px solid var(--hl)}
  .pim img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .8s cubic-bezier(.2,.7,.2,1)}
  .pfc:hover .pim img{transform:scale(1.04)}
  .pb{display:flex;flex-direction:column;gap:8px;padding:24px}
  /* faq */
  .fq{border-top:1px solid var(--hl)}
  details{border-bottom:1px solid var(--hl);padding:20px 0}
  summary{display:flex;justify-content:space-between;align-items:center;gap:16px;cursor:pointer;list-style:none}
  summary::-webkit-details-marker{display:none}
  summary :global(svg){flex:none;transition:transform .3s}
  details[open] summary :global(svg){transform:rotate(45deg)}
  details p{margin:10px 0 0}
  @media (max-width:1023px){
    .shots{grid-template-columns:1fr 1fr}.web{grid-column:1/3}
    .web .scr{height:340px}@keyframes pan{0%,10%{transform:translateY(0)}90%,100%{transform:translateY(calc(-100% + 340px))}}
  }
  @media (max-width:767px){
    .shots{grid-template-columns:1fr;margin-top:40px}.web{grid-column:auto}.por{display:none}
    .web .scr{height:260px}.adm .scr{height:200px}
    .yr li{grid-template-columns:1fr;gap:8px}
    .pc{padding:24px}
  }
  @media (prefers-reduced-motion:reduce){[data-rv]{opacity:1;transform:none;transition:none}.web img,.flow.in::after,.flow.in li{animation:none}.flow li{opacity:1}}
</style>
