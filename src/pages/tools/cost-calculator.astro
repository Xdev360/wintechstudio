---
import Page from '../../layouts/Page.astro';
import Icon from '../../components/Icon.astro';
import ToolHero from '../../components/tools/ToolHero.astro';
import services from '../../data/services.json';
import '../../components/tools/tools.css';

// Our figures come from services.json starting prices. Market ranges (domain and hosting, freelancers)
// and the Wintech Templates plans ($0 to $25 a month, see /templates) are the ones set in the Figma frame.
const num = (s: string) => Number(((s || '').match(/[\d,]+/) || ['0'])[0].replace(/,/g, ''));
const mo = (s: string) => { const m = (s || '').match(/\+\s*[$₦]([\d,]+)\/mo/); return m ? Number(m[1].replace(/,/g, '')) : 0; };
const get = (slug: string) => services.find(s => s.slug === slug)!;
const web = get('websites'), brand = get('brand'), ai = get('ai-assistant');
const P = {
  web: { usd: num(web.price), ngn: num(web.priceNgn) },
  brand: { usd: num(brand.price), ngn: num(brand.priceNgn) },
  ai: { usd: num(ai.price), ngn: num(ai.priceNgn), usdMo: mo(ai.price), ngnMo: mo(ai.priceNgn) },
  tpl: { usdMo: [0, 25], ngnMo: [0, 37500] },
  domain: { usd: [30, 120] },
  rate: num(web.priceNgn) / num(web.price),
};
const studioHi = Math.round(P.web.usd * 5 / 3 / 50) * 50;
const extras = [
  { v: 'brand', t: 'Brand refresh', s: `From $${P.brand.usd.toLocaleString('en-US')}` },
  { v: 'photo', t: 'Product photography direction', s: 'Quoted with the shoot' },
  { v: 'ai', t: 'WhatsApp and AI replies', s: `From $${P.ai.usd.toLocaleString('en-US')} + $${P.ai.usdMo}/mo`, on: true },
  { v: 'seo', t: 'Google and AI search setup', s: 'Included in every build', on: true, fixed: true },
  { v: 'motion', t: 'Animations and interactions', s: 'Part of every design', on: true, fixed: true },
];
const ways = [
  { t: 'Freelancer', p: '$300 to $3,000', rows: ['One person', '2 to 12 weeks', 'Varies', 'Depends on them'] },
  { t: 'Wintech Templates', p: '$0 to $25/mo', rows: ['You, with AI help', 'An afternoon', 'Monthly plan', 'You run it'] },
  { t: 'Wintech Studio', p: `$${P.web.usd.toLocaleString('en-US')} to $${studioHi.toLocaleString('en-US')}`, rows: ['Project lead + specialists', '2 to 5 weeks', 'Agreed before work starts', 'We run it if you want'], rec: true },
];
const keys = ['Team', 'Timeline', 'Fixed price', 'After launch'];
---
<Page title="Website cost calculator for Lagos businesses · Free tool · Wintech Studio" description="Pick pages, platform and extras to see what a website costs in year one, in dollars or naira. Our own prices or clear market ranges, free, no sign up." crumbs={[['Free tools', '/tools'], ['Cost calculator', '/tools/cost-calculator']]} theme="dark">
  <ToolHero label="Free tool" title="Website cost calculator<br />for Lagos businesses" text="Pick your scope, pages, platform and extras to see what year one costs, in dollars or naira. Every figure is our own price or a clear market range." />
  <section class="tl-body calc">
    <div class="wrap"><div class="tl-grid cc">
      <div class="tl-panel">
        <div class="tl-head"><h2>Your website</h2><p class="tl-mono">Approximate, as of October 2026</p></div>
        <div class="tl-q">
          <p class="tl-qh"><span class="n">01</span>What you need</p>
          <div class="tl-seg" id="need">{['Website', 'Store with checkout', 'Refresh my site'].map((t, i) => <button type="button" data-v={['site', 'store', 'refresh'][i]} aria-pressed={i === 0 ? 'true' : 'false'}>{t}</button>)}</div>
        </div>
        <div class="tl-q">
          <div class="tl-qrow"><p class="tl-qh"><span class="n">02</span>Pages</p><output id="pages-out">6 pages</output></div>
          <input class="tl-range" id="pages" type="range" min="1" max="15" step="1" value="6" aria-label="Pages" />
        </div>
        <div class="tl-q">
          <p class="tl-qh"><span class="n">03</span>Built on</p>
          <div class="tl-seg" id="on"><button type="button" data-v="tpl" aria-pressed="false">Wintech Templates</button><button type="button" data-v="custom" aria-pressed="true">Custom (Astro or Next.js)</button></div>
        </div>
        <div class="tl-q ex">
          <p class="tl-qh"><span class="n">04</span>Extras</p>
          {extras.map(e => (
            <button type="button" class="chk" data-v={e.v} aria-checked={e.on ? 'true' : 'false'} role="checkbox" aria-disabled={e.fixed ? 'true' : undefined}>
              <span class="tl-box"><Icon name="check" size={14} stroke={2.5} /></span>
              <span><b>{e.t}</b><small>{e.s}</small></span>
            </button>))}
        </div>
      </div>
      <aside class="tl-panel tl-est" aria-live="polite">
        <div class="tl-est-in">
          <div class="eh"><p class="tl-mono">Year one estimate</p><button type="button" class="tl-mono curb" id="cur" aria-label="Switch currency">USD</button></div>
          <div class="tl-bar" id="bar"></div>
          <div class="tl-rows" id="rows"></div>
          <div class="tl-rule"></div>
          <div class="tl-kv"><span>Typical timeline</span><b id="tl">-</b></div>
          <div class="tl-total"><p class="tl-mono">Year one</p><p class="big" id="big">-</p><p class="sub" id="sub"></p></div>
          <a class="tl-btn" id="send" href="https://wa.me/2349134071813" target="_blank" rel="noopener">Get an exact quote <Icon name="arrow-right" size={14} /></a>
        </div>
      </aside>
    </div></div>
  </section>
  <section class="tl-body ways">
    <div class="wrap">
      <p class="tl-mono">Three ways to buy it</p>
      <h2>The same site, from a freelancer,<br />a template or the studio</h2>
      <div class="wg">{ways.map(w => (
        <div class:list={['tl-panel', 'way', { rec: w.rec }]}>
          {w.rec && <p class="tl-mono rl">Recommended</p>}
          <h3>{w.t}</h3>
          <p class="wp">{w.p}</p>
          {w.rows.map((r, i) => <div class="kv"><span class="tl-mono">{keys[i]}</span><span>{r}</span></div>)}
        </div>))}</div>
    </div>
  </section>
</Page>
<script is:inline define:vars={{ P }}>
(function(){
  var st={need:'site',pages:6,on:'custom',ex:{brand:false,photo:false,ai:true,seo:true,motion:true},cur:'usd'};
  var $=function(s){return document.querySelector(s)};
  var r50=function(n){return Math.round(n/50)*50};
  var u=function(n){return '$'+Math.round(n).toLocaleString('en-US')};
  var uk=function(n){return n>=1000?'$'+(Math.floor(n/100)/10)+'k':u(n)};
  var nn=function(n){return n>=1e6?'₦'+(Math.round(n/1e5)/10)+'m':'₦'+Math.round(n).toLocaleString('en-US')};
  var rng=function(a,b,f){return a===b?f(a):f(a)+' to '+f(b)};
  document.querySelectorAll('#need button').forEach(function(b){b.onclick=function(){st.need=b.dataset.v;r()}});
  document.querySelectorAll('#on button').forEach(function(b){b.onclick=function(){st.on=b.dataset.v;r()}});
  document.querySelectorAll('.chk').forEach(function(b){b.onclick=function(){if(b.getAttribute('aria-disabled'))return;st.ex[b.dataset.v]=!st.ex[b.dataset.v];r()}});
  $('#pages').oninput=function(){st.pages=+this.value;r()};
  $('#cur').onclick=function(){st.cur=st.cur==='usd'?'ngn':'usd';r()};
  function r(){
    document.querySelectorAll('#need button').forEach(function(b){b.setAttribute('aria-pressed',st.need===b.dataset.v)});
    document.querySelectorAll('#on button').forEach(function(b){b.setAttribute('aria-pressed',st.on===b.dataset.v)});
    document.querySelectorAll('.chk').forEach(function(b){b.setAttribute('aria-checked',!!st.ex[b.dataset.v])});
    var pg=$('#pages');pg.style.setProperty('--p',((st.pages-1)/14*100)+'%');$('#pages-out').textContent=st.pages+(st.pages===1?' page':' pages');
    $('#cur').textContent=st.cur.toUpperCase();
    var rows=[],tlLo=2,tlHi=Math.min(6,3+Math.floor(st.pages/3)),n=1;
    if(st.on==='tpl'){
      rows.push({c:'#F4F6FA',t:'Wintech Templates plan',s:'Free, or up to $25 a month',u:[P.tpl.usdMo[0]*12,P.tpl.usdMo[1]*12],n:[P.tpl.ngnMo[0]*12,P.tpl.ngnMo[1]*12]});tlLo=0;tlHi=0;
    }else{
      var f=Math.max(1,1+(st.pages-6)*0.06)*(st.need==='store'?1.25:1),lo=r50(P.web.usd*f),hi=r50(lo*5/3),nlo=Math.round(P.web.ngn*f/50000)*50000,nhi=Math.round(nlo*5/3/50000)*50000;
      rows.push({c:'#F4F6FA',t:st.need==='refresh'?'Redesign and rebuild':'Design and build',s:st.pages+(st.pages===1?' page':' pages')+(st.need==='store'?', checkout':'')+', our prices',u:[lo,hi],n:[nlo,nhi]});
      if(st.need==='store')tlHi=Math.min(6,tlHi+1);
    }
    var mUsd=0,mNgn=0;
    if(st.ex.brand){rows.push({c:'#B9C1CF',t:'Brand refresh',s:'Logo, colours, type',u:[P.brand.usd,P.brand.usd],n:[P.brand.ngn,P.brand.ngn]});tlLo=Math.max(tlLo,3);tlHi=Math.max(tlHi,4);n++}
    if(st.ex.ai){rows.push({c:'#7C93FF',t:'AI replies',s:'Plus $'+P.ai.usdMo+' a month',u:[P.ai.usd,P.ai.usd],n:[P.ai.ngn,P.ai.ngn]});mUsd=P.ai.usdMo*12;mNgn=P.ai.ngnMo*12;tlLo=Math.max(tlLo,4);tlHi=Math.max(tlHi,6);n++}
    if(st.ex.photo)rows.push({c:'#3B5BFF',t:'Photography direction',s:'Quoted with the shoot',q:1});
    if(st.on!=='tpl')rows.push({c:'#5E6678',t:'Domain and hosting',s:'Yours, in your name',u:P.domain.usd,n:[P.domain.usd[0]*P.rate,P.domain.usd[1]*P.rate]});
    else rows.push({c:'#5E6678',t:'Domain (optional)',s:'yourname.wintechstudio.com is free',u:[0,P.domain.usd[0]],n:[0,P.domain.usd[0]*P.rate]});
    var el=$('#rows'),bar=$('#bar');el.innerHTML='';bar.innerHTML='';var a=mUsd,b=mUsd,na=mNgn,nb=mNgn;
    rows.forEach(function(x){var d=document.createElement('div');d.className='tl-row';d.innerHTML='<span class="l"><span class="dot"></span><span><b></b><small></small></span></span><span class="v"></span>';
      d.querySelector('.dot').style.background=x.c;d.querySelector('b').textContent=x.t;d.querySelector('small').textContent=x.s;
      d.querySelector('.v').textContent=x.q?'Quoted':(st.cur==='usd'?rng(x.u[0],x.u[1],u):rng(x.n[0],x.n[1],nn));el.appendChild(d);
      if(!x.q){a+=x.u[0];b+=x.u[1];na+=x.n[0];nb+=x.n[1];var s=document.createElement('span');s.style.background=x.c;s.style.flexGrow=Math.max(x.u[1],8);bar.appendChild(s)}});
    if(n>1&&tlHi){tlLo++;tlHi++}
    var tl=st.on==='tpl'&&n===1?'An afternoon':(tlLo+' to '+tlHi+' weeks');$('#tl').textContent=tl;
    $('#big').textContent=st.cur==='usd'?rng(a,b,uk):rng(na,nb,nn);
    $('#sub').textContent=(st.cur==='usd'?rng(na,nb,nn):rng(a,b,uk))+(mUsd?', with 12 months of the AI care plan':'');
    var t='Hello Wintech, I used the website cost calculator.\nNeed: '+$('#need [aria-pressed="true"]').textContent+'\nPages: '+st.pages+'\nBuilt on: '+$('#on [aria-pressed="true"]').textContent+'\nExtras: '+rows.slice(1).map(function(x){return x.t}).join(', ')+'\nYear one estimate: '+rng(a,b,u)+' ('+rng(na,nb,nn)+')\nCan I get an exact quote?';
    $('#send').href='https://wa.me/2349134071813?text='+encodeURIComponent(t);
  }
  r();
})();
</script>
<style>
  .calc{padding:0 0 96px}
  .cc{grid-template-columns:776px 400px}
  .ex{gap:0}.ex .tl-qh{margin-bottom:18px}
  .chk{display:flex;align-items:center;gap:12px;width:100%;padding:6px 0;min-height:47px;background:none;border:0;color:#F4F6FA;text-align:left;font:inherit;cursor:pointer}
  .chk[aria-disabled="true"]{cursor:default}
  .chk + .chk{margin-top:18px}
  .chk b{display:block;font-weight:500;font-size:15px;line-height:18px}.chk small{display:block;margin-top:1px;font-size:13px;line-height:16px;color:#9AA3B2}
  .eh{display:flex;justify-content:space-between;align-items:center}
  .curb{background:none;border:0;padding:0;cursor:pointer;text-decoration:underline dotted;text-underline-offset:3px}
  .ways{padding:96px 0 128px}
  .ways h2{margin:36px 0 40px;font-size:44px;line-height:1.08;letter-spacing:-.015em;font-weight:600;color:#F4F6FA}
  .wg{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;align-items:start}
  .way{display:grid;gap:16px;padding:24px}
  .way.rec{background:#161D2A;border-color:rgba(124,147,255,.6)}
  .rl{color:#7C93FF;font-size:10px;line-height:13px}
  .way h3{margin:0;font-size:20px;font-weight:600;line-height:24px;letter-spacing:0;color:#F4F6FA}
  .wp{margin:0;font-size:28px;font-weight:600;letter-spacing:-.01em;line-height:34px;color:#F4F6FA}
  .kv{display:grid;gap:2px;padding-top:10px;border-top:1px solid rgba(255,255,255,.09);font-size:15px;line-height:18px;color:#F4F6FA}
  @media (max-width:1023px){
    .calc{padding:0 0 53px}.calc .wrap,.ways .wrap{padding:0 16px}
    .chk + .chk{margin-top:18px}
    .ways{padding:53px 0 70px}
    .ways h2{margin:22px 0;font-size:30px;line-height:1.08}.ways h2 br{display:none}
    .wg{grid-template-columns:1fr}
    .way h3{font-size:18px;line-height:22px}.wp{font-size:24px;line-height:29px}
  }
</style>
