---
import Page from '../../layouts/Page.astro';
import Icon from '../../components/Icon.astro';
import ToolHero from '../../components/tools/ToolHero.astro';
import '../../components/tools/tools.css';

type Item = { id: string; crit?: boolean; t: string | Record<string, string>; why: string; fix: string | Record<string, string> };
const sections: [string, Item[]][] = [
  ['Replies', [
    { id: 'fast', crit: true, t: 'Someone or something replies within 10 minutes, even at night', why: 'Most buyers message two or three sellers at the same time. The first useful reply usually gets the order.', fix: 'Answer at night with an AI assistant' },
    { id: 'price', crit: true, t: 'Customers get price and delivery in the first reply', why: 'Every extra back and forth is a chance for the buyer to go quiet. Price and delivery up front saves two messages.', fix: 'Reply with price and delivery in the first message' },
    { id: 'count', t: 'You know how many messages went unanswered last week', why: 'You cannot fix a leak you cannot see. A simple count shows which hours and days you lose people.', fix: 'Count missed messages for one week' },
  ]],
  ['Ordering', [
    { id: 'pay', crit: true, t: { products: 'Customers can pay without sending a transfer screenshot', services: 'Clients can pay without sending a transfer screenshot', bookings: 'Clients can pay a deposit without sending a screenshot' }, why: 'Checking screenshots by hand is slow and easy to fake. A payment link confirms itself and sends the receipt.', fix: 'Take payment on a link, not a screenshot' },
    { id: 'fee', t: { products: 'Delivery fee is shown before they pay', services: 'Your prices are visible before they ask', bookings: 'Open slots are visible before they message' }, why: 'Surprises at the last step are where people drop off. Showing it early means only ready buyers reach you.', fix: { products: 'Show delivery fees by area before checkout', services: 'Put your price list where buyers can see it', bookings: 'Show open slots so clients can pick one' } },
    { id: 'stock', t: { products: 'Stock on the page is the stock you have', services: 'Turnaround time is stated up front', bookings: 'Clients get a reminder the day before' }, why: 'Saying sorry after someone has paid costs you the customer and the next one they would have sent.', fix: { products: 'Keep stock on the page in sync with the shelf', services: 'State your turnaround time on every offer', bookings: 'Send a reminder the day before every booking' } },
  ]],
  ['Trust', [
    { id: 'photos', crit: true, t: 'Real photos of your products or past work are online', why: 'People buy from strangers when they can see the real thing. Stock photos make careful buyers leave.', fix: 'Put real photos of your work online' },
    { id: 'brand', t: 'Your brand looks like the price you charge', why: 'Customers judge the price by the logo, the box and the page before they read a word.', fix: 'Refresh the brand so it matches your price' },
    { id: 'reviews', t: 'Reviews or results are easy to find', why: 'A buyer who cannot find proof asks for it in the DM, and many never ask.', fix: 'Put reviews where buyers can see them' },
  ]],
];
const items = sections.flatMap(s => s[1]);
const txt = (v: string | Record<string, string>) => typeof v === 'string' ? v : v.products;
const BARS = 46;
---
<Page title="Is your inbox losing you orders? · Free tool · Wintech Studio" description="Tick what already happens in your business and get a readiness score out of 100 plus the three fixes that matter most for your DMs and WhatsApp. Free, private." crumbs={[['Free tools', '/tools'], ['Inbox check', '/tools/inbox-check']]} theme="dark">
  <ToolHero label="Free tool" title="Is your inbox<br />losing you orders?" text="Tick what already happens in your business. You get a score out of 100 and the three fixes that matter most. Nothing you tick leaves your browser." />
  <section class="tl-body ic">
    <div class="wrap"><div class="tl-grid ig">
      <div class="col">
        <div class="tl-panel biz">
          <h2>Your business</h2>
          <div class="tl-seg" id="type">{[['products', 'Sells products'], ['services', 'Sells services'], ['bookings', 'Takes bookings']].map(([v, t], i) => <button type="button" data-v={v} aria-pressed={i === 0 ? 'true' : 'false'}>{t}</button>)}</div>
          <p class="tl-hint">Critical checks count three times as much as polish. The score updates as you tick.</p>
        </div>
        {sections.map(([name, list], si) => (
          <div class="tl-panel isec" data-sec={si}>
            <div class="sh"><span class="num">0{si + 1}</span><h3>{name}</h3><span class="cnt" data-cnt={si}>0/{list.length}</span></div>
            {list.map(it => (
              <div class="item" data-id={it.id}>
                <div class="ir">
                  <button type="button" class="chk" role="checkbox" aria-checked="false" data-id={it.id} data-t={typeof it.t === 'string' ? undefined : JSON.stringify(it.t)}>
                    <span class="tl-box"><Icon name="check" size={14} stroke={2.5} /></span>
                    <span class="lbl"><span class="tx">{txt(it.t)}</span>{it.crit && <span class="crit">Critical</span>}</span>
                  </button>
                  <button type="button" class="why" aria-expanded="false" aria-controls={`why-${it.id}`}>Why <Icon name="plus" size={10} /></button>
                </div>
                <p class="wt" id={`why-${it.id}`} hidden>{it.why}</p>
              </div>))}
          </div>))}
      </div>
      <aside class="tl-panel tl-est" aria-live="polite">
        <div class="tl-est-in">
          <p class="tl-mono">Readiness score</p>
          <p class="score"><span id="score">0</span><small>/100</small></p>
          <div class="bars" id="bars" aria-hidden="true">{Array.from({ length: BARS }, () => <i></i>)}</div>
          <p class="vd"><span class="sq"></span><span id="vd">Losing orders</span></p>
          <p class="vt" id="vt"></p>
          <div class="fx"><p class="tl-mono">Your top 3 fixes</p><ol id="fixes"></ol></div>
          <a class="tl-btn" id="send" href="https://wa.me/2349134071813" target="_blank" rel="noopener">Fix these with Wintech <Icon name="arrow-right" size={14} /></a>
          <div class="acts"><button type="button" id="pdf">Save as PDF</button><button type="button" id="reset">Reset</button></div>
        </div>
      </aside>
    </div></div>
  </section>
</Page>
<script is:inline define:vars={{ items, BARS }}>
(function(){
  var KEY='wt-inbox',st={type:'products',on:{}};
  try{var s=JSON.parse(localStorage.getItem(KEY)||'null');if(s&&s.on)st=s}catch(e){}
  var $=function(s){return document.querySelector(s)};
  var t=function(v){return typeof v==='string'?v:v[st.type]};
  var total=items.reduce(function(a,i){return a+(i.crit?3:1)},0);
  document.querySelectorAll('#type button').forEach(function(b){b.onclick=function(){st.type=b.dataset.v;r()}});
  document.querySelectorAll('.chk').forEach(function(b){b.onclick=function(){st.on[b.dataset.id]=!st.on[b.dataset.id];r()}});
  document.querySelectorAll('.why').forEach(function(b){b.onclick=function(){var p=document.getElementById(b.getAttribute('aria-controls')),o=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',!o);p.hidden=o}});
  $('#pdf').onclick=function(){window.print()};
  $('#reset').onclick=function(){st.on={};r()};
  function r(){
    document.querySelectorAll('#type button').forEach(function(b){b.setAttribute('aria-pressed',st.type===b.dataset.v)});
    var sc=0;
    document.querySelectorAll('.chk').forEach(function(b){var on=!!st.on[b.dataset.id];b.setAttribute('aria-checked',on);if(b.dataset.t)b.querySelector('.tx').textContent=JSON.parse(b.dataset.t)[st.type]});
    items.forEach(function(i){if(st.on[i.id])sc+=i.crit?3:1});
    document.querySelectorAll('[data-sec]').forEach(function(s){var n=s.querySelectorAll('.chk[aria-checked="true"]').length,all=s.querySelectorAll('.chk').length;s.querySelector('.cnt').textContent=n+'/'+all});
    var score=Math.round(sc/total*100),band=score>=75?'ok':score>=40?'mid':'low';
    $('#score').textContent=score;document.querySelector('.ic .tl-est').dataset.band=band;
    var fill=Math.round(score/100*BARS);document.querySelectorAll('#bars i').forEach(function(b,i){b.className=i<fill?'on':''});
    $('#vd').textContent=band==='ok'?'Ready to take orders':band==='mid'?'Leaking some orders':'Losing orders';
    var miss=items.filter(function(i){return !st.on[i.id]}).sort(function(a,b){return (b.crit?1:0)-(a.crit?1:0)});
    var critMiss=miss.filter(function(i){return i.crit}).length;
    $('#vt').textContent=band==='ok'?(miss.length?'Strong. A few small fixes and your inbox works for you around the clock.':'Every check is ticked. Your inbox is working for you.'):band==='mid'?'You answer people, but some leave before they pay. '+(critMiss?critMiss+' critical '+(critMiss===1?'check is':'checks are')+' still open.':'The polish is what is left.'):'Many buyers give up before they reach the point of paying. Start with the critical checks.';
    var ol=$('#fixes');ol.innerHTML='';var top=miss.slice(0,3);
    if(!top.length){var li=document.createElement('li');li.textContent='Nothing urgent. Keep it this way.';ol.appendChild(li)}
    top.forEach(function(i){var li=document.createElement('li');li.textContent=t(i.fix);ol.appendChild(li)});
    var msg='Hello Wintech, I used the inbox check.\nScore: '+score+'/100 ('+$('#vd').textContent+')\nTop fixes:\n'+top.map(function(i,n){return (n+1)+'. '+t(i.fix)}).join('\n')+'\nCan you help me fix these?';
    $('#send').href='https://wa.me/2349134071813?text='+encodeURIComponent(msg);
    try{localStorage.setItem(KEY,JSON.stringify(st))}catch(e){}
  }
  r();
})();
</script>
<style>
  .ic{padding:0 0 128px}
  .ig{grid-template-columns:816px 360px}
  .col{display:grid;gap:16px;min-width:0}
  .biz{display:grid;gap:18px;padding:24px 28px}
  .biz h2{margin:0;font-size:22px;font-weight:600;line-height:26px;letter-spacing:0;color:#F4F6FA}
  .sh{display:flex;align-items:center;gap:12px;padding:18px 20px}
  .num{background:#F4F6FA;color:#0A0E17;font:400 12px/16px var(--mono);padding:6px 8px}
  .sh h3{margin:0;font-size:20px;font-weight:600;line-height:24px;letter-spacing:0;color:#F4F6FA;flex:1}
  .cnt{font-size:13px;color:#9AA3B2}
  .item{border-top:1px solid rgba(255,255,255,.09)}
  .ir{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 20px;min-height:52px}
  .chk{display:flex;align-items:center;gap:12px;background:none;border:0;padding:0;color:#F4F6FA;font:inherit;text-align:left;cursor:pointer;min-width:0}
  .lbl{display:flex;align-items:center;gap:12px;flex-wrap:wrap;font-size:15px;line-height:18px}
  .crit{background:rgba(229,72,77,.18);color:#FF8A8E;font:400 10px/13px var(--mono);letter-spacing:.02em;text-transform:uppercase;padding:2px 6px}
  .why{flex:none;display:inline-flex;align-items:center;gap:4px;padding:4px 8px;background:none;border:1px solid rgba(255,255,255,.09);color:#9AA3B2;font:400 10px/13px var(--mono);text-transform:uppercase;cursor:pointer}
  .why:hover{color:#F4F6FA}.why :global(svg){transition:transform .2s}.why[aria-expanded="true"] :global(svg){transform:rotate(45deg)}
  .wt{margin:0;padding:0 20px 16px 52px;font-size:14px;line-height:1.5;color:#9AA3B2}
  .score{display:flex;align-items:baseline;gap:4px;margin:0;font-size:88px;font-weight:600;letter-spacing:-.03em;line-height:106px;color:var(--c)}
  .score small{font-size:26px;font-weight:500;letter-spacing:0;color:#9AA3B2}
  .tl-est{--c:#FF8A8E}.tl-est[data-band="mid"]{--c:#F2B35B}.tl-est[data-band="ok"]{--c:#5BD49A}
  .bars{display:flex;gap:2px;height:26px}.bars i{width:4px;background:rgba(255,255,255,.12)}.bars i.on{background:var(--c)}
  .vd{display:flex;align-items:center;gap:8px;margin:0;font-size:20px;font-weight:600;line-height:24px;color:var(--c)}.sq{width:10px;height:10px;background:var(--c)}
  .vt{margin:0;font-size:14px;line-height:1.45;color:#9AA3B2}
  .fx{background:#161D2A;padding:16px;display:grid;gap:10px}
  .fx ol{margin:0;padding:0;list-style:none;counter-reset:f;display:grid;gap:10px}
  .fx :global(li){counter-increment:f;font-size:14px;font-weight:500;line-height:1.4;color:#F4F6FA}
  .fx :global(li)::before{content:counter(f) '. '}
  .acts{display:flex;justify-content:center;gap:20px}
  .acts button{background:none;border:0;padding:0;color:#9AA3B2;font:400 14px/17px var(--font);cursor:pointer}.acts button:hover{color:#F4F6FA}
  @media (max-width:1023px){
    .ic{padding:0 0 70px}
    .biz{padding:24px 15px}.biz h2{font-size:20px;line-height:24px}
    .ir{align-items:flex-start}.chk{align-items:flex-start}
    .wt{padding-left:20px}
    .score{font-size:36px;line-height:43px}.score small{font-size:20px}
    .bars{overflow:hidden}
    .vd{font-size:18px;line-height:22px}
  }
  @media print{
    :global(header),:global(footer),:global(.closing),:global(.crumbs),:global(.th),:global([class*="ask"]),.tl-btn,.acts,.why{display:none !important}
    .ig{grid-template-columns:1fr}
  }
</style>
