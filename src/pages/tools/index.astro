---
import Page from '../../layouts/Page.astro';
import Icon from '../../components/Icon.astro';
import Bi from '../../components/tools/Bi.astro';
import ToolHero from '../../components/tools/ToolHero.astro';
import '../../components/tools/tools.css';
const tools = [
  { href: '/tools/plan', icon: 'rocket', title: 'Plan your project', text: 'Where you are, what you need, a price range and a timeline. Send it as a brief.', badge: 'Most used' },
  { href: '/tools/cost-calculator', icon: 'chart', title: 'Website cost calculator', text: 'Pages, platform and extras to a year one cost, in dollars or naira.' },
  { href: '/tools/inbox-check', icon: 'message', title: 'Is your inbox losing orders?', text: 'A score out of 100 and the three fixes that matter most.' },
];
---
<Page title="Free tools · Wintech Studio" description="Free planning tools for business owners: plan your project, estimate a website's year one cost and check whether your inbox is losing orders." crumbs={[['Free tools', '/tools']]} theme="dark">
  <ToolHero label="Free tools" title="Clarity before<br />you book a call" text="Three tools that answer the first questions owners and founders ask us. Free, no sign up, and you can send the result straight to the project lead." />
  <section class="tl-body list">
    <div class="wrap cards">
      {tools.map(t => (
        <a class="tl-panel card" href={t.href}>
          <div class="top"><Bi name={t.icon} size={48} />{t.badge && <span class="badge">{t.badge}</span>}</div>
          <h2>{t.title}</h2>
          <p>{t.text}</p>
          <span class="go">Open the tool <Icon name="arrow-right" size={14} /></span>
        </a>
      ))}
    </div>
  </section>
</Page>
<style>
  .list{padding:0 0 128px}
  .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  .card{display:flex;flex-direction:column;gap:16px;padding:28px;text-decoration:none;color:#F4F6FA;transition:border-color .2s,background .2s}
  .card:hover{border-color:rgba(255,255,255,.22);background:#141B29}
  .top{display:flex;justify-content:space-between;align-items:center;height:48px}
  .badge{background:rgba(59,91,255,.18);color:#7C93FF;font-size:12px;line-height:14px;padding:3px 7px}
  h2{margin:0;font-size:22px;font-weight:600;letter-spacing:0;line-height:26px}
  p{margin:0;font-size:15px;line-height:1.5;color:#9AA3B2;max-width:320px}
  .go{display:inline-flex;align-items:center;gap:6px;font-size:14px;font-weight:500;line-height:17px}
  .card:hover .go :global(svg){transform:translateX(3px)}.go :global(svg){transition:transform .2s}
  @media (max-width:1023px){.list{padding-bottom:72px}.cards{grid-template-columns:1fr}.card{padding:24px}}
</style>
