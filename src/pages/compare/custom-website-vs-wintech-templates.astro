---
import Page from '../../layouts/Page.astro';
import SFaq from '../../components/search/SFaq.astro';
import SRelated from '../../components/search/SRelated.astro';
import services from '../../data/services.json';
import { contact } from '../../data/site';
import '../../components/search/search.css';
// Two columns only: the Figma frame also has a Bumpa column, left out until those facts are verified.
const web = services.find(s => s.slug === 'websites')!;
const cols = ['Custom website', 'Wintech Templates'];
const rows: [string, string, string][] = [
  ['Best for', 'Brands that need to stand out and rank', 'Small businesses going live fast'],
  ['Cost to start', `From ${web.price.replace(/^from /, '')}`, 'Free site at yourname.wintechstudio.com'],
  ['Time to launch', web.timeline, 'Today'],
  ['Design freedom', 'Anything you can picture', 'Pick a design, change words and photos'],
  ['Payments', 'Card, bank transfer and USSD', 'Bank transfer checkout'],
  ['You own the code', 'Yes, in your accounts', 'Site stays on our platform'],
  ['Good on Google', 'Built for it', 'Basic'],
];
const title = 'Custom website or Wintech Templates: which one fits your business?';
---
<Page title="Custom website or Wintech Templates: which fits your business? · Wintech Studio" description="Compare a custom website with a free Wintech Templates site: cost, time to launch, design freedom, payments, ownership and Google." crumbs={[['Compare', '/guides'], ['Website options', '/compare/custom-website-vs-wintech-templates']]} closing={false}>
  <div class="dm">
  <section class="dm-top cmp">
    <div class="wrap dm-stick">
      <div class="side">
      <div class="dm-head"><p class="dm-eb">Compare</p><h1 class="dm-h1 sm">{title}</h1></div>
      <div class="dm-short"><p class="dm-eb">Short answer</p><p>Selling a few products and need to start this week: a template. Need a site that proves your work, ranks on Google or does something no template can: a custom build.</p></div>
      </div>
      <div class="body">
      <table class="tb">
        <thead><tr><td></td>{cols.map((c, i) => <th scope="col" class:list={{ ours: i === 0 }}>{c}</th>)}</tr></thead>
        <tbody>{rows.map(r => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td></tr>)}</tbody>
      </table>
      <div class="mc">{cols.map((c, ci) => (
        <div class:list={['opt', { ours: ci === 0 }]}><h2>{c}</h2>{rows.map(r => <div class="mr"><b>{r[0]}</b><span>{r[ci + 1]}</span></div>)}</div>))}</div>
      <div class="dm-grid g2 picks">
        <div class="dm-card panel"><h2 class="dm-h3">Pick a template if</h2><p class="dm-body">You sell a handful of things, you want to be live today, and you are happy with a proven layout.</p><a class="dm-btn s mw" href={contact.templates} target="_blank" rel="noopener">Browse templates</a></div>
        <div class="dm-card hi"><h2 class="dm-h3">Pick custom if</h2><p class="dm-body">Your site has to win trust, rank on Google, take bookings or orders your way, or connect to your tools.</p><a class="dm-btn p mw" href="/services/websites#brief">Build your brief</a></div>
      </div>
      </div>
    </div>
  </section>
  </div>
  <SFaq items={[['Can I start on a template and move to custom later?', 'Yes. We can carry your products, words and photos over when you are ready.'], ['Do templates take a cut of my sales?', 'No. Wintech Templates charges in naira for the plan, never a percentage of what you sell.'], ['Which one is best for Google?', 'A custom Astro site, because every page can be written and structured for the searches your customers make.']]} />
  <SRelated items={[['Guide · Payments', 'How to take Paystack payments on your website in Nigeria', '/guides/paystack-payments-on-your-website'], ['Industry', 'Websites and AI for salons in Lagos', '/industries/salons'], ['Glossary', 'Website and AI words, in plain English', '/glossary']]} />
</Page>

<style>
  .cmp{padding-bottom:128px}
  .dm-short{margin-top:32px}
  .tb{width:100%;border-collapse:collapse;border:1px solid var(--hl);table-layout:fixed}
  .tb thead th,.tb thead td{height:56px;padding:0 24px;text-align:left;font-size:16px;font-weight:600;line-height:24px;position:relative;background:var(--panel)}
  .tb thead td{width:180px}
  .tb .ours::before{content:'';position:absolute;left:0;right:0;top:-1px;height:2px;background:var(--sig)}
  .tb tbody th,.tb tbody td{padding:14px 24px;border-top:1px solid var(--hl);text-align:left;vertical-align:top;font-size:16px;line-height:24px}
  .tb tbody th{font-weight:500}.tb tbody td{color:var(--mute)}
  .mc{display:none}
  .picks{margin-top:40px}
  .picks .dm-card{padding:32px;align-items:flex-start}
  .picks .hi{border-color:var(--fg)}
  .picks .dm-btn{margin-top:auto}
  @media (max-width:1023px){
    .cmp{padding-bottom:64px}
    .dm-short{margin-top:24px}
    .tb{display:none}
    .mc{display:grid;gap:16px}
    .opt{position:relative;border:1px solid var(--hl)}
    .opt.ours::before{content:'';position:absolute;left:-1px;right:-1px;top:-1px;height:2px;background:var(--sig)}
    .opt h2{padding:14px 16px;font-size:16px;line-height:24px}
    .mr{display:grid;grid-template-columns:110px 1fr;gap:12px;padding:10px 16px;border-top:1px solid var(--hl);font-size:14px;line-height:21px}
    .mr b{font-weight:500}.mr span{color:var(--mute)}
    .picks{margin-top:24px}
    .picks .dm-card{padding:20px}
  }
</style>
