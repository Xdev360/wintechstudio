---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import AskAI from '../components/AskAI.astro';
import Footer from '../components/Footer.astro';
import Closing from '../components/ui/Closing.astro';
import Hero from '../components/home/Hero.astro';
import Sections from '../components/home/Sections.astro';
---
<Base title="Wintech Studio · Design and build studio in Lagos" description="Brand, websites, stores, AI and automation for businesses starting out, adding tech, or refreshing their brand. One team in Lagos, working worldwide.">
  <Header />
  <main class="home">
    <Hero />
    <Sections />
    <Closing />
  </main>
  <Footer />
  <AskAI />
</Base>
<style is:global>
  /* Home colour roles, from Figma H1 (light) and H2 (dark) */
  .home{
    --h-fg:#0A0E17; --h-mute:#5E6678; --h-soft:#9AA3B2; --h-rule:#E3E7EE; --h-guide:#E3E7EE;
    --h-bg:#FFFFFF; --h-alt:#F2F4F8; --h-card:#FFFFFF; --h-chip:#F2F4F8; --h-skel:#F5F7FA;
    --h-accent:#3B5BFF; --h-ok-bg:#E7F6EC; --h-ok:#1A7F43; --h-dot:#9AA3B2;
    --h-grad:linear-gradient(90deg,#254D7F,#3B5BFF);
    --h-shadow:0 8px 24px rgba(10,15,26,.06);
  }
  :root[data-theme="dark"] .home{
    --h-fg:#F4F6FA; --h-mute:#9AA3B2; --h-soft:#5E6678; --h-rule:rgba(255,255,255,.09); --h-guide:rgba(255,255,255,.09);
    --h-bg:#0A0E17; --h-alt:#111723; --h-card:#161D2A; --h-chip:#1C2432; --h-skel:#1C2432;
    --h-accent:#7C93FF; --h-ok-bg:#12301F; --h-ok:#5FD38A; --h-dot:#5E6678;
    --h-grad:linear-gradient(90deg,#8FA3FF,#D5DCFF);
    --h-shadow:0 8px 24px rgba(0,0,0,.3);
  }
  .home{background:var(--h-bg);color:var(--h-fg)}
  .home .h-wrap{max-width:1200px;margin:0 auto;box-sizing:content-box;padding-left:120px;padding-right:120px}
  .home .h-mono{font:400 11px/normal var(--mono);letter-spacing:.66px;text-transform:uppercase;color:var(--h-mute);margin:0}
  .home .h-grad{background:var(--h-grad);-webkit-background-clip:text;background-clip:text;color:transparent}
  .home .h-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:13px 20px;border-radius:4px;font:500 16px/normal var(--font);text-decoration:none;white-space:nowrap;transition:background .15s}
  .home .h-btn.primary{background:#3B5BFF;color:#fff}.home .h-btn.primary:hover{background:#2F4BE6}
  .home .h-btn.soft{background:#F2F4F8;color:#0A0E17}.home .h-btn.soft:hover{background:#E3E7EE}
  :root[data-theme="dark"] .home .h-btn.soft{background:#fff;color:#0A0E17}
  .home .h-link{display:inline-flex;align-items:center;gap:6px;font:500 15px/normal var(--font);color:var(--h-fg);text-decoration:none}
  .home .h-link:hover{color:var(--h-accent)}
  /* Figma guide rails at x=80 and x=1359 */
  .home .rails{position:relative}
  .home .rails::before,.home .rails::after{content:'';position:absolute;top:0;bottom:0;width:1px;background:var(--h-guide);pointer-events:none;z-index:1}
  .home .rails::before{left:calc(50% - 640px)}.home .rails::after{left:calc(50% + 639px)}
  @media (max-width:1359px){.home .rails::before,.home .rails::after{display:none}}
  @media (max-width:1439px){.home .h-wrap{padding-left:clamp(16px,8.34vw,120px);padding-right:clamp(16px,8.34vw,120px)}}
  @media (max-width:1023px){:root[data-theme="dark"] .home{--h-alt:#0A0E17}}
  @media (max-width:1023px){.home .h-wrap{padding-left:16px;padding-right:16px}.home .h-mono{font-size:10px;letter-spacing:.6px}.home .h-btn{border-radius:0}}
</style>
