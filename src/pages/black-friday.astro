---
// Black Friday 2026 · 20 brands only. Design: Figma "Website · v5" > BF · Black Friday 2026 (desktop/mobile, dark/light).
// No online payment: every action goes to /book?service=black-friday. No borders, no radius on this page.
import Page from '../layouts/Page.astro';
import Lc from '../components/ui/Lc.astro';
import BfScene from '../components/bf/BfScene.astro';
import Faq from '../components/ui/Faq.astro';
import '../styles/studio.css';

const ENDS = '2026-11-27T23:59:00+01:00';
const TOTAL = 20, TAKEN = 0; // update TAKEN as calls are booked and confirmed
const LEFT = TOTAL - TAKEN;
const book = '/book?service=black-friday';

const logos = [
  ['Mylo', '/images/cases/icon-mylo.svg', 'var(--fg)'], ['Virelle Wellness', '/images/cases/icon-virelle.svg', '#1D6B4A'],
  ['Tobel Pearls', '/images/cases/icon-tobel-pearls.svg', '#007DFE'], ['Manzeelatur Ridho', '/images/cases/icon-manzeelatur-ridho.webp', '#2A4BD7'],
  ["Let's Hang", '/images/cases/icon-lets-hang.svg', '#834DFB'],
];
const pack = [
  ['search', 'Brand audit', 'How customers find you, where they drop off and what competitors do better. Written down.'],
  ['pen', 'Brand identity', 'Logo refresh, colours, type and a guideline, so everything looks like one business.'],
  ['layout', 'Social page', 'A highlight for each service, post and story templates, X and LinkedIn covers.'],
  ['globe', 'Website', 'New or rebuilt. Fast on a phone, found on Google, with WhatsApp, booking and contact.'],
];
const steps = [
  ['Week 1', 'Audit', 'We study your page, your site and your sales, and write down what is losing you customers.', ['How customers find you', 'Where they drop off', 'What competitors do better', 'What to fix first'], 'Weak point: no prices on the page'],
  ['Week 2', 'Brand', 'Identity and guideline, built on what the audit found. You approve before we move on.', ['Logo refresh', 'Colours and type', 'Brand guideline', 'Approved by you'], 'Colours and type locked'],
  ['Week 3', 'Social page', 'Highlights and templates that lead people straight to what you sell.', ['A highlight for each service', 'Post and story templates', 'Profile picture', 'X and LinkedIn covers'], 'Highlights point to prices'],
  ['Weeks 4 to 6', 'Website', 'Designed and built to fix the problems the audit found, not just to look new.', ['Up to 5 pages', 'WhatsApp, booking, contact', 'Fast on a phone', 'Found on Google'], 'Prices now on the home page'],
  ['January', 'Launch', 'We go live together. Files, guideline and logins are handed over to you.', ['Go live', 'Files and guideline', 'Logins handed over', 'Aftercare starts'], 'Live, and handed over'],
];
const packs = [
  { id: 'refresh', name: 'Refresh', who: 'For brands that need to look the part', was: 1000000, now: 300000, usd: 220, items: ['Brand audit, written', 'Logo refresh', 'Brand guideline', 'Social page kit', 'X and LinkedIn covers'] },
  { id: 'revamp', name: 'Revamp', who: 'Brand, social page and a new website', was: 1900000, now: 600000, usd: 450, hi: true, items: ['Everything in Refresh', '5 page website, new or rebuilt', 'WhatsApp, contact and booking', 'Found on Google', 'Launch in January'] },
  { id: 'revamp-ai', name: 'Revamp + AI', who: 'Everything, plus AI on your website', was: 3100000, now: 900000, usd: 650, items: ['Everything in Revamp', 'AI assistant on your website', 'Answers customers day and night', 'First month of care', 'Priority launch slot'] },
];
const addons = [['page', 'Extra website page', 60000], ['store', 'Online store with Paystack', 250000], ['motion', '15 second motion intro', 250000], ['content', 'One month of content, 12 posts', 300000]] as const;
const who = [['bag', 'Fashion and retail', 'Sell from your page with a real store behind it.'], ['utensils', 'Restaurants and food', 'Menu, orders and bookings in one place.'], ['scissors', 'Beauty and salons', 'Book straight from your highlights.'], ['layers', 'Logistics and clearing', 'Look as big as the cargo you move.'], ['heart', 'Clinics and services', 'Trust before the first appointment.'], ['rocket', 'Startups and new brands', 'Launch 2027 with everything in place.']];
const care = [['wrench', '2 maintenance checks a year', 'We check speed, links, forms and payments twice a year.'], ['shield', 'Bugs fixed free', 'If something on your site breaks, we fix it at no cost.'], ['tag', '30% off future updates', 'New pages, features or campaigns at 30% off the quote.']];
const faqs: [string, string][] = [
  ['Why only 20 brands?', 'Every pack starts with a real audit and ends with a January launch. Twenty is what we can do properly in that time.'],
  ['How do I pay?', 'Book a call first. We agree your pack and plan on the call, then send the first invoice. Pay in 3 (30% to lock your spot, 35% in December, 35% before launch) or pay in 2 (50% now, 50% before launch).'],
  ['I already have a logo. Do I still need the brand part?', 'We keep what works. The audit tells us if your logo needs a refresh or just a proper guideline around it.'],
  ['What happens after launch?', 'Black Friday clients get two maintenance checks a year, free bug fixes on the site, and 30% off any future update.'],
  ['Can I pay in dollars?', 'Yes. Every pack has a dollar price for businesses outside Nigeria.'],
];
const ngn = (n: number) => '₦' + n.toLocaleString('en-NG');
const ld = [{ '@context': 'https://schema.org', '@type': 'Offer', name: 'Wintech Black Friday 2026', description: 'Brand audit, identity, social page and website for 20 brands, launching January 2027.', priceCurrency: 'NGN', price: '300000', availabilityEnds: ENDS, seller: { '@type': 'Organization', name: 'Wintech Studio' } }];
---
<Page title="Black Friday 2026 · 20 brands only · Wintech Studio" description="We are taking 20 businesses only: a brand audit first, then your brand, social page and website, launching in January 2027. Packs from ₦300,000, paid in parts." crumbs={[['Black Friday', '/black-friday']]} jsonld={ld} closing={false}>
<div class="dm bf">
  <canvas class="burst" id="burst" aria-hidden="true"></canvas>

  <!-- HERO -->
  <section class="hero">
    <div class="wrap hg">
      <div>
        <p class="dm-eb acc">Black Friday 2026 · 20 brands only</p>
        <h1 class="h1">Ready for 2027?<br /><span>Your brand isn't.</span></h1>
        <p class="dm-intro"><span class="dk">We are taking 20 businesses only. We study yours first, then rebuild your brand, your social page and your website, so you start the new year ready to sell.</span><span class="mb">20 brands only. We rebuild your brand, social page and website for 2027.</span></p>
        <div class="ctas dk"><a class="dm-btn p" href={book}>Book a call</a><a class="dm-btn s" href="#packs">See the packs</a></div>
      </div>
      <div class="tc">
        <span class="tag">Black Friday</span>
        <p class="dm-eb">Ends Black Friday · 27 Nov · 11:59 PM WAT</p>
        <div class="cd" id="cd" data-ends={ENDS}>
          {['Days', 'Hrs', 'Min', 'Sec'].map(l => <div><b data-u={l}>00</b><span>{l}</span></div>)}
        </div>
        <p class="dm-eb">{LEFT === TOTAL ? `All ${TOTAL} spots open` : `${LEFT} of ${TOTAL} spots left`}</p>
        <div class="spots" aria-label={`${LEFT} of ${TOTAL} spots left`}>{Array.from({ length: TOTAL }, (_, i) => <i class={i < LEFT ? 'on' : ''}></i>)}</div>
        <p class="dm-small">Audit first. Brand, social page and website. Launch in January.</p>
        <a class="dm-btn p w dk" href={book}>Book a call</a>
      </div>
      <div class="mcta mb"><a class="dm-btn p" href={book}>Book a call</a><a class="more-l" href="#packs">See the packs <Lc name="chevron-down" size={16} /></a></div>
    </div>
  </section>

  <!-- PROOF -->
  <section class="proof">
    <div class="wrap">
      <p class="dm-eb">Brands we have designed and built</p>
      <div class="lm"><ul class="logos">{[0, 1].map(k => logos.map(([n, src, c]) => <li style={`--c:${c}`} class={k ? 'dup' : ''} aria-hidden={k ? 'true' : undefined}><img src={src} alt="" width="22" height="22" loading="lazy" /><span>{n}</span></li>))}</ul></div>
    </div>
  </section>

  <!-- PACK -->
  <section class="dm-sec alt">
    <div class="wrap">
      <p class="dm-eb acc">What's in the pack</p>
      <h2 class="h2">Four things your business <br />needs before 2027.</h2>
      <div class="row4 swipe">
        {pack.map(([ic, t, d], i) => (
          <article class="card rv">
            <div class={`ill ill${i}`} aria-hidden="true">
              {i === 0 && <div class="bars">{[['Found you', 100], ['Messaged', 55], ['Paid', 20]].map(([l, v]) => <p><span>{l}</span><i style={`--v:${v}%`}></i></p>)}</div>}
              {i === 1 && <div class="aa"><b>Aa</b><span><i></i><i></i><i></i><i></i></span></div>}
              {i === 2 && <div class="soc"><i class="av"></i><span><i></i><i></i><i></i><i></i></span></div>}
              {i === 3 && <div class="br"><i class="hb">Your brand, ready for 2027.</i><span><i></i><i></i><i></i></span></div>}
            </div>
            <div class="cb"><span class="ic"><Lc name={ic} size={18} /></span><span class="n">0{i + 1}</span></div>
            <h3>{t}</h3><p>{d}</p>
          </article>
        ))}
      </div>
      <div class="dots" data-for="row4" aria-hidden="true">{pack.map((_, i) => <i class={i === 0 ? 'on' : ''}></i>)}</div>
    </div>
  </section>

  <!-- AUDIT: pinned, cards flip 1 to 5 on scroll -->
  <section class="audit" id="audit">
    <div class="pin">
      <div class="wrap">
        <div class="ah">
          <div><p class="dm-eb acc">How it runs</p><h2 class="h2">We start with an audit, <br />not a logo.</h2></div>
          <p class="dm-body">Most redesigns start with how things look. Ours start with why customers are not buying. Then every step fixes something the audit found.</p>
        </div>
        <div class="stage">
          <ol class="rail"><i class="rf" aria-hidden="true"></i>{steps.map(([w, t], i) => <li class={i === 0 ? 'on' : ''} data-k={i} tabindex="0" role="button" aria-label={`Go to step ${i + 1}: ${t}`}><b>{i + 1}</b><span><em>{w}</em>{t}</span></li>)}</ol>
          <div class="stack">
            {steps.map(([w, t, d, list], i) => (
              <article class="sc" data-i={i} style={`--i:${i}`}>
                <div class="st"><span class="tg">Step 0{i + 1} · {w}</span><span class="dm-eb">{i + 1} / 5</span></div>
                <h3>{t}</h3><p class="dm-body">{d}</p>
                <p class="dm-eb">What we do</p>
                <ul>{(list as string[]).map(x => <li><Lc name="check" size={16} stroke={2.2} />{x}</li>)}</ul>
                <div class="pg"><i style={`width:${(i + 1) * 20}%`}></i></div>
              </article>
            ))}
          </div>
          <div class="aill" aria-hidden="true">
            {steps.map((_, i) => <div class={`scn${i === 0 ? ' on' : ''}`} data-k={i}><BfScene k={i} play={i === 0} /></div>)}
          </div>
        </div>
        <ol class="tl" id="tl">
          <i class="fill" aria-hidden="true"></i>
          {steps.map(([w, t, d, list, note], i) => (
            <li class={`ts${i === 0 ? ' on' : ''}`}>
              <span class="node">{i + 1}</span>
              <div class="tb">
                <div class="tsc"><BfScene k={i} /></div>
                <p class="tw">Step {i + 1} · {w}</p>
                <h3>{t}</h3>
                <p>{d}</p>
                <ul class="tch">{(list as string[]).slice(0, 3).map(x => <li><Lc name="check" size={14} stroke={2.4} />{x}</li>)}</ul>
                <p class="tn">{note}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
  <section class="dm-sec cmp-sec">
    <div class="wrap cmp">
      <div class="card"><p class="dm-eb">The usual way</p><ul class="no">{['Logo first', 'Website from a template', 'Hope people buy'].map(x => <li><Lc name="x" size={16} stroke={2.2} /><s>{x}</s></li>)}</ul></div>
      <div class="card hi"><p class="dm-eb acc">The Wintech way</p><ul>{['Audit first', 'Brand and social built on the audit', 'A website that fixes what was losing sales'].map(x => <li><Lc name="check" size={16} stroke={2.2} />{x}</li>)}</ul></div>
    </div>
  </section>

  <!-- PACKS + PLAN -->
  <section class="dm-sec alt" id="packs">
    <div class="wrap">
      <div class="ph">
        <div><p class="dm-eb acc">Pick your pack</p><h2 class="h2">Pick your pack. <br />Pay in small parts.</h2></div>
        <p class="dm-body">No big payment up front. Start from 30% after your call, and the rest is spread until launch in January.</p>
      </div>
      <div class="ptabs" role="tablist" aria-label="Packs">{packs.map(p => <button type="button" class={p.hi ? 'on' : ''} data-id={p.id}>{p.name}</button>)}</div>
      <div class="row3 swipe" role="radiogroup" aria-label="Packs">
        {packs.map(p => (
          <button type="button" class={`pk rv${p.hi ? ' on' : ''}`} role="radio" aria-checked={p.hi ? 'true' : 'false'} data-id={p.id} data-name={p.name} data-price={p.now}>
            {p.hi && <span class="badge">Most picked</span>}
            <b class="nm">{p.name}</b><span class="who">{p.who}</span>
            <s class="was">{ngn(p.was)}</s><b class="pr">{ngn(p.now)}</b><span class="usd">${p.usd} outside Nigeria</span>
            <span class="from">From {ngn(Math.round(p.now * 0.3))} after your call<em>Pay in 3</em></span>
            <ul>{p.items.map(x => <li><Lc name="check" size={16} stroke={2.2} />{x}</li>)}</ul>
            <span class="sel">{p.hi ? 'Selected' : 'Choose ' + p.name}</span>
          </button>
        ))}
      </div>

      <div class="plan" id="plan">
        <div class="pl-top">
          <div><p class="dm-eb">Your plan</p><b class="pl-name" id="plName">Revamp</b></div>
          <b class="pl-total" id="plTotal">{ngn(600000)}</b>
        </div>
        <div class="pl-grid">
          <div>
            <p class="dm-eb o-l">Add what you need</p>
            <details class="more" id="more" open>
              <summary><Lc name="plus" size={16} stroke={2.4} /><b>Add more</b><span>{addons.length} add-ons</span><Lc name="chevron-down" size={16} /></summary>
              <div class="adds">{addons.map(([id, n, p]) => <label class="add"><input type="checkbox" value={id} data-price={p} data-name={n} /><span class="box"><Lc name="check" size={14} stroke={2.6} /></span><span class="an">{n}</span><span class="ap">+ {ngn(p)}</span></label>)}</div>
            </details>
            <p class="dm-eb gap o-h">How you pay</p>
            <div class="plans o-p" role="radiogroup" aria-label="Payment plan">
              <button type="button" class="pp on" role="radio" aria-checked="true" data-plan="3"><b>Pay in 3</b><span>30% after your call</span></button>
              <button type="button" class="pp" role="radio" aria-checked="false" data-plan="2"><b>Pay in 2</b><span>50% after your call</span></button>
            </div>
          </div>
          <div>
            <p class="dm-eb o-w">When you pay</p>
            <ol class="sched" id="sched"></ol>
            <div class="due">
              <div><p class="dm-eb">First payment, after your call</p><b id="plFirst">{ngn(180000)}</b><span class="mtot mb">of <span id="plTot2">{ngn(600000)}</span> total</span></div>
              <a class="dm-btn p" id="plBook" href={book}>Book a call</a>
            </div>
            <p class="dm-small o-s">Book a call to lock your spot. We agree the plan on the call and send your first invoice after. Nothing is handed over until the last payment.</p>
          </div>
        </div>
      </div>

      <div class="care">
        <p class="dm-eb acc">Black Friday aftercare · included</p>
        <div class="cg">{care.map(([ic, t, d]) => <div><span class="ic s"><Lc name={ic} size={18} /></span><span><b>{t}</b><span class="dm-small">{d}</span></span></div>)}</div>
      </div>
    </div>
  </section>

  <!-- WHO -->
  <section class="dm-sec">
    <div class="wrap">
      <p class="dm-eb acc">Who it's for</p>
      <h2 class="h2 nb">For businesses that look smaller <br />online than they really are.</h2>
      <div class="row-who swipe">{who.map(([ic, t, d]) => <div class="card rv"><span class="ic s"><Lc name={ic} size={18} /></span><h3>{t}</h3><p>{d}</p></div>)}</div>
      <div class="dots" data-for="row-who" aria-hidden="true">{who.map((_, i) => <i class={i === 0 ? 'on' : ''}></i>)}</div>
    </div>
  </section>
</div>

<Faq items={faqs} title="Black Friday questions" ld={true} service="black-friday" />

<section class="bfc">
  <div class="glow" aria-hidden="true"><span class="g g1"></span><span class="g g2"></span><span class="g g3"></span><span class="hz"></span></div>
  <div class="cf" aria-hidden="true">{Array.from({ length: 26 }, (_, i) => <i style={`--x:${(i * 37) % 100}%;--y:${(i * 23) % 60}%;--r:${(i * 47) % 180 - 90}deg;--c:${['#3B5BFF', '#8B9CFF', '#5A6378'][i % 3]};--dl:-${((i * 1.9) % 14).toFixed(1)}s`}></i>)}</div>
  <div class="in">
    <p class="dm-eb">Black Friday · ends 27 November</p>
    <h2>20 brands.<br />Then we close.</h2>
    <p class="sub">Audit first, then brand, social page and website. Book a call to lock your spot.</p>
    <a class="dm-btn p" href={book}>Book a call</a>
  </div>
</section>

<a class="sticky" href={book}><span><b>{LEFT === TOTAL ? `All ${TOTAL} spots open` : `${LEFT} of ${TOTAL} spots left`}</b><em>Ends 27 Nov</em></span><span class="dm-btn p sm">Book a call</span></a>
</Page>

<style>
  .bf{position:relative}
  .bf *,.bfc *,.sticky *{border-radius:0}
  .bf b,.sticky b,.bf strong{font-weight:600}
  .acc{color:var(--sig)}
  :global(:root[data-theme="dark"]) .acc{color:#8B9CFF}
  .h1{font-size:68px;line-height:72px;letter-spacing:-1.6px;font-weight:600;margin:16px 0 24px}
  .h1 span{color:var(--sig)}
  :global(:root[data-theme="dark"]) .h1 span{color:#8B9CFF}
  .h2{font-size:42px;line-height:48px;letter-spacing:-.9px;font-weight:600;margin:12px 0 0}
  .card{border:0;background:var(--bg);padding:24px;display:flex;flex-direction:column;gap:10px}
  .alt .card{background:var(--bg)}
  .ic{display:inline-grid;place-items:center;width:40px;height:40px;color:var(--sig)}
  .ic.s{background:var(--sig);color:#fff}
  .burst{position:absolute;left:0;top:0;width:100%;height:100vh;pointer-events:none;z-index:60}

  /* hero */
  .hero{padding:96px 0 72px;position:relative}
  .hg{display:grid;grid-template-columns:minmax(0,1fr) 440px;gap:64px;align-items:center}
  .ctas{display:flex;gap:12px;margin-top:32px;flex-wrap:wrap}
  .tc{position:relative;background:var(--panel);padding:32px 28px 28px;display:flex;flex-direction:column;gap:14px}
  .tag{position:absolute;top:0;left:50%;transform:translate(-50%,-50%);background:#000;color:#fff;font:500 11px/1 var(--font-mono,monospace);letter-spacing:1.4px;text-transform:uppercase;padding:8px 14px;white-space:nowrap}
  .cd{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
  .cd div{background:var(--bg);padding:14px 0 12px;text-align:center}
  .cd b{display:block;font-size:36px;line-height:40px;font-weight:600;letter-spacing:-.8px;font-variant-numeric:tabular-nums}
  .cd span{font-size:10px;letter-spacing:1px;text-transform:uppercase;color:var(--lab)}
  .spots{display:grid;grid-template-columns:repeat(20,1fr);gap:4px}
  .spots i{height:14px;background:var(--tint)}
  .spots i.on{background:var(--sig)}

  .proof{padding:28px 0 40px}
  .logos{list-style:none;margin:16px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:12px}
  .logos li{display:flex;align-items:center;gap:8px;background:var(--panel);padding:12px 18px;color:var(--c);font-weight:500;font-size:15px}
  .logos img{width:22px;height:22px}
  :global(:root[data-theme="dark"]) .logos li{color:color-mix(in srgb,var(--c) 45%,#fff)}

  /* pack */
  .row4{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:48px}
  .row4 .card{padding:0 0 24px}
  .row4 .card>:not(.ill){padding:0 24px}
  .row4 h3{font-size:20px;font-weight:600;margin:0}
  .row4 p,.row-who p{font-size:14px;line-height:21px;color:var(--mute);margin:0}
  .cb{display:flex;justify-content:space-between;align-items:center;margin-top:20px}
  .cb .n{font:400 11px var(--font-mono,monospace);color:var(--lab)}
  .ill{height:150px;background:var(--panel);padding:20px;position:relative;overflow:hidden}
  .bars p{margin:0 0 14px;font-size:11px;color:var(--lab)}
  .bars i{display:block;height:8px;width:var(--v);background:var(--sig);margin-top:6px}
  .bars p:nth-child(2) i{opacity:.6}.bars p:nth-child(3) i{opacity:.3}
  .aa b{font-size:56px;line-height:60px;font-weight:600;letter-spacing:-2px}
  .aa span,.soc span{display:flex;gap:8px;margin-top:12px}
  .aa span i,.soc span i{width:28px;height:28px;border-radius:50%;background:var(--fg);opacity:.12}
  .aa span i:first-child,.soc .av{background:var(--sig);opacity:1}
  .soc .av{display:block;width:40px;height:40px;border-radius:50%;margin-bottom:12px}
  .soc span i{width:34px;height:34px}
  .br{background:var(--bg);padding:10px;height:100%}
  .br .hb{display:block;background:var(--sig);color:#fff;font-style:normal;font-size:11px;font-weight:600;padding:16px 10px}
  .br span{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:8px}
  .br span i{height:26px;background:var(--tint)}

  /* audit pinned */
  .audit{height:340vh;position:relative}
  .pin{position:sticky;top:0;height:100vh;display:flex;align-items:center;overflow:hidden;background:var(--bg)}
  .pin>.wrap{width:100%}
  .ah{display:grid;grid-template-columns:1fr 500px;gap:64px;align-items:end;margin-bottom:48px}
  .stage{display:grid;grid-template-columns:260px 440px minmax(0,1fr);gap:56px;align-items:center}
  .rail{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:36px;position:relative}
  .rail::before{content:"";position:absolute;left:17px;top:18px;bottom:18px;width:2px;background:var(--tint)}
  .rail li{display:flex;gap:16px;align-items:center;position:relative;z-index:1;color:var(--lab);transition:color .3s;cursor:pointer;outline:0}
  .rail li:hover{color:var(--fg)}.rail li:focus-visible b{box-shadow:0 0 0 2px var(--bg),0 0 0 4px var(--sig)}
  .rf{position:absolute;left:17px;top:18px;width:2px;height:0;background:var(--sig);z-index:0;transition:height .55s cubic-bezier(.2,.8,.2,1)}
  .rail b{width:36px;height:36px;display:grid;place-items:center;background:var(--panel);font-size:14px;transition:background .3s,color .3s;flex:none}
