  var ngn=function(n){return '₦'+Math.round(n).toLocaleString('en-NG')};
  // countdown
  var cd=document.getElementById('cd');if(cd){var end=new Date(cd.dataset.ends).getTime();var u=function(k){return cd.querySelector('[data-u="'+k+'"]')};
    var tick=function(){var d=Math.max(0,end-Date.now());var s=Math.floor(d/1000);var v={Days:Math.floor(s/86400),Hrs:Math.floor(s%86400/3600),Min:Math.floor(s%3600/60),Sec:s%60};for(var k in v)u(k).textContent=String(v[k]).padStart(2,'0')};tick();setInterval(tick,1000);}
  // confetti burst on load
  var cv=document.getElementById('burst');if(cv&&!reduce){var x=cv.getContext('2d'),W=cv.width=innerWidth,H=cv.height=innerHeight,cols=['#3B5BFF','#8B9CFF','#C9CED8','#3B5BFF'],ps=[];
    for(var i=0;i<140;i++){var a=Math.random()*Math.PI*2,sp=6+Math.random()*10;ps.push({x:W/2,y:H*0.38,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp-6,w:5+Math.random()*6,h:9+Math.random()*9,r:Math.random()*6,vr:(Math.random()-.5)*.3,c:cols[i%4],o:1})}
    var t0=performance.now();(function f(t){x.clearRect(0,0,W,H);var alive=false;ps.forEach(function(p){p.vy=Math.min(p.vy+0.16,2.4);p.vx*=0.97;p.x+=p.vx+Math.sin((t-t0)/400+p.r)*0.6;p.y+=p.vy;p.r+=p.vr;if(t-t0>2600)p.o-=0.012;if(p.o>0&&p.y<H+40){alive=true;x.save();x.globalAlpha=Math.max(0,p.o);x.translate(p.x,p.y);x.rotate(p.r);x.fillStyle=p.c;x.fillRect(-p.w/2,-p.h/2,p.w,p.h);x.restore()}});if(alive)requestAnimationFrame(f);else cv.remove()})(t0);} else if(cv)cv.remove();
  // reveal
  var io=new IntersectionObserver(function(es){es.forEach(function(e,i){if(e.isIntersecting){var el=e.target;setTimeout(function(){el.classList.add('in')},(Array.prototype.indexOf.call(el.parentNode.children,el)%4)*90);io.unobserve(el)}})},{threshold:.15});
  document.querySelectorAll('.rv').forEach(function(el){reduce?el.classList.add('in'):io.observe(el)});
  // audit pinned stack
  var au=document.getElementById('audit');var mob=matchMedia('(max-width: 767px)');
  if(au){var cards=au.querySelectorAll('.sc'),rail=au.querySelectorAll('.rail li'),rf=au.querySelector('.rf'),scn=au.querySelectorAll('.scn');var cur=-1,N=cards.length;
    // one card at a time: the active card is fully on, cards behind are blank sheets, passed cards fly off
    var set=function(k){if(k===cur)return;cur=k;
      cards.forEach(function(c,i){var d=i-k;c.classList.toggle('bk',d>0);if(d<0){c.style.transform='translateY(-48px) rotateX(14deg) scale(.96)';c.style.opacity='0';c.style.zIndex=String(10+i)}else{c.style.transform='translateY('+(-d*14)+'px) scale('+(1-d*0.04)+')';c.style.opacity=d>2?'0':'1';c.style.zIndex=String(10-d)}});
      rail.forEach(function(r,i){r.classList.toggle('on',i===k)});
      if(rail.length>1){var a=rail[0].offsetTop+18,z=rail[N-1].offsetTop+18;rf.style.top=a+'px';rf.style.height=((z-a)*k/(N-1))+'px'}
      scn.forEach(function(sc,i){sc.classList.toggle('on',i===k);var sv=sc.firstElementChild;if(i===k){sv.classList.remove('play');void sv.offsetWidth;sv.classList.add('play')}else sv.classList.remove('play')})};
    var range=function(){return au.offsetHeight-innerHeight};
    var top0=function(){return au.getBoundingClientRect().top+scrollY};
    var posOf=function(i){return top0()+range()*((i+0.5)/N)};
    var prog=function(){return Math.min(1,Math.max(0,-au.getBoundingClientRect().top/range()))};
    var on=function(){if(mob.matches)return;set(Math.min(N-1,Math.floor(prog()*N)))};
    // magnetic: when scrolling stops inside the section, settle on the nearest step
    var snapT,snapping=false;
    var snap=function(){if(mob.matches||snapping)return;var r=au.getBoundingClientRect();if(r.top>0||r.bottom<innerHeight)return;var p=prog();if(p<=0.02||p>=0.98)return;var k=Math.min(N-1,Math.floor(p*N));var y=posOf(k);if(Math.abs(y-scrollY)<6)return;snapping=true;scrollTo({top:y,behavior:reduce?'auto':'smooth'});setTimeout(function(){snapping=false},700)};
    addEventListener('scroll',function(){on();clearTimeout(snapT);snapT=setTimeout(snap,140)},{passive:true});
    rail.forEach(function(r,i){var go=function(){snapping=true;scrollTo({top:posOf(i),behavior:reduce?'auto':'smooth'});setTimeout(function(){snapping=false},900)};r.addEventListener('click',go);r.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();go()}})});
    addEventListener('resize',on);set(0);on();}
  // phone timeline: line fills to the middle of the screen, steps light up as they pass it
  var tl=document.getElementById('tl');if(tl){var fill=tl.querySelector('.fill'),ts=tl.querySelectorAll('.ts');
    var tlu=function(){if(!mob.matches)return;var r=tl.getBoundingClientRect(),mid=innerHeight*0.55;var h=Math.max(0,Math.min(r.height-40,mid-r.top-20));fill.style.height=h+'px';ts.forEach(function(t,i){var r2=t.getBoundingClientRect();var o=i===0||r2.top+20<=mid;t.classList.toggle('on',o);var sv=t.querySelector('.sv');if(sv){var vis=r2.bottom>0&&r2.top<innerHeight;if(vis&&!sv.classList.contains('play'))sv.classList.add('play');else if(!vis)sv.classList.remove('play')}})};
    addEventListener('scroll',tlu,{passive:true});addEventListener('resize',tlu);tlu();}
  // sticky bar shows only when no other Book a call is on screen
  var st=document.querySelector('.sticky');if(st&&'IntersectionObserver' in window){var seen=new Set();var so=new IntersectionObserver(function(es){es.forEach(function(e){e.isIntersecting?seen.add(e.target):seen.delete(e.target)});st.classList.toggle('show',seen.size===0)},{threshold:0});['.hero','#packs .plan','.bfc'].forEach(function(q){var el=document.querySelector(q);if(el)so.observe(el)})}
  // swipe dots
  document.querySelectorAll('.dots[data-for]').forEach(function(d){var row=document.querySelector('.'+d.dataset.for);if(!row)return;var ds=d.querySelectorAll('i');row.addEventListener('scroll',function(){var w=row.firstElementChild.getBoundingClientRect().width+12;var k=Math.min(ds.length-1,Math.round(row.scrollLeft/w));if(row.scrollLeft+row.clientWidth>=row.scrollWidth-4)k=ds.length-1;ds.forEach(function(x,i){x.classList.toggle('on',i===k)})},{passive:true})});
  // add-ons start closed on phones
  var more=document.getElementById('more');if(more&&matchMedia('(max-width: 767px)').matches)more.open=false;
  // packs + plan
  var pks=document.querySelectorAll('.pk'),adds=document.querySelectorAll('.add input'),pps=document.querySelectorAll('.pp');var pack=document.querySelector('.pk.on'),plan='3';
  var upd=function(){var base=+pack.dataset.price,ex=0,names=[pack.dataset.name],ids=[];adds.forEach(function(a){if(a.checked){ex+=+a.dataset.price;ids.push(a.value);names.push(a.dataset.name)}});var tot=base+ex;
    document.getElementById('plName').textContent=pack.dataset.name+(ids.length?' + '+(ids.length===1?names[1].charAt(0).toLowerCase()+names[1].slice(1):ids.length+' add-ons'):'');document.getElementById('plTotal').textContent=ngn(tot);
    var parts=plan==='3'?[['After your call','Locks your spot',.3],['15 December','After brand and social',.35],['Before launch','January handover',.35]]:[['After your call','Locks your spot',.5],['Before launch','January handover',.5]];
    document.getElementById('sched').innerHTML=parts.map(function(p){return '<li><span><em>'+p[0]+'</em>'+p[1]+'</span><b>'+ngn(tot*p[2])+'</b></li>'}).join('');
    document.getElementById('plFirst').textContent=ngn(tot*parts[0][2]);document.getElementById('plTot2').textContent=ngn(tot);
    document.getElementById('plBook').href='/book?service=black-friday&pack='+pack.dataset.id+'&plan='+plan+(ids.length?'&addons='+ids.join(','):'')};
  var tabs=document.querySelectorAll('.ptabs button');
  pks.forEach(function(b){b.addEventListener('click',function(){pks.forEach(function(x){x.classList.remove('on');x.setAttribute('aria-checked','false');x.querySelector('.sel').textContent='Choose '+x.dataset.name});b.classList.add('on');b.setAttribute('aria-checked','true');b.querySelector('.sel').textContent='Selected';pack=b;tabs.forEach(function(t){t.classList.toggle('on',t.dataset.id===b.dataset.id)});upd()})});
  tabs.forEach(function(t){t.addEventListener('click',function(){var b=document.querySelector('.pk[data-id="'+t.dataset.id+'"]');if(b)b.click()})});
  adds.forEach(function(a){a.addEventListener('change',upd)});
  pps.forEach(function(b){b.addEventListener('click',function(){pps.forEach(function(x){x.classList.remove('on');x.setAttribute('aria-checked','false')});b.classList.add('on');b.setAttribute('aria-checked','true');plan=b.dataset.plan;upd()})});
  if(pack)upd();
})();
</script>
