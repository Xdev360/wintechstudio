    .sticky .dm-btn{margin-right:60px}.sticky b{display:block;font-size:14px}.sticky em{font-style:normal;font-size:12px;color:var(--mute)}
  }
  @media (prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;filter:none;transition:none}.sc,.mag{transition:none}}
</style>

