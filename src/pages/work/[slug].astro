---
// Case study template, DesignMe case-page proportions (measured on designme.agency/projects/* at 1440 and 390):
// overview band (eyebrow, H1 56, summary 18/600, stats + status cards, services row), then chapters
// (index column 389: number + 24/600 title; body 672: lead 18/600, body 16 at 75%, numbered points),
// each followed by full-width media (padding 0 40, 12 gap). Ends with "Next case" cards and the site closing band.
// Light by default and follows the site theme; Mylo and Virtual Trades stay dark (their brands are dark).
import Page from '../../layouts/Page.astro';
import Masonry from '../../components/work/Masonry.astro';
import Visual from '../../components/work/Visual.astro';
import Card from '../../components/work/Card.astro';
import Icon from '../../components/Icon.astro';
import { cases, tiles, workOrder } from '../../data/cases';
export function getStaticPaths() { return cases.map(c => ({ params: { slug: c.slug } })); }
const c = cases.find(x => x.slug === Astro.params.slug)!;
// Next cases follow the Work index order.
const order = workOrder.map(s => cases.find(x => x.slug === s)!);
const at = order.findIndex(x => x.slug === c.slug);
const more = [1, 2, 3].map(k => order[(at + k) % order.length]);
const ld = { '@context': 'https://schema.org', '@type': 'CreativeWork', name: c.headline, about: c.name, creator: { '@type': 'Organization', name: 'Wintech Studio' }, description: c.intro, image: `https://www.wintechstudio.com/images/cases/film-${c.slug}.webp` };
const dark = c.theme === 'dark';
const vt = c.slug === 'virtual-trades';
---
<Page title={`${c.name} case study · Wintech Studio`} description={c.intro.slice(0, 158)} crumbs={[['Work', '/work'], [c.name, `/work/${c.slug}`]]} jsonld={[ld]} theme={dark ? 'dark' : undefined}>
  <article class:list={['case', dark ? 'is-dark' : 'is-light', { vt }]}>
    <section class="ov" id="overview">
      <div class="in">
        <p class="lbl">Overview</p>
        <h1>{c.headline}</h1>
        <p class="sum">{c.intro}</p>
        <div class="grid">
          <dl class="stats">
            {c.stats.map(([t, d]) => <div class="stat"><dt>{d}</dt><dd>{t}</dd></div>)}
          </dl>
          <div class="status">
            {c.icon && <img class="ic" src={c.icon} alt="" width="40" height="40" />}
            <p class="lbl">Status</p>
            <p class="st">{c.status}</p>
            <span class="rule" aria-hidden="true"></span>
            <div class="sf">
              <p class="who"><span class="nm">{c.name}</span><span class="rl">{c.kind} · {c.year}</span></p>
              {c.url && <a class="visit" href={c.url} target="_blank" rel="noopener">Visit {c.url.replace('https://', '')}<Icon name="arrow-up-right" size={14} /></a>}
            </div>
          </div>
        </div>
        <div class="svc">
          <p class="sr-only">What we did</p>
          <ul>{c.did.map(d => <li><Icon name="check" size={12} />{d}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="ch" id="film" aria-labelledby="t-01">
      <div class="idx"><div class="ln"><span class="num" aria-hidden="true">01</span><h2 id="t-01">{c.film.title}</h2></div><span class="cr" aria-hidden="true"></span></div>
      <div class="bd"><p class="lead">{c.film.lead}</p><p class="tx">{c.film.body}</p></div>
    </section>
    <div class="media">
      <figure class="film">
        <img src={`/images/cases/film-${c.slug}.webp`} srcset={`/images/cases/film-${c.slug}-800.webp 1292w, /images/cases/film-${c.slug}.webp ${c.film.w * 2}w`} sizes="(max-width:1023px) calc(100vw - 32px), min(1360px, calc(100vw - 80px))" width={c.film.w} height={c.film.h} style={`max-width:min(100%,${c.film.w}px)`} alt={`${c.name}: ${c.film.label}`} fetchpriority="high" decoding="async" />
      </figure>
      <div class="gal"><Masonry slug={c.slug} name={c.name} cols={tiles[c.slug]} /></div>
    </div>

    {c.chapters.map(ch => (
      <>
        <section class="ch" id={`ch-${ch.n}`} aria-labelledby={`t-${ch.n}`}>
          <div class="idx"><div class="ln"><span class="num" aria-hidden="true">{ch.n}</span><h2 id={`t-${ch.n}`}>{ch.title}</h2></div><span class="cr" aria-hidden="true"></span></div>
          <div class="bd">
            <p class="lead">{ch.lead}</p>
            <p class="tx">{ch.body}</p>
            {ch.list && (
              <dl class="pts">
                {ch.list.map(([t, d], k) => <div class="pt"><span class="pn" aria-hidden="true">{String(k + 1).padStart(2, '0')}</span><dt>{t}</dt><dd>{d}</dd></div>)}
              </dl>
            )}
          </div>
        </section>
        {ch.visuals && <div class="media">{ch.visuals.map(v => <Visual v={v} />)}</div>}
      </>
    ))}

    <section class="more" aria-labelledby="more-t">
      <div class="in">
        <header class="mh">
          <p class="lbl">Next case</p>
          <h2 id="more-t">More case studies</h2>
        </header>
        <div class="cards">{more.map(m => <Card c={m} ratio="369 / 257" />)}</div>
      </div>
    </section>
  </article>
</Page>

<script>
  // Swipe slider (mobile gallery): progress line follows scroll.
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach(s => {
    const t = s.querySelector<HTMLElement>('[data-track]'); const b = s.querySelector<HTMLElement>('[data-bar]');
    if (!t || !b) return;
    const up = () => { const vis = t.clientWidth / t.scrollWidth; const p = t.scrollLeft / Math.max(1, t.scrollWidth - t.clientWidth); b.style.width = `${Math.max(8, vis * 100)}%`; b.style.left = `${p * (100 - Math.max(8, vis * 100))}%`; };
    t.addEventListener('scroll', up, { passive: true }); addEventListener('resize', up); up();
  });
  // Parallax columns (desktop, motion allowed): side columns drift against the middle one.
  const par = document.querySelector<HTMLElement>('[data-parallax]');
  if (par && matchMedia('(min-width:1024px) and (prefers-reduced-motion:no-preference)').matches) {
    const cols = [...par.querySelectorAll<HTMLElement>('[data-speed="1"]')];
    let raf = 0;
    const run = () => { raf = 0; const r = par.getBoundingClientRect(); const p = Math.min(1, Math.max(0, (innerHeight - r.top) / (innerHeight + r.height))); cols.forEach(c => { c.style.transform = `translateY(${(0.5 - p) * 48}px)`; }); };
    addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(run); }, { passive: true }); run();
  }
  // Chapter rule grows in when the chapter enters the viewport (as on DesignMe).
  const rules = document.querySelectorAll<HTMLElement>('.case .ch');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in-view'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -20% 0px' });
    rules.forEach(r => io.observe(r));
  } else rules.forEach(r => r.classList.add('in-view'));
</script>

<style>
  /* Palettes. Light by default (follows the site toggle); dark cases are forced dark by the page. */
  .case{--c-bg:#FFFFFF;--c-panel:#FAFAFA;--c-card:#FFFFFF;--c-fg:#0A0E17;--c-line:rgba(10,14,23,.10);--c-line2:rgba(10,14,23,.2);
    --wk-bg:var(--c-bg);--wk-panel:var(--c-panel);--wk-fg:var(--c-fg);--wk-line:var(--c-line);--wk-line2:var(--c-line2);--wk-tint:rgba(10,14,23,.06);
    background:var(--c-bg);color:var(--c-fg)}
  :root[data-theme="dark"] .case,.case.is-dark{--c-bg:#0F0F0F;--c-panel:#151515;--c-card:#1A1A1A;--c-fg:#F5F5F5;--c-line:rgba(245,245,245,.12);--c-line2:rgba(245,245,245,.24);--wk-tint:rgba(245,245,245,.08)}
  :root .case.vt.is-dark{--c-bg:#07070A;--c-panel:#111015;--c-card:#17161C;--c-fg:#F4F3F7;--c-line:rgba(244,243,247,.12);--c-line2:rgba(244,243,247,.24)}
  /* Breadcrumb row sits on the overview band colour. */
  :global(main:has(.case) > .crumbs){background:#FAFAFA;box-shadow:0 0 0 100vmax #FAFAFA;clip-path:inset(0 -100vmax)}
  :global(:root[data-theme="dark"] main:has(.case) > .crumbs){background:#151515;box-shadow:0 0 0 100vmax #151515}
  :global(main:has(.case.vt) > .crumbs){background:#111015!important;box-shadow:0 0 0 100vmax #111015!important}

  .in{max-width:1200px;margin:0 auto;padding:0 40px;box-sizing:content-box}
  .lbl{margin:0;font-size:11px;line-height:14.3px;font-weight:500;letter-spacing:.66px;text-transform:uppercase;opacity:.62}

  /* Overview: band 64 / 96 */
  .ov{background:var(--c-panel);padding:64px 0 96px}
  .ov h1{margin:12px 0 0;max-width:1000px;font-size:56px;line-height:64.4px;font-weight:600;letter-spacing:-1.12px}
  .sum{margin:20px 0 0;max-width:900px;font-size:18px;line-height:25.2px;font-weight:600}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:40px}
  .stats{display:grid;gap:12px;margin:0}
  .stat{display:flex;flex-direction:column-reverse;justify-content:flex-end;gap:4px;padding:20px;background:var(--c-card);border:1px solid var(--c-line)}
  .stat dd{margin:0;font-size:32px;line-height:35.2px;font-weight:600;letter-spacing:-.64px}
  .stat dt{font-size:14px;line-height:21px;font-weight:500;opacity:.75}
  .status{display:flex;flex-direction:column;align-items:flex-start;gap:20px;padding:24px;background:var(--c-card);border:1px solid var(--c-line)}
  .ic{width:40px;height:40px;border-radius:9px;display:block}
  .status .lbl{margin-bottom:-8px}
  .st{margin:0;font-size:24px;line-height:32.4px;font-weight:600;letter-spacing:-.24px;max-width:544px}
  .rule{width:40px;height:2px;background:var(--c-fg)}
  .sf{margin-top:auto;display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:12px 24px;width:100%}
  .who{margin:0;display:flex;flex-direction:column}
  .nm{font-size:16px;line-height:24px;font-weight:600}
  .rl{font-size:14px;line-height:21px;opacity:.62}
  .visit{display:inline-flex;align-items:center;gap:6px;font-size:14px;line-height:21px;font-weight:600;color:inherit;text-decoration:underline;text-underline-offset:3px}
  .svc{margin-top:32px;padding-top:20px;border-top:1px solid var(--c-line)}
  .svc ul{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:8px 20px}
  .svc li{display:inline-flex;align-items:center;gap:8px;font-size:14px;line-height:21px;opacity:.75}
  .svc li :global(svg){opacity:.83}

  /* Chapters: 128 / 80 inside a 1280 container; index 389 + gap 32 + body 672 */
  .ch{max-width:1200px;margin:0 auto;padding:128px 40px 80px;box-sizing:content-box;display:grid;grid-template-columns:389px minmax(0,672px);gap:32px}
  .idx{display:flex;flex-direction:column;gap:16px}
  .ln{margin:0;display:flex;align-items:baseline;gap:16px}
  .num{font-size:16px;line-height:24px;opacity:.62;font-variant-numeric:tabular-nums}
  .ch h2{margin:0;font-size:24px;line-height:31.2px;font-weight:600;letter-spacing:-.24px}
  .cr{display:block;width:0;height:2px;background:var(--c-fg);transition:width .6s cubic-bezier(.2,.7,.2,1)}
  .ch.in-view .cr{width:40px}
  @media (prefers-reduced-motion:reduce){.cr{transition:none;width:40px}}
  .bd{display:flex;flex-direction:column;gap:20px}
  .lead{margin:0;font-size:18px;line-height:26.1px;font-weight:600;letter-spacing:-.18px}
  .tx{margin:0;font-size:16px;line-height:24px;opacity:.75}
  .pts{margin:0}
  .pt{display:grid;grid-template-columns:36px minmax(0,1fr);gap:4px 16px;padding:20px 0;border-top:1px solid var(--c-line)}
  .pt:first-child{padding-top:0;border-top:0}
  .pt:last-child{padding-bottom:0}
  .pn{grid-row:span 2;width:36px;height:36px;display:grid;place-items:center;border:1px solid var(--c-line2);font-size:13px;line-height:19.5px}
  .pt dt{margin-top:5px;font-size:20px;line-height:26px;font-weight:600;letter-spacing:-.2px}
  .pt dd{margin:0;font-size:16px;line-height:24px;opacity:.75}

  /* Media: full width, padding 0 40, 12 gap; images never above their pixel size */
  .media{padding:0 40px;display:flex;flex-direction:column;align-items:center;gap:12px}
  .media > :global(*){width:100%}
  .film{margin:0;display:flex;justify-content:center;background:transparent}
  .film img{display:block;width:100%;height:auto;background:var(--c-panel)}
  .gal{width:100%}

  /* Next case: section 128, centred head, 3 cards of 387 */
  .more{padding:128px 0}
  .mh{display:flex;flex-direction:column;align-items:center;gap:12px;text-align:center;margin-bottom:64px}
  .mh h2{margin:0;font-size:56px;line-height:64.4px;font-weight:600;letter-spacing:-1.12px}
  .cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}

  @media (max-width:1023px){
    .in{padding:0 16px}
    .ov{padding:40px 0 56px}
    .ov h1{font-size:36px;line-height:41.4px;letter-spacing:-.72px}
    .sum{margin-top:16px;font-size:16px;line-height:22.4px}
    .grid{grid-template-columns:1fr;margin-top:32px}
    .stat dd{font-size:24px;line-height:26.4px;letter-spacing:-.48px}
    .st{font-size:20px;line-height:27px;letter-spacing:-.2px}
    .svc{margin-top:32px}
    .ch{display:flex;flex-direction:column;gap:20px;padding:64px 16px 40px;max-width:none}
    .ch h2{font-size:20px;line-height:26px;letter-spacing:-.2px}
    .num{font-size:15px;line-height:22.5px}
    .lead{font-size:16px;line-height:23.2px;letter-spacing:-.16px}
    .tx{font-size:15px;line-height:22.5px}
    .pt{padding:0 0 20px;border-top:0}
    .pt + .pt{padding-top:20px;border-top:1px solid var(--c-line)}
    .pn{font-size:12px;line-height:18px}
    .pt dt{font-size:18px;line-height:23.4px;letter-spacing:-.18px}
    .pt dd{font-size:15px;line-height:22.5px}
    .media{padding:0 16px;gap:8px}
    .gal{margin:0 -16px;width:calc(100% + 32px)!important}
    .more{padding:64px 0}
    .mh{margin-bottom:32px}
    .mh h2{font-size:36px;line-height:41.4px;letter-spacing:-.72px}
    .cards{grid-template-columns:1fr}
  }
</style>
