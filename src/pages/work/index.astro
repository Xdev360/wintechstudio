---
// Work index, DesignMe /projects layout: centred head (eyebrow, H1 56, sub 18/500), filter chips,
// 2-column grid of hairline cards. Light by default, follows the site theme.
// Motion pieces section is left out until the videos exist (data kept in cases.ts as motionPieces).
import Page from '../../layouts/Page.astro';
import Card from '../../components/work/Card.astro';
import { cases, workOrder } from '../../data/cases';
const list = workOrder.map(s => cases.find(c => c.slug === s)!);
const filters = ['All', 'Branding', 'Apps', 'Websites', 'Motion'].filter(f => f === 'All' || list.some(c => c.filters.includes(f)));
const ld = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Work from Wintech Studio', hasPart: list.map(c => ({ '@type': 'CreativeWork', name: c.name, url: `https://www.wintechstudio.com/work/${c.slug}` })) };
---
<Page title="Work · Wintech Studio" description="Case studies from Wintech Studio in Lagos: client work, our own products and concepts, from Mylo to Tobel Pearls. Every card says which, and what we made." crumbs={[['Work', '/work']]} jsonld={[ld]}>
  <div class="wx">
    <section class="hd">
      <p class="lb">Case studies</p>
      <h1>Work from the studio, for businesses starting, adding tech and refreshing</h1>
      <p class="sb">Client work, our own products and concepts. Every card says which, and what we made.</p>
      <div class="chips" role="toolbar" aria-label="Filter work">
        {filters.map((f, k) => <button type="button" class:list={['chip', { on: k === 0 }]} data-f={f} aria-pressed={k === 0 ? 'true' : 'false'}>{f}</button>)}
      </div>
    </section>

    <section class="gd" aria-label="Case studies">
      <div class="grid" id="w-cards">
        {list.map((c, k) => <Card c={c} eager={k < 2} filters />)}
        <div class="yours" id="w-yours">
          <p class="lb">Next case study</p>
          <h2>Your project could be next.</h2>
          <p>Branding, apps, websites and motion, by one team.</p>
          <a class="bt" href="/book">Book a call</a>
        </div>
      </div>
      <p class="none" id="w-none" hidden>Nothing matches that yet. Try another filter.</p>
    </section>
  </div>
</Page>

<script>
  const btns = [...document.querySelectorAll<HTMLButtonElement>('.chips .chip')];
  const cards = [...document.querySelectorAll<HTMLElement>('#w-cards [data-cats]')];
  const none = document.getElementById('w-none')!;
  const apply = (cur: string) => {
    let shown = 0;
    cards.forEach(c => { const ok = cur === 'All' || (c.dataset.cats || '').split(',').includes(cur); c.hidden = !ok; if (ok) shown++; });
    none.hidden = shown > 0;
  };
  btns.forEach(b => b.addEventListener('click', () => {
    btns.forEach(x => { x.classList.toggle('on', x === b); x.setAttribute('aria-pressed', String(x === b)); });
    apply(b.dataset.f!);
  }));
</script>

<style>
  .wx{--wk-bg:#FFFFFF;--wk-panel:#FAFAFA;--wk-fg:#0A0E17;--wk-line:rgba(10,14,23,.10);--wk-line2:rgba(10,14,23,.2);--wk-tint:rgba(10,14,23,.06);background:var(--wk-bg);color:var(--wk-fg)}
  :root[data-theme="dark"] .wx{--wk-bg:#0F0F0F;--wk-panel:#151515;--wk-fg:#F5F5F5;--wk-line:rgba(245,245,245,.12);--wk-line2:rgba(245,245,245,.24);--wk-tint:rgba(245,245,245,.08)}
  .hd,.gd{max-width:1200px;margin:0 auto;padding-left:40px;padding-right:40px;box-sizing:content-box}

  .hd{padding-top:60px;padding-bottom:48px;display:flex;flex-direction:column;align-items:center;gap:16px;text-align:center}
  .lb{margin:0;font-size:11px;line-height:14.3px;font-weight:500;letter-spacing:.66px;text-transform:uppercase;opacity:.62}
  h1{margin:0;max-width:1104px;font-size:56px;line-height:64.4px;font-weight:600;letter-spacing:-1.12px}
  .sb{margin:0;max-width:640px;font-size:18px;line-height:27px;font-weight:500;color:inherit}
  .chips{display:flex;gap:8px;padding:4px 0;justify-content:center;flex-wrap:wrap}
  .chip{height:40px;padding:0 16px;font:500 14px/21px var(--font);color:var(--wk-fg);background:var(--wk-bg);border:1px solid var(--wk-line2);border-radius:2px;cursor:pointer;white-space:nowrap;transition:background .15s,border-color .15s}
  .chip:hover{border-color:var(--wk-fg)}
  .chip.on{background:var(--wk-fg);border-color:var(--wk-fg);color:var(--wk-bg)}

  .gd{padding-bottom:128px}
  .grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
  .yours{display:flex;flex-direction:column;align-items:flex-start;justify-content:flex-end;gap:12px;padding:40px 32px;background:var(--wk-panel);border:1px solid var(--wk-line);min-height:320px}
  .yours h2{margin:0;font-size:32px;line-height:35.2px;font-weight:600;letter-spacing:-.64px}
  .yours p:not(.lb){margin:0;font-size:16px;line-height:24px;opacity:.75}
  .bt{margin-top:12px;display:inline-flex;align-items:center;height:40px;padding:0 24px;font-size:16px;font-weight:500;border-radius:2px;background:#3B5BFF;color:#fff;text-decoration:none;transition:background .15s}
  .bt:hover{background:#2F4BE6}
  .none{margin:24px 0 0;opacity:.75}
  .none[hidden]{display:none}

  @media (max-width:1023px){
    .hd,.gd{padding-left:16px;padding-right:16px}
    .hd{padding-top:40px;padding-bottom:32px;align-items:flex-start;text-align:left}
    h1{font-size:36px;line-height:41.4px;letter-spacing:-.72px}
    .sb{font-size:16px;line-height:24px}
    .chips{flex-wrap:nowrap;justify-content:flex-start;overflow-x:auto;scrollbar-width:none;margin:0 -16px;padding:4px 16px;box-sizing:border-box;width:calc(100% + 32px);max-width:none;align-self:stretch}
    .chips::-webkit-scrollbar{display:none}
    .chip{font-size:13px;line-height:19.5px;flex:none}
    .gd{padding-bottom:64px}
    .grid{grid-template-columns:1fr}
    .yours{min-height:0;padding:32px 20px}
    .yours h2{font-size:24px;line-height:28.8px;letter-spacing:-.48px}
    .bt{width:100%;justify-content:center;font-size:15px}
  }
</style>
