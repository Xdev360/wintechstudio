---
import Page from '../layouts/Page.astro';
import '../styles/studio.css';
const build = [['Fee', 'Full project price'], ['Payment', '50 / 40 / 10'], ['After launch', 'Optional care plan'], ['Who it suits', 'You want to own it outright']];
const partner = [['Fee', 'A reduced project fee'], ['Payment', 'Agreed per project'], ['After launch', 'We run the channels we built'], ['Our share', 'A percentage of sales through them, for a set period or until a cap'], ['Who it suits', 'Strong product, tight cash, ready to grow']];
const steps = [['Paid diagnostic', '$200. We study the business and the numbers.'], ['We decide together', 'If the numbers work, we offer a partner build in writing.'], ['Signed agreement', 'Share, period, cap and reporting, before any work.']];
---
<Page title="Partner build · Wintech Studio" description="Pay less up front, we earn when it sells. A partner build is offered by invitation after the paid diagnostic." crumbs={[['Pricing', '/pricing'], ['Partner build', '/partner-build']]}>
  <div class="dm pb">
    <section class="dm-top">
      <div class="wrap">
        <div class="dm-head c">
          <p class="dm-eb">Partner build · By invitation</p>
          <h1 class="dm-h1">Pay less up front. We earn when it sells.</h1>
          <p class="dm-intro">For businesses ready to grow but not ready for the whole cost. Offered only after the paid diagnostic, when we both believe the numbers.</p>
        </div>
      </div>
    </section>

    <section class="dm-sec alt">
      <div class="wrap dm-stick">
        <div class="dm-head"><p class="dm-eb">Two ways to work with us</p><h2 class="dm-h2s">Build or partner build</h2><p class="dm-intro">Pay the full price and own it outright, or pay less up front and share what the system sells.</p></div>
        <div class="dm-grid g2 cg">
          <div class="dm-card cc"><p class="dm-eb">Pay the full price</p><h3>Build</h3><dl>{build.map(([a, b]) => <div><dt>{a}</dt><dd>{b}</dd></div>)}</dl></div>
          <div class="dm-card cc hi"><div class="ct"><p class="dm-eb">By invitation</p><span class="dm-tag b">After the diagnostic</span></div><h3>Partner build</h3><dl>{partner.map(([a, b]) => <div><dt>{a}</dt><dd>{b}</dd></div>)}</dl></div>
        </div>
      </div>
    </section>

    <section class="dm-sec">
      <div class="wrap dm-stick">
        <div class="dm-head"><p class="dm-eb">How you get one</p><h2 class="dm-h2s">Three steps, no promises up front</h2></div>
        <div>
        <ol class="dm-rows sg">{steps.map(([t, d], i) => <li><span class="dm-num">{String(i + 1).padStart(2, '0')}</span><h3 class="dm-h3">{t}</h3><p class="dm-body">{d}</p></li>)}</ol>
        <div class="go"><a class="dm-btn p mw" href="/diagnostic">Start with the diagnostic</a><a class="dm-link" href="/book?service=diagnostic">Or book a call</a></div>
        </div>
      </div>
    </section>
  </div>
</Page>
<style>
  .cg{align-items:start}
  .cc{padding:32px;gap:16px}
  .cc.hi{border-color:var(--fg)}
  .ct{display:flex;justify-content:space-between;align-items:center;gap:12px}
  .cc h3{font-size:32px;line-height:38.4px;letter-spacing:-.64px}
  .cc dl{margin:0;display:flex;flex-direction:column}
  .cc dl div{border-top:1px solid var(--hl);padding:12px 0;display:flex;flex-direction:column;gap:2px}
  .cc dt{font-size:13px;line-height:18px;color:var(--lab)}
  .cc dd{margin:0;font-size:16px;line-height:24px;font-weight:500}
  .sg li{display:grid;grid-template-columns:64px 220px minmax(0,1fr);gap:24px;align-items:baseline;padding:32px 0}
  .sg .dm-num{font-size:20px;line-height:26px;font-weight:600;color:var(--fg)}
  .go{display:flex;align-items:center;gap:24px;margin-top:40px}
  @media (max-width:1023px){
    .sg li{grid-template-columns:40px minmax(0,1fr);gap:4px 12px;padding:20px 0}
    .sg .dm-num{font-size:16px;line-height:24px;grid-row:span 2}
    .cc{padding:20px}
    .cc h3{font-size:24px;line-height:31px}
    .go{flex-direction:column;align-items:stretch;gap:16px;margin-top:24px}
    .go .dm-link{align-self:flex-start}
  }
</style>
