---
import Page from '../layouts/Page.astro';
const rows = [['Fee', 'Full project price', 'A reduced project fee'], ['Payment', '50 / 40 / 10', 'Agreed per project'], ['After launch', 'Optional care plan', 'We run the channels we built'], ['Our share', 'None', 'A percentage of sales through them, for a set period or until a cap'], ['Who it suits', 'You want to own it outright', 'Strong product, tight cash, ready to grow']];
const steps = [['Paid diagnostic', '$200. We study the business and the numbers.'], ['We decide together', 'If the numbers work, we offer a partner build in writing.'], ['Signed agreement', 'Share, period, cap and reporting, before any work.']];
---
<Page title="Partner build · Wintech Studio" description="Pay less up front, we earn when it sells. A partner build is offered by invitation after the paid diagnostic." crumbs={[['Pricing', '/pricing'], ['Partner build', '/partner-build']]}>
  <section class="sec">
    <div class="wrap">
      <p class="mono">Partner build · By invitation</p>
      <h1 class="h1">Pay less up front.<br />We earn when it sells.</h1>
      <p class="lede">For businesses ready to grow but not ready for the whole cost. Offered only after the paid diagnostic, when we both believe the numbers.</p>
      <div class="tw"><table><thead><tr><th></th><th>Build<small>Pay the full price</small></th><th class="ours">Partner build<small>By invitation</small></th></tr></thead><tbody>{rows.map(r => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td></tr>)}</tbody></table></div>
    </div>
  </section>
  <section class="sec alt">
    <div class="wrap"><p class="mono">How you get one</p><h2 class="h2">Three steps, no promises up front.</h2>
      <ol class="grid g3 st">{steps.map(([t, d], i) => <li class="card"><p class="mono">{String(i + 1).padStart(2, '0')}</p><h3>{t}</h3><p>{d}</p></li>)}</ol>
      <a class="btn btn-primary" href="/book">Start with the diagnostic</a>
    </div>
  </section>
</Page>
<style>
  .tw{overflow-x:auto;border:1px solid var(--rule);margin-top:48px}table{width:100%;border-collapse:collapse;min-width:620px}th,td{text-align:left;padding:18px 24px;border-top:1px solid var(--rule);vertical-align:top}thead th{background:var(--surface);border-top:0;font-size:17px}thead small{display:block;font:11px var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--fg-2);margin-top:4px}td{color:var(--fg-2)}tbody th{font-weight:500}.ours{box-shadow:inset 0 3px 0 var(--sig)}
  .st{list-style:none;padding:0;margin:40px 0 32px}
</style>
